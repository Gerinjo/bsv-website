---
import { Image } from 'astro:assets';
import BambiniPhotoGallery from './BambiniPhotoGallery.astro';
import bambiniLogo from '../assets/events/weihnachts-bambini-logo.png';
import { BAMBINI_EVENT } from '../../supabase/functions/_shared/bambini-event.mjs';
import { withBase } from '../utils/paths';

const eventPath = withBase('/erlebnis/weihnachts-bambini-spieltag');
---

<section class="home-bambini" id="bambini-spieltag" aria-labelledby="home-bambini-title">
  <div class="event-card">
    <div class="event-photos"><BambiniPhotoGallery id="home-bambini" compact /></div>
    <div class="event-copy">
      <div class="event-topline">
        <div><p class="eyebrow">Bambini · Hallenfußball</p><time datetime={BAMBINI_EVENT.isoDate}>{BAMBINI_EVENT.date}</time></div>
        <Image src={bambiniLogo} width={160} format="webp" alt="Weihnachtlicher Bambini-Spieltag · BSV Nordstern" class="event-logo" loading="lazy" />
      </div>
      <h2 id="home-bambini-title">Kleine Kicker.<br /><em>Große Weihnachtsfreude.</em></h2>
      <p class="event-intro">Hallenfußball, eine Überraschung für jedes Kind und vielleicht sogar Besuch vom Nikolaus. Seid mit eurer Bambini-Mannschaft dabei!</p>
      <dl>
        <div class="venue"><dt>Spielort</dt><dd>{BAMBINI_EVENT.venue}</dd></div>
        <div><dt>Startzeiten</dt><dd>9:00 · 12:00 · 15:00 Uhr</dd></div>
        <div><dt>Startgebühr</dt><dd>{BAMBINI_EVENT.fee}</dd></div>
      </dl>
      <a class="event-button" href={`${eventPath}#anmeldung`}>Mannschaft anmelden <span aria-hidden="true">↗</span></a>
      <a class="event-details" href={eventPath}>Alle Infos zum weihnachtlichen Spieltag <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .home-bambini { padding: 52px 0 12px; background: #f4f1e8; scroll-margin-top: 130px; }
  .event-card { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); width: min(1160px, calc(100% - 48px)); margin-inline: auto; border-top: 4px solid #e4bf6a; background: #0e3929; color: #fff9ec; box-shadow: 0 18px 42px #0e392915; }
  .event-photos { min-width: 0; align-self: center; }.event-copy { min-width: 0; padding: 29px 32px 31px; }
  .event-topline { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 19px; }.event-topline :global(.event-logo) { display: block; flex: 0 0 auto; width: 76px; height: 76px; object-fit: contain; }
  .eyebrow { margin: 0 0 8px; color: #e4bf6a; font-size: .65rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }.event-topline time { font-size: 1.03rem; font-weight: 800; }
  h2 { margin: 0 0 18px; font-size: clamp(2rem, 3vw, 2.65rem); line-height: 1.03; letter-spacing: -.045em; }h2 em { color: #e4bf6a; font-family: Georgia, serif; font-weight: 400; }
  .event-intro { margin: 0 0 22px; color: #d0dfd2; font-size: .9rem; line-height: 1.7; }
  dl { display: grid; grid-template-columns: 1fr auto; gap: 16px 25px; margin: 0 0 26px; padding: 20px 0; border-block: 1px solid #52705b; }.venue { grid-column: 1 / -1; }dt { margin-bottom: 5px; color: #b7c9ba; font-size: .59rem; font-weight: 750; letter-spacing: .07em; text-transform: uppercase; }dd { margin: 0; font-size: .87rem; font-weight: 750; line-height: 1.5; }
  .event-button { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 19px; background: #f4d638; color: #092f20; font-size: .86rem; font-weight: 850; text-decoration: none; }.event-button:hover { background: #ffe967; }
  .event-details { display: block; margin-top: 17px; color: #e4bf6a; font-size: .75rem; line-height: 1.5; text-underline-offset: 4px; }.event-details span { margin-left: 7px; }a:focus-visible { outline: 3px solid #fff9ec; outline-offset: 4px; }
  @media(max-width: 1000px) { .event-card { grid-template-columns: 1fr 1fr; }.event-copy { padding: 25px; }h2 { font-size: 2rem; } }
  @media(max-width: 800px) { .event-card { grid-template-columns: 1fr; }.event-copy { grid-row: 1; padding: 26px 30px 30px; }.event-topline { margin-bottom: 14px; }h2 { font-size: clamp(2rem, 5vw, 2.7rem); }.event-intro { max-width: 590px; }.event-photos { border-top: 1px solid #52705b; } }
  @media(max-width: 480px) { .home-bambini { padding-top: 30px; }.event-card { width: calc(100% - 30px); }.event-copy { padding: 22px 20px 26px; }.event-topline :global(.event-logo) { width: 65px; height: 65px; }.event-topline time { font-size: .92rem; }.eyebrow { font-size: .57rem; }h2 { font-size: 1.95rem; }dl { gap: 14px; }dd { font-size: .77rem; } }
</style>
