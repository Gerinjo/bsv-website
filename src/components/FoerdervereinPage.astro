---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';
import FoerdervereinApplicationForm from './FoerdervereinApplicationForm.astro';

type View = 'overview' | 'board' | 'join';

interface Props {
  view: View;
}

const { view } = Astro.props;

const pages = {
  overview: {
    title: 'Förderverein | BSV Nordstern Radolfzell',
    description: 'Der Förderverein des BSV Nordstern schafft zusätzliche Möglichkeiten für Sport, Jugend und Vereinsleben.',
    eyebrow: 'Gemeinsam mehr ermöglichen',
    headline: 'Rückenwind für|den BSV.',
    intro: 'Der Förderverein stärkt Ideen, Projekte und Anschaffungen, die unseren Sport und unsere Gemeinschaft nachhaltig voranbringen.',
  },
  // board view removed — Förderverein Vorstandschaft is no longer current
  join: {
    title: 'Mitglied im Förderverein werden | BSV Nordstern Radolfzell',
    description: 'Mitgliedschaft im Förderverein des BSV Nordstern: Beiträge, Vorteile und Aufnahmeantrag.',
    eyebrow: 'Gemeinsam fördern',
    headline: 'Ein Beitrag, der|viel bewegt.',
    intro: 'Mit deiner Mitgliedschaft gibst du guten Ideen eine verlässliche Basis – dauerhaft, unkompliziert und direkt für den BSV.',
  },
} satisfies Record<View, { title: string; description: string; eyebrow: string; headline: string; intro: string }>;

const page = pages[view];
const [headline, emphasis] = page.headline.split('|');

const sectionLinks = [
  { key: 'overview', number: '01', label: 'Förderverein', href: '/foerderverein' },
  { key: 'join', number: '02', label: 'Mitglied werden', href: '/foerderverein/mitglied-werden' },
] as const;

const impactAreas = [
  { number: '01', title: 'Ausstattung', copy: 'Bälle, Tore, Trainingsmaterial und weitere Dinge, die den Sportbetrieb besser machen.' },
  { number: '02', title: 'Projekte', copy: 'Zusätzliche Ideen für Jugend, Mannschaften und das gemeinsame Vereinsleben.' },
  { number: '03', title: 'Veranstaltungen', copy: 'Unterstützung für Turniere, Aktionstage und Begegnungen auf unserem Vereinsgelände.' },
  { number: '04', title: 'Gemeinschaft', copy: 'Engagement dort, wo Menschen zusammenkommen und aus einer Idee ein echtes Erlebnis wird.' },
];

const boardMembers = [
  { name: 'Eberhard Klinkenberg', role: '1. Vorstand', image: '/images/verein/personen/eberhard-klinkenberg.jpg' },
  { name: 'Heike Seidel', role: 'Kassiererin', image: '/images/verein/personen/heike-seidel.jpg' },
  { name: 'Theopond Walz', role: 'Beisitzer' },
  { name: 'Abdul Al Darwish', role: 'Sponsoring' },
  { name: 'Thomas Burkhardt', role: 'Beisitzer' },
  { name: 'Robert Stepzinski', role: 'Beisitzer' },
  { name: 'Janet Nohl', role: 'Beisitzerin' },
];

const initials = (name: string) => name.split(' ').map((part) => part[0]).join('').slice(0, 2);
---

<Layout title={page.title} description={page.description}>
  <Header />

  <main>
    <section class="fv-hero">
      <div class="hero-orbit" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <a class="back-link" href={withBase('/verein')}><span aria-hidden="true">←</span> Zurück zum Verein</a>
          <p class="eyebrow"><span></span>{page.eyebrow}</p>
          <h1>{headline}<br /><em>{emphasis}</em></h1>
          <p class="hero-intro">{page.intro}</p>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <span class="hero-label">Förderverein</span>
          <strong>✦</strong>
          <small>BSV Nordstern<br />Radolfzell</small>
        </div>
      </div>
    </section>

    <nav class="section-nav" aria-label="Förderverein">
      <div class="shell">
        {sectionLinks.map((link) => (
          <a href={withBase(link.href)} aria-current={view === link.key ? 'page' : undefined}>
            <small>{link.number}</small><span>{link.label}</span><b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </nav>

    {view === 'overview' && (
      <>
        <section class="intro-section">
          <div class="shell intro-grid">
            <div>
              <p class="eyebrow dark"><span></span>Warum es uns gibt</p>
              <h2>Gute Ideen brauchen<br /><em>Rückenwind.</em></h2>
            </div>
            <div class="intro-copy">
              <p class="lead">Der Förderverein ist ein eigenständiger Partner des BSV Nordstern. Er bündelt Beiträge, Spenden und persönliches Engagement, um zusätzliche Vorhaben möglich zu machen.</p>
              <p>Die Unterstützung ergänzt die reguläre Vereinsarbeit gezielt: bei Anschaffungen, besonderen Projekten, Veranstaltungen und überall dort, wo eine gute Idee zusätzliche Kraft benötigt.</p>
            </div>
          </div>
        </section>

        <section class="impact-section">
          <div class="shell">
            <header class="section-heading">
              <div><p class="eyebrow light"><span></span>Was wir bewegen</p><h2>Förderung, die<br /><em>ankommt.</em></h2></div>
              <p>Jeder Beitrag fließt zurück in den Sport und die Vereinsgemeinschaft.</p>
            </header>
            <div class="impact-grid">
              {impactAreas.map((area) => (
                <article><small>{area.number}</small><span aria-hidden="true">✦</span><h3>{area.title}</h3><p>{area.copy}</p></article>
              ))}
            </div>
          </div>
        </section>

        <section class="path-section">
          <div class="shell path-grid">
            <a class="path-card path-join" href={withBase('/foerderverein/mitglied-werden')}>
              <small>Teil der Unterstützung werden</small><h2>Gemeinsam<br />mehr bewegen.</h2><p>Schon ein verlässlicher Jahresbeitrag schafft neue Möglichkeiten.</p><strong>Mitglied werden <span>↗</span></strong>
            </a>
          </div>
        </section>
      </>
    )}

    {/* board view removed — no current Vorstandschaft for Förderverein */}

    {view === 'join' && (
      <>
        <section class="join-intro">
          <div class="shell join-grid">
            <div class="join-copy">
              <p class="eyebrow dark"><span></span>Fördermitgliedschaft</p>
              <h2>Verlässlich helfen.<br /><em>Jahr für Jahr.</em></h2>
              <p class="lead">Mit deiner Fördermitgliedschaft stärkst du Projekte, Anschaffungen und Veranstaltungen des BSV langfristig.</p>
              <p>Du entscheidest selbst, ob du beim Mindestbeitrag bleibst oder den Förderverein mit einem höheren Jahresbeitrag unterstützen möchtest.</p>
            </div>
            <div class="contribution-grid">
              <article><small>BSV-Mitglieder</small><strong>11 <span>€</span></strong><p>Mindestjahresbeitrag</p></article>
              <article class="primary"><small>Nichtmitglieder</small><strong>25 <span>€</span></strong><p>Mindestjahresbeitrag</p></article>
              <p class="contribution-note">Die Beiträge werden jährlich eingezogen. Ein zusätzlicher freiwilliger Förderbetrag kann im Antrag angegeben werden.</p>
            </div>
          </div>
        </section>

        <section class="steps-section">
          <div class="shell">
            <header class="section-heading light-background"><div><p class="eyebrow dark"><span></span>So wirst du Mitglied</p><h2>Drei Schritte.<br /><em>Viel Wirkung.</em></h2></div><p>Den vollständigen Antrag kannst du direkt hier auf der Website ausfüllen und unterschreiben.</p></header>
            <ol class="steps-grid">
              <li><span>01</span><div><h3>Daten eintragen</h3><p>Fülle den Online-Antrag mit deinen persönlichen Daten und deinem Förderbeitrag aus.</p></div></li>
              <li><span>02</span><div><h3>Digital unterschreiben</h3><p>Bestätige das SEPA-Mandat und unterschreibe direkt mit Maus, Finger oder Stift.</p></div></li>
              <li><span>03</span><div><h3>Sicher absenden</h3><p>Der Antrag geht automatisch an den Förderverein. Du erhältst eine Eingangsbestätigung per E-Mail.</p></div></li>
            </ol>
          </div>
        </section>

        <FoerdervereinApplicationForm />
      </>
    )}
    <section class="contact-section">
      <div class="shell">
        <a class="contact-link" href={withBase('/kontakt?thema=foerderverein')}>Kontakt zum Förderverein</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(body) { background: #f4f1e8; }
  .shell { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { letter-spacing: -.055em; }
  .eyebrow { display:flex; align-items:center; gap:10px; margin:0 0 18px; color:#f4d638; font-size:.68rem; font-weight:900; letter-spacing:.17em; text-transform:uppercase; }
  .eyebrow > span { width:26px; height:2px; background:currentColor; }
  .eyebrow.dark { color:#1c5b3b; }.eyebrow.light { color:#a9cfb7; }

  .fv-hero { position:relative; overflow:hidden; min-height:570px; color:white; background:linear-gradient(105deg,#082c1e,#164f32 66%,#1d6540); }
  .fv-hero::before { position:absolute; inset:0; opacity:.13; background-image:radial-gradient(#fff 1px,transparent 1px); background-size:22px 22px; mask-image:linear-gradient(90deg,#000,transparent 72%); content:''; }
  .hero-orbit { position:absolute; right:-160px; top:-220px; width:590px; aspect-ratio:1; border:1px solid rgb(255 255 255 / 14%); border-radius:50%; box-shadow:0 0 0 75px rgb(255 255 255 / 3%),0 0 0 150px rgb(255 255 255 / 2%); }
  .hero-grid { position:relative; z-index:1; min-height:570px; padding-block:70px; display:grid; grid-template-columns:1.25fr .75fr; align-items:center; gap:90px; }
  .back-link { display:inline-flex; align-items:center; gap:9px; margin-bottom:55px; color:#a9c2b3; font-size:.76rem; font-weight:750; text-decoration:none; }.back-link:hover{color:#f4d638}
  h1 { max-width:790px; margin-bottom:25px; font-size:clamp(3.7rem,7vw,6.8rem); line-height:.85; }
  h1 em,h2 em { color:#f4d638; font-family:Georgia,serif; font-weight:400; }
  .hero-intro { max-width:680px; margin:0; color:#c9d9d0; font-size:clamp(1rem,1.6vw,1.18rem); line-height:1.7; }
  .hero-visual { position:relative; min-height:330px; padding:30px; box-sizing:border-box; display:flex; flex-direction:column; justify-content:space-between; border:1px solid rgb(255 255 255 / 18%); background:#f4d638; color:#0a2f20; box-shadow:18px 18px 0 rgb(5 27 18 / 42%); transform:rotate(2.5deg); }
  .hero-visual::after { position:absolute; right:-45px; bottom:-45px; width:170px; aspect-ratio:1; border:1px solid rgb(10 47 32 / 20%); border-radius:50%; box-shadow:0 0 0 30px rgb(10 47 32 / 5%); content:''; }
  .hero-label { font-size:.67rem; font-weight:900; letter-spacing:.18em; text-transform:uppercase; }
  .hero-visual > strong { align-self:center; font-size:7rem; line-height:1; }.hero-visual > small { position:relative; z-index:1; align-self:flex-end; font-size:.73rem; font-weight:850; line-height:1.35; letter-spacing:.08em; text-align:right; text-transform:uppercase; }

  .section-nav { position:relative; z-index:3; background:white; border-bottom:1px solid #dfe7e0; box-shadow:0 8px 25px rgb(12 48 31 / 7%); }
  .section-nav .shell { display:grid; grid-template-columns:repeat(3,1fr); }
  .section-nav a { min-height:78px; padding:0 24px; display:flex; align-items:center; gap:15px; border-left:1px solid #e4e9e5; color:#617167; text-decoration:none; }
  .section-nav a:last-child { border-right:1px solid #e4e9e5; }.section-nav a:hover{background:#f5f8f5;color:#164f32}.section-nav a[aria-current='page']{background:#164f32;color:white}
  .section-nav small { color:#91a197; font-size:.62rem; font-weight:900; }.section-nav a[aria-current='page'] small{color:#f4d638}.section-nav span{font-size:.82rem;font-weight:850}.section-nav b{margin-left:auto;color:#f4d638}

  .intro-section,.board-intro { padding:105px 0; background:#fff; }
  .intro-grid { display:grid; grid-template-columns:1fr 1fr; gap:100px; align-items:start; }
  .intro-grid h2,.join-copy h2 { margin:0; color:#113524; font-size:clamp(2.8rem,5vw,4.8rem); line-height:.92; }
  .intro-copy { padding-top:36px; border-top:1px solid #cdd9d1; color:#57675d; font-size:.98rem; line-height:1.8; }.intro-copy p:last-child{margin-bottom:0}.intro-copy .lead,.join-copy .lead{color:#173d29;font-size:1.2rem;font-weight:700;line-height:1.65}

  .impact-section { padding:100px 0 115px; color:white; background:#0a3021; }
  .section-heading { margin-bottom:55px; display:flex; justify-content:space-between; align-items:end; gap:80px; }.section-heading h2{margin:0;font-size:clamp(2.8rem,5vw,4.7rem);line-height:.92}.section-heading>p{max-width:390px;margin:0;color:#9db7a8;line-height:1.7}
  .impact-grid { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid rgb(255 255 255 / 16%); border-left:1px solid rgb(255 255 255 / 16%); }
  .impact-grid article { position:relative; min-height:330px; padding:28px; box-sizing:border-box; border-right:1px solid rgb(255 255 255 / 16%); border-bottom:1px solid rgb(255 255 255 / 16%); }
  .impact-grid article:hover{background:#123f2b}.impact-grid small{color:#789887;font-size:.62rem;font-weight:900}.impact-grid article>span{position:absolute;right:24px;top:22px;color:#f4d638;font-size:1.15rem}.impact-grid h3{margin:110px 0 17px;font-size:1.5rem}.impact-grid p{margin:0;color:#9eb5a8;font-size:.88rem;line-height:1.7}

  .path-section { padding:110px 0; background:#f4f1e8; }.path-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.path-card{position:relative;min-height:390px;padding:55px;box-sizing:border-box;display:flex;flex-direction:column;color:white;text-decoration:none;overflow:hidden}.path-card::after{position:absolute;right:-100px;bottom:-130px;width:300px;aspect-ratio:1;border:1px solid rgb(255 255 255 / 15%);border-radius:50%;box-shadow:0 0 0 50px rgb(255 255 255 / 3%);content:''}.path-board{background:#164f32}.path-join{background:#f4d638;color:#103121}.path-card>small{font-size:.65rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.path-card h2{margin:65px 0 16px;font-size:clamp(2.4rem,4vw,3.8rem);line-height:.95}.path-card p{max-width:420px;margin-bottom:35px;line-height:1.65;opacity:.75}.path-card strong{margin-top:auto;display:flex;justify-content:space-between;align-items:center;font-size:.83rem;text-transform:uppercase;letter-spacing:.08em}.path-card strong span{display:grid;place-items:center;width:42px;aspect-ratio:1;border-radius:50%;background:#f4d638;color:#103121}.path-join strong span{background:#103121;color:#f4d638}

  .people-section { padding:100px 0 120px; background:#eef3ef; }.people-head{margin-bottom:35px;padding-bottom:18px;display:flex;justify-content:space-between;border-bottom:1px solid #c8d4cc;color:#557064;font-size:.68rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.people-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.person-card{background:white}.person-media{position:relative;height:310px;overflow:hidden;background:linear-gradient(145deg,#0b3222,#1e6942);}.person-media img{width:100%;height:100%;object-fit:cover;object-position:center 20%;filter:saturate(.8)}.person-media>span{height:100%;display:grid;place-items:center;color:rgb(255 255 255 / 13%);font-size:6rem;font-weight:950}.person-media>small{position:absolute;left:20px;top:18px;display:grid;place-items:center;width:34px;aspect-ratio:1;border-radius:50%;background:#f4d638;color:#123b28;font-size:.6rem;font-weight:950}.person-copy{padding:25px 25px 29px}.person-copy span{display:block;margin-bottom:8px;color:#668073;font-size:.62rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.person-copy h2{margin:0;color:#173b29;font-size:1.35rem;line-height:1.1}.person-card.featured{grid-column:span 1}.person-card.featured .person-media{height:370px}

  .contact-section { padding:0 0 110px; background:#eef3ef; }.contact-card{position:relative;min-height:285px;padding:55px 60px;box-sizing:border-box;display:grid;grid-template-columns:1fr auto;align-items:center;gap:70px;overflow:hidden;background:#f4d638;color:#133524}.contact-symbol{position:absolute;right:270px;top:-75px;color:rgb(19 53 36 / 8%);font-size:18rem;font-weight:950;line-height:1}.contact-card>div{position:relative;z-index:1}.contact-card h2{margin:0 0 12px;font-size:clamp(2.2rem,4vw,3.6rem);line-height:.95}.contact-card p:last-child{max-width:650px;margin:0;line-height:1.65}.contact-card>a{position:relative;z-index:1;min-height:54px;padding:0 22px;display:flex;align-items:center;gap:30px;background:#0c3322;color:white;font-size:.8rem;font-weight:850;text-decoration:none}.contact-card>a span{color:#f4d638}

  .join-intro{padding:105px 0;background:#fff}.join-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}.join-copy>p:not(.eyebrow){color:#5a6a60;line-height:1.75}.join-copy h2{margin-bottom:30px}.contribution-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.contribution-grid article{min-height:245px;padding:28px;box-sizing:border-box;display:flex;flex-direction:column;background:#edf3ef;color:#123925}.contribution-grid article.primary{background:#164f32;color:white}.contribution-grid small{font-size:.63rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.contribution-grid strong{margin:auto 0 15px;font-size:4.5rem;line-height:1;letter-spacing:-.08em}.contribution-grid strong span{font-size:1.6rem}.contribution-grid article p{margin:0;color:#688073;font-size:.78rem;font-weight:800}.contribution-grid .primary p{color:#a8c3b3}.contribution-note{grid-column:1/-1;margin:4px 0 0;padding:16px 18px;border-left:3px solid #f4d638;background:#f6f2e7;color:#607066;font-size:.78rem;line-height:1.6}

  .steps-section{padding:105px 0;background:#f4f1e8}.section-heading.light-background>p{color:#65756b}.steps-grid{margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);list-style:none;border-top:1px solid #bccbc1;border-left:1px solid #bccbc1}.steps-grid li{min-height:260px;padding:28px;display:flex;flex-direction:column;border-right:1px solid #bccbc1;border-bottom:1px solid #bccbc1}.steps-grid li>span{color:#1c5b3b;font-size:.64rem;font-weight:950}.steps-grid div{margin-top:auto}.steps-grid h3{margin-bottom:13px;color:#153c29;font-size:1.25rem}.steps-grid p{margin:0;color:#64736a;font-size:.86rem;line-height:1.65}

  .application-section{padding:0 0 115px;background:#f4f1e8}.application-card{min-height:290px;padding:48px 55px;box-sizing:border-box;display:grid;grid-template-columns:130px 1fr auto;align-items:center;gap:45px;background:#0b3021;color:white}.application-mark{height:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#f4d638;color:#123a27;transform:rotate(-3deg)}.application-mark span{font-size:.63rem;font-weight:950;letter-spacing:.16em}.application-mark strong{font-size:3.2rem;line-height:1}.application-card>div:nth-child(2)>small{color:#f4d638;font-size:.64rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.application-card h2{margin:9px 0 12px;font-size:2.35rem}.application-card p{max-width:560px;margin:0;color:#a8bcaf;line-height:1.65}.application-actions{display:flex;flex-direction:column;align-items:stretch;gap:13px}.application-actions a{display:flex;align-items:center;justify-content:space-between;gap:28px;color:#c7d6cd;font-size:.78rem;font-weight:850;text-decoration:none}.application-actions .primary-action{min-height:54px;padding:0 20px;background:#f4d638;color:#123a27}.application-actions>a:not(.primary-action){padding:8px 3px}

  @media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:55px}.hero-visual{min-height:230px}.intro-grid,.join-grid{grid-template-columns:1fr;gap:55px}.impact-grid{grid-template-columns:1fr 1fr}.people-grid{grid-template-columns:1fr 1fr}.join-grid{align-items:start}.application-card{grid-template-columns:110px 1fr}.application-actions{grid-column:1/-1;flex-direction:row}.application-actions a{flex:1}.contact-card{grid-template-columns:1fr;gap:35px}.contact-card>a{width:max-content}.contact-symbol{right:-20px}.section-heading{align-items:start;flex-direction:column;gap:25px}}
  @media(max-width:620px){.shell{width:min(100% - 30px,1160px)}.fv-hero,.hero-grid{min-height:640px}.hero-grid{padding-block:55px}.back-link{margin-bottom:40px}.hero-visual{min-height:190px}.hero-visual>strong{font-size:4.8rem}.section-nav .shell{width:100%;grid-template-columns:1fr}.section-nav a{min-height:58px;padding:0 18px;border-right:0!important;border-bottom:1px solid #e4e9e5}.intro-section,.board-intro,.join-intro{padding:75px 0}.impact-section,.people-section,.steps-section{padding:75px 0}.impact-grid,.path-grid,.people-grid,.steps-grid,.contribution-grid{grid-template-columns:1fr}.impact-grid article{min-height:250px}.impact-grid h3{margin-top:75px}.path-section{padding:75px 0}.path-card{min-height:340px;padding:38px 30px}.person-card.featured{grid-column:auto}.person-card.featured .person-media,.person-media{height:310px}.contact-section{padding-bottom:75px}.contact-card{padding:38px 28px}.contact-card>a{width:auto}.contribution-note{grid-column:auto}.application-section{padding-bottom:75px}.application-card{padding:35px 28px;grid-template-columns:1fr;gap:28px}.application-mark{width:105px;height:105px}.application-actions{grid-column:auto;flex-direction:column}.application-card h2{font-size:2rem}}
</style>
