---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';
import FoerdervereinApplicationForm from './FoerdervereinApplicationForm.astro';

type View = 'overview' | 'information' | 'join';

interface Props {
  view: View;
}

const { view } = Astro.props;

const pages = {
  overview: {
    title: 'Vorstandschaft des Fördervereins | BSV Nordstern Radolfzell',
    description: 'Vorstandschaft und Unterstützer des Fördervereins: Der 1. Vorsitz ist aktuell vakant. Wir suchen dringend weitere Menschen, die Verantwortung übernehmen und mithelfen.',
    eyebrow: 'Förderverein · Vorstandschaft',
    headline: 'Vorstandschaft des|Fördervereins.',
    intro: 'Die Vorstandschaft und unsere Unterstützer setzen sich für den BSV ein. Der 1. Vorsitz ist aktuell vakant – und wir brauchen dringend weitere Menschen, die mitgestalten und mithelfen.',
  },
  information: {
    title: 'Informationen & Zielsetzungen des Fördervereins | BSV Nordstern Radolfzell',
    description: 'Was der Förderverein macht, welche Projekte er unterstützt und wie du durch Mitgliedschaft, Förderbeiträge oder ehrenamtliche Mitarbeit helfen kannst.',
    eyebrow: 'Förderverein · Informationen & Zielsetzungen',
    headline: 'Gemeinsam fördern.|Gemeinsam bewegen.',
    intro: 'Wir schaffen zusätzliche Möglichkeiten für Sport, Jugend und Vereinsleben. Hier erfährst du, wie wir Mittel gewinnen, wo unsere Förderung ankommt und wie du dazu beitragen kannst.',
  },
  join: {
    title: 'Mitglied im Förderverein werden | BSV Nordstern Radolfzell',
    description: 'Mitgliedschaft im Förderverein des BSV Nordstern: Beiträge, Vorteile und Aufnahmeantrag.',
    eyebrow: 'Gemeinsam fördern',
    headline: 'Ein Beitrag, der|viel bewegt.',
    intro: 'Mit deiner Mitgliedschaft gibst du guten Ideen eine verlässliche Basis – dauerhaft, unkompliziert und direkt für den BSV.',
  },
} satisfies Record<View, { title: string; description: string; eyebrow: string; headline: string; intro: string }>;

const page = pages[view];
const [headline, emphasis] = page.headline.split('|');

const sectionLinks = [
  { key: 'overview', number: '01', label: 'Vorstandschaft', href: '/foerderverein' },
  { key: 'information', number: '02', label: 'Informationen & Zielsetzungen', href: '/foerderverein/informationen-zielsetzungen' },
  { key: 'join', number: '03', label: 'Mitglied werden', href: '/foerderverein/mitglied-werden' },
] as const;

const informationTabs = [
  { id: 'activities', label: 'Was machen wir' },
  { id: 'impact', label: 'Was unterstützen wir' },
  { id: 'support', label: 'Wie kannst du uns unterstützen' },
] as const;

const impactAreas = [
  {
    number: '01',
    title: 'Material',
    copy: 'Bälle, Tore, Trikots und Trainingshilfen, die unsere Teams jeden Tag weiterbringen.',
    image: '/images/events/urmel/2026/03-kleinfeld.webp',
    alt: 'Ein Fußballtor beim Kinderturnier des BSV Nordstern',
  },
  {
    number: '02',
    title: 'Training & Projekte',
    copy: 'Zusätzliche Angebote und Ideen, die Kindern und Jugendlichen neue sportliche Erfahrungen ermöglichen.',
    image: '/images/events/tdm/2025/06-training.jpg',
    alt: 'Jugendliche des BSV bei einer gemeinsamen Trainingseinheit',
  },
  {
    number: '03',
    title: 'Turniere & Erlebnisse',
    copy: 'Unterstützung für Spieltage, Turniere und besondere Momente auf unserem Vereinsgelände.',
    image: '/images/events/urmel/2026/04-turniertag.webp',
    alt: 'Kinderteams beim URMEL-Turniertag des BSV',
  },
  {
    number: '04',
    title: 'Teamausflüge',
    copy: 'Gemeinsame Erlebnisse abseits des Platzes, die aus Mannschaften eine starke Gemeinschaft machen.',
    image: '/images/jugend/juniorinnen/u17/2026-solarcup-teamausflug/IMG-20260712-WA0004.webp',
    alt: 'U17-Juniorinnen beim gemeinsamen Teamausflug',
  },
];

const fundingSources = [
  { number: '01', title: 'Freiwillige Beiträge', copy: 'Mitgliedsbeiträge und zusätzliche freiwillige Förderbeträge schaffen eine verlässliche Grundlage.' },
  { number: '02', title: 'Flohmärkte', copy: 'Mit Standgebühren und Bewirtung erwirtschaftet der Förderverein zusätzliche Mittel für den Sport.' },
  { number: '03', title: 'Gebrauchträdermärkte', copy: 'Gemeinsam organisierte Rädermärkte verbinden nachhaltiges Handeln mit konkreter Unterstützung.' },
  { number: '04', title: 'Feste & Bewirtung', copy: 'Bei Festivitäten, Turnieren und weiteren Veranstaltungen sorgt das Team für Essen, Getränke und Einnahmen.' },
];

const boardMembers = [
  { name: 'Aktuell vakant', role: '1. Vorsitz', vacant: true },
  { name: 'Eberhard Klinkenberg', role: '2. Vorsitz', image: '/images/verein/personen/eberhard-klinkenberg.jpg' },
  { name: 'Heike Seidel', role: 'Kasse', image: '/images/verein/personen/heike-seidel.jpg' },
  { name: 'Sarah Hainke', role: 'Schriftführerin' },
];

const supporters = [
  { name: 'Thomas Burkhardt', role: 'Unterstützer', image: '/images/verein/personen/thomas-burkhardt.jpg' },
  { name: 'Theopolt Walz', role: 'Unterstützer' },
  { name: 'Sigrid Burkhardt', role: 'Unterstützerin', image: '/images/verein/personen/sigrid-burkhardt.jpg' },
  { name: 'Hardy Seidel', role: 'Unterstützer', image: '/images/verein/personen/hardy-seidel.jpg' },
  { name: 'Janet Nohl', role: 'Unterstützerin', image: '/images/verein/personen/janet-nohl.jpg' },
];

const volunteerRoles = [
  {
    title: '1. Vorsitzende/r gesucht',
    copy: 'Der 1. Vorsitz ist aktuell vakant. Du möchtest Verantwortung übernehmen und unseren Förderverein aktiv mitgestalten? Diese Aufgaben erwarten dich:',
    tasks: [
      'Den Förderverein nach außen und innen vertreten',
      'Die Vereinsarbeit gemeinsam mit der Vorstandschaft koordinieren',
      'Neue Ideen und Impulse einbringen',
    ],
  },
  {
    title: 'Helferinnen und Helfer gesucht',
    copy: 'Ob regelmäßig oder bei einer einzelnen Aktion: Wir freuen uns auf Menschen, die gemeinsam mit uns anpacken. Hier kannst du mithelfen:',
    tasks: [
      'Bei Veranstaltungen unterstützen, etwa beim Aufbau oder in der Bewirtung',
      'Bei Projekten und Aktionen mithelfen',
      'Eigene Talente und Zeit einbringen – auch für kleine Aufgaben',
    ],
  },
];

const supportOptions = [
  { number: '01', title: 'Mitglied werden', copy: 'Ein verlässlicher Jahresbeitrag hilft uns, Förderung zu planen und gute Ideen umzusetzen. Den Mitgliedsantrag kannst du direkt online ausfüllen.', label: 'Zum Mitgliedsantrag', href: '/foerderverein/mitglied-werden' },
  { number: '02', title: 'Zusätzlich fördern', copy: 'Im Mitgliedsantrag kannst du einen zusätzlichen freiwilligen Förderbetrag angeben. Wenn du mit einer Spende ein konkretes Vorhaben unterstützen möchtest, sprich uns gerne an.', label: 'Förderung besprechen', href: '/kontakt?thema=foerderverein' },
  { number: '03', title: 'Bei Aktionen mithelfen', copy: 'Ob Aufbau, Bewirtung oder Organisation bei Flohmärkten, Gebrauchträdermärkten und Festen: Auch Hilfe bei einzelnen Veranstaltungen entlastet unser Team.', label: 'Mithilfe anbieten', href: '/kontakt?thema=foerderverein' },
  { number: '04', title: 'Verantwortung übernehmen', copy: 'Der 1. Vorsitz ist aktuell vakant. Wenn du den Förderverein mitgestalten oder unser Team langfristig unterstützen möchtest, freuen wir uns auf ein Gespräch.', label: 'Zur Vorstandschaft', href: '/foerderverein' },
];

const initials = (name: string) => name.split(' ').map((part) => part[0]).join('').slice(0, 2);
---

<Layout title={page.title} description={page.description}>
  <Header />

  <main>
    <section class="fv-hero">
      <div class="hero-orbit" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <a class="back-link" href={withBase('/verein')}><span aria-hidden="true">←</span> Zurück zum Verein</a>
          <p class="eyebrow"><span></span>{page.eyebrow}</p>
          <h1>{headline}<br /><em>{emphasis}</em></h1>
          <p class="hero-intro">{page.intro}</p>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <span class="hero-label">Förderverein</span>
          <strong>✦</strong>
          <small>BSV Nordstern<br />Radolfzell</small>
        </div>
      </div>
    </section>

    <nav class="section-nav" aria-label="Förderverein">
      <div class="shell">
        {sectionLinks.map((link) => (
          <a href={withBase(link.href)} aria-current={view === link.key ? 'page' : undefined}>
            <small>{link.number}</small><span>{link.label}</span><b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </nav>

    {view === 'overview' && (
      <>
        <section class="team-section" id="wer-sind-wir">
          <div class="shell">
            <header class="section-heading light-background">
              <div><p class="eyebrow dark"><span></span>Vorstandschaft & Unterstützer</p><h2>Gemeinsam<br /><em>Verantwortung tragen.</em></h2></div>
              <p>Die Vorstandschaft kümmert sich um die Mittel und entscheidet gemeinsam, wo Unterstützung ankommt. Unsere Unterstützer helfen bei Aktionen und Veranstaltungen mit.</p>
            </header>
            <section class="team-group" aria-labelledby="vorstandschaft-heading">
              <h3 id="vorstandschaft-heading">Vorstandschaft des Fördervereins</h3>
              <div class="team-grid board-grid">
                {boardMembers.map((member) => (
                  <article class:list={{ 'vacant-card': member.vacant }}>
                    <div class="team-portrait">
                      {member.image ? <img src={member.image} alt={member.name} loading="lazy" /> : <span aria-hidden="true">{member.vacant ? '?' : initials(member.name)}</span>}
                    </div>
                    <div><small>{member.role}</small><h4>{member.name}</h4></div>
                  </article>
                ))}
              </div>
            </section>
            <section class="team-group supporters-group" aria-labelledby="unterstuetzer-heading">
              <h3 id="unterstuetzer-heading">Unterstützer</h3>
              <div class="team-grid supporters-grid">
                {supporters.map((member) => (
                  <article>
                    <div class="team-portrait">
                      {member.image ? <img src={member.image} alt={member.name} loading="lazy" /> : <span aria-hidden="true">{initials(member.name)}</span>}
                    </div>
                    <div><small>{member.role}</small><h4>{member.name}</h4></div>
                  </article>
                ))}
              </div>
            </section>
            <aside class="engagement-callout" aria-labelledby="engagement-heading">
              <p class="eyebrow dark"><span></span>Dringend Unterstützung gesucht</p>
              <h2 id="engagement-heading">Der 1. Vorsitz ist vakant.<br /><em>Dein Engagement zählt.</em></h2>
              <p class="engagement-intro">Unser Förderverein unterstützt den BSV von der Jugendarbeit bis zur Vereinsentwicklung. Damit das auch in Zukunft so bleibt, suchen wir dringend Menschen, die Verantwortung übernehmen und unseren Verein aktiv mitgestalten. Besonders wichtig ist es, den aktuell unbesetzten 1. Vorsitz wieder zu besetzen.</p>
              <div class="engagement-grid">
                {volunteerRoles.map((role) => (
                  <div>
                    <h3>{role.title}</h3>
                    <p>{role.copy}</p>
                    <ul>{role.tasks.map((task) => <li>{task}</li>)}</ul>
                  </div>
                ))}
              </div>
              <p class="engagement-intro">Du kannst auch ohne Vorstandsamt mithelfen. Mit deinem Engagement fördern wir die Jugend, stärken das Vereinsleben und erreichen gemeinsam mehr.</p>
              <a class="engagement-action" href={withBase('/kontakt?thema=foerderverein')}>Beim Förderverein melden <span aria-hidden="true">↗</span></a>
            </aside>
          </div>
        </section>
      </>
    )}

    {view === 'information' && (
      <section class="information-section" data-information-tabs>
        <div class="shell">
          <div class="information-tabs" role="tablist" aria-label="Informationen und Zielsetzungen des Fördervereins" hidden>
            {informationTabs.map((tab, index) => (
              <button type="button" role="tab" id={`information-tab-${tab.id}`} aria-controls={`information-panel-${tab.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>{tab.label}</button>
            ))}
          </div>

          <section class="information-panel" id="information-panel-activities" role="tabpanel" aria-labelledby="information-tab-activities" tabindex="0">
            <header class="section-heading light-background activities-heading">
              <div><p class="eyebrow dark"><span></span>Was machen wir</p><h2>Engagement, das<br /><em>Förderung möglich macht.</em></h2></div>
              <a class="support-banner" href="#information-panel-support" aria-label="Herz für Grün? Pack mit an! – So kannst du uns unterstützen">
                <span>Herz für Grün? <strong>Pack mit an!</strong></span><span aria-hidden="true">→</span>
              </a>
              <p>Der Förderverein ist ein eigenständiger Partner des BSV. Wir bündeln Beiträge, Spenden und ehrenamtlichen Einsatz, um zusätzliche Vorhaben zu ermöglichen.</p>
            </header>
            <div class="information-purpose">
              <h3>Unsere Zielsetzung</h3>
              <p>Wir wollen Sport, Jugend und Gemeinschaft beim BSV stärken. Unsere Förderung ergänzt die reguläre Vereinsarbeit dort, wo zusätzliche Mittel für Ausstattung, besondere Projekte und gemeinsame Erlebnisse gebraucht werden.</p>
              <p>Die Mittel dafür entstehen durch freiwillige Beiträge und durch den Einsatz bei Veranstaltungen. Unsere Vorstandschaft kümmert sich um diese Mittel und entscheidet gemeinsam, welche Vorhaben unterstützt werden.</p>
            </div>
            <ol class="funding-grid">
              {fundingSources.map((source) => (
                <li><small>{source.number}</small><div><h3>{source.title}</h3><p>{source.copy}</p></div></li>
              ))}
            </ol>
          </section>

          <section class="information-panel impact-section" id="information-panel-impact" role="tabpanel" aria-labelledby="information-tab-impact" tabindex="0">
            <header class="section-heading">
              <div><p class="eyebrow light"><span></span>Was unterstützen wir</p><h2>Förderung, die<br /><em>ankommt.</em></h2></div>
              <p>Jeder Beitrag fließt zurück in den Sport und die Vereinsgemeinschaft.</p>
            </header>
            <div class="impact-grid">
              {impactAreas.map((area) => (
                <article>
                  <div class="impact-image"><img src={area.image} alt={area.alt} loading="lazy" /></div>
                  <div class="impact-copy"><small>{area.number}</small><span aria-hidden="true">✦</span><h3>{area.title}</h3><p>{area.copy}</p></div>
                </article>
              ))}
            </div>
          </section>

          <section class="information-panel" id="information-panel-support" role="tabpanel" aria-labelledby="information-tab-support" tabindex="0">
            <header class="section-heading light-background">
              <div><p class="eyebrow dark"><span></span>Wie kannst du uns unterstützen</p><h2>Jeder Beitrag<br /><em>hilft uns weiter.</em></h2></div>
              <p>Mitgliedschaft, ein zusätzlicher Förderbetrag oder persönliche Mithilfe: Es gibt viele Wege, den Förderverein und damit den BSV zu stärken.</p>
            </header>
            <aside class="engagement-callout support-recruitment" aria-labelledby="support-recruitment-heading">
              <p class="eyebrow dark"><span></span>Der Förderverein braucht Dich</p>
              <h3 id="support-recruitment-heading">Gesucht: 1. Vorsitz und helfende Hände</h3>
              <p class="engagement-intro">Von der Jugendarbeit bis zur Vereinsentwicklung: Dein Engagement hilft, die Arbeit unseres Fördervereins auch in Zukunft fortzuführen.</p>
              <div class="engagement-grid">
                {volunteerRoles.map((role) => (
                  <div>
                    <h4>{role.title}</h4>
                    <p>{role.copy}</p>
                    <ul>{role.tasks.map((task) => <li>{task}</li>)}</ul>
                  </div>
                ))}
              </div>
              <p class="engagement-intro">Du kannst auch ohne Vorstandsamt mithelfen. Mit deinem Engagement fördern wir die Jugend, stärken das Vereinsleben und erreichen gemeinsam mehr.</p>
              <a class="engagement-action" href={withBase('/kontakt?thema=foerderverein')}>Beim Förderverein melden <span aria-hidden="true">↗</span></a>
            </aside>
            <div class="support-options">
              {supportOptions.map((option) => (
                <article><small>{option.number}</small><h3>{option.title}</h3><p>{option.copy}</p><a href={withBase(option.href)}>{option.label} <span aria-hidden="true">↗</span></a></article>
              ))}
            </div>
          </section>
        </div>
      </section>
    )}

    {view === 'join' && (
      <>
        <section class="join-intro">
          <div class="shell join-grid">
            <div class="join-copy">
              <p class="eyebrow dark"><span></span>Mitglied werden</p>
              <h2>Verlässlich helfen.<br /><em>Jahr für Jahr.</em></h2>
              <p class="lead">Mit deiner Fördermitgliedschaft stärkst du Projekte, Anschaffungen und Veranstaltungen des BSV langfristig.</p>
              <p>Du entscheidest selbst, ob du beim Mindestbeitrag bleibst oder den Förderverein mit einem höheren Jahresbeitrag unterstützen möchtest.</p>
            </div>
            <div class="contribution-grid">
              <article><small>BSV-Mitglieder</small><strong>11 <span>€</span></strong><p>Mindestjahresbeitrag</p></article>
              <article class="primary"><small>Nichtmitglieder</small><strong>25 <span>€</span></strong><p>Mindestjahresbeitrag</p></article>
              <p class="contribution-note">Die Beiträge werden jährlich eingezogen. Ein zusätzlicher freiwilliger Förderbetrag kann im Antrag angegeben werden.</p>
            </div>
          </div>
        </section>

        <section class="steps-section">
          <div class="shell">
            <header class="section-heading light-background"><div><p class="eyebrow dark"><span></span>So wirst du Mitglied</p><h2>Drei Schritte.<br /><em>Viel Wirkung.</em></h2></div><p>Den vollständigen Antrag kannst du direkt hier auf der Website ausfüllen und unterschreiben.</p></header>
            <ol class="steps-grid">
              <li><span>01</span><div><h3>Daten eintragen</h3><p>Fülle den Online-Antrag mit deinen persönlichen Daten und deinem Förderbeitrag aus.</p></div></li>
              <li><span>02</span><div><h3>Digital unterschreiben</h3><p>Bestätige das SEPA-Mandat und unterschreibe direkt mit Maus, Finger oder Stift.</p></div></li>
              <li><span>03</span><div><h3>Sicher absenden</h3><p>Der Antrag geht automatisch an den Förderverein. Du erhältst eine Eingangsbestätigung per E-Mail.</p></div></li>
            </ol>
          </div>
        </section>

        <FoerdervereinApplicationForm />
      </>
    )}
    <section class="contact-section">
      <div class="shell contact-card">
        <span class="contact-symbol" aria-hidden="true">?</span>
        <div>
          <p class="eyebrow dark"><span></span>Direkter Kontakt</p>
          <h2>Noch Fragen oder<br />eine gute Idee?</h2>
          <p>Du möchtest ein konkretes Projekt unterstützen oder mehr über den Förderverein erfahren? Schreib uns – deine Nachricht landet direkt bei der richtigen Stelle.</p>
        </div>
        <a href={withBase('/kontakt?thema=foerderverein')}>Kontakt aufnehmen <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-information-tabs]').forEach((section) => {
    const tablist = section.querySelector<HTMLElement>('[role="tablist"]');
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...section.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    if (!tablist || !tabs.length) return;

    const mobileLayout = window.matchMedia('(max-width: 620px)');
    const updateOrientation = () => tablist.setAttribute('aria-orientation', mobileLayout.matches ? 'vertical' : 'horizontal');
    updateOrientation();
    mobileLayout.addEventListener('change', updateOrientation);

    const selectTab = (index: number, focus = false, updateHash = false) => {
      tabs.forEach((tab, tabIndex) => {
        tab.setAttribute('aria-selected', String(tabIndex === index));
        tab.tabIndex = tabIndex === index ? 0 : -1;
      });
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
      if (updateHash) history.replaceState(history.state, '', `#${panels[index].id}`);
      if (focus) tabs[index].focus();
    };

    const selectFromHash = () => {
      const index = panels.findIndex((panel) => `#${panel.id}` === window.location.hash);
      if (index < 0) return;
      selectTab(index);
      panels[index].focus({ preventScroll: true });
      requestAnimationFrame(() => tablist.scrollIntoView({ block: 'start' }));
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(index, false, true));
      tab.addEventListener('keydown', (event) => {
        const nextKey = mobileLayout.matches ? 'ArrowDown' : 'ArrowRight';
        const previousKey = mobileLayout.matches ? 'ArrowUp' : 'ArrowLeft';
        let target: number;
        if (event.key === nextKey) target = (index + 1) % tabs.length;
        else if (event.key === previousKey) target = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') target = 0;
        else if (event.key === 'End') target = tabs.length - 1;
        else return;
        event.preventDefault();
        selectTab(target, true, true);
      });
    });
    selectTab(0);
    tablist.hidden = false;
    selectFromHash();
    window.addEventListener('hashchange', selectFromHash);
    if (document.readyState !== 'complete') {
      window.addEventListener('load', selectFromHash, { once: true });
    }
    document.querySelectorAll<HTMLAnchorElement>('.foerderverein-menu-cta').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const target = new URL(link.href);
        if (target.origin !== location.origin || target.pathname.replace(/\/$/, '') !== location.pathname.replace(/\/$/, '')) return;
        event.preventDefault();
        history.replaceState(history.state, '', target.hash);
        selectFromHash();
      });
    });
  });
</script>

<style>
  :global(body) { background: #f4f1e8; }
  .shell { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
  section[id] { scroll-margin-top:30px; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { letter-spacing: -.055em; }
  .eyebrow { display:flex; align-items:center; gap:10px; margin:0 0 18px; color:#f4d638; font-size:.68rem; font-weight:900; letter-spacing:.17em; text-transform:uppercase; }
  .eyebrow > span { width:26px; height:2px; background:currentColor; }
