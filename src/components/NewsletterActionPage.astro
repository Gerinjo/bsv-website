---
import { withBase } from '../utils/paths';
import { newsletterEndpoint } from '../utils/newsletter';
interface Props { action: 'confirm' | 'unsubscribe' }
const { action } = Astro.props;
const confirmation = action === 'confirm';
const title = confirmation ? 'E-Mail-Anmeldung bestätigen' : 'E-Mails abmelden';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href={withBase('/images/verein/wappen/bsv-nordstern.png')} />
    <title>{title} · BSV Nordstern Radolfzell</title>
  </head>
  <body>
    <main data-newsletter-operation={action} data-endpoint={newsletterEndpoint}>
      <a class="brand" href={withBase('/')} aria-label="BSV Nordstern – zur Startseite"><img src={withBase('/images/verein/wappen/bsv-nordstern.png')} width="76" height="72" alt="BSV Nordstern Radolfzell" /></a>
      <p class="eyebrow">✦ Post vom BSV</p>
      <h1>{confirmation ? 'Schön, dass du dabei bist.' : 'Bis bald beim BSV.'}</h1>
      <p role="status" aria-live="polite" tabindex="-1" data-action-status>{confirmation ? 'Deine Anmeldung wird geprüft …' : 'Wenn du diese E-Mails nicht mehr erhalten möchtest, bestätige hier deine Abmeldung. Sie gilt nur für den Verteiler aus deiner Nachricht; andere Anmeldungen bleiben bestehen.'}</p>
      <button type="button" data-action-button hidden={confirmation}>{confirmation ? 'Erneut versuchen' : 'Abmeldung bestätigen'}</button>
      <a class="back" href={withBase('/newsletter')}>Zu Newsletter & Informations-E-Mails →</a>
      <noscript><p>Bitte aktiviere JavaScript, um {confirmation ? 'deine Anmeldung zu bestätigen' : 'dich abzumelden'}. Bei Fragen erreichst du uns unter info@bsvnordstern.de.</p></noscript>
    </main>
    <footer><strong>BSV Nordstern e.V. Radolfzell</strong><br />Schlesierstraße 43 · 78315 Radolfzell<br /><a href="mailto:info@bsvnordstern.de">info@bsvnordstern.de</a><p><a href={withBase('/impressum')}>Impressum</a> · <a href={withBase('/datenschutz#newsletter')}>Datenschutz</a></p></footer>
    <script>
      const main = document.querySelector<HTMLElement>('[data-newsletter-operation]')!;
      const status = main.querySelector<HTMLElement>('[data-action-status]')!;
      const button = main.querySelector<HTMLButtonElement>('[data-action-button]')!;
      const token = new URLSearchParams(window.location.hash.slice(1)).get('token') || '';
      // The bearer token never reaches server logs or third-party tracking.
      // Keep it only in this page's memory so retry remains possible.
      history.replaceState(null, '', window.location.pathname);
      let finished = false;
      let busy = false;
      const perform = async () => {
        if (busy || finished) return;
        busy = true;
        button.disabled = true;
        status.textContent = main.dataset.newsletterOperation === 'confirm' ? 'Deine Anmeldung wird bestätigt …' : 'Deine Abmeldung wird gespeichert …';
        try {
          const response = await fetch(main.dataset.endpoint!, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, signal: AbortSignal.timeout(30000),
            body: JSON.stringify({ action: main.dataset.newsletterOperation, token }),
          });
          const data = await response.json();
          if (!response.ok || !data.ok) {
            finished = response.status >= 400 && response.status < 500;
            throw new Error(data.message || 'Bitte versuche es in wenigen Minuten erneut.');
          }
          finished = true;
          status.textContent = data.message;
          main.dataset.success = 'true';
        } catch (error) {
          status.textContent = error instanceof Error && error.name === 'Error' ? error.message : 'Die Verbindung wurde unterbrochen. Bitte versuche es erneut.';
          button.textContent = 'Erneut versuchen';
        } finally {
          busy = false;
          button.disabled = false;
          button.hidden = finished;
          status.focus();
        }
      };
      if (!/^[0-9a-f]{64}$/.test(token)) {
        status.textContent = 'Hier fehlt ein gültiger Link. Bitte öffne den vollständigen Link aus deiner E-Mail oder melde dich auf unserer Newsletter-Seite erneut an.';
        button.hidden = true;
      } else {
        button.addEventListener('click', perform);
        if (main.dataset.newsletterOperation === 'confirm') void perform();
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; padding: 60px 20px 30px; background: #f4f1e8; color: #10251a; font-family: system-ui, sans-serif; }
  main { max-width: 650px; margin: auto; padding: 40px; border-top: 6px solid #f4d638; background: #164f32; color: #fff; box-shadow: 10px 10px 0 #dce4d9; }
  .brand img { display: block; height: auto; }
  .eyebrow { margin: 30px 0 18px; color: #f4d638; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  h1 { font-size: clamp(2.4rem, 6vw, 3.6rem); line-height: 1.05; letter-spacing: -.05em; margin: 0 0 24px; }
  [role=status] { line-height: 1.75; color: #e3eee7; outline: none; }
  button { margin: 18px 0; padding: 15px 22px; border: 0; border-radius: 3px; background: #f4d638; color: #092f20; font: inherit; font-weight: 800; cursor: pointer; }
  button:disabled { opacity: .6; cursor: wait; }
  button[hidden] { display: none; }
  .back { display: block; margin-top: 26px; color: #fff; font-weight: 750; }
  footer { max-width: 650px; margin: 32px auto 0; padding: 0 10px; font-size: .8rem; line-height: 1.8; color: #506459; }
  footer a { color: #164f32; }
  a:focus-visible, button:focus-visible { outline: 3px solid #f4d638; outline-offset: 5px; }
  @media(max-width:480px) { :global(body) { padding: 24px 18px; } main { padding: 28px 24px; box-shadow: 6px 6px 0 #dce4d9; } }
</style>
