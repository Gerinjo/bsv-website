---
import { trainingFilterOptions } from '../data/trainingPlanFilters';
---

<div class="filter-panel" data-training-filter>
  <div class="filter-copy">
    <span>Mannschaftsfilter</span>
    <strong>Termine gezielt anzeigen</strong>
    <p data-filter-status aria-live="polite">Alle Termine werden angezeigt.</p>
  </div>
  <div class="filter-buttons" role="group" aria-label="Mannschaft auswählen">
    {trainingFilterOptions.map((option, index) => (
      <button
        type="button"
        data-filter-button={option.key}
        data-filter-label={option.fullLabel}
        aria-label={option.fullLabel}
        aria-pressed={index === 0 ? 'true' : 'false'}
        class:list={{ 'is-active': index === 0 }}
      >{option.label}</button>
    ))}
  </div>
</div>

<script>
  const filterRoot = document.querySelector<HTMLElement>('[data-training-filter]');
  const scheduleList = document.querySelector<HTMLElement>('[data-schedule-list]');

  if (filterRoot && scheduleList) {
    const buttons = [...filterRoot.querySelectorAll<HTMLButtonElement>('[data-filter-button]')];
    const filterableItems = [...document.querySelectorAll<HTMLElement>('[data-team-filter]')];
    const status = filterRoot.querySelector<HTMLElement>('[data-filter-status]');

    const applyFilter = (filterKey: string, label: string) => {
      buttons.forEach((button) => {
        const isActive = button.dataset.filterButton === filterKey;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });

      filterableItems.forEach((item) => {
        item.hidden = filterKey !== 'all' && item.dataset.teamFilter !== filterKey;
      });

      scheduleList.querySelectorAll<HTMLElement>('[data-conflict-list]').forEach((conflictList) => {
        const conflictItems = [...conflictList.querySelectorAll<HTMLElement>('[data-conflict-filter-keys]')];
        conflictItems.forEach((item) => {
          const keys = item.dataset.conflictFilterKeys?.split(' ') ?? [];
          item.hidden = filterKey !== 'all' && !keys.includes(filterKey);
        });
        conflictList.hidden = filterKey !== 'all' && !conflictItems.some((item) => !item.hidden);
      });

      scheduleList.querySelectorAll<HTMLElement>('[data-pitch-card]').forEach((pitchCard) => {
        const hasVisibleBooking = [...pitchCard.querySelectorAll<HTMLElement>('.booking[data-team-filter]')].some((booking) => !booking.hidden);
        const emptyMessage = pitchCard.querySelector<HTMLElement>('[data-filter-empty]');
        if (emptyMessage) emptyMessage.hidden = filterKey === 'all' || hasVisibleBooking;
      });

      scheduleList.querySelectorAll<HTMLElement>('[data-schedule-day]').forEach((dayCard) => {
        const hasVisibleBooking = [...dayCard.querySelectorAll<HTMLElement>('.booking[data-team-filter]')].some((booking) => !booking.hidden);
        dayCard.hidden = filterKey !== 'all' && !hasVisibleBooking;
      });

      document.querySelectorAll<HTMLElement>('[data-filter-detail-list]').forEach((detailList) => {
        const detailItems = [...detailList.querySelectorAll<HTMLElement>('a[data-team-filter]')];
        const emptyMessage = detailList.querySelector<HTMLElement>('[data-filter-detail-empty]');
        if (emptyMessage) emptyMessage.hidden = filterKey === 'all' || detailItems.some((item) => !item.hidden);
      });

      if (status) status.textContent = filterKey === 'all' ? 'Alle Termine werden angezeigt.' : `Auswahl: ${label}`;
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => applyFilter(button.dataset.filterButton ?? 'all', button.dataset.filterLabel ?? button.textContent ?? ''));
    });
  }
</script>

<style>
  .filter-panel{display:grid;grid-template-columns:245px 1fr;gap:28px;align-items:center;margin-bottom:32px;padding:21px 23px;border:1px solid #d9e2da;background:white;box-shadow:0 10px 28px rgb(9 47 32 / 6%)}
  .filter-copy>span{display:block;color:var(--green);font-size:.64rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}
  .filter-copy>strong{display:block;margin-top:3px;color:var(--dark);font-family:Georgia,serif;font-size:1.22rem}
  .filter-copy p{margin:5px 0 0;color:#6b776f;font-size:.75rem}
  .filter-buttons{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}
  .filter-buttons button{min-width:43px;min-height:42px;padding:0 13px;border:1px solid #cbd7cd;border-radius:3px;background:#f3f7f4;color:var(--dark);font:inherit;font-size:.78rem;font-weight:900;cursor:pointer;transition:background .16s ease,border-color .16s ease,color .16s ease,transform .16s ease}
  .filter-buttons button:hover,.filter-buttons button:focus-visible{border-color:var(--green);transform:translateY(-1px)}
  .filter-buttons button.is-active{border-color:var(--dark);background:var(--dark);color:var(--yellow);box-shadow:0 4px 0 var(--yellow)}
  :global(.booking[hidden]),:global(.day-card[hidden]),:global(.detail-list a[hidden]),:global(.filter-empty[hidden]),:global(.detail-empty[hidden]),:global(.conflict-list[hidden]),:global(.conflict-list p[hidden]){display:none}
  @media(max-width:900px){.filter-panel{grid-template-columns:1fr;gap:18px}.filter-buttons{justify-content:flex-start}}
  @media(max-width:600px){.filter-panel{padding:18px 16px}.filter-buttons{gap:7px}.filter-buttons button{min-width:40px;min-height:40px;padding:0 10px}}
</style>
