---
import {teamStaffMarkup} from '../utils/team-staff.mjs';
import {withBase} from '../utils/paths';
const {coaches,path,isOldMenTeam=false}=Astro.props;
const contactPath=withBase(`/kontakt?thema=team--${path.replaceAll('/', '--')}--general`);
---
<section class="d-girls-coaches" data-trainer-path={path} data-contact-path={contactPath} data-base-path={import.meta.env.BASE_URL} hidden={coaches.length===0}>
 <div class="d-girls-section-head"><div><span>{isOldMenTeam?'Kontakt':'Ansprechpersonen'}</span><h2>{isOldMenTeam ? 'Ansprechperson.' : 'Das Trainerteam.'}</h2></div><p>{isOldMenTeam?'Der direkte Draht für Fragen rund um die Alten Herren.':'Klare Zuständigkeiten und ein direkter Draht für Spieler:innen und Eltern.'}</p></div>
 <div class:list={['coach-grid',{'is-single':coaches.length===1}]} set:html={teamStaffMarkup(coaches,{contactPath,withBase})}></div>
</section>
<script>
 import {fetchTeamStaff,updateTeamStaff,updateTeamPhoto} from '../utils/team-staff.mjs';
 const refresh=async()=>{const roots=document.querySelectorAll<HTMLElement>('[data-trainer-path]');if(!roots.length)return;const feed=await fetchTeamStaff();if(feed){roots.forEach(root=>updateTeamStaff(root,feed));document.querySelectorAll<HTMLElement>('[data-team-photo-path]').forEach(root=>updateTeamPhoto(root,feed));}};
 refresh();document.addEventListener('astro:page-load',refresh);window.addEventListener('pageshow',event=>{if(event.persisted)refresh();});
</script>
<style>
 .d-girls-coaches{margin-bottom:115px}.d-girls-coaches[hidden]{display:none}.d-girls-section-head{margin-bottom:50px;display:flex;align-items:end;justify-content:space-between;gap:45px}.d-girls-section-head h2{font-size:clamp(3rem,5vw,4.5rem);margin:10px 0;color:var(--ink);letter-spacing:-.06em;line-height:1.02}.d-girls-section-head>p{max-width:350px;margin:0;color:#687970;line-height:1.65}.d-girls-section-head span{color:var(--green);font-size:.7rem;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.coach-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
 .coach-grid :global(.coach-card){min-height:310px;padding:38px;display:grid;grid-template-columns:185px 1fr;align-items:center;gap:34px;border-radius:8px;background:#edf2ee}.coach-grid.is-single :global(.coach-card){grid-column:span 2}.coach-grid :global(.coach-card:nth-child(even)){background:var(--green)}.coach-grid :global(.coach-portrait){width:185px;aspect-ratio:1;overflow:hidden;display:grid;place-items:center;border:5px solid white;border-radius:50%;background:var(--dark);box-shadow:0 12px 35px rgb(9 47 32 / 14%)}.coach-grid :global(.coach-portrait img){width:100%;height:100%;object-fit:cover;object-position:center 22%}.coach-grid :global(.coach-placeholder){color:var(--yellow);font-size:3rem;font-weight:900}.coach-grid :global(.coach-details small){color:var(--green);font-size:.67rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.coach-grid :global(.coach-details h3){margin:10px 0 7px;color:var(--ink);font-size:1.55rem;letter-spacing:-.035em}.coach-grid :global(.coach-details>p){margin:0;color:#6a7a70;font-size:.8rem}.coach-grid :global(.coach-card:nth-child(even) .coach-details small){color:var(--yellow)}.coach-grid :global(.coach-card:nth-child(even) .coach-details h3){color:white}.coach-grid :global(.coach-card:nth-child(even) .coach-details>p){color:#b8cabf}.coach-grid :global(.coach-details .coach-club){margin-top:15px;padding-top:12px;border-top:1px solid rgb(9 47 32 / 14%)}.coach-grid :global(.coach-club small),.coach-grid :global(.coach-club strong){display:block}.coach-grid :global(.contact-icons){display:flex;gap:10px;margin-top:20px}.coach-grid :global(.contact-icons a){width:36px;height:36px;display:grid;place-items:center;border-radius:50%;background:var(--green);color:white;text-decoration:none}.coach-grid :global(.coach-card:nth-child(even) .contact-icons a){background:var(--yellow);color:var(--dark)}
 @media(max-width:1100px){.coach-grid :global(.coach-card){grid-template-columns:130px 1fr;padding:25px;gap:22px}.coach-grid :global(.coach-portrait){width:130px}}@media(max-width:760px){.coach-grid{grid-template-columns:1fr}.coach-grid.is-single :global(.coach-card){grid-column:auto}.d-girls-section-head{align-items:start;flex-direction:column;gap:20px}}@media(max-width:500px){.d-girls-coaches{margin-bottom:80px}.coach-grid :global(.coach-card){grid-template-columns:1fr;text-align:center}.coach-grid :global(.coach-portrait){margin:auto}.coach-grid :global(.contact-icons){justify-content:center}}
</style>
