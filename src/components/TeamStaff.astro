---
import {teamStaffMarkup,teamStaffKey} from '../utils/team-staff.mjs';
import {withBase} from '../utils/paths';
const {coaches,path,isOldMenTeam=false}=Astro.props;
const contactPath=withBase(`/kontakt?thema=team--${path.replaceAll('/', '--')}--general`);
---
<section class="d-girls-coaches" data-trainer-path={path} data-staff-render-key={teamStaffKey(coaches)} data-contact-path={contactPath} data-base-path={import.meta.env.BASE_URL} hidden={coaches.length===0}>
 <div class="d-girls-section-head"><div><span>{isOldMenTeam?'Kontakt':'Ansprechpersonen'}</span><h2>{isOldMenTeam ? 'Ansprechperson.' : 'Das Trainerteam.'}</h2></div><p>{isOldMenTeam?'Der direkte Draht für Fragen rund um die Alten Herren.':'Klare Zuständigkeiten und ein direkter Draht für Spieler:innen und Eltern.'}</p></div>
 <div class:list={['coach-grid',{'is-single':coaches.length===1}]} set:html={teamStaffMarkup(coaches,{contactPath,withBase})}></div>
</section>
<script>
 import {fetchTeamStaff,updateTeamStaff} from '../utils/team-staff.mjs';
 const refresh=async()=>{const roots=document.querySelectorAll<HTMLElement>('[data-trainer-path]');if(!roots.length)return;const feed=await fetchTeamStaff();if(feed)roots.forEach(root=>updateTeamStaff(root,feed));};
 refresh();document.addEventListener('astro:page-load',refresh);window.addEventListener('pageshow',event=>{if(event.persisted)refresh();});
</script>
<style>
 .d-girls-coaches{margin-bottom:115px}.d-girls-coaches[hidden]{display:none}.d-girls-section-head{margin-bottom:50px;display:flex;align-items:end;justify-content:space-between;gap:45px}.d-girls-section-head h2{font-size:clamp(3rem,5vw,4.5rem);margin:10px 0;color:var(--ink);letter-spacing:-.06em;line-height:1.02}.d-girls-section-head>p{max-width:350px;margin:0;color:#687970;line-height:1.65}.d-girls-section-head span{color:var(--green);font-size:.7rem;font-weight:900;letter-spacing:.2em;text-transform:uppercase}@media(max-width:760px){.d-girls-section-head{align-items:start;flex-direction:column;gap:20px}}@media(max-width:500px){.d-girls-coaches{margin-bottom:80px}}
</style>
