---
import type { DocumentProfile } from '../data/documentPages';

interface Props {
  document: DocumentProfile;
}

const { document } = Astro.props;
const isFees = document.type === 'Beitragsordnung';
---

<article class:list={['document-page', { 'is-fees': isFees }]}>
  <header class="document-intro">
    <div class="document-statement">
      <span class="document-kicker">Ordnung schafft Orientierung</span>
      <h2>{isFees ? <>Klar geregelt.<br /><em>Fair für alle.</em></> : <>Unser Verein.<br /><em>Unsere Grundlage.</em></>}</h2>
      <p>{document.intro}</p>
    </div>
    <div class="document-meta" aria-label="Dokumentinformationen">
      <div><small>Dokument</small><strong>{document.type}</strong></div>
      <div><small>Fassung</small><strong>{document.edition}</strong></div>
      <div><small>Umfang</small><strong>{document.readingTime}</strong></div>
      <a href={document.pdf.href} target="_blank" rel="noreferrer"><span>PDF öffnen</span><b aria-hidden="true">↗</b></a>
    </div>
  </header>

  <section class="document-highlights" aria-label="Das Wichtigste auf einen Blick">
    {document.highlights.map((highlight, index) => (
      <article>
        <small>{String(index + 1).padStart(2, '0')}</small>
        <strong>{highlight.value}</strong>
        <h3>{highlight.label}</h3>
        <p>{highlight.detail}</p>
      </article>
    ))}
  </section>

  <div class="document-layout">
    <aside class="document-navigation">
      <span>In diesem Dokument</span>
      <nav aria-label={`${document.type} – Inhaltsübersicht`}>
        {document.sections.map((section) => (
          <a href={`#${section.id}`}><small>{section.number}</small><strong>{section.title}</strong></a>
        ))}
      </nav>
    </aside>

    <div class="document-sections">
      {document.sections.map((section) => (
        <section id={section.id} class:list={['document-section', { 'is-accent': section.accent }]}>
          <div class="section-number" aria-hidden="true">{section.number}</div>
          <div class="section-copy">
            <span>{section.kicker}</span>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => <li><i aria-hidden="true">✓</i><span>{bullet}</span></li>)}
              </ul>
            )}
          </div>
          {section.table && (
            <div class="document-table-block">
              <div class="table-title"><span>Übersicht</span><h3>{section.table.title}</h3></div>
              <div class="table-scroll">
                <table>
                  <thead><tr>{section.table.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
                  <tbody>
                    {section.table.rows.map((row) => (
                      <tr class:list={{ 'is-emphasis': row.emphasis }}>
                        {row.cells.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {section.table.note && <p class="table-note"><b aria-hidden="true">i</b><span>{section.table.note}</span></p>}
            </div>
          )}
        </section>
      ))}
    </div>
  </div>

  <footer class="document-download">
    <div class="pdf-symbol" aria-hidden="true"><span>PDF</span></div>
    <div><small>{document.edition}</small><h2>Die vollständige Fassung.</h2><p>Für verbindliche Auskünfte gilt das von der Mitgliederversammlung beschlossene Originaldokument.</p></div>
    <a href={document.pdf.href} target="_blank" rel="noreferrer"><span><small>{document.pdf.meta}</small><strong>{document.pdf.label}</strong></span><b aria-hidden="true">↓</b></a>
  </footer>

  <aside class="document-contact">
    <div><small>Persönliche Auskunft</small><h2>Noch etwas unklar?</h2><p>Die Vorstandschaft hilft bei Fragen zur Satzung, zur Beitragsordnung oder zur persönlichen Einstufung gerne weiter.</p></div>
    <a href="mailto:info@bsvnordstern.de">Vorstandschaft kontaktieren <span aria-hidden="true">↗</span></a>
  </aside>
</article>

<style>
  .document-page { --doc-line:#d7dfd9; padding-bottom:10px; }
  .document-intro { padding-bottom:95px; display:grid; grid-template-columns:1.35fr .65fr; gap:90px; align-items:start; }
  .document-kicker,.document-navigation>span,.section-copy>span,.table-title>span,.document-download small,.document-contact small { color:var(--green); font-size:.67rem; font-weight:900; letter-spacing:.15em; text-transform:uppercase; }
  .document-statement h2 { margin:16px 0 28px; color:var(--ink); font-size:clamp(3.5rem,6vw,5.8rem); line-height:.9; letter-spacing:-.065em; }
  .document-statement h2 em { color:var(--green); font-family:Georgia,serif; font-weight:400; }
  .document-statement>p { max-width:700px; margin:0; color:#5e6d63; font-size:1.15rem; line-height:1.78; }
  .document-meta { border-top:4px solid var(--yellow); background:#edf2ee; }
  .document-meta>div { padding:19px 22px; display:flex; align-items:center; justify-content:space-between; gap:20px; border-bottom:1px solid #d4ded7; }
  .document-meta small { color:#7a897f; font-size:.6rem; font-weight:850; letter-spacing:.12em; text-transform:uppercase; }
  .document-meta strong { color:var(--ink); font-size:.75rem; text-align:right; }
  .document-meta>a { padding:19px 22px; display:flex; align-items:center; justify-content:space-between; color:white; background:var(--green); font-size:.76rem; font-weight:900; text-decoration:none; }
  .document-meta>a b { color:var(--yellow); font-size:1rem; }
  .document-meta>a:hover { background:var(--dark); }
  .document-highlights { margin-bottom:115px; display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid var(--doc-line); border-bottom:1px solid var(--doc-line); }
  .document-highlights article { position:relative; min-height:235px; padding:32px 34px; border-right:1px solid var(--doc-line); }
  .document-highlights article:last-child { border-right:0; }
  .document-highlights article>small { position:absolute; right:25px; top:25px; color:#9aaaa0; font-size:.6rem; font-weight:900; }
  .document-highlights article>strong { display:block; margin:25px 0 28px; color:var(--green); font-size:clamp(2.8rem,4.5vw,4.3rem); line-height:1; letter-spacing:-.065em; }
  .document-page:not(.is-fees) .document-highlights article>strong { width:48px; aspect-ratio:1; margin-top:18px; display:grid; place-items:center; border-radius:50%; background:var(--yellow); color:var(--dark); font-size:1rem; letter-spacing:0; }
  .document-highlights h3 { margin:0 0 6px; font-size:1rem; }
  .document-highlights p { margin:0; color:#6b7a70; font-size:.74rem; line-height:1.55; }
  .document-layout { display:grid; grid-template-columns:250px minmax(0,1fr); gap:85px; align-items:start; }
  .document-navigation { position:sticky; top:25px; }
  .document-navigation>span { display:block; margin-bottom:18px; }
  .document-navigation nav { border-top:1px solid var(--doc-line); }
  .document-navigation a { padding:15px 2px; display:grid; grid-template-columns:28px 1fr; gap:10px; border-bottom:1px solid var(--doc-line); color:#5f6f65; text-decoration:none; }
  .document-navigation a small { color:#91a096; font-size:.58rem; font-weight:900; }
  .document-navigation a strong { font-size:.75rem; line-height:1.35; }
  .document-navigation a:hover { padding-left:9px; color:var(--green); background:#edf2ee; }
  .document-section { scroll-margin-top:30px; padding:0 0 78px; margin-bottom:78px; display:grid; grid-template-columns:70px minmax(0,1fr); column-gap:32px; border-bottom:1px solid var(--doc-line); }
  .document-section.is-accent { margin-left:-24px; padding:40px 34px 65px 24px; border:0; background:var(--yellow); }
  .section-number { width:56px; aspect-ratio:1; display:grid; place-items:center; border:1px solid #bac8be; border-radius:50%; color:var(--green); font-size:.7rem; font-weight:900; }
  .is-accent .section-number { border-color:rgb(9 47 32 / 35%); background:var(--dark); color:var(--yellow); }
  .section-copy h2 { margin:10px 0 25px; color:var(--ink); font-size:clamp(2.1rem,4vw,3.35rem); line-height:1; letter-spacing:-.055em; }
  .section-copy p { margin:0 0 17px; color:#5e6e64; font-size:1rem; line-height:1.78; }
  .section-copy p:last-child { margin-bottom:0; }
  .is-accent .section-copy>span { color:#315842; }
  .is-accent .section-copy p { color:#425646; }
  .section-copy ul { padding:0; margin:30px 0 0; list-style:none; }
  .section-copy li { padding:13px 0; display:grid; grid-template-columns:30px 1fr; gap:12px; align-items:start; border-top:1px solid var(--doc-line); color:#4f6055; font-size:.88rem; line-height:1.55; }
  .section-copy li:last-child { border-bottom:1px solid var(--doc-line); }
  .section-copy li i { width:22px; aspect-ratio:1; display:grid; place-items:center; border-radius:50%; color:var(--yellow); background:var(--green); font-size:.65rem; font-style:normal; }
  .document-table-block { grid-column:1 / -1; margin-top:50px; padding:34px; background:#edf2ee; }
  .is-accent .document-table-block { background:white; }
  .table-title { margin-bottom:24px; display:flex; align-items:end; justify-content:space-between; gap:25px; }
  .table-title h3 { margin:0; color:var(--ink); font-size:1.45rem; }
  .table-scroll { overflow-x:auto; }
  table { width:100%; border-collapse:collapse; background:white; }
  th,td { padding:16px 15px; border-bottom:1px solid #dbe2dc; text-align:left; }
  thead th { color:#79887e; background:#f7f9f7; font-size:.58rem; letter-spacing:.08em; text-transform:uppercase; }
  tbody th { color:var(--ink); font-size:.76rem; }
  tbody td { color:#64746a; font-size:.75rem; white-space:nowrap; }
  tbody td:last-child { color:var(--green); font-weight:900; }
  tbody tr.is-emphasis { background:#fffbe8; }
  tbody tr.is-emphasis th { color:var(--green); }
  .table-note { margin:20px 0 0; display:grid; grid-template-columns:26px 1fr; gap:12px; align-items:start; color:#5f7065; font-size:.72rem; line-height:1.6; }
  .table-note b { width:23px; aspect-ratio:1; display:grid; place-items:center; border-radius:50%; color:var(--yellow); background:var(--green); font-family:Georgia,serif; font-style:italic; }
  .document-download { margin:25px 0 95px; padding:40px 42px; display:grid; grid-template-columns:90px 1fr auto; gap:32px; align-items:center; color:white; background:var(--green); }
  .pdf-symbol { width:76px; aspect-ratio:.78; display:grid; place-items:center; border:2px solid rgb(255 255 255 / 35%); color:var(--yellow); }
  .pdf-symbol span { font-size:.76rem; font-weight:900; letter-spacing:.15em; }
  .document-download small { color:var(--yellow); }
  .document-download h2 { margin:8px 0 6px; font-size:2rem; letter-spacing:-.04em; }
  .document-download p { margin:0; color:#bad0c1; font-size:.78rem; line-height:1.55; }
  .document-download>a { min-width:270px; padding:17px 18px; display:flex; align-items:center; justify-content:space-between; gap:25px; color:var(--ink); background:var(--yellow); text-decoration:none; }
  .document-download>a span { display:flex; flex-direction:column; gap:4px; }
  .document-download>a small { color:#5e6b56; font-size:.52rem; }
  .document-download>a strong { font-size:.76rem; }
  .document-download>a b { font-size:1.25rem; }
  .document-download>a:hover { background:white; }
  .document-contact { padding:48px 52px; display:flex; align-items:center; justify-content:space-between; gap:60px; background:var(--yellow); }
  .document-contact h2 { margin:8px 0 10px; color:var(--ink); font-size:2.4rem; letter-spacing:-.05em; }
  .document-contact p { max-width:650px; margin:0; color:#536256; line-height:1.65; }
  .document-contact>a { min-width:250px; padding:16px 18px; display:flex; justify-content:space-between; gap:22px; color:white; background:var(--dark); font-size:.76rem; font-weight:900; text-decoration:none; }
  .document-contact>a span { color:var(--yellow); }
  @media(max-width:900px) {
    .document-intro { grid-template-columns:1fr; gap:45px; }
    .document-highlights article { padding:26px 24px; }
    .document-layout { grid-template-columns:1fr; gap:55px; }
    .document-navigation { position:static; }
    .document-navigation nav { display:grid; grid-template-columns:repeat(2,1fr); }
    .document-navigation a:nth-child(odd) { border-right:1px solid var(--doc-line); }
    .document-download { grid-template-columns:75px 1fr; }
    .document-download>a { grid-column:1 / -1; }
    .document-contact { align-items:flex-start; flex-direction:column; }
  }
  @media(max-width:600px) {
    .document-intro { padding-bottom:70px; }
    .document-statement h2 { font-size:3.35rem; }
    .document-highlights { margin-bottom:80px; grid-template-columns:1fr; }
    .document-highlights article { min-height:0; border-right:0; border-bottom:1px solid var(--doc-line); }
    .document-highlights article:last-child { border-bottom:0; }
    .document-highlights article>strong { margin:15px 0 20px; }
    .document-page:not(.is-fees) .document-highlights article>strong { margin-top:5px; }
    .document-navigation nav { grid-template-columns:1fr; }
    .document-navigation a:nth-child(odd) { border-right:0; }
    .document-section { padding-bottom:55px; margin-bottom:55px; grid-template-columns:42px minmax(0,1fr); column-gap:15px; }
    .document-section.is-accent { margin-inline:-15px; padding:30px 15px 50px; }
    .section-number { width:38px; font-size:.58rem; }
    .section-copy h2 { font-size:2.15rem; }
    .document-table-block { margin-top:35px; padding:20px 15px; }
    .table-title { align-items:flex-start; flex-direction:column; gap:8px; }
    th,td { padding:13px 11px; }
    .document-download { margin-bottom:70px; padding:32px 24px; grid-template-columns:1fr; }
    .pdf-symbol { width:60px; }
    .document-download>a { grid-column:auto; min-width:0; }
    .document-contact { padding:38px 28px; gap:30px; }
    .document-contact>a { width:100%; min-width:0; }
  }
</style>
