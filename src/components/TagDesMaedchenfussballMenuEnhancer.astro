---
import { withBase } from '../utils/paths';
const tdmHref = withBase('/erlebnis/tag-des-maedchenfussballs');
const tdmImage = withBase('/images/events/tdm/2025/01-gruppenfoto.jpg');
const urmelHref = withBase('/erlebnis/urmel-bambini-spieltag');
const urmelLogo = withBase('/images/events/urmel/urmel-kinder-krebshilfe.webp');
const instagramUrl = 'https://www.instagram.com/sg.nordsternhoeri.damen/';
---
<script define:vars={{tdmHref,tdmImage,urmelHref,urmelLogo,instagramUrl}}>
const setPreview=(mega,link,c)=>{const p=mega.querySelector('[data-experience-preview]');if(!(p instanceof HTMLAnchorElement))return;mega.querySelectorAll('.experience-link').forEach(i=>i.classList.toggle('is-active',i===link));p.href=c.href;p.style.setProperty('--preview-accent',c.accent);p.style.setProperty('--preview-bg',c.background);const m=p.querySelector('[data-preview-media]'),t=p.querySelector('[data-preview-title]'),cat=p.querySelector('[data-preview-category]'),d=p.querySelector('[data-preview-date]'),n=p.querySelector('[data-preview-next]');if(t)t.textContent=c.title;if(cat)cat.textContent=c.category;if(d){d.textContent=c.date;d.toggleAttribute('hidden',!c.date)}if(n){const s=n.querySelector('strong');if(s)s.textContent=c.next;n.toggleAttribute('hidden',!c.next)}if(!(m instanceof HTMLElement))return;m.dataset.kind=c.kind;m.replaceChildren();const img=document.createElement('img');img.src=c.src;img.alt=c.alt;img.decoding='async';img.className=c.kind==='urmel-logo'?'urmel-preview-logo':'tdm-preview-image';m.append(img)};
const install=()=>{const mega=document.querySelector('.mega-inner.erlebnis-mega');if(!(mega instanceof HTMLElement))return false;const group=[...mega.querySelectorAll('.experience-list-group')].find(g=>g.querySelector('h3')?.textContent?.trim()==='Turniere & Aktionstage');const wrap=group?.querySelector('.experience-links');if(!(wrap instanceof HTMLElement))return false;let tdm=wrap.querySelector('[data-experience-id="tag-des-maedchenfussballs"]');if(!(tdm instanceof HTMLAnchorElement)){tdm=document.createElement('a');tdm.href=tdmHref;tdm.className='experience-link';tdm.dataset.experienceId='tag-des-maedchenfussballs';tdm.innerHTML='<span class="experience-link-copy"><strong>Tag des Mädchenfußballs</strong><small>Mädchenfußball · Frühjahr 2027</small></span><b>↗</b>';wrap.append(tdm)}let urmel=wrap.querySelector('[data-experience-id="urmel-bambini-spieltag"]');if(!(urmel instanceof HTMLAnchorElement)){urmel=document.createElement('a');urmel.href=urmelHref;urmel.className='experience-link';urmel.dataset.experienceId='urmel-bambini-spieltag';urmel.innerHTML='<span class="experience-link-copy"><strong>URMEL Bambini Spieltag</strong><small>Bambini · Mai 2027</small></span><b>↗</b>';wrap.append(urmel)}const gst=wrap.querySelector('[data-experience-id="buergerstiftung-grundschulturnier"]');[tdm,urmel,gst].forEach(i=>{if(i instanceof HTMLElement)wrap.append(i)});if(tdm.dataset.previewBound!=='true'){tdm.dataset.previewBound='true';const a=()=>setPreview(mega,tdm,{href:tdmHref,accent:'#a8cbb4',background:'#164f32',title:'Tag des Mädchenfußballs',category:'Mädchenfußball · Aktionstag',date:'Rückblick · 11. Mai 2025',next:'Frühjahr 2027',kind:'photo',src:tdmImage,alt:'Tag des Mädchenfußballs 2025'});tdm.addEventListener('mouseenter',a);tdm.addEventListener('focus',a)}if(urmel.dataset.previewBound!=='true'){urmel.dataset.previewBound='true';const a=()=>setPreview(mega,urmel,{href:urmelHref,accent:'#9fc900',background:'#fff',title:'URMEL Bambini Spieltag',category:'Bambini · Benefizspieltag',date:'Rückblick · 1. Mai 2026',next:'Mai 2027',kind:'urmel-logo',src:urmelLogo,alt:'URMEL Kinder-Krebshilfe e.V.'});urmel.addEventListener('mouseenter',a);urmel.addEventListener('focus',a)}return true};
const enhanceInstagram=()=>{const path=location.pathname.replace(/\/+$/,'');if(!path.endsWith('/fussball/frauen/bezirksliga')&&!path.endsWith('/fussball/frauen/kreisliga'))return;const main=document.querySelector('main');if(!(main instanceof HTMLElement)||main.querySelector('[data-sg-frauen-instagram]'))return;const note=document.createElement('section');note.className='sg-frauen-instagram';note.dataset.sgFrauenInstagram='true';note.innerHTML=`<div class="sg-frauen-instagram-inner"><span class="sg-frauen-instagram-mark" aria-hidden="true"><svg viewBox="0 0 24 24" role="img"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.25"></circle><circle class="instagram-dot" cx="17.4" cy="6.7" r="1.15"></circle></svg></span><div class="sg-frauen-instagram-copy"><small>SG Frauen 1 & 2</small><strong>Mehr aus dem Team auf Instagram.</strong><p>Spieltage, Einblicke und Neuigkeiten der SG Nordstern Höri Damen gibt es auch auf dem gemeinsamen Instagram-Kanal.</p></div><a href="${instagramUrl}" target="_blank" rel="noopener noreferrer">Instagram öffnen <b>↗</b></a></div>`;const first=main.querySelector(':scope > section');first?first.insertAdjacentElement('afterend',note):main.prepend(note)};
const start=()=>{enhanceInstagram();if(install())return;const o=new MutationObserver(()=>{if(install())o.disconnect()});o.observe(document.body,{childList:true,subtree:true});setTimeout(()=>o.disconnect(),8000)};document.readyState==='loading'?addEventListener('DOMContentLoaded',start,{once:true}):start();
</script>
<style>
:global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='photo']){padding:0!important;background:#164f32!important;overflow:hidden!important}:global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='photo'] img){width:100%;height:100%;object-fit:cover}:global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='photo'] img.tdm-preview-image){object-position:center bottom!important;transform:scale(1.32);transform-origin:center 160%}:global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='urmel-logo']){padding:16px 28px!important;background:#fff!important}:global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='urmel-logo'] img){display:block;width:100%;height:100%;max-width:330px;max-height:145px;object-fit:contain}
:global(.sg-frauen-instagram){width:min(1120px,calc(100% - 48px));margin:26px auto 10px}:global(.sg-frauen-instagram-inner){padding:18px 20px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:18px;background:#fff;border-left:5px solid #a8cbb4;box-shadow:0 12px 32px rgb(9 47 32 / 9%)}:global(.sg-frauen-instagram-mark){width:46px;height:46px;display:grid;place-items:center;border-radius:50%;background:#092f20;color:#a8cbb4}:global(.sg-frauen-instagram-mark svg){width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}:global(.sg-frauen-instagram-mark .instagram-dot){fill:currentColor;stroke:none}:global(.sg-frauen-instagram-copy small){display:block;color:#164f32;font-size:.58rem;font-weight:950;text-transform:uppercase}:global(.sg-frauen-instagram-copy strong){display:block;margin-top:3px;color:#17251b;font-size:.98rem}:global(.sg-frauen-instagram-copy p){margin:4px 0 0;color:#65746b;font-size:.72rem;line-height:1.5}:global(.sg-frauen-instagram a){min-height:44px;padding:0 15px;display:flex;align-items:center;gap:24px;background:#092f20;color:#fff!important;text-decoration:none!important;font-size:.68rem;font-weight:900}@media(max-width:900px){:global(.sg-frauen-instagram-inner){grid-template-columns:auto 1fr}:global(.sg-frauen-instagram a){grid-column:1/-1}}@media(max-width:620px){:global(.sg-frauen-instagram){width:min(100% - 32px,1120px)}:global(.sg-frauen-instagram-inner){grid-template-columns:1fr}}
:global(.urmel-page .lightbox){grid-template-columns:96px minmax(0,1180px) 96px!important;justify-content:center!important;padding:16px!important}
:global(.urmel-page .lightbox-stage){width:100%!important;height:min(88vh,900px)!important;min-width:0!important;min-height:0!important;margin:0!important;padding:45px 0 38px!important;overflow:hidden!important;display:grid!important;grid-template-rows:minmax(0,1fr) auto!important;place-items:center!important;box-sizing:border-box!important}
:global(.urmel-page .lightbox-stage img){display:block!important;width:100%!important;height:100%!important;min-width:0!important;min-height:0!important;max-width:100%!important;max-height:100%!important;margin:0!important;object-fit:contain!important}
:global(.urmel-page .lightbox-stage figcaption){width:100%!important;max-width:100%!important;margin:10px 0 0!important}
@media(max-width:760px){:global(.urmel-page .lightbox){grid-template-columns:1fr!important;padding:16px!important}:global(.urmel-page .lightbox-stage){height:min(88vh,900px)!important;padding:55px 14px 40px!important}}
</style>
