---
import { withBase } from '../utils/paths';

const tdmHref = withBase('/erlebnis/tag-des-maedchenfussballs');
const tdmImage = withBase('/images/events/tdm/2025/01-gruppenfoto.jpg');
const tdmFallbackImage = 'https://bodensee.sbfv.de/fileadmin/_processed_/8/3/csm_Tag_des_Maedchenfussballs__1__-_Bild_Verein_a21765ab93.jpg';
const urmelHref = withBase('/erlebnis/urmel-bambini-spieltag');
const instagramUrl = 'https://www.instagram.com/sg.nordsternhoeri.damen/';
---

<script define:vars={{ tdmHref, tdmImage, tdmFallbackImage, urmelHref, instagramUrl }}>
  const setPreview = (mega, link, config) => {
    const preview = mega.querySelector('[data-experience-preview]');
    if (!(preview instanceof HTMLAnchorElement)) return;

    mega.querySelectorAll('.experience-link').forEach((item) => item.classList.toggle('is-active', item === link));
    preview.href = config.href;
    preview.style.setProperty('--preview-accent', config.accent);
    preview.style.setProperty('--preview-bg', config.background);

    const media = preview.querySelector('[data-preview-media]');
    const title = preview.querySelector('[data-preview-title]');
    const category = preview.querySelector('[data-preview-category]');
    const date = preview.querySelector('[data-preview-date]');
    const next = preview.querySelector('[data-preview-next]');

    if (title) title.textContent = config.title;
    if (category) category.textContent = config.category;
    if (date) {
      date.textContent = config.date;
      date.toggleAttribute('hidden', !config.date);
    }
    if (next) {
      const nextValue = next.querySelector('strong');
      if (nextValue) nextValue.textContent = config.next;
      next.dataset.tone = 'normal';
      next.toggleAttribute('hidden', !config.next);
    }

    if (!(media instanceof HTMLElement)) return;
    media.dataset.kind = config.kind;
    media.replaceChildren();

    if (config.kind === 'photo') {
      const image = document.createElement('img');
      image.src = config.src;
      image.alt = config.alt;
      image.className = 'tdm-preview-image';
      image.decoding = 'async';
      image.addEventListener('error', () => {
        if (!config.fallback || image.dataset.fallbackUsed === 'true') return;
        image.dataset.fallbackUsed = 'true';
        image.src = config.fallback;
      });
      media.append(image);
      return;
    }

    if (config.kind === 'urmel') {
      const label = document.createElement('span');
      label.className = 'urmel-preview-label';
      label.innerHTML = '<b>URMEL BAMBINI</b><span>Kids spielen für Kids</span><small>Benefizspieltag beim BSV</small>';
      media.append(label);
    }
  };

  const installTournamentMenuItems = () => {
    const mega = document.querySelector('.mega-inner.erlebnis-mega');
    if (!(mega instanceof HTMLElement)) return false;

    const groups = [...mega.querySelectorAll('.experience-list-group')];
    const targetGroup = groups.find((group) => group.querySelector('h3')?.textContent?.trim() === 'Turniere & Aktionstage');
    const linksWrap = targetGroup?.querySelector('.experience-links');
    if (!(linksWrap instanceof HTMLElement)) return false;

    let tdmLink = linksWrap.querySelector('[data-experience-id="tag-des-maedchenfussballs"]');
    if (!(tdmLink instanceof HTMLAnchorElement)) {
      tdmLink = document.createElement('a');
      tdmLink.href = tdmHref;
      tdmLink.className = 'experience-link';
      tdmLink.dataset.experienceId = 'tag-des-maedchenfussballs';
      tdmLink.innerHTML = `
        <span class="experience-link-copy">
          <strong>Tag des Mädchenfußballs</strong>
          <small>Mädchenfußball · Frühjahr 2027</small>
        </span>
        <b aria-hidden="true">↗</b>`;
      linksWrap.append(tdmLink);
    } else {
      const subtitle = tdmLink.querySelector('small');
      if (subtitle) subtitle.textContent = 'Mädchenfußball · Frühjahr 2027';
    }

    let urmelLink = linksWrap.querySelector('[data-experience-id="urmel-bambini-spieltag"]');
    if (!(urmelLink instanceof HTMLAnchorElement)) {
      urmelLink = document.createElement('a');
      urmelLink.href = urmelHref;
      urmelLink.className = 'experience-link';
      urmelLink.dataset.experienceId = 'urmel-bambini-spieltag';
      urmelLink.innerHTML = `
        <span class="experience-link-copy">
          <strong>URMEL Bambini Spieltag</strong>
          <small>Bambini · Mai 2027</small>
        </span>
        <b aria-hidden="true">↗</b>`;
      linksWrap.append(urmelLink);
    }

    const grundschulLink = linksWrap.querySelector('[data-experience-id="buergerstiftung-grundschulturnier"]');
    if (grundschulLink instanceof HTMLAnchorElement) {
      const subtitle = grundschulLink.querySelector('small');
      if (subtitle) subtitle.textContent = 'Schule & Gemeinschaft · Juli 2027';
    }

    [tdmLink, urmelLink, grundschulLink].forEach((item) => {
      if (item instanceof HTMLElement) linksWrap.append(item);
    });

    if (tdmLink.dataset.previewBound !== 'true') {
      tdmLink.dataset.previewBound = 'true';
      const activateTdm = () => setPreview(mega, tdmLink, {
        href: tdmHref,
        accent: '#f4d638',
        background: '#164f32',
        title: 'Tag des Mädchenfußballs',
        category: 'Mädchenfußball · Aktionstag',
        date: 'Rückblick · 11. Mai 2025',
        next: 'Frühjahr 2027',
        kind: 'photo',
        src: tdmImage,
        fallback: tdmFallbackImage,
        alt: 'Gruppenfoto vom Tag des Mädchenfußballs 2025 beim BSV Nordstern',
      });
      tdmLink.addEventListener('mouseenter', activateTdm);
      tdmLink.addEventListener('focus', activateTdm);
    }

    if (urmelLink.dataset.previewBound !== 'true') {
      urmelLink.dataset.previewBound = 'true';
      const activateUrmel = () => setPreview(mega, urmelLink, {
        href: urmelHref,
        accent: '#f4d638',
        background: '#092f20',
        title: 'URMEL Bambini Spieltag',
        category: 'Bambini · Benefizspieltag',
        date: 'Rückblick · 1. Mai 2026',
        next: 'Mai 2027',
        kind: 'urmel',
        src: '',
        fallback: '',
        alt: '',
      });
      urmelLink.addEventListener('mouseenter', activateUrmel);
      urmelLink.addEventListener('focus', activateUrmel);
    }

    return true;
  };

  const enhanceTdmPage = () => {
    const currentPath = window.location.pathname.replace(/\/+$/, '');
    if (!currentPath.endsWith('/erlebnis/tag-des-maedchenfussballs')) return;

    const page = document.querySelector('.tdm-page');
    if (!(page instanceof HTMLElement) || page.dataset.tdmPageEnhanced === 'true') return;
    page.dataset.tdmPageEnhanced = 'true';

    const meta = page.querySelector('.hero-meta');
    if (meta instanceof HTMLElement) {
      meta.innerHTML = `
        <span class="tdm-next-date">
          <small>Nächster Termin</small>
          <strong>Frühjahr 2027</strong>
        </span>
        <span class="tdm-review-date">
          <small>Rückblick</small>
          <strong>11. Mai 2025</strong>
          <em>BSV Nordstern Radolfzell</em>
        </span>`;
    }
  };

  const enhanceSgFrauenInstagram = () => {
    const currentPath = window.location.pathname.replace(/\/+$/, '');
    const isSgFrauenPage = currentPath.endsWith('/fussball/frauen/bezirksliga') || currentPath.endsWith('/fussball/frauen/kreisliga');
    if (!isSgFrauenPage) return;

    const main = document.querySelector('main');
    if (!(main instanceof HTMLElement) || main.querySelector('[data-sg-frauen-instagram]')) return;

    const note = document.createElement('section');
    note.className = 'sg-frauen-instagram';
    note.dataset.sgFrauenInstagram = 'true';
    note.innerHTML = `
      <div class="sg-frauen-instagram-inner">
        <span class="sg-frauen-instagram-mark" aria-hidden="true">◎</span>
        <div class="sg-frauen-instagram-copy">
          <small>SG Frauen 1 & 2</small>
          <strong>Mehr aus dem Team auf Instagram.</strong>
          <p>Spieltage, Einblicke und Neuigkeiten der SG Nordstern Höri Damen gibt es auch auf dem gemeinsamen Instagram-Kanal.</p>
        </div>
        <a href="${instagramUrl}" target="_blank" rel="noopener noreferrer" aria-label="Instagram der SG Nordstern Höri Damen öffnen">
          Instagram öffnen <b aria-hidden="true">↗</b>
        </a>
      </div>`;

    const firstSection = main.querySelector(':scope > section');
    if (firstSection) firstSection.insertAdjacentElement('afterend', note);
    else main.prepend(note);
  };

  const startEnhancer = () => {
    enhanceTdmPage();
    enhanceSgFrauenInstagram();

    if (installTournamentMenuItems()) return;
    const observer = new MutationObserver(() => {
      if (installTournamentMenuItems()) observer.disconnect();
    });
    observer.observe(document.body, { childList: true, subtree: true });
    window.setTimeout(() => observer.disconnect(), 8000);
  };

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', startEnhancer, { once: true });
  } else {
    startEnhancer();
  }
</script>

<style>
  :global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='photo']){padding:0!important;background:#164f32!important;overflow:hidden!important}
  :global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='photo'] img){width:100%;height:100%;max-width:none!important;max-height:none!important;display:block;object-fit:cover}
  :global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='photo'] img.tdm-preview-image){object-position:center bottom!important;transform:scale(1.32);transform-origin:center 160%}
  :global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='urmel']){padding:24px!important;background:linear-gradient(145deg,#092f20,#164f32)!important;color:#fff}
  :global(.mega-inner.erlebnis-mega .urmel-preview-label){width:100%;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:3px}
  :global(.mega-inner.erlebnis-mega .urmel-preview-label b){color:#f4d638;font-size:2rem;line-height:.9;letter-spacing:-.04em}
  :global(.mega-inner.erlebnis-mega .urmel-preview-label span){color:#fff;font-family:Georgia,serif;font-size:1.45rem;font-style:italic;line-height:1}
  :global(.mega-inner.erlebnis-mega .urmel-preview-label small){margin-top:9px;color:#bcd0c4;font-size:.58rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}

  :global(.tdm-page .hero-grid){grid-template-columns:minmax(0,1.16fr) minmax(330px,.84fr)!important;gap:46px!important}
  :global(.tdm-page .hero h1){font-size:clamp(3.25rem,5.35vw,5.45rem)!important;line-height:.9!important;overflow:visible}
  :global(.tdm-page .hero h1 em){display:block;font-size:.68em;line-height:1.03;white-space:nowrap}
  :global(.tdm-page .hero-image){width:min(92%,520px);justify-self:center;overflow:hidden!important;border:7px solid #fff;box-shadow:0 28px 58px rgb(0 0 0 / 32%)!important;transform:rotate(-2deg);transform-origin:center center}
  :global(.tdm-page .hero-image img){aspect-ratio:16/11!important;object-fit:cover!important;object-position:center 67%!important}
  :global(.tdm-page .hero-meta){display:grid!important;grid-template-columns:auto auto;justify-content:start;align-items:stretch!important;gap:10px!important}
  :global(.tdm-page .tdm-next-date),:global(.tdm-page .tdm-review-date){min-width:170px;padding:10px 13px;display:grid;gap:2px}
  :global(.tdm-page .tdm-next-date){background:#f4d638;color:#092f20}
  :global(.tdm-page .tdm-review-date){border:1px solid rgb(255 255 255 / 22%);background:rgb(255 255 255 / 6%);color:#fff}
  :global(.tdm-page .hero-meta small){display:block;color:inherit!important;font-size:.55rem;font-weight:950;letter-spacing:.09em;text-transform:uppercase}
  :global(.tdm-page .hero-meta strong){display:block;color:inherit;font-size:.9rem!important}
  :global(.tdm-page .tdm-review-date em){color:#a9c0b2;font-size:.6rem;font-style:normal}

  :global(.sg-frauen-instagram){width:min(1120px,calc(100% - 48px));margin:26px auto 10px;padding:0}
  :global(.sg-frauen-instagram-inner){padding:18px 20px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:18px;background:#fff;border-left:5px solid #f4d638;box-shadow:0 12px 32px rgb(9 47 32 / 9%)}
  :global(.sg-frauen-instagram-mark){width:46px;height:46px;display:grid;place-items:center;border-radius:50%;background:#092f20;color:#f4d638;font-size:1.65rem;font-weight:900}
  :global(.sg-frauen-instagram-copy small){display:block;color:#164f32;font-size:.58rem;font-weight:950;letter-spacing:.1em;text-transform:uppercase}
  :global(.sg-frauen-instagram-copy strong){display:block;margin-top:3px;color:#17251b;font-size:.98rem}
  :global(.sg-frauen-instagram-copy p){margin:4px 0 0;color:#65746b;font-size:.72rem;line-height:1.5}
  :global(.sg-frauen-instagram a),:global(.sg-frauen-instagram a:visited){min-height:44px;padding:0 15px;display:flex;align-items:center;gap:24px;background:#092f20;color:#fff!important;text-decoration:none!important;font-size:.68rem;font-weight:900;white-space:nowrap}
  :global(.sg-frauen-instagram a b){color:#f4d638}
  :global(.sg-frauen-instagram a:hover){background:#164f32}

  @media(max-width:900px){
    :global(.tdm-page .hero-grid){grid-template-columns:1fr!important;gap:38px!important}
    :global(.tdm-page .hero-image){width:min(88%,640px);transform:rotate(-1.35deg)}
    :global(.sg-frauen-instagram-inner){grid-template-columns:auto 1fr}
    :global(.sg-frauen-instagram a){grid-column:1/-1;justify-content:space-between}
  }
  @media(max-width:620px){
    :global(.tdm-page .hero h1){font-size:clamp(3rem,14vw,4.2rem)!important}
    :global(.tdm-page .hero h1 em){font-size:.58em}
    :global(.tdm-page .hero-image){width:92%;border-width:5px;transform:rotate(-1deg)}
    :global(.tdm-page .hero-meta){grid-template-columns:1fr!important;width:100%}
    :global(.tdm-page .tdm-next-date),:global(.tdm-page .tdm-review-date){min-width:0}
    :global(.sg-frauen-instagram){width:min(100% - 32px,1120px);margin-top:20px}
    :global(.sg-frauen-instagram-inner){grid-template-columns:1fr;padding:18px}
    :global(.sg-frauen-instagram-mark){width:40px;height:40px}
    :global(.sg-frauen-instagram a){grid-column:auto}
  }
</style>
