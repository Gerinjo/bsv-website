---
import { erlebnisCooperations } from '../data/erlebnis';
import { withBase } from '../utils/paths';

const byId = (id: string) => erlebnisCooperations.find((item) => item.id === id)!;
const menuGroups = [
  {
    title: 'Fußballcamps',
    eyebrow: 'Ferien, Training & Erlebnis',
    items: [
      byId('skechers-fussballschule'),
      byId('porsche-maedchencamp'),
      {
        id: 'save-play-torwartcamp',
        menuTitle: 'Save & Play Torwartcamp',
        category: 'Torwarttraining & Feriencamp',
        actionHref: '/erlebnis/torwartcamp',
        accent: '#164f32',
        logoBackground: '#eef3ef',
        logoSrc: '',
        logoLabel: 'SAVE & PLAY\nTORWARTCAMP',
        date: undefined,
      },
    ],
  },
  {
    title: 'Turniere & Aktionstage',
    eyebrow: 'Gemeinsam auf dem Platz',
    items: [byId('buergerstiftung-grundschulturnier')],
  },
  {
    title: 'Benefits',
    eyebrow: 'Vorteile für BSV-Mitglieder',
    items: [byId('mcshape-radolfzell')],
  },
];
---

<template id="erlebnis-mega-template">
  <div class="experience-intro">
    <span>Erlebnis beim BSV</span>
    <h2>Mehr erleben.<br /><em>Gemeinsam wachsen.</em></h2>
    <p>Fußballcamps, besondere Turniere und attraktive Benefits ergänzen den Vereinsalltag und schaffen zusätzliche Erlebnisse für unsere Mitglieder und Gäste.</p>
    <a href={withBase('/erlebnis')}>Alle Erlebnisse entdecken <b aria-hidden="true">↗</b></a>
  </div>

  <div class="experience-groups">
    {menuGroups.map((group) => (
      <section class="experience-group" aria-label={group.title}>
        <div class="experience-group-heading">
          <div><span>{group.eyebrow}</span><h3>{group.title}</h3></div>
          <b>{String(group.items.length).padStart(2, '0')}</b>
        </div>
        <div class="experience-group-grid">
          {group.items.map((cooperation, index) => (
            <a
              class="experience-card"
              href={withBase(cooperation.actionHref)}
              style={`--experience-accent:${cooperation.accent};--logo-bg:${cooperation.logoBackground}`}
            >
              <span class="experience-number">0{index + 1}</span>
              <span class="experience-logo-wrap">
                {cooperation.logoSrc ? (
                  <img
                    class="experience-logo"
                    src={cooperation.logoSrc.startsWith('/') ? withBase(cooperation.logoSrc) : cooperation.logoSrc}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : null}
                {cooperation.logoLabel && (
                  <span class="experience-logo-label">{cooperation.logoLabel.split('\n').map((line) => <span>{line}</span>)}</span>
                )}
              </span>
              <small>{cooperation.category}</small>
              <strong>{cooperation.menuTitle}</strong>
              {cooperation.date && <p>{cooperation.date}</p>}
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</template>

<script>
  const enhanceErlebnisMenu = () => {
    const template = document.querySelector<HTMLTemplateElement>('#erlebnis-mega-template');
    if (!template) return;

    const menuItem = [...document.querySelectorAll<HTMLElement>('.menu-item')].find((item) => {
      const link = item.querySelector<HTMLElement>('.menu-link');
      return link?.textContent?.trim().startsWith('Erlebnis');
    });

    const megaInner = menuItem?.querySelector<HTMLElement>('.mega-inner');
    if (!megaInner || megaInner.dataset.erlebnisEnhanced === 'true') return;

    megaInner.dataset.erlebnisEnhanced = 'true';
    megaInner.classList.add('erlebnis-mega');
    megaInner.replaceChildren(template.content.cloneNode(true));
  };

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', enhanceErlebnisMenu, { once: true });
  } else {
    enhanceErlebnisMenu();
  }
</script>

<style>
  :global(.mega-inner.erlebnis-mega){position:relative;grid-template-columns:300px minmax(0,1fr);gap:0;padding:0;overflow:auto;max-height:min(760px,calc(100vh - 105px));border-top-color:#f4d638;background:#f4f7f4}
  .experience-intro{position:sticky;top:0;align-self:start;min-height:100%;overflow:hidden;padding:36px 30px;background:linear-gradient(145deg,#071f16,#164f32);color:white}
  .experience-intro::before{content:'ERLEBNIS';position:absolute;left:-12px;bottom:-20px;color:rgb(255 255 255 / 4%);font-size:5.6rem;font-weight:950;letter-spacing:-.08em;transform:rotate(-90deg);transform-origin:left bottom}
  .experience-intro::after{content:'✦';position:absolute;right:-18px;top:-32px;color:rgb(244 214 56 / 13%);font-size:9rem}
  .experience-intro>span{position:relative;z-index:1;color:#f4d638;font-size:.62rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}
  .experience-intro h2{position:relative;z-index:1;margin:14px 0 18px;color:white;font-family:Georgia,serif;font-size:2.25rem;line-height:.94;letter-spacing:-.045em;text-transform:none}
  .experience-intro h2 em{color:#f4d638;font-weight:400}
  .experience-intro p{position:relative;z-index:1;margin:0;color:#bfd0c5;font-size:.79rem;line-height:1.7}
  .experience-intro>a{position:relative;z-index:1;min-height:43px;margin-top:27px;padding:0 15px;display:flex;align-items:center;justify-content:space-between;gap:18px;background:#f4d638;color:#071f16;font-size:.7rem;font-weight:900;text-decoration:none}
  .experience-intro>a b{font-size:.95rem;transition:transform .18s ease}.experience-intro>a:hover b{transform:translate(2px,-2px)}
  .experience-groups{padding:24px 25px 28px;display:grid;gap:26px;background:#f4f7f4}
  .experience-group{min-width:0}
  .experience-group+.experience-group{padding-top:24px;border-top:1px solid #d8e1da}
  .experience-group-heading{margin-bottom:12px;display:flex;align-items:end;justify-content:space-between;gap:22px}
  .experience-group-heading span{display:block;margin-bottom:3px;color:#718078;font-size:.53rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}
  .experience-group-heading h3{margin:0;color:#164f32;font-size:1rem;letter-spacing:-.015em}
  .experience-group-heading>b{color:#a3aea7;font-size:.64rem;letter-spacing:.08em}
  .experience-group-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}
  .experience-group:nth-child(n+2) .experience-group-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .experience-card{position:relative;min-height:176px;padding:14px 16px 17px;display:flex;flex-direction:column;overflow:hidden;border-top:4px solid var(--experience-accent);background:white;color:#17251b;text-decoration:none;box-shadow:0 7px 20px rgb(9 47 32 / 6%);transition:transform .18s ease,box-shadow .18s ease}
  .experience-card:hover,.experience-card:focus{outline:none;transform:translateY(-3px);box-shadow:0 14px 30px rgb(9 47 32 / 12%)}
  .experience-number{position:absolute;z-index:3;right:15px;top:12px;padding:4px 6px;background:rgb(255 255 255 / 88%);color:#68756d;font-size:.53rem;font-weight:900}
  .experience-logo-wrap{height:68px;margin:-1px -2px 12px;padding:8px 11px;display:flex;align-items:center;justify-content:center;gap:11px;overflow:hidden;background:var(--logo-bg);border:1px solid rgb(9 47 32 / 7%)}
  .experience-logo{display:block;max-width:100%;max-height:50px;object-fit:contain}
  .experience-logo-label{display:flex;flex-direction:column;color:#164f32;font-size:.67rem;font-weight:950;line-height:1.05;text-align:center;letter-spacing:.03em}
  .experience-card small{padding-right:22px;color:var(--experience-accent);font-size:.5rem;font-weight:950;letter-spacing:.07em;text-transform:uppercase}
  .experience-card>strong{max-width:245px;margin-top:6px;padding-right:28px;font-size:.87rem;line-height:1.2}
  .experience-card>p{margin:6px 0 0;color:#68766d;font-size:.58rem;font-weight:800}
  .experience-card>b{position:absolute;z-index:1;right:14px;bottom:13px;width:24px;aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:#092f20;color:#f4d638;font-size:.64rem}
  @media(max-width:1080px){.experience-group-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:980px){:global(.mega-inner.erlebnis-mega){display:grid;grid-template-columns:1fr;padding:0!important;max-height:none}.experience-intro{position:relative;min-height:0;padding:28px 24px}.experience-intro h2{font-size:1.85rem}.experience-groups{padding:20px}.experience-group-grid,.experience-group:nth-child(n+2) .experience-group-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:620px){.experience-group-grid,.experience-group:nth-child(n+2) .experience-group-grid{grid-template-columns:1fr}.experience-card{min-height:170px}}
</style>
