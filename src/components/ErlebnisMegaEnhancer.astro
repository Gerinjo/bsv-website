---
import { erlebnisCooperations } from '../data/erlebnis';
import { withBase } from '../utils/paths';

const byId = (id: string) => erlebnisCooperations.find((item) => item.id === id)!;
const skechers = byId('skechers-fussballschule');
const porsche = byId('porsche-maedchencamp');
const grundschulturnier = byId('buergerstiftung-grundschulturnier');
const mcshape = byId('mcshape-radolfzell');

const logoPreview = (item: typeof skechers, nextEvent = '', nextTone = 'normal') => ({
  ...item,
  previewSrc: item.logoSrc.startsWith('/') ? withBase(item.logoSrc) : item.logoSrc,
  previewKind:
    item.id === 'porsche-maedchencamp'
      ? 'kickers'
      : item.id === 'mcshape-radolfzell'
        ? 'mcshape'
        : 'logo',
  previewBackground: item.logoBackground,
  previewLabel: item.id === 'porsche-maedchencamp' ? 'Porsche Fußballschule\nStuttgarter Kickers' : '',
  nextEvent,
  nextTone,
});

const menuGroups = [
  {
    title: 'Fußballcamps',
    items: [
      logoPreview(skechers, 'Sommerferien 2027'),
      logoPreview(porsche, 'Oktober 2026 · JETZT noch anmelden', 'urgent'),
      {
        id: 'save-play-torwartcamp',
        menuTitle: 'Save & Play Torwartcamp',
        category: 'Torwarttraining & Feriencamp',
        actionHref: '/erlebnis/torwartcamp',
        accent: '#164f32',
        previewSrc: '',
        previewKind: 'label',
        previewBackground: '#eef3ef',
        previewLabel: 'SAVE & PLAY\nTORWARTCAMP',
        date: '',
        nextEvent: 'Ostern 2027',
        nextTone: 'normal',
        logoAlt: 'Save & Play Torwartcamp',
      },
    ],
  },
  {
    title: 'Turniere & Aktionstage',
    items: [logoPreview(grundschulturnier, 'Juli 2027')],
  },
  {
    title: 'Benefits',
    items: [logoPreview(mcshape)],
  },
];
const previewItems = menuGroups.flatMap((group) => group.items);
const firstItem = previewItems[0];
---

<template id="erlebnis-mega-template">
  <div class="experience-intro">
    <span>Erlebnis beim BSV</span>
    <h2>Mehr erleben.<br /><em>Gemeinsam wachsen.</em></h2>
    <p>Fußballcamps, besondere Turniere und attraktive Benefits ergänzen den Vereinsalltag.</p>
    <a href={withBase('/erlebnis')}>Alle Erlebnisse entdecken <b aria-hidden="true">↗</b></a>
  </div>

  <div class="experience-browser">
    <nav class="experience-list" aria-label="Erlebnisse beim BSV">
      {menuGroups.map((group) => (
        <section class="experience-list-group">
          <h3>{group.title}</h3>
          <div class="experience-links">
            {group.items.map((item) => (
              <a
                href={withBase(item.actionHref)}
                class="experience-link"
                data-experience-id={item.id}
                data-preview-src={item.previewSrc}
                data-preview-kind={item.previewKind}
                data-preview-background={item.previewBackground}
                data-preview-label={item.previewLabel ?? ''}
                data-preview-title={item.menuTitle}
                data-preview-category={item.category}
                data-preview-date={item.date ?? ''}
                data-preview-accent={item.accent}
                data-preview-next={item.nextEvent ?? ''}
                data-preview-next-tone={item.nextTone ?? 'normal'}
                data-preview-alt={item.logoAlt ?? item.menuTitle}
              >
                <span class="experience-link-copy">
                  <strong>{item.menuTitle}</strong>
                  <small>{item.category}</small>
                </span>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </section>
      ))}
    </nav>

    <a
      class="experience-preview"
      href={withBase(firstItem.actionHref)}
      data-experience-preview
      style={`--preview-accent:${firstItem.accent};--preview-bg:${firstItem.previewBackground}`}
    >
      <div class="experience-preview-media" data-preview-media data-kind={firstItem.previewKind}>
        {firstItem.previewSrc ? <img src={firstItem.previewSrc} alt={firstItem.logoAlt ?? ''} decoding="async" /> : null}
        {firstItem.previewLabel ? (
          <span class:list={["experience-preview-label", firstItem.previewKind === 'kickers' && 'is-kickers']}>
            {firstItem.previewLabel.split('\n').map((line) => <span>{line}</span>)}
          </span>
        ) : null}
      </div>
      <div class="experience-preview-copy">
        <span class="experience-next" data-preview-next data-tone={firstItem.nextTone} hidden={!firstItem.nextEvent}>
          <b>Nächster Termin</b><strong>{firstItem.nextEvent}</strong>
        </span>
        <small data-preview-category>{firstItem.category}</small>
        <strong data-preview-title>{firstItem.menuTitle}</strong>
        <p data-preview-date>{firstItem.date ?? ''}</p>
        <b class="experience-more" aria-hidden="true">Mehr erfahren ↗</b>
      </div>
    </a>
  </div>
</template>

<script>
  const enhanceErlebnisMenu = () => {
    const template = document.querySelector<HTMLTemplateElement>('#erlebnis-mega-template');
    if (!template) return;

    const menuItem = [...document.querySelectorAll<HTMLElement>('.menu-item')].find((item) => {
      const link = item.querySelector<HTMLElement>('.menu-link');
      return link?.textContent?.trim().startsWith('Erlebnis');
    });

    const megaInner = menuItem?.querySelector<HTMLElement>('.mega-inner');
    if (!megaInner || megaInner.dataset.erlebnisEnhanced === 'true') return;

    megaInner.dataset.erlebnisEnhanced = 'true';
    megaInner.classList.add('erlebnis-mega');
    megaInner.replaceChildren(template.content.cloneNode(true));

    const links = [...megaInner.querySelectorAll<HTMLAnchorElement>('[data-experience-id]')];
    const preview = megaInner.querySelector<HTMLAnchorElement>('[data-experience-preview]');
    const media = preview?.querySelector<HTMLElement>('[data-preview-media]');
    const title = preview?.querySelector<HTMLElement>('[data-preview-title]');
    const category = preview?.querySelector<HTMLElement>('[data-preview-category]');
    const date = preview?.querySelector<HTMLElement>('[data-preview-date]');
    const next = preview?.querySelector<HTMLElement>('[data-preview-next]');
    if (!preview || !media || !title || !category || !date || !next) return;

    const activate = (link: HTMLAnchorElement) => {
      links.forEach((item) => item.classList.toggle('is-active', item === link));
      preview.href = link.href;
      preview.style.setProperty('--preview-accent', link.dataset.previewAccent ?? '#164f32');
      preview.style.setProperty('--preview-bg', link.dataset.previewBackground ?? '#ffffff');
      title.textContent = link.dataset.previewTitle ?? '';
      category.textContent = link.dataset.previewCategory ?? '';
      date.textContent = link.dataset.previewDate ?? '';
      date.hidden = !link.dataset.previewDate;

      const nextValue = link.dataset.previewNext ?? '';
      const nextTone = link.dataset.previewNextTone ?? 'normal';
      const nextStrong = next.querySelector<HTMLElement>('strong');
      if (nextStrong) nextStrong.textContent = nextValue;
      next.dataset.tone = nextTone;
      next.hidden = !nextValue;

      const src = link.dataset.previewSrc ?? '';
      const kind = link.dataset.previewKind ?? 'logo';
      const label = link.dataset.previewLabel ?? '';
      const alt = link.dataset.previewAlt ?? '';
      media.dataset.kind = kind;
      media.replaceChildren();

      if (src) {
        const image = document.createElement('img');
        image.src = src;
        image.alt = alt;
        image.decoding = 'async';
        media.append(image);
      }

      if (label) {
        const labelWrap = document.createElement('span');
        labelWrap.className = `experience-preview-label${kind === 'kickers' ? ' is-kickers' : ''}`;
        label.split('\n').forEach((line) => {
          const row = document.createElement('span');
          row.textContent = line;
          labelWrap.append(row);
        });
        media.append(labelWrap);
      }
    };

    links.forEach((link) => {
      link.addEventListener('mouseenter', () => activate(link));
      link.addEventListener('focus', () => activate(link));
    });
    if (links[0]) activate(links[0]);
  };

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', enhanceErlebnisMenu, { once: true });
  } else {
    enhanceErlebnisMenu();
  }
</script>

<style>
  :global(.mega-inner.erlebnis-mega){grid-template-columns:270px minmax(0,1fr);gap:0;padding:0;overflow:hidden!important;max-height:none!important;border-top-color:#a8cbb4;background:#f4f7f4}
  :global(.mega-inner.erlebnis-mega .experience-intro){position:relative;overflow:hidden;padding:32px 27px;background:linear-gradient(145deg,#071f16,#164f32);color:white}
  :global(.mega-inner.erlebnis-mega .experience-intro::before){content:'ERLEBNIS';position:absolute;left:-12px;bottom:-20px;color:rgb(255 255 255 / 4%);font-size:5.2rem;font-weight:950;letter-spacing:-.08em;transform:rotate(-90deg);transform-origin:left bottom}
  :global(.mega-inner.erlebnis-mega .experience-intro::after){content:'✦';position:absolute;right:-18px;top:-32px;color:rgb(168 203 180 / 13%);font-size:8rem}
  :global(.mega-inner.erlebnis-mega .experience-intro>span){position:relative;z-index:1;color:#a8cbb4;font-size:.6rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}
  :global(.mega-inner.erlebnis-mega .experience-intro h2){position:relative;z-index:1;margin:12px 0 16px;color:white;font-family:Georgia,serif;font-size:2rem;line-height:.95;letter-spacing:-.045em;text-transform:none}
  :global(.mega-inner.erlebnis-mega .experience-intro h2 em){color:#a8cbb4;font-weight:400}
  :global(.mega-inner.erlebnis-mega .experience-intro p){position:relative;z-index:1;margin:0;color:#bfd0c5;font-size:.75rem;line-height:1.65}
  :global(.mega-inner.erlebnis-mega .experience-intro>a){position:relative;z-index:1;min-height:42px;margin-top:23px;padding:0 14px;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#a8cbb4;color:#071f16;font-size:.68rem;font-weight:900;text-decoration:none}
  :global(.mega-inner.erlebnis-mega .experience-browser){padding:22px;display:grid;grid-template-columns:minmax(270px,.9fr) minmax(330px,1.1fr);gap:20px;min-width:0;background:#f4f7f4}
  :global(.mega-inner.erlebnis-mega .experience-list){display:grid;align-content:start;gap:14px;min-width:0}
  :global(.mega-inner.erlebnis-mega .experience-list-group){min-width:0}
  :global(.mega-inner.erlebnis-mega .experience-list-group+.experience-list-group){padding-top:12px;border-top:1px solid #d7e0d9}
  :global(.mega-inner.erlebnis-mega .experience-list-group h3){margin:0 0 6px;color:#164f32!important;font-size:.72rem;font-weight:950;letter-spacing:.08em;text-transform:uppercase}
  :global(.mega-inner.erlebnis-mega .experience-links){display:grid;gap:2px}
  :global(.mega-inner.erlebnis-mega .experience-link),:global(.mega-inner.erlebnis-mega .experience-link:visited){min-height:45px;padding:7px 8px 7px 10px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-left:3px solid transparent;color:#293a30!important;text-decoration:none!important;line-height:1.18;transition:background .16s ease,border-color .16s ease,color .16s ease}
  :global(.mega-inner.erlebnis-mega .experience-link-copy){min-width:0;display:block}
  :global(.mega-inner.erlebnis-mega .experience-link-copy strong){display:block;color:#293a30!important;font-size:.76rem!important;font-weight:850!important;line-height:1.2!important;text-decoration:none!important}
  :global(.mega-inner.erlebnis-mega .experience-link-copy small){display:block;margin-top:3px;color:#7c8a81!important;font-size:.55rem!important;font-weight:750!important;line-height:1.25!important;letter-spacing:.015em!important;text-transform:none!important;text-decoration:none!important}
  :global(.mega-inner.erlebnis-mega .experience-link>b){flex:0 0 auto;color:#8a9990!important;font-size:.68rem;opacity:.55}
  :global(.mega-inner.erlebnis-mega .experience-link:hover),:global(.mega-inner.erlebnis-mega .experience-link:focus),:global(.mega-inner.erlebnis-mega .experience-link.is-active){outline:none;border-left-color:#a8cbb4;background:#edf5f0;color:#0b3523!important}
  :global(.mega-inner.erlebnis-mega .experience-link:hover strong),:global(.mega-inner.erlebnis-mega .experience-link:focus strong),:global(.mega-inner.erlebnis-mega .experience-link.is-active strong){color:#0b3523!important}
  :global(.mega-inner.erlebnis-mega .experience-link:hover small),:global(.mega-inner.erlebnis-mega .experience-link:focus small),:global(.mega-inner.erlebnis-mega .experience-link.is-active small){color:#5e6d64!important}
  :global(.mega-inner.erlebnis-mega .experience-link:hover b),:global(.mega-inner.erlebnis-mega .experience-link:focus b),:global(.mega-inner.erlebnis-mega .experience-link.is-active b){color:#164f32!important;opacity:1}
  :global(.mega-inner.erlebnis-mega .experience-preview),:global(.mega-inner.erlebnis-mega .experience-preview:visited){position:relative;align-self:start;display:flex;flex-direction:column;overflow:hidden;background:#fff;color:#17251b!important;text-decoration:none!important;border-top:4px solid var(--preview-accent);box-shadow:0 10px 26px rgb(9 47 32 / 9%);transition:transform .18s ease,box-shadow .18s ease}
  :global(.mega-inner.erlebnis-mega .experience-preview:hover){transform:translateY(-2px);box-shadow:0 15px 32px rgb(9 47 32 / 13%)}
  :global(.mega-inner.erlebnis-mega .experience-preview-media){height:176px;flex:0 0 176px;padding:22px 30px;display:grid;place-items:center;overflow:hidden;background:var(--preview-bg);border-bottom:1px solid #e1e7e2;box-sizing:border-box}
  :global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='logo'] img){display:block;max-width:78%;max-height:118px;object-fit:contain}
  :global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='mcshape']){padding:15px 28px;background:#000!important}
  :global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='mcshape'] img){display:block;width:auto;height:132px;max-width:72%;max-height:132px;object-fit:contain}
  :global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='kickers']){grid-template-columns:86px minmax(0,1fr);place-items:center start;gap:20px;padding:25px 34px;background:#fff!important}
  :global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='kickers'] img){display:block;width:82px;height:82px;object-fit:contain}
  :global(.mega-inner.erlebnis-mega .experience-preview-label){display:flex;flex-direction:column;color:#164f32;font-size:1.3rem;font-weight:950;line-height:1.02;text-align:center;letter-spacing:.03em}
  :global(.mega-inner.erlebnis-mega .experience-preview-label.is-kickers){align-items:flex-start;color:#009fe3;font-size:1.08rem;line-height:1.08;text-align:left;letter-spacing:-.02em}
  :global(.mega-inner.erlebnis-mega .experience-preview-label.is-kickers span:last-child){margin-top:4px;color:#006f9f;font-size:.86rem;letter-spacing:.01em}
  :global(.mega-inner.erlebnis-mega .experience-preview-media[data-kind='label']){background:linear-gradient(145deg,#e8efea,#fff)}
  :global(.mega-inner.erlebnis-mega .experience-preview-copy){position:relative;min-height:125px;padding:17px 20px 38px;background:#fff;box-sizing:border-box}
  :global(.mega-inner.erlebnis-mega .experience-preview-copy>small){display:block;color:var(--preview-accent)!important;font-size:.52rem;font-weight:950;letter-spacing:.09em;text-transform:uppercase}
  :global(.mega-inner.erlebnis-mega .experience-preview-copy>[data-preview-title]){display:block;margin-top:6px;color:#17251b!important;font-size:1.04rem!important;line-height:1.18!important;text-decoration:none!important}
  :global(.mega-inner.erlebnis-mega .experience-preview-copy>p){margin:6px 0 0;color:#68766d;font-size:.62rem;font-weight:800}
  :global(.mega-inner.erlebnis-mega .experience-more){position:absolute;right:20px;bottom:15px;color:#164f32!important;font-size:.61rem}
  :global(.mega-inner.erlebnis-mega .experience-next){margin:-17px -20px 14px;padding:8px 12px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#a8cbb4;color:#092f20}
  :global(.mega-inner.erlebnis-mega .experience-next>b){font-size:.48rem;font-weight:950;letter-spacing:.1em;text-transform:uppercase}
  :global(.mega-inner.erlebnis-mega .experience-next>strong){color:#092f20!important;font-size:.7rem;font-weight:950;text-align:right}
  :global(.mega-inner.erlebnis-mega .experience-next[data-tone='urgent']){background:#ef2132;color:white}
  :global(.mega-inner.erlebnis-mega .experience-next[data-tone='urgent']>strong){color:white!important}
  :global(.mega-inner.erlebnis-mega .experience-next[hidden]){display:none}
  @media(max-width:980px){
    :global(.mega-inner.erlebnis-mega){display:grid;grid-template-columns:1fr;padding:0!important}
    :global(.mega-inner.erlebnis-mega .experience-intro){padding:24px}
    :global(.mega-inner.erlebnis-mega .experience-intro h2){font-size:1.75rem}
    :global(.mega-inner.erlebnis-mega .experience-browser){grid-template-columns:1fr}
    :global(.mega-inner.erlebnis-mega .experience-preview){display:none}
    :global(.mega-inner.erlebnis-mega .experience-list){gap:13px}
  }
</style>
