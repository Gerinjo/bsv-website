---
import { erlebnisCooperations } from '../data/erlebnis';
import { withBase } from '../utils/paths';

const byId = (id: string) => erlebnisCooperations.find((item) => item.id === id)!;
const skechers = byId('skechers-fussballschule');
const porsche = byId('porsche-maedchencamp');
const grundschulturnier = byId('buergerstiftung-grundschulturnier');
const mcshape = byId('mcshape-radolfzell');

const logoPreview = (item: typeof skechers) => ({
  ...item,
  previewSrc: item.logoSrc.startsWith('/') ? withBase(item.logoSrc) : item.logoSrc,
  previewKind: 'logo',
  previewBackground: item.logoBackground,
});

const menuGroups = [
  {
    title: 'Fußballcamps',
    items: [
      logoPreview(skechers),
      logoPreview(porsche),
      {
        id: 'save-play-torwartcamp',
        menuTitle: 'Save & Play Torwartcamp',
        category: 'Torwarttraining & Feriencamp',
        actionHref: '/erlebnis/torwartcamp',
        accent: '#164f32',
        previewSrc: '',
        previewKind: 'label',
        previewBackground: '#eef3ef',
        previewLabel: 'SAVE & PLAY\nTORWARTCAMP',
        date: 'Oster Torwart Camp 2026',
      },
    ],
  },
  {
    title: 'Turniere & Aktionstage',
    items: [logoPreview(grundschulturnier)],
  },
  {
    title: 'Benefits',
    items: [logoPreview(mcshape)],
  },
];
const previewItems = menuGroups.flatMap((group) => group.items);
const firstItem = previewItems[0];
---

<template id="erlebnis-mega-template">
  <div class="experience-intro">
    <span>Erlebnis beim BSV</span>
    <h2>Mehr erleben.<br /><em>Gemeinsam wachsen.</em></h2>
    <p>Fußballcamps, besondere Turniere und attraktive Benefits ergänzen den Vereinsalltag.</p>
    <a href={withBase('/erlebnis')}>Alle Erlebnisse entdecken <b aria-hidden="true">↗</b></a>
  </div>

  <div class="experience-browser">
    <nav class="experience-list" aria-label="Erlebnisse beim BSV">
      {menuGroups.map((group) => (
        <section class="experience-list-group">
          <h3>{group.title}</h3>
          <div class="experience-links">
            {group.items.map((item) => (
              <a
                href={withBase(item.actionHref)}
                class="experience-link"
                data-experience-id={item.id}
                data-preview-src={item.previewSrc}
                data-preview-kind={item.previewKind}
                data-preview-background={item.previewBackground}
                data-preview-label={'previewLabel' in item ? item.previewLabel : ''}
                data-preview-title={item.menuTitle}
                data-preview-category={item.category}
                data-preview-date={item.date ?? ''}
                data-preview-accent={item.accent}
              >
                <span>{item.menuTitle}</span><b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </section>
      ))}
    </nav>

    <a
      class="experience-preview"
      href={withBase(firstItem.actionHref)}
      data-experience-preview
      style={`--preview-accent:${firstItem.accent};--preview-bg:${firstItem.previewBackground}`}
    >
      <div class="experience-preview-media" data-preview-media data-kind={firstItem.previewKind}>
        {firstItem.previewSrc ? <img src={firstItem.previewSrc} alt="" decoding="async" /> : null}
        {'previewLabel' in firstItem && firstItem.previewLabel ? (
          <span class="experience-preview-label">{firstItem.previewLabel.split('\n').map((line) => <span>{line}</span>)}</span>
        ) : null}
      </div>
      <div class="experience-preview-copy">
        <small data-preview-category>{firstItem.category}</small>
        <strong data-preview-title>{firstItem.menuTitle}</strong>
        <p data-preview-date>{firstItem.date ?? ''}</p>
        <b aria-hidden="true">Mehr erfahren ↗</b>
      </div>
    </a>
  </div>
</template>

<script>
  const enhanceErlebnisMenu = () => {
    const template = document.querySelector<HTMLTemplateElement>('#erlebnis-mega-template');
    if (!template) return;

    const menuItem = [...document.querySelectorAll<HTMLElement>('.menu-item')].find((item) => {
      const link = item.querySelector<HTMLElement>('.menu-link');
      return link?.textContent?.trim().startsWith('Erlebnis');
    });

    const megaInner = menuItem?.querySelector<HTMLElement>('.mega-inner');
    if (!megaInner || megaInner.dataset.erlebnisEnhanced === 'true') return;

    megaInner.dataset.erlebnisEnhanced = 'true';
    megaInner.classList.add('erlebnis-mega');
    megaInner.replaceChildren(template.content.cloneNode(true));

    const links = [...megaInner.querySelectorAll<HTMLAnchorElement>('[data-experience-id]')];
    const preview = megaInner.querySelector<HTMLAnchorElement>('[data-experience-preview]');
    const media = megaInner.querySelector<HTMLElement>('[data-preview-media]');
    const title = megaInner.querySelector<HTMLElement>('[data-preview-title]');
    const category = megaInner.querySelector<HTMLElement>('[data-preview-category]');
    const date = megaInner.querySelector<HTMLElement>('[data-preview-date]');
    if (!preview || !media || !title || !category || !date) return;

    const activate = (link: HTMLAnchorElement) => {
      links.forEach((item) => item.classList.toggle('is-active', item === link));
      preview.href = link.href;
      preview.style.setProperty('--preview-accent', link.dataset.previewAccent ?? '#164f32');
      preview.style.setProperty('--preview-bg', link.dataset.previewBackground ?? '#ffffff');
      title.textContent = link.dataset.previewTitle ?? '';
      category.textContent = link.dataset.previewCategory ?? '';
      date.textContent = link.dataset.previewDate ?? '';
      date.hidden = !link.dataset.previewDate;

      const src = link.dataset.previewSrc ?? '';
      const kind = link.dataset.previewKind ?? 'logo';
      const label = link.dataset.previewLabel ?? '';
      media.dataset.kind = kind;
      media.replaceChildren();

      if (src) {
        const image = document.createElement('img');
        image.src = src;
        image.alt = '';
        image.decoding = 'async';
        media.append(image);
      }
      if (label) {
        const labelWrap = document.createElement('span');
        labelWrap.className = 'experience-preview-label';
        label.split('\n').forEach((line) => {
          const row = document.createElement('span');
          row.textContent = line;
          labelWrap.append(row);
        });
        media.append(labelWrap);
      }
    };

    links.forEach((link) => {
      link.addEventListener('mouseenter', () => activate(link));
      link.addEventListener('focus', () => activate(link));
    });
    if (links[0]) activate(links[0]);
  };

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', enhanceErlebnisMenu, { once: true });
  } else {
    enhanceErlebnisMenu();
  }
</script>

<style>
  :global(.mega-inner.erlebnis-mega){grid-template-columns:270px minmax(0,1fr);gap:0;padding:0;overflow:hidden!important;max-height:none!important;border-top-color:#f4d638;background:#f4f7f4}
  .experience-intro{position:relative;overflow:hidden;padding:32px 27px;background:linear-gradient(145deg,#071f16,#164f32);color:white}
  .experience-intro::before{content:'ERLEBNIS';position:absolute;left:-12px;bottom:-20px;color:rgb(255 255 255 / 4%);font-size:5.2rem;font-weight:950;letter-spacing:-.08em;transform:rotate(-90deg);transform-origin:left bottom}
  .experience-intro::after{content:'✦';position:absolute;right:-18px;top:-32px;color:rgb(244 214 56 / 13%);font-size:8rem}
  .experience-intro>span{position:relative;z-index:1;color:#f4d638;font-size:.6rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}
  .experience-intro h2{position:relative;z-index:1;margin:12px 0 16px;color:white;font-family:Georgia,serif;font-size:2rem;line-height:.95;letter-spacing:-.045em;text-transform:none}
  .experience-intro h2 em{color:#f4d638;font-weight:400}
  .experience-intro p{position:relative;z-index:1;margin:0;color:#bfd0c5;font-size:.75rem;line-height:1.65}
  .experience-intro>a{position:relative;z-index:1;min-height:42px;margin-top:23px;padding:0 14px;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#f4d638;color:#071f16;font-size:.68rem;font-weight:900;text-decoration:none}
  .experience-browser{padding:22px;display:grid;grid-template-columns:minmax(250px,.86fr) minmax(330px,1.14fr);gap:20px;min-width:0;background:#f4f7f4}
  .experience-list{display:grid;align-content:start;gap:16px;min-width:0}
  .experience-list-group{min-width:0}.experience-list-group+.experience-list-group{padding-top:14px;border-top:1px solid #d7e0d9}
  .experience-list-group h3{margin:0 0 6px;color:#164f32;font-size:.74rem;font-weight:950;letter-spacing:.08em;text-transform:uppercase}
  .experience-links{display:grid;gap:2px}
  .experience-link{min-height:34px;padding:7px 8px 7px 10px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-left:3px solid transparent;color:#293a30;text-decoration:none;font-size:.77rem;font-weight:800;line-height:1.2;transition:background .16s ease,border-color .16s ease,color .16s ease}
  .experience-link b{flex:0 0 auto;color:#8a9990;font-size:.68rem;opacity:.55}.experience-link:hover,.experience-link:focus,.experience-link.is-active{outline:none;border-left-color:#f4d638;background:#fff;color:#0b3523}.experience-link:hover b,.experience-link:focus b,.experience-link.is-active b{color:#164f32;opacity:1}
  .experience-preview{position:relative;min-height:315px;display:grid;grid-template-rows:190px auto;overflow:hidden;background:#fff;color:#17251b;text-decoration:none;border-top:5px solid var(--preview-accent);box-shadow:0 12px 30px rgb(9 47 32 / 10%);transition:transform .18s ease,box-shadow .18s ease}
  .experience-preview:hover{transform:translateY(-2px);box-shadow:0 17px 36px rgb(9 47 32 / 14%)}
  .experience-preview-media{min-height:190px;padding:28px;display:grid;place-items:center;overflow:hidden;background:var(--preview-bg);border-bottom:1px solid rgb(9 47 32 / 7%)}
  .experience-preview-media[data-kind='logo'] img{display:block;max-width:78%;max-height:118px;object-fit:contain}
  .experience-preview-media[data-kind='label']{background:linear-gradient(145deg,#e8efea,#fff)}
  .experience-preview-label{display:flex;flex-direction:column;color:#164f32;font-size:1.4rem;font-weight:950;line-height:1.02;text-align:center;letter-spacing:.03em}
  .experience-preview-copy{position:relative;padding:19px 21px 21px}.experience-preview-copy small{display:block;color:var(--preview-accent);font-size:.54rem;font-weight:950;letter-spacing:.09em;text-transform:uppercase}.experience-preview-copy strong{display:block;margin-top:6px;padding-right:90px;font-size:1.13rem;line-height:1.18}.experience-preview-copy p{margin:7px 0 0;color:#68766d;font-size:.65rem;font-weight:800}.experience-preview-copy>b{position:absolute;right:20px;bottom:21px;color:#164f32;font-size:.64rem}
  @media(max-width:980px){:global(.mega-inner.erlebnis-mega){display:grid;grid-template-columns:1fr;padding:0!important}.experience-intro{padding:24px}.experience-intro h2{font-size:1.75rem}.experience-browser{grid-template-columns:1fr}.experience-preview{display:none}.experience-list{gap:13px}}
</style>
