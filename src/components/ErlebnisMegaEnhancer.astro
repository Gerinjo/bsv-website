---
import { erlebnisCooperations } from '../data/erlebnis';
import { withBase } from '../utils/paths';
---

<template id="erlebnis-mega-template">
  <div class="experience-intro">
    <span>Kooperationen, die bewegen</span>
    <h2>Mehr erleben.<br /><em>Gemeinsam wachsen.</em></h2>
    <p>Starke Partner eröffnen Kindern, Jugendlichen und Erwachsenen zusätzliche Möglichkeiten rund um Fußball, Fitness, Schule und Gemeinschaft.</p>
    <a href={withBase('/erlebnis')}>Alle Kooperationen entdecken <b aria-hidden="true">↗</b></a>
  </div>

  <div class="experience-partners">
    {erlebnisCooperations.map((cooperation, index) => (
      <a
        class="experience-card"
        href={withBase(`/erlebnis#${cooperation.id}`)}
        style={`--experience-accent:${cooperation.accent}`}
      >
        <span class="experience-number">0{index + 1}</span>
        <span class="experience-symbol" aria-hidden="true">{cooperation.symbol}</span>
        <small>{cooperation.category}</small>
        <strong>{cooperation.menuTitle}</strong>
        {cooperation.date && <p>{cooperation.date}</p>}
        <b aria-hidden="true">↗</b>
      </a>
    ))}
  </div>

  <div class="experience-footer">
    <span><b>✦</b> Fußballcamps</span>
    <span><b>▲</b> Fitness & Athletik</span>
    <span><b>◎</b> Schule & Gemeinschaft</span>
  </div>
</template>

<script>
  const enhanceErlebnisMenu = () => {
    const template = document.querySelector<HTMLTemplateElement>('#erlebnis-mega-template');
    if (!template) return;

    const menuItem = [...document.querySelectorAll<HTMLElement>('.menu-item')].find((item) => {
      const link = item.querySelector<HTMLElement>('.menu-link');
      return link?.textContent?.trim().startsWith('Erlebnis');
    });

    const megaInner = menuItem?.querySelector<HTMLElement>('.mega-inner');
    if (!megaInner || megaInner.dataset.erlebnisEnhanced === 'true') return;

    megaInner.dataset.erlebnisEnhanced = 'true';
    megaInner.classList.add('erlebnis-mega');
    megaInner.replaceChildren(template.content.cloneNode(true));
  };

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', enhanceErlebnisMenu, { once: true });
  } else {
    enhanceErlebnisMenu();
  }
</script>

<style>
  :global(.mega-inner.erlebnis-mega){position:relative;grid-template-columns:330px minmax(0,1fr);gap:0;padding:0;overflow:hidden;border-top-color:#f4d638;background:#f4f7f4}
  .experience-intro{position:relative;overflow:hidden;padding:36px 33px;background:linear-gradient(145deg,#071f16,#164f32);color:white}
  .experience-intro::before{content:'ERLEBNIS';position:absolute;left:-12px;bottom:-20px;color:rgb(255 255 255 / 4%);font-size:5.6rem;font-weight:950;letter-spacing:-.08em;transform:rotate(-90deg);transform-origin:left bottom}
  .experience-intro::after{content:'✦';position:absolute;right:-18px;top:-32px;color:rgb(244 214 56 / 13%);font-size:9rem}
  .experience-intro>span{position:relative;z-index:1;color:#f4d638;font-size:.62rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}
  .experience-intro h2{position:relative;z-index:1;margin:14px 0 18px;color:white;font-family:Georgia,serif;font-size:2.25rem;line-height:.94;letter-spacing:-.045em;text-transform:none}
  .experience-intro h2 em{color:#f4d638;font-weight:400}
  .experience-intro p{position:relative;z-index:1;margin:0;color:#bfd0c5;font-size:.79rem;line-height:1.7}
  .experience-intro>a{position:relative;z-index:1;min-height:43px;margin-top:27px;padding:0 15px;display:flex;align-items:center;justify-content:space-between;gap:18px;background:#f4d638;color:#071f16;font-size:.7rem;font-weight:900;text-decoration:none}
  .experience-intro>a b{font-size:.95rem;transition:transform .18s ease}.experience-intro>a:hover b{transform:translate(2px,-2px)}
  .experience-partners{padding:25px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;background:#f4f7f4}
  .experience-card{position:relative;min-height:145px;padding:20px 20px 18px;display:flex;flex-direction:column;overflow:hidden;border-top:4px solid var(--experience-accent);background:white;color:#17251b;text-decoration:none;box-shadow:0 9px 24px rgb(9 47 32 / 7%);transition:transform .18s ease,box-shadow .18s ease}
  .experience-card::after{content:'';position:absolute;right:-42px;bottom:-55px;width:125px;aspect-ratio:1;border:1px solid color-mix(in srgb,var(--experience-accent) 28%,transparent);border-radius:50%}
  .experience-card:hover,.experience-card:focus{outline:none;transform:translateY(-3px);box-shadow:0 15px 34px rgb(9 47 32 / 13%)}
  .experience-number{position:absolute;right:17px;top:14px;color:#a6b1aa;font-size:.59rem;font-weight:900}
  .experience-symbol{width:29px;aspect-ratio:1;margin-bottom:13px;display:grid;place-items:center;border-radius:50%;background:var(--experience-accent);color:white;font-size:.75rem;font-weight:900}
  .experience-card small{padding-right:22px;color:var(--experience-accent);font-size:.55rem;font-weight:950;letter-spacing:.09em;text-transform:uppercase}
  .experience-card strong{max-width:245px;margin-top:7px;font-size:1rem;line-height:1.25}
  .experience-card p{margin:8px 0 0;color:#68766d;font-size:.63rem;font-weight:800}
  .experience-card>b{position:absolute;z-index:1;right:16px;bottom:15px;width:25px;aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:#092f20;color:#f4d638;font-size:.67rem}
  .experience-footer{grid-column:1/-1;min-height:48px;padding:0 26px;display:flex;align-items:center;justify-content:flex-end;gap:22px;border-top:1px solid #dce3dd;background:white;color:#58685e;font-size:.63rem;font-weight:850}
  .experience-footer span{display:flex;align-items:center;gap:6px}.experience-footer b{color:#164f32}
  @media(max-width:980px){:global(.mega-inner.erlebnis-mega){display:grid;grid-template-columns:1fr;padding:0!important}.experience-intro{padding:28px 24px}.experience-intro h2{font-size:1.85rem}.experience-partners{padding:18px}.experience-footer{padding:13px 18px;justify-content:flex-start;flex-wrap:wrap}}
  @media(max-width:620px){.experience-partners{grid-template-columns:1fr}.experience-footer{display:grid;gap:9px}}
</style>
