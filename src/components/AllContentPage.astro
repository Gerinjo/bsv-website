---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Layout from '../layouts/Layout.astro';
import type { MenuItem } from '../data/navigation';
import { withBase } from '../utils/paths';

interface Props {
  item: MenuItem;
  intro: string;
}

const { item, intro } = Astro.props;
const linkCount = item.groups.reduce((total, group) => total + group.links.length, 0);
const groupId = (title: string) => `bereich-${title.toLocaleLowerCase('de-DE').replace(/[^a-z0-9äöüß]+/g, '-').replace(/(^-|-$)/g, '')}`;
const sectionName = item.label === 'Junge Sterne' ? 'Nachwuchsbereich' : item.label;
---

<Layout
  title={`Alle Inhalte – ${item.label} | BSV Nordstern Radolfzell`}
  description={`Alle Seiten und Themen aus dem Bereich ${item.label} des BSV Nordstern Radolfzell auf einen Blick.`}
>
  <Header />

  <main>
    <section class="directory-hero">
      <div class="hero-lines" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <a class="back-link" href={withBase(item.href)}><span aria-hidden="true">←</span> Zurück zu {item.label}</a>
          <p class="eyebrow"><span></span> Alle Inhalte</p>
          <h1>{item.label}<br /><em>im Überblick.</em></h1>
          <p class="hero-intro">{intro}</p>
        </div>

        <div class="hero-index" aria-hidden="true">
          <div class="index-card index-card-main">
            <span>BSV</span>
            <strong>{String(linkCount).padStart(2, '0')}</strong>
            <small>Seiten</small>
          </div>
          <div class="index-card index-card-side">
            <span>{String(item.groups.length).padStart(2, '0')}</span>
            <small>Bereiche</small>
          </div>
          <div class="index-star">✦</div>
        </div>
      </div>
    </section>

    <nav class="jump-nav" aria-label="Themenbereiche auf dieser Seite">
      <div class="shell jump-inner">
        <span>Direkt zu</span>
        <div>
          {item.groups.map((group, index) => (
            <a href={`#${groupId(group.title)}`}><small>0{index + 1}</small>{group.title}</a>
          ))}
        </div>
      </div>
    </nav>

    <section class="directory-section">
      <div class="shell section-intro">
        <div>
          <p class="eyebrow dark"><span></span> Orientierung</p>
          <h2>Alles an<br /><em>einem Ort.</em></h2>
        </div>
        <p>Wähle einen Themenbereich oder öffne direkt die gewünschte Seite. Die Übersicht entspricht immer der aktuellen Struktur unseres Mega-Menüs.</p>
      </div>

      <div class="shell directory-grid">
        {item.groups.map((group, groupIndex) => (
          <article class:list={['directory-card', { featured: groupIndex === 0 }]} id={groupId(group.title)}>
            <header>
              <span>0{groupIndex + 1}</span>
              <div>
                <small>{sectionName}</small>
                <h3>{group.title}</h3>
              </div>
              <b>{String(group.links.length).padStart(2, '0')}</b>
            </header>
            <ul>
              {group.links.map((link, linkIndex) => (
                <li>
                  <a href={withBase(link.href)}>
                    <small>{String(linkIndex + 1).padStart(2, '0')}</small>
                    <strong>{link.label}</strong>
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="contact-strip">
      <div class="shell contact-card">
        <div class="contact-mark" aria-hidden="true">?</div>
        <div>
          <p class="eyebrow dark"><span></span> Noch nicht gefunden?</p>
          <h2>Wir helfen gerne weiter.</h2>
        </div>
        <a href={withBase('/kontakt')}>Kontakt aufnehmen <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(body) { background: #f4f7f4; }
  .shell { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }

  .directory-hero {
    position: relative;
    overflow: hidden;
    min-height: 530px;
    color: #fff;
    background: #123f2b;
  }
  .directory-hero::after {
    position: absolute;
    right: -9vw;
    bottom: -25vw;
    width: 48vw;
    height: 48vw;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 50%;
    box-shadow: 0 0 0 6vw rgb(255 255 255 / 0.025), 0 0 0 12vw rgb(255 255 255 / 0.02);
    content: '';
  }
  .hero-lines {
    position: absolute;
    inset: 0;
    opacity: .11;
    background-image: repeating-linear-gradient(112deg, transparent 0 68px, #fff 69px 70px);
    mask-image: linear-gradient(90deg, transparent, #000 50%, #000);
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(320px, .7fr);
    align-items: center;
    gap: 80px;
    min-height: 530px;
    padding-block: 68px 76px;
  }
  .back-link {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    margin-bottom: 48px;
    color: #b9c9c0;
    font-size: .78rem;
    font-weight: 750;
    text-decoration: none;
    transition: color .2s ease;
  }
  .back-link:hover { color: #a8cbb4; }
  .eyebrow {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 0 0 16px;
    color: #a8cbb4;
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .eyebrow > span { width: 24px; height: 2px; background: currentColor; }
  .eyebrow.dark { color: #1c5b3b; }
  h1, h2, h3, p { margin-top: 0; }
  h1 {
    max-width: 800px;
    margin-bottom: 22px;
    font-size: clamp(3.4rem, 7vw, 6.9rem);
    line-height: .84;
    letter-spacing: -.075em;
  }
  h1 em, h2 em { color: #a8cbb4; font-family: Georgia, serif; font-weight: 400; }
  .hero-intro {
    max-width: 670px;
    margin-bottom: 0;
    color: #c7d4cd;
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.7;
  }
  .hero-index { position: relative; min-height: 330px; }
  .index-card {
    position: absolute;
    display: flex;
    flex-direction: column;
    border: 1px solid rgb(255 255 255 / .16);
  }
  .index-card-main {
    top: 0;
    right: 35px;
    width: 245px;
    height: 270px;
    padding: 30px;
    color: #123f2b;
    background: #a8cbb4;
    box-shadow: 18px 18px 0 rgb(8 37 25 / .45);
    transform: rotate(2.5deg);
  }
  .index-card-main > span { font-size: .72rem; font-weight: 900; letter-spacing: .18em; }
  .index-card-main strong { position: absolute; right: 28px; bottom: 57px; font-size: 5.7rem; line-height: .72; letter-spacing: -.09em; }
  .index-card-main small { position: absolute; right: 29px; bottom: 25px; font-size: .72rem; font-weight: 850; letter-spacing: .16em; text-transform: uppercase; }
  .index-card-side {
    right: 220px;
    bottom: 0;
    z-index: 2;
    width: 142px;
    height: 118px;
    justify-content: center;
    padding: 22px;
    background: #fff;
    color: #123f2b;
    transform: rotate(-3deg);
  }
  .index-card-side span { font-size: 2.2rem; font-weight: 900; line-height: 1; }
  .index-card-side small { margin-top: 8px; color: #607168; font-weight: 750; }
  .index-star { position: absolute; right: 0; bottom: 20px; color: #a8cbb4; font-size: 3rem; }

  .jump-nav { position: relative; z-index: 3; border-bottom: 1px solid #dce3de; background: #fff; }
  .jump-inner { display: flex; gap: 38px; align-items: center; min-height: 84px; }
  .jump-inner > span { color: #718078; font-size: .68rem; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; white-space: nowrap; }
  .jump-inner > div { display: flex; flex: 1; }
  .jump-inner a {
    display: flex;
    gap: 10px;
    align-items: center;
    min-height: 84px;
    padding: 0 28px;
    border-left: 1px solid #e4e9e5;
    color: #17251b;
    font-size: .86rem;
    font-weight: 800;
    text-decoration: none;
    transition: color .2s ease, background .2s ease;
  }
  .jump-inner a:last-child { border-right: 1px solid #e4e9e5; }
  .jump-inner a small { color: #1c5b3b; font-size: .62rem; }
  .jump-inner a:hover { color: #1c5b3b; background: #f4f7f4; }

  .directory-section { padding: 112px 0 124px; }
  .section-intro {
    display: grid;
    grid-template-columns: minmax(300px, .9fr) minmax(400px, 1.1fr);
    gap: 100px;
    align-items: end;
    margin-bottom: 66px;
  }
  .section-intro h2 {
    margin-bottom: 0;
    color: #17251b;
    font-size: clamp(3rem, 5vw, 5.2rem);
    line-height: .92;
    letter-spacing: -.065em;
  }
  .section-intro h2 em { color: #1c5b3b; }
  .section-intro > p { max-width: 590px; margin-bottom: 4px; color: #617168; font-size: 1.08rem; line-height: 1.75; }

  .directory-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .directory-card {
    scroll-margin-top: 30px;
    overflow: hidden;
    border: 1px solid #dce4de;
    border-radius: 3px;
    background: #fff;
    box-shadow: 0 18px 50px rgb(21 62 43 / .06);
  }
  .directory-card header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 22px;
    align-items: center;
    min-height: 142px;
    padding: 30px 34px;
    border-bottom: 1px solid #dce4de;
    background: #edf2ee;
  }
  .directory-card header > span {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 50%;
    color: #a8cbb4;
    background: #164c33;
    font-size: .72rem;
    font-weight: 900;
  }
  .directory-card header small { color: #738178; font-size: .62rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .directory-card h3 { margin: 5px 0 0; font-size: clamp(1.45rem, 2vw, 2rem); letter-spacing: -.04em; }
  .directory-card header > b { color: #c9d3cc; font-size: 2.5rem; letter-spacing: -.08em; }
  .directory-card ul { margin: 0; padding: 0; list-style: none; }
  .directory-card li + li { border-top: 1px solid #edf0ed; }
  .directory-card li a {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    gap: 14px;
    align-items: center;
    min-height: 67px;
    padding: 11px 30px;
    color: #17251b;
    text-decoration: none;
    transition: color .2s ease, background .2s ease, padding .2s ease;
  }
  .directory-card li a small { color: #89958e; font-size: .65rem; font-weight: 800; }
  .directory-card li a strong { font-size: .95rem; }
  .directory-card li a span { color: #1c5b3b; font-size: 1.05rem; }
  .directory-card li a:hover { padding-left: 37px; color: #164c33; background: #f8faf8; }
  .directory-card li a:hover span { color: #e0bd00; }
  .directory-card.featured header { color: #fff; background: #164c33; }
  .directory-card.featured header > span { color: #164c33; background: #a8cbb4; }
  .directory-card.featured header small { color: #9fb5a9; }
  .directory-card.featured header > b { color: rgb(255 255 255 / .16); }

  .contact-strip { padding: 0 0 110px; }
  .contact-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 28px;
    align-items: center;
    padding: 42px 48px;
    color: #17251b;
    background: #a8cbb4;
  }
  .contact-mark { display: grid; width: 68px; height: 68px; place-items: center; border: 2px solid #17251b; border-radius: 50%; font-family: Georgia, serif; font-size: 2rem; font-style: italic; }
  .contact-card .eyebrow { margin-bottom: 8px; }
  .contact-card h2 { margin-bottom: 0; font-size: clamp(1.8rem, 3vw, 2.8rem); letter-spacing: -.045em; }
  .contact-card > a {
    display: inline-flex;
    gap: 24px;
    align-items: center;
    min-height: 54px;
    padding: 0 22px;
    border: 1px solid #17251b;
    color: #17251b;
    font-size: .8rem;
    font-weight: 850;
    text-decoration: none;
    transition: color .2s ease, background .2s ease;
  }
  .contact-card > a:hover { color: #fff; background: #17251b; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 45px; padding-block: 54px 64px; }
    .hero-index { display: none; }
    .jump-inner { align-items: stretch; overflow-x: auto; }
    .jump-inner > span { display: none; }
    .jump-inner > div { width: max-content; }
    .jump-inner a { white-space: nowrap; }
    .section-intro { grid-template-columns: 1fr; gap: 30px; }
    .directory-grid { grid-template-columns: 1fr; }
    .contact-card { grid-template-columns: auto 1fr; }
    .contact-card > a { grid-column: 2; justify-self: start; }
  }

  @media (max-width: 600px) {
    .shell { width: min(100% - 30px, 1180px); }
    .directory-hero, .hero-grid { min-height: 470px; }
    .back-link { margin-bottom: 42px; }
    h1 { font-size: clamp(3.1rem, 16vw, 4.8rem); }
    .jump-inner { width: 100%; }
    .jump-inner a { min-height: 70px; padding-inline: 20px; }
    .directory-section { padding-block: 80px 88px; }
    .section-intro { margin-bottom: 42px; }
    .section-intro > p { font-size: 1rem; }
    .directory-card header { min-height: 116px; padding: 24px 20px; gap: 15px; }
    .directory-card header > span { width: 38px; height: 38px; }
    .directory-card header > b { font-size: 1.8rem; }
    .directory-card li a { min-height: 62px; padding-inline: 20px; }
    .directory-card li a:hover { padding-left: 25px; }
    .contact-strip { padding-bottom: 80px; }
    .contact-card { grid-template-columns: 1fr; padding: 34px 26px; }
    .contact-mark { width: 55px; height: 55px; }
    .contact-card > a { grid-column: 1; }
  }
</style>
