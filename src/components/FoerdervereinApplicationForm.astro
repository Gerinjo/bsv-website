ubmit-row button:disabled{opacity:.45;cursor:not-allowed}.submit-row button.is-submitting{cursor:wait}.submit-row button b{font-size:1rem}.spinner{display:none;width:15px;height:15px;border:2px solid rgb(11 48 32 / 25%);border-top-color:#0b3020;border-radius:50%;animation:spin .7s linear infinite}.is-submitting .spinner{display:block}.is-submitting .button-label,.is-submitting b{display:none}.submit-row>div{display:grid;gap:5px}.submit-row p{margin:0;font-size:.76rem;line-height:1.45}.submit-hint{color:#708078}#fv-form-status{color:#193d2a;font-weight:850}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:900px){.form-layout{grid-template-columns:1fr;gap:35px}.form-layout aside{position:static;max-width:620px}}@media(max-width:650px){.fv-form-section{padding:65px 0 80px}.shell{width:min(100% - 30px,1160px)}.form-block{padding:25px 20px}.fields,.member-choice{grid-template-columns:1fr}.field.full{grid-column:1}.form-block>header{grid-template-columns:40px 1fr;gap:13px}.form-block>header>span{width:36px}.form-block>header h3{font-size:1.3rem}.signature-head,.submit-row{align-items:flex-start;flex-direction:column}.submit-row button{width:100%}}
  .form-layout{grid-template-columns:280px minmax(0,1fr);gap:70px}
  .form-layout aside h2{font-family:Georgia,serif;font-size:2.15rem;line-height:1.06;letter-spacing:normal}
  .form-layout aside ol{margin:0;padding-left:20px;color:#4e6155;line-height:1.75}
  .form-layout aside>p:not(.form-eyebrow){margin-top:28px;padding:18px;border-left:3px solid #f4d638;background:#edf2ee;font-size:.78rem}
  .form-block>header{align-items:start;border-bottom:0;padding-bottom:0}
