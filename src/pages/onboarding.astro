---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';

const contactPath = withBase('/kontakt?thema=youth');
---

<Layout
  title="Trainer-Onboarding | BSV Nordstern Radolfzell"
  description="Interner Ablauf für neue Trainerinnen und Trainer beim BSV Nordstern Radolfzell."
  noindex
>
  <Header />

  <main class="onboarding-page">
    <section class="onboarding-hero">
      <div class="orbit" aria-hidden="true"></div>
      <div class="shell hero-inner">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Intern · Trainer-Onboarding</p>
          <h1>Dein Start<br /><em>beim BSV.</em></h1>
          <p>Sechs Schritte, ein klarer Ablauf. Hier siehst du, welche Angaben, Zugänge und Übergaben wir gemeinsam erledigen, bevor du mit deinem Team loslegst.</p>
        </div>
        <aside class="progress-card" aria-live="polite">
          <div><span>Dein Fortschritt</span><strong><b id="progress-count">0</b> / 6</strong></div>
          <div class="progress-track"><span id="progress-bar"></span></div>
          <p id="progress-copy">Bereit für den ersten Schritt.</p>
        </aside>
      </div>
    </section>

    <nav class="step-nav" aria-label="Onboarding-Schritte">
      <div class="shell">
        <a href="#schritt-1"><span>01</span>Erfassung</a>
        <a href="#schritt-2"><span>02</span>Formalitäten</a>
        <a href="#schritt-3"><span>03</span>TimeTree</a>
        <a href="#schritt-4"><span>04</span>Schlüssel</a>
        <a href="#schritt-5"><span>05</span>DFBnet</a>
        <a href="#schritt-6"><span>06</span>Teambus</a>
      </div>
    </nav>

    <section class="intro shell">
      <div><p class="eyebrow dark"><span></span> Gut vorbereitet</p><h2>Schritt für Schritt.<br />Nichts geht verloren.</h2></div>
      <p>Die Jugendleitung begleitet dich durch den gesamten Ablauf. Hake einen Schritt erst ab, wenn die Übergabe oder Freischaltung bestätigt ist. Dein Fortschritt wird ausschließlich in diesem Browser gespeichert.</p>
    </section>

    <section class="steps shell" aria-label="Die sechs Onboarding-Schritte">
      <article class="step-card featured" id="schritt-1" data-step="1">
        <div class="step-number"><span>01</span><i></i></div>
        <div class="step-body">
          <header><div><small>Grundlage</small><h2>Persönliche Erfassung</h2></div><span class="status">Offen</span></header>
          <p>Zu Beginn erfassen wir dich als neue Trainerin oder neuen Trainer. Die Jugendleitung teilt dir dafür den vereinbarten, geschützten Übermittlungsweg mit.</p>
          <div class="detail-grid">
            <section><h3>Persönliche Angaben</h3><ul><li>Vor- und Nachname</li><li>Geburtsdatum und Anschrift</li><li>Mobilnummer und E-Mail-Adresse</li><li>Mannschaft und vorgesehene Funktion</li><li>Bereits Mitglied im Verein: ja oder nein</li></ul></section>
            <section><h3>Benötigte Nachweise</h3><div class="document-list"><span><i aria-hidden="true">ID</i>Personalausweis</span><span><i aria-hidden="true">FS</i>Führerschein</span></div><p>Bitte jeweils gut lesbar und vollständig hochladen. Sensible Dokumente nicht unaufgefordert per normaler E-Mail versenden.</p></section>
          </div>
          <aside class="privacy-note"><strong>Datenschutz</strong><span>Die Dokumente dienen ausschließlich der internen Erfassung und – beim Führerschein – der Prüfung für die Fahrzeugnutzung. Details zur Ablage und Löschung klärt die Jugendleitung beim Start.</span></aside>
          <button class="step-toggle" type="button" aria-pressed="false"><span class="check" aria-hidden="true">✓</span><span class="toggle-label">Als erledigt markieren</span></button>
        </div>
      </article>

      <article class="step-card" id="schritt-2" data-step="2">
        <div class="step-number"><span>02</span><i></i></div>
        <div class="step-body">
          <header><div><small>Verein & Jugendschutz</small><h2>Formalitäten klären</h2></div><span class="status">Offen</span></header>
          <p>Wir prüfen deine Vereinsmitgliedschaft und klären alle Unterlagen, die für die Arbeit mit Kindern und Jugendlichen benötigt werden.</p>
          <ul class="checklist"><li><span>Mitgliedschaft</span><b>Besteht bereits oder wird gemeinsam angestoßen</b></li><li><span>Jugendschutz</span><b>Erweitertes Führungszeugnis beziehungsweise erforderliche Nachweise klären</b></li><li><span>Vereinsgrundlagen</span><b>Ansprechpersonen, Leitlinien und wichtige Abläufe kennenlernen</b></li></ul>
          <button class="step-toggle" type="button" aria-pressed="false"><span class="check" aria-hidden="true">✓</span><span class="toggle-label">Als erledigt markieren</span></button>
        </div>
      </article>

      <article class="step-card" id="schritt-3" data-step="3">
        <div class="step-number"><span>03</span><i></i></div>
        <div class="step-body">
          <header><div><small>Organisation</small><h2>TimeTree einrichten</h2></div><span class="status">Offen</span></header>
          <p>TimeTree ist unser gemeinsamer Kalender für die Administration. Du erhältst die Einladung und wirst dem passenden Teamkalender zugeordnet.</p>
          <div class="info-stripe"><span>Training</span><span>Spiele & Turniere</span><span>Teamtermine</span><span>Busbelegung</span></div>
          <p class="hint"><strong>Wichtig:</strong> Termine vollständig und frühzeitig eintragen, damit Jugendleitung, Teams und Ressourcen verlässlich planen können.</p>
          <button class="step-toggle" type="button" aria-pressed="false"><span class="check" aria-hidden="true">✓</span><span class="toggle-label">Als erledigt markieren</span></button>
        </div>
      </article>

      <article class="step-card" id="schritt-4" data-step="4">
        <div class="step-number"><span>04</span><i></i></div>
        <div class="step-body">
          <header><div><small>Zugang zum Gelände</small><h2>Persönlichen Schlüssel erhalten</h2></div><span class="status">Offen</span></header>
          <p>Jede Trainerin und jeder Trainer erhält einen eigenen Schlüssel. Die Ausgabe wird über das Schlüsselmanagement dokumentiert.</p>
          <div class="two-column"><section><strong>Bei der Übergabe</strong><p>Schlüsselnummer, berechtigte Bereiche und Rückgabe werden festgehalten.</p></section><section><strong>Im Alltag</strong><p>Schlüssel nicht weitergeben. Verlust bitte sofort an Schlüsselmanagement und Jugendleitung melden.</p></section></div>
          <button class="step-toggle" type="button" aria-pressed="false"><span class="check" aria-hidden="true">✓</span><span class="toggle-label">Als erledigt markieren</span></button>
        </div>
      </article>

      <article class="step-card" id="schritt-5" data-step="5">
        <div class="step-number"><span>05</span><i></i></div>
        <div class="step-body">
          <header><div><small>Spielbetrieb</small><h2>DFBnet-Zugang beantragen</h2></div><span class="status">Offen</span></header>
          <p>Den persönlichen DFBnet-Zugang beantragt der Verein für dich. Die Rechte werden passend zu deiner Mannschaft und Aufgabe vergeben.</p>
          <ol class="mini-flow"><li><span>1</span><div><strong>Antrag</strong><p>Jugendleitung gibt deine Daten und Rolle weiter.</p></div></li><li><span>2</span><div><strong>Freischaltung</strong><p>Du erhältst die Zugangsinformationen an deine E-Mail-Adresse.</p></div></li><li><span>3</span><div><strong>Einweisung</strong><p>Spielbericht und relevante Abläufe werden kurz erklärt.</p></div></li></ol>
          <button class="step-toggle" type="button" aria-pressed="false"><span class="check" aria-hidden="true">✓</span><span class="toggle-label">Als erledigt markieren</span></button>
        </div>
      </article>

      <article class="step-card final-step" id="schritt-6" data-step="6">
        <div class="step-number"><span>06</span><i></i></div>
        <div class="step-body">
          <header><div><small>Mobil mit dem Team</small><h2>Mannschaftsbus kennenlernen</h2></div><span class="status">Offen</span></header>
          <p>Der Mannschaftsbus steht grundsätzlich allen Teams zur Verfügung. Vor der ersten Fahrt erfolgt eine kurze Einweisung; die Nutzung wird verbindlich abgestimmt.</p>
          <div class="bus-rules"><span><b>01</b>Fahrt rechtzeitig abstimmen</span><span><b>02</b>Fahrberechtigung bestätigen lassen</span><span><b>03</b>Bus ordentlich zurückgeben</span><span><b>04</b>Schäden oder Probleme direkt melden</span></div>
          <button class="step-toggle" type="button" aria-pressed="false"><span class="check" aria-hidden="true">✓</span><span class="toggle-label">Als erledigt markieren</span></button>
        </div>
      </article>
    </section>

    <section class="finish-section">
      <div class="shell finish-card">
        <div><p class="eyebrow dark"><span></span> Fragen oder etwas fehlt?</p><h2>Die Jugendleitung hilft dir weiter.</h2><p>Wenn ein Zugang noch nicht angekommen ist, eine Übergabe offen ist oder du bei einem Schritt unsicher bist, melde dich direkt bei uns.</p></div>
        <a href={contactPath}>Jugendleitung kontaktieren <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const storageKey = 'bsv-trainer-onboarding-v1';
  const cards = [...document.querySelectorAll<HTMLElement>('.step-card[data-step]')];
  const count = document.querySelector<HTMLElement>('#progress-count');
  const bar = document.querySelector<HTMLElement>('#progress-bar');
  const copy = document.querySelector<HTMLElement>('#progress-copy');

  let completed: string[] = [];
  try {
    const stored = JSON.parse(localStorage.getItem(storageKey) ?? '[]');
    if (Array.isArray(stored)) completed = stored.filter((step): step is string => typeof step === 'string');
  } catch {}

  const render = () => {
    cards.forEach((card) => {
      const step = card.dataset.step ?? '';
      const done = completed.includes(step);
      card.classList.toggle('is-complete', done);
      const button = card.querySelector<HTMLButtonElement>('.step-toggle');
      const label = card.querySelector<HTMLElement>('.toggle-label');
      const status = card.querySelector<HTMLElement>('.status');
      button?.setAttribute('aria-pressed', String(done));
      if (label) label.textContent = done ? 'Erledigt' : 'Als erledigt markieren';
      if (status) status.textContent = done ? 'Erledigt' : 'Offen';
    });

    const total = completed.length;
    if (count) count.textContent = String(total);
    if (bar) bar.style.width = `${(total / cards.length) * 100}%`;
    if (copy) copy.textContent = total === cards.length
      ? 'Alles erledigt – willkommen im Trainerteam!'
      : total === 0 ? 'Bereit für den ersten Schritt.' : `Noch ${cards.length - total} ${cards.length - total === 1 ? 'Schritt' : 'Schritte'} bis zum Ziel.`;
  };

  cards.forEach((card) => card.querySelector('.step-toggle')?.addEventListener('click', () => {
    const step = card.dataset.step ?? '';
    completed = completed.includes(step) ? completed.filter((value) => value !== step) : [...completed, step];
    localStorage.setItem(storageKey, JSON.stringify(completed));
    render();
  }));

  render();
</script>

