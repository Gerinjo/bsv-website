---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import TrainerOnboardingForm from '../components/TrainerOnboardingForm.astro';
import TrainerOnboardingAccess from '../components/TrainerOnboardingAccess.astro';
import { withBase } from '../utils/paths';
const contactPath = withBase('/kontakt?thema=youth-leadership');
const endpoint = import.meta.env.PUBLIC_TRAINER_ONBOARDING_ENDPOINT || 'https://api.bsvnordstern.de/api/trainer-onboarding.php';
---

<Layout title="Trainer-Onboarding | BSV Nordstern Radolfzell" description="Persönliche Daten, Mitgliedschaft, Unterlagen und Erklärungen für deinen Start im Trainerteam des BSV Nordstern." noindex>
  <TrainerOnboardingAccess endpoint={endpoint} />
  <div id="trainer-onboarding-content" hidden inert>
  <Header />
  <main class="onboarding-page">
    <header class="onboarding-hero">
      <div class="shell"><p class="eyebrow">Trainer-Onboarding · BSV Nordstern</p><h1>Dein Start.<br /><em>Alles an einem Ort.</em></h1><p>Hier erfassen wir deine persönlichen Daten, die Unterlagen für deine Mitgliedschaft und die Angaben für deinen Trainervertrag.</p></div>
    </header>
    <div class="shell document-layout">
      <aside class="document-intro">
        <p class="eyebrow">Deine Unterlagen</p><h2>Gut vorbereitet<br />ins Trainerteam.</h2><p>Fülle das Formular in Ruhe aus und unterschreibe am Ende deine Trainerunterlagen. Wenn du noch kein Mitglied bist, gilt diese Unterschrift auch für deinen Mitgliedsantrag.</p>
        <nav aria-label="Inhalt des Onboarding-Formulars"><a href="#trainer-person">Persönliche Daten</a><a href="#trainer-ausweis">Personalausweis</a><a href="#trainer-mitgliedschaft">Mitgliedschaft</a><a href="#trainer-aufgabe">Mannschaft und Rolle</a><a href="#trainer-vertragsdaten">Kontoverbindung</a><a href="#trainer-kleidung">Trainerkleidung und Größen</a><a href="#trainer-bus">Mannschaftsbus und Führerschein</a><a href="#trainer-erklaerungen">Führungszeugnis und Erklärungen</a><a href="#trainer-unterschrift">Unterschrift und Versand</a></nav>
        <p class="help-copy">Bei Fragen hilft dir die <a href={contactPath}>Jugendleitung</a>.</p>
      </aside>
      <div class="onboarding-document"><TrainerOnboardingForm /></div>
    </div>
    <section class="shell organisation" aria-labelledby="organisation-title">
      <p class="eyebrow">Dein Start im Alltag</p><h2 id="organisation-title">Das klären wir anschließend gemeinsam.</h2>
      <div class="organisation-grid">
        <article><h3>Mannschafts-App</h3><p>G- und F-Jugend nutzen Spond. E-, D-, C-, B- und A-Jugend nutzen Teampunkt. Die passenden Installationslinks erhältst du in deiner Begrüßungs-Mail.</p></article>
        <article><h3>Schlüssel</h3><p>Deinen persönlichen Schlüssel übergibt das Schlüsselmanagement. Berechtigungen und Rückgabe werden dokumentiert.</p></article>
        <article><h3>DFBnet</h3><p>Ab der E-Jugend informieren wir unseren Administrator für deinen persönlichen Zugang. Er nimmt für die Einrichtung Kontakt mit dir auf.</p></article>
        <article><h3>Mannschaftsbus · TimeTree</h3><p>Wenn du den Bus fahren möchtest, installiere TimeTree. Nach der Führerscheinprüfung und Freigabe erhältst du die Einladung zum Buskalender.</p></article>
      </div>
    </section>
  </main>
  <Footer />
  </div>
</Layout>

<script>
  import { initTrainerOnboardingAccess } from '../scripts/trainer-onboarding-access.js';
  import { initTrainerOnboardingForm } from '../scripts/trainer-onboarding-form.js';
  const gate = document.querySelector<HTMLElement>('#trainer-onboarding-access');
  const content = document.querySelector<HTMLElement>('#trainer-onboarding-content');
  const form = document.querySelector<HTMLFormElement>('#trainer-onboarding-form');
  let initialized = false;
  if (gate && content && form) {
    initTrainerOnboardingAccess(gate, () => {
      content.hidden = false;
      content.removeAttribute('inert');
      if (!initialized) { initialized = true; initTrainerOnboardingForm(form); }
      else window.dispatchEvent(new Event('bsv:trainer-access-renewed'));
      form.querySelector<HTMLInputElement>('[name="firstName"]')?.focus({ preventScroll:true });
    });
    window.addEventListener('bsv:trainer-access-required', () => {
      content.hidden = true;
      content.setAttribute('inert','');
    });
  }
</script>

<style>
  #trainer-onboarding-content[hidden]{display:none}
  .onboarding-page{background:#f3f6f2;color:#14251a}.shell{width:min(1120px,calc(100% - 48px));margin-inline:auto}.onboarding-hero{padding:78px 0 84px;background:#092f20;color:white}.eyebrow{margin:0 0 16px;color:#17613a;font-size:.7rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.onboarding-hero .eyebrow{color:#f4d638}.onboarding-hero h1{margin:0;font-size:clamp(3.1rem,6vw,5.4rem);line-height:.98;letter-spacing:-.05em}.onboarding-hero em{color:#f4d638;font-family:Georgia,serif;font-weight:400}.onboarding-hero .shell>p:last-child{max-width:680px;margin:25px 0 0;color:#c9d9cf;line-height:1.75}.document-layout{display:grid;grid-template-columns:260px minmax(0,1fr);gap:55px;align-items:start;padding-block:70px 85px}.document-intro h2{margin:0;font-size:2rem;line-height:1.12;letter-spacing:-.035em}.document-intro>p:not(.eyebrow){color:#5f6f64;line-height:1.75;font-size:.9rem}.document-intro nav{display:grid;margin-top:28px;border-top:1px solid #ccd8ce}.document-intro nav a{padding:13px 0;border-bottom:1px solid #ccd8ce;color:#164f32;font-size:.82rem;font-weight:800;text-decoration:none}.document-intro nav a:hover{text-decoration:underline}.help-copy a{color:#164f32;font-weight:800}.onboarding-document{min-width:0;background:white;border-top:5px solid #164f32;box-shadow:0 12px 35px rgb(9 47 32 / 6%)}.organisation{padding-bottom:90px}.organisation>h2{margin:0 0 28px;font-size:clamp(1.8rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}.organisation-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.organisation article{padding:23px;background:#e8efe9}.organisation h3{margin:0 0 12px;color:#164f32;font-size:1rem}.organisation article p{margin:0;color:#5f6f64;line-height:1.65;font-size:.85rem}@media(max-width:950px){.document-layout{grid-template-columns:minmax(0,1fr);gap:30px}.document-intro nav{grid-template-columns:1fr 1fr;column-gap:25px}.organisation-grid{grid-template-columns:1fr 1fr}}@media(max-width:640px){.shell{width:calc(100% - 30px)}.onboarding-hero{padding:55px 0 60px}.document-layout{padding-block:42px 55px}.document-intro nav{grid-template-columns:1fr}.organisation-grid{grid-template-columns:1fr}.organisation{padding-bottom:55px}}
</style>
