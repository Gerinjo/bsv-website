---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import StadiumMagazineReader from '../../../components/StadiumMagazineReader.astro';
import { stadiumMagazines, type StadiumMagazine } from '../../../data/stadiumMagazines';
import { withBase } from '../../../utils/paths';

export function getStaticPaths() {
  return stadiumMagazines.map((magazine) => ({ params: { slug: magazine.slug }, props: { magazine } }));
}
interface Props { magazine: StadiumMagazine }
const { magazine } = Astro.props;
---

<Layout title={`Stadionheft · Ausgabe ${magazine.issue} · ${magazine.season} | BSV Nordstern Radolfzell`} description={`Blättere im Stadionheft des BSV vom ${magazine.dateLabel}: Ausgabe ${magazine.issue}, Saison ${magazine.season}.`}>
  <Header />
  <main>
    <div class="heading">
      <a href={withBase('/media/stadionheft')}>← Alle Ausgaben</a>
      <h1>Stadionheft</h1>
      <p>Ausgabe {magazine.issue} · Saison {magazine.season} · {magazine.dateLabel}</p>
    </div>
    <StadiumMagazineReader magazine={magazine} />
  </main>
  <Footer />
</Layout>

<style>
  main{padding:32px 24px 55px;background:#edf2ed}.heading{max-width:1240px;margin:0 auto 24px;color:#102b1d}.heading a{color:#164f32;font-size:.8rem;font-weight:750;text-decoration:none}.heading a:hover{text-decoration:underline}h1{margin:20px 0 10px;font-size:clamp(2rem,4vw,3rem);letter-spacing:-.04em}.heading p{margin:0;font-size:.85rem;line-height:1.6;color:#52665a}@media(max-width:600px){main{padding:24px 10px 35px}.heading{padding-inline:5px}}
</style>
