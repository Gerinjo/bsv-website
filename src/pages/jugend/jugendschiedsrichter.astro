---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';

const referees = [
  { name: 'Stefan Gastaudo', role: 'Ansprechpartner Jugendschiedsrichter', image: '/images/verein/personen/stefan-gastaudo.jpg', highlight: true },
  { name: 'Remo Schellhammer', role: 'Jugendschiedsrichter', image: '/images/verein/personen/remo-schellhammer.jpg' },
  { name: 'Leonardo Gastaudo', role: 'Jugendschiedsrichter', image: '/images/verein/personen/leonardo-gastaudo.jpg' },
  { name: 'Mia Julie Huber', role: 'Jugendschiedsrichterin', image: '/images/verein/personen/mia-julie-huber.jpg' },
  { name: 'Johannes Horn', role: 'Jugendschiedsrichter', image: '/images/verein/personen/johannes-horn.jpg' },
  { name: 'Sven Goldhagen', role: 'Schiedsrichter · Jugendtrainer U17 B-Juniorinnen', image: '/images/verein/personen/sven-goldhagen.jpg' },
];
---

<Layout title="Schiedsrichter & Jugendschiedsrichter | Junge Sterne | BSV Nordstern Radolfzell" description="Unsere Schiedsrichterinnen und Schiedsrichter aus der Jugendabteilung des BSV Nordstern Radolfzell.">
  <Header />
  <main class="referee-page">
    <section class="hero">
      <div class="shell hero-grid">
        <div>
          <a href={withBase('/jugend')}>← Zurück zu Junge Sterne</a>
          <span>Verantwortung übernehmen</span>
          <h1>Schiedsrichter &<br /><em>Jugendschiedsrichter.</em></h1>
          <p>Wer pfeift, übernimmt Verantwortung. Bei uns kommen junge Nachwuchsschiedsrichterinnen und -schiedsrichter genauso zum Einsatz wie Trainer, die zusätzlich Spiele leiten.</p>
        </div>
        <figure><img src={withBase('/images/jugend/schiedsrichter/7b4f53d574-WhatsApp_Bild_2024-05-29_um_16.44.07_afe27bc6.jpg')} alt="Schiedsrichter beim BSV Nordstern" /></figure>
      </div>
    </section>

    <section class="intro shell">
      <div><span>Fairness braucht Haltung</span><h2>Entscheiden.<br /><em>Verantwortung tragen.</em></h2></div>
      <div><p>Schiedsrichterinnen und Schiedsrichter sind ein unverzichtbarer Teil des Fußballs. Sie sorgen dafür, dass Spiele fair, verlässlich und mit gegenseitigem Respekt stattfinden.</p><p>Beim BSV möchten wir junge Menschen für diese Aufgabe begeistern – und zugleich diejenigen sichtbar machen, die zusätzlich zu ihrer Arbeit als Trainer auch Spiele pfeifen.</p></div>
    </section>

    <section class="team shell">
      <div class="team-head"><div><span>Unser Team</span><h2>Die Menschen<br />mit der Pfeife.</h2></div><p>Unterschiedliche Wege, eine gemeinsame Aufgabe: Fußball fair und verlässlich möglich machen.</p></div>
      <div class="grid">
        {referees.map((referee, index) => (
          <article class:list={["card", { highlight: referee.highlight }]}>
            <span class="number">0{index + 1}</span>
            <div class="portrait"><img src={withBase(referee.image)} alt={referee.name} loading="lazy" /></div>
            <div class="info"><h3>{referee.name}</h3><p>{referee.role}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="note shell">
      <div><span>Auch ohne klassische Laufbahn</span><h2>Pfeifen, wenn man gebraucht wird.</h2></div>
      <p>Sven Goldhagen ist Jugendtrainer beim BSV und hat sich zusätzlich dazu bereit erklärt, Spiele als Schiedsrichter zu leiten. Er ist dabei keine Ansprechperson für das Schiedsrichterwesen, sondern unterstützt den Spielbetrieb dort, wo seine Hilfe gebraucht wird.</p>
    </section>

    <section class="cta"><div class="shell"><div><span>Neue Perspektive gesucht?</span><h2>Werde Schiedsrichter:in.</h2><p>Du möchtest Verantwortung übernehmen und den Fußball einmal aus einer anderen Perspektive erleben? Sprich uns gerne an.</p></div><a href="mailto:Stefan.Gastaudo@bsvnordstern.de">Interesse anmelden ↗</a></div></section>
  </main>
  <Footer />
</Layout>

<style>
:root{--green:#092f20;--mid:#164f32;--yellow:#f4d638;--paper:#f4f7f4;--ink:#17251b}.shell{width:min(1120px,calc(100% - 48px));margin-inline:auto}.referee-page{background:var(--paper);color:var(--ink)}.hero{padding:80px 0 90px;background:linear-gradient(135deg,#061e14,#164f32);color:#fff}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center}.hero a{color:var(--yellow);font-size:.75rem;font-weight:900;text-decoration:none}.hero span,.intro span,.team-head span,.note span,.cta span{display:block;margin-top:42px;color:var(--yellow);font-size:.66rem;font-weight:950;letter-spacing:.14em;text-transform:uppercase}.hero h1{margin:14px 0 24px;font-size:clamp(3.3rem,6vw,6rem);line-height:.9;letter-spacing:-.055em}.hero h1 em,.intro h2 em{font-family:Georgia,serif;font-weight:400;color:var(--yellow)}.hero p{max-width:650px;color:#d0ded5;line-height:1.75;font-size:1.05rem}.hero figure{margin:0;overflow:hidden;background:#fff;box-shadow:18px 18px 0 rgb(244 214 56 / 20%)}.hero figure img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}.intro{padding:90px 0;display:grid;grid-template-columns:.9fr 1.1fr;gap:80px}.intro span,.team-head span,.note span{margin:0;color:var(--mid)}.intro h2,.team-head h2,.note h2,.cta h2{margin:10px 0 0;font-size:clamp(2.7rem,4.8vw,4.8rem);line-height:.94;letter-spacing:-.045em}.intro p,.note p{margin:0 0 18px;color:#617067;line-height:1.82}.team{padding-bottom:95px}.team-head{display:flex;justify-content:space-between;align-items:end;gap:50px;margin-bottom:40px}.team-head>p{max-width:360px;margin:0;color:#6b7a71;line-height:1.65}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.card{position:relative;min-height:360px;padding:28px;display:flex;flex-direction:column;align-items:center;text-align:center;background:#edf2ee;border-radius:8px}.card.highlight{background:var(--yellow)}.number{position:absolute;top:18px;left:20px;color:var(--green);font-size:.66rem;font-weight:950}.portrait{width:160px;aspect-ratio:1;margin:30px auto 24px;border:5px solid #fff;border-radius:50%;overflow:hidden;background:var(--green);box-shadow:0 8px 25px rgb(9 47 32 / 14%)}.portrait img{width:100%;height:100%;object-fit:cover;object-position:50% 20%}.info{margin-top:auto}.info h3{margin:0 0 7px;font-size:1.25rem}.info p{margin:0;color:#65756b;font-size:.82rem;line-height:1.45}.highlight .info p{color:#405243}.note{margin-bottom:95px;padding:55px 60px;display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;background:#fff;border-left:5px solid var(--yellow)}.note p{align-self:center;margin:0}.cta{padding:75px 0;background:var(--yellow)}.cta>.shell{display:grid;grid-template-columns:1fr auto;gap:60px;align-items:center}.cta span{margin:0;color:var(--green)}.cta h2{color:var(--green)}.cta p{max-width:700px;color:#405243;line-height:1.7}.cta a{padding:14px 18px;background:var(--green);color:#fff;font-size:.8rem;font-weight:900;text-decoration:none;white-space:nowrap}@media(max-width:820px){.hero-grid,.intro,.note,.cta>.shell{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.team-head{align-items:flex-start;flex-direction:column}.hero figure{max-width:620px}}@media(max-width:560px){.shell{width:min(100% - 32px,1120px)}.hero{padding:60px 0 75px}.hero h1{font-size:3.45rem}.grid{grid-template-columns:1fr}.note{padding:38px 28px}.cta a{justify-self:start;white-space:normal}}
</style>
