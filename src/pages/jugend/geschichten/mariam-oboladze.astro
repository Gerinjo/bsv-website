---
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import Layout from '../../../layouts/Layout.astro';
import { withBase } from '../../../utils/paths';

const mariamImage = 'https://www.suedkurier.de/storage/image/1/3/8/8/14118831_shift-644x362_1BUvzZ_Hgncje.jpg';
const storyArticle = 'https://www.suedkurier.de/regionalsport/regionalsport-bodensee-west/georgiens-verband-bekommt-videos-von-mariam-oboladze-und-macht-die-singenerin-zur-nationalspielerin%3Bart2783%2C11918263';
const debutArticle = 'https://www.suedkurier.de/regionalsport/regionalsport-bodensee-west/debuet-fuer-georgien-mariam-oboladze-verwirklicht-sich-ihren-traum-als-nationalspielerin%3Bart2783%2C11949542';
const u19Article = 'https://hegauerfv.de/2024/12/09/mariam-oboladze-bei-georgien/';
---

<Layout title="Vom BSV ins Nationaltrikot | Mariam Oboladze" description="Die Geschichte von Mariam Oboladze: von den B-Juniorinnen des BSV Nordstern Radolfzell in die georgische U17-Nationalmannschaft.">
  <Header />
  <main class="story-page">
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy"><a href={withBase('/jugend')}>← Zurück zu Junge Sterne</a><span>Geschichten · Mädchenfußball</span><h1>Vom BSV<br /><em>ins Nationaltrikot.</em></h1><p>Manchmal beginnt eine große Fußballgeschichte auf einem ganz normalen Trainingsplatz. Für Mariam Oboladze führte der Weg von den B-Juniorinnen des BSV Nordstern bis in die georgische U17-Nationalmannschaft.</p></div>
        <figure class="hero-photo"><img src={mariamImage} alt="Mariam Oboladze auf dem BSV-Nordstern-Gelände" /><figcaption>Foto: Dirk Salzmann / Südkurier · Verwendung mit Genehmigung</figcaption></figure>
      </div>
    </section>

    <section class="lead shell"><div><span>Eine BSV-Geschichte</span><h2>Kapitänin.<br />Mittelfeldspielerin.<br /><em>Nationalspielerin.</em></h2></div><div><p>Mariam spielte beim BSV Nordstern im zentralen Mittelfeld und führte unsere B-Juniorinnen als Spielführerin aufs Feld. In der Saison 2023/24 trat die Mannschaft in der Verbandsliga an. Ihre Stärken: Dribbling, Abschluss und der Mut, Verantwortung zu übernehmen.</p><p>Dann nahm die Geschichte eine außergewöhnliche Wendung. Mariams Onkel schickte Videoclips ihrer Spiele an den georgischen Fußballverband. Aus einer Idee wurde plötzlich eine Einladung: Mariam sollte sich bei Georgiens U17 zeigen.</p></div></section>

    <section class="timeline"><div class="shell"><span class="eyebrow">Der Weg</span><div class="steps"><article><b>01</b><small>BSV Nordstern</small><h3>B-Juniorinnen</h3><p>Mariam entwickelt sich beim BSV zur Leistungsträgerin und Spielführerin der B-Juniorinnen.</p></article><article><b>02</b><small>Videos nach Georgien</small><h3>Eine Chance entsteht</h3><p>Videoclips erreichen den georgischen Fußballverband – und wecken dort Interesse.</p></article><article><b>03</b><small>März 2024</small><h3>EM-Qualifikation</h3><p>Die Einladung zur georgischen U17 führt Mariam zu den Qualifikationsspielen auf die Färöer-Inseln.</p></article><article><b>04</b><small>23. März 2024</small><h3>Das Debüt</h3><p>Mariam kommt gegen Lettland zu ihrem ersten Einsatz für Georgiens U17 – als Spielerin des BSV Nordstern Radolfzell.</p></article></div></div></section>

    <section class="moment shell"><div class="moment-number">🇬🇪</div><div><span>Der besondere Moment</span><h2>Plötzlich wird aus einem Traum ein Länderspiel.</h2><p>Auf den Färöer-Inseln trug Mariam erstmals das Nationaltrikot. Für sie persönlich war es ein großer Schritt – und für uns beim BSV eine Geschichte, die zeigt, wohin Begeisterung, Entwicklung und Mut führen können.</p><p>Im Sommer 2024 wechselte Mariam zum Hegauer FV. Ihre internationale Geschichte ging weiter: Später folgte auch die Berufung in die georgische U19.</p></div></section>

    <section class="reading"><div class="shell"><div><span>Die ganze Geschichte</span><h2>Nachlesen.</h2></div><div class="links"><a href={storyArticle} target="_blank" rel="noopener noreferrer"><small>Südkurier · 1. März 2024</small><strong>Wie Mariam zur Nationalspielerin wurde</strong><b>↗</b></a><a href={debutArticle} target="_blank" rel="noopener noreferrer"><small>Südkurier · 25. März 2024</small><strong>Das Debüt für Georgien</strong><b>↗</b></a><a href={u19Article} target="_blank" rel="noopener noreferrer"><small>Hegauer FV</small><strong>Der Weg geht weiter: Georgien U19</strong><b>↗</b></a></div></div></section>
  </main>
  <Footer />
</Layout>

<style>
:root{--green:#092f20;--mid:#164f32;--yellow:#f4d638;--paper:#f4f7f4}.shell{width:min(1120px,calc(100% - 48px));margin-inline:auto}.story-page{background:var(--paper);color:#17251b}.hero{padding:80px 0 90px;background:linear-gradient(135deg,#061e14,#164f32);color:#fff}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center}.hero-copy>a{color:var(--yellow);font-size:.75rem;font-weight:900;text-decoration:none}.hero-copy>span,.lead span,.moment span,.reading span,.eyebrow{display:block;margin-top:45px;color:var(--yellow);font-size:.65rem;font-weight:950;letter-spacing:.14em;text-transform:uppercase}.hero h1{margin:14px 0 25px;font-size:clamp(3.5rem,6.6vw,6.6rem);line-height:.88;letter-spacing:-.055em}.hero h1 em,.lead h2 em{font-family:Georgia,serif;font-weight:400;color:var(--yellow)}.hero p{max-width:650px;color:#d0ded5;font-size:1.05rem;line-height:1.75}.hero-photo{margin:0;background:#fff;box-shadow:18px 18px 0 rgb(244 214 56 / 20%)}.hero-photo img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}.hero-photo figcaption{padding:10px 14px;color:#66746b;font-size:.64rem}.lead{padding:90px 0;display:grid;grid-template-columns:.9fr 1.1fr;gap:80px}.lead span{margin:0;color:var(--mid)}.lead h2,.moment h2,.reading h2{margin:10px 0 0;font-size:clamp(2.6rem,4.7vw,4.7rem);line-height:.94;letter-spacing:-.045em}.lead p,.moment p{margin:0 0 18px;color:#617067;line-height:1.85}.timeline{padding:85px 0;background:var(--green);color:#fff}.eyebrow{margin:0}.steps{margin-top:28px;display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.steps article{min-height:280px;padding:28px;border-top:4px solid var(--yellow);background:rgb(255 255 255 / 6%)}.steps b{color:var(--yellow);font-size:2rem}.steps small{display:block;margin-top:42px;color:#9db4a6;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.steps h3{margin:8px 0 14px;font-size:1.35rem}.steps p{color:#b9cbbf;line-height:1.65}.moment{padding:95px 0;display:grid;grid-template-columns:.45fr 1.55fr;gap:75px;align-items:start}.moment-number{font-size:8rem;line-height:1}.moment span{margin:0;color:var(--mid)}.reading{padding:85px 0;background:var(--yellow)}.reading>.shell{display:grid;grid-template-columns:.65fr 1.35fr;gap:80px}.reading span{margin:0;color:var(--green)}.links{display:grid;gap:8px}.links a{padding:20px 22px;display:grid;grid-template-columns:1fr auto;gap:5px 20px;background:#fff;color:var(--green);text-decoration:none}.links small{grid-column:1;margin:0;color:#6c796f;font-size:.65rem;text-transform:uppercase;letter-spacing:.08em}.links strong{font-size:1rem}.links b{grid-column:2;grid-row:1/3;align-self:center;font-size:1.2rem}@media(max-width:850px){.hero-grid,.lead,.moment,.reading>.shell{grid-template-columns:1fr}.steps{grid-template-columns:1fr 1fr}.hero-photo{max-width:620px}.moment-number{font-size:5rem}}@media(max-width:560px){.shell{width:min(100% - 32px,1120px)}.hero{padding:60px 0 75px}.hero h1{font-size:3.5rem}.steps{grid-template-columns:1fr}.lead,.moment{padding:70px 0}.reading{padding:70px 0}}
</style>
