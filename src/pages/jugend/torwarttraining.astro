---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { withBase } from '../../utils/paths';
import { goalkeeperTraining } from '../../data/goalkeeperTraining';

const contactUrl = withBase('/kontakt?thema=goalkeeping');
const skills = [
  { number: '01', title: 'Sicher zugreifen.', text: 'Fangtechnik und eine gute Grundstellung geben dir Sicherheit – vom ersten Ball bis zur letzten Parade.' },
  { number: '02', title: 'Schnell reagieren.', text: 'Mit Koordination, Reaktion und dem richtigen Timing bist du bereit, wenn es darauf ankommt.' },
  { number: '03', title: 'Mutig mitspielen.', text: 'Stellungsspiel und klare Entscheidungen helfen dir, dein Tor zu verteidigen und deinem Team Rückhalt zu geben.' },
];
---

<Layout title="Torwarttraining | Junge Sterne | BSV Nordstern Radolfzell" description="Dein Tor. Dein Moment. Torwarttraining mit Stefan Gastaudo: mittwochs 17:30–18:30 Uhr am 5-m-Tor und 18:45–19:45 Uhr am 7,32-m-Tor. Jetzt Kontakt aufnehmen.">
  <Header />
  <main class="keeper-page">
    <section class="keeper-hero" aria-labelledby="keeper-title">
      <div class="shell">
        <a class="back-link" href={withBase('/jugend')}>← Junge Sterne</a>
        <div class="hero-grid">
          <div class="hero-copy">
            <span class="eyebrow"><span class="live-dot" aria-hidden="true"></span> Torwarttraining beim BSV</span>
            <h1 id="keeper-title">Dein Tor.<br /><em>Dein Moment.</em></h1>
            <p>Fliegen. Fangen. Für dein Team da sein. Entdecke, was in dir steckt – mit gezieltem Training für junge Torhüterinnen und Torhüter.</p>
            <div class="hero-actions">
              <a class="button button-yellow" href={contactUrl}>Training anfragen <span aria-hidden="true">↗</span></a>
              <a class="text-link" href="#trainingszeiten">Zu den Trainingszeiten <span aria-hidden="true">↓</span></a>
            </div>
            <div class="hero-facts"><span>Jeden Mittwoch</span><span>5 m & 7,32 m</span><span>Mit Stefan Gastaudo</span></div>
          </div>
          <div class="goal-visual" aria-hidden="true">
            <div class="visual-top"><span>Zwischen den Pfosten</span><span>BSV / 01</span></div>
            <svg class="goal-art" viewBox="0 0 520 430" fill="none">
              <defs>
                <pattern id="keeper-net" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" stroke="#b4d2b7" stroke-opacity=".28" stroke-width="1" /></pattern>
                <radialGradient id="keeper-glow"><stop stop-color="#b8d057" stop-opacity=".3"/><stop offset="1" stop-color="#b8d057" stop-opacity="0"/></radialGradient>
              </defs>
              <circle cx="295" cy="200" r="210" fill="url(#keeper-glow)" />
              <path d="M65 340L425 340L477 391H16L65 340Z" fill="#0a2c20" stroke="#74997e" stroke-opacity=".3" />
              <path d="M111 128H449V324H111Z" fill="url(#keeper-net)" stroke="#86aa8c" stroke-width="2" />
              <path d="M64 170L111 128M405 170L449 128M405 364L449 324M64 364L111 324" stroke="#9bbaa0" stroke-width="2"/>
              <path d="M65 365V169H405V365" stroke="#f3f6e8" stroke-width="9" stroke-linejoin="round"/>
              <path d="M104 310C177 316 230 285 270 225" stroke="#f4d638" stroke-width="3" stroke-linecap="round" stroke-dasharray="7 10"/>
              <path d="M259 228L277 213L276 237" stroke="#f4d638" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <g transform="translate(306 174) rotate(-18)">
                <circle r="53" fill="#f4d638"/>
                <path d="M0 -22L22 -7L14 19H-14L-22 -7Z" fill="#123d28"/>
                <path d="M0 -22V-51M22 -7L49 -16M14 19L30 42M-14 19L-30 42M-22 -7L-49 -16" stroke="#123d28" stroke-width="3"/>
                <path d="M-17 -49L0 -39L17 -49M50 -5L38 -18L43 -32M40 35L22 34L19 49M-19 49L-22 34L-40 35M-43 -32L-38 -18L-50 -5" stroke="#123d28" stroke-width="3"/>
              </g>
              <path d="M368 84V108M356 96H380M183 77V93M175 85H191" stroke="#f4d638" stroke-width="2" />
            </svg>
            <div class="visual-bottom"><span>Bereit für deine<br /><strong>nächste Parade?</strong></span><span class="visual-arrow">↗</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="training-section shell" id="trainingszeiten" aria-labelledby="training-title">
      <div class="section-heading"><div><span class="eyebrow">Dein Mittwoch. Dein Training.</span><h2 id="training-title">Zwei Tore.<br /><em>Ein Ziel: besser werden.</em></h2></div><p>Eine Stunde ganz für dein Torwartspiel. Wähle deine Gruppe und stimme den Einstieg mit Stefan ab.</p></div>
      <div class="training-grid">
        <article class="training-card">
          <div class="group-top"><span>Gruppe 01</span><span class="day-badge">Mittwoch</span></div>
          <h3>5<span> m</span><small>Torbreite</small></h3>
          <p class="training-time"><time datetime="17:30">17:30</time><span>–</span><time datetime="18:30">18:30</time><small>Uhr</small></p>
          <p class="training-location">{goalkeeperTraining[0].location}</p>
          <div class="group-description"><strong>E-Jugend, D-Jugend & D-Juniorinnen</strong><p>Für Torhüterinnen und Torhüter bis einschließlich 160 cm Körpergröße.</p></div>
          <a href={contactUrl}>Für diese Gruppe anfragen <span aria-hidden="true">↗</span></a>
        </article>
        <article class="training-card training-card-dark">
          <div class="group-top"><span>Gruppe 02</span><span class="day-badge">Mittwoch</span></div>
          <h3>7,32<span> m</span><small>Torbreite</small></h3>
          <p class="training-time"><time datetime="18:45">18:45</time><span>–</span><time datetime="19:45">19:45</time><small>Uhr</small></p>
          <p class="training-location">{goalkeeperTraining[1].location}</p>
          <div class="group-description"><strong>Training am großen Tor</strong><p>Auch für Torhüterinnen und Torhüter über 160 cm aus der ersten Gruppe. Die Einteilung besprichst du mit Stefan.</p></div>
          <a href={contactUrl}>Für diese Gruppe anfragen <span aria-hidden="true">↗</span></a>
        </article>
      </div>
      <p class="training-note"><span aria-hidden="true">↗</span> Unsicher, welche Gruppe passt? Frag Stefan – gemeinsam findet ihr den richtigen Einstieg.</p>
    </section>

    <section class="skills-section shell" aria-labelledby="skills-title">
      <div class="section-heading"><div><span class="eyebrow">Mehr als Bälle halten</span><h2 id="skills-title">Werde sicher.<br /><em>Und trau dich mehr.</em></h2></div><p>Technik, Koordination und Selbstvertrauen: Wir trainieren altersgerecht und mit Freude an deiner Entwicklung.</p></div>
      <div class="skills-grid">{skills.map((skill) => <article><span>{skill.number}</span><h3>{skill.title}</h3><p>{skill.text}</p></article>)}</div>
    </section>

    <section class="coach-section" aria-labelledby="coach-title">
      <div class="shell coach-grid">
        <div class="coach-portrait"><span class="portrait-word" aria-hidden="true">COACH</span><img src={withBase('/images/verein/personen/transparent/stefan-gastaudo-transparent.png')} width="667" height="1000" alt="Stefan Gastaudo, Torwarttrainer beim BSV Nordstern" loading="lazy" /><span class="license-badge">C-Lizenz</span></div>
        <div class="coach-copy"><span class="eyebrow">Dein Trainer. Dein Ansprechpartner.</span><h2 id="coach-title">Stefan<br /><em>Gastaudo.</em></h2><p class="coach-role">Torwarttrainer · BSV Nordstern</p><p>Stefan begleitet dich auf deinem Weg zwischen den Pfosten. Mit gezieltem Training hilft er dir, deine Technik zu verbessern, sicherer zu entscheiden und deine Stärken weiterzuentwickeln.</p><p>Du möchtest mitmachen oder hast eine Frage zur passenden Gruppe? Melde dich direkt bei ihm.</p>
          <div class="coach-contacts">
            <a href={contactUrl}><span class="contact-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg></span><span><small>E-Mail über Kontaktformular</small><strong>Stefan eine Nachricht schreiben</strong></span><b aria-hidden="true">↗</b></a>
            <a href="tel:+491795111126"><span class="contact-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M6 3H3v3c0 8.3 6.7 15 15 15h3v-5l-5-2-2 3a16 16 0 0 1-7-7l3-2-2-5H6Z"/></svg></span><span><small>Mobil</small><strong>0179 5111126</strong></span><b aria-hidden="true">↗</b></a>
          </div>
        </div>
      </div>
    </section>

    <section class="join-section shell"><span class="eyebrow">Dein Platz ist zwischen den Pfosten.</span><h2>Lust auf die<br /><em>nächste Parade?</em></h2><p>Sag uns, in welcher Mannschaft du spielst und wie groß du bist. Stefan meldet sich bei dir und klärt alles Weitere.</p><a class="button button-green" href={contactUrl}>Kontaktanfrage senden <span aria-hidden="true">↗</span></a></section>
  </main>
  <Footer />
</Layout>

<style>
  .keeper-page { --green:#103e2a; --dark:#082b1d; --yellow:#f4d638; --paper:#f5f6ef; color:var(--dark); background:var(--paper); }
  .keeper-page * { box-sizing:border-box; }
  .shell { width:min(1160px,calc(100% - 48px)); margin-inline:auto; }
  a { color:inherit; }
  a:focus-visible { outline:3px solid #cdab00; outline-offset:6px; }
  .keeper-hero { padding:35px 0 65px; color:#fff; background:var(--dark); overflow:hidden; }
  .back-link { color:#b8cabc; font-size:.8rem; text-decoration:none; }
  .hero-grid { display:grid; grid-template-columns:1.15fr 1fr; align-items:center; gap:55px; margin-top:54px; }
  .eyebrow { display:block; font-size:.7rem; font-weight:850; letter-spacing:.13em; text-transform:uppercase; line-height:1.6; }
  .hero-copy .eyebrow { color:var(--yellow); }
  .live-dot { display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--yellow); margin:0 8px 1px 0; }
  h1 { margin:24px 0; font-size:clamp(3.5rem,6.8vw,6.4rem); letter-spacing:-.065em; line-height:1.01; font-weight:850; }
  h1 em,h2 em { font-family:Georgia,serif; font-weight:400; }
  h1 em { color:var(--yellow); }
  .hero-copy>p { max-width:490px; color:#c5d4c9; font-size:1.05rem; line-height:1.8; }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:25px; margin-top:30px; }
  .button { display:inline-flex; align-items:center; justify-content:space-between; gap:24px; min-height:52px; padding:16px 22px; font-size:.82rem; font-weight:850; text-decoration:none; border-radius:3px; transition:transform .2s,background .2s; }
  .button:hover { transform:translateY(-2px); }
  .button-yellow { color:var(--dark); background:var(--yellow); }
  .button-green { color:white; background:var(--green); }
  .text-link { font-size:.79rem; text-underline-offset:6px; }
  .text-link span { margin-left:6px; }
  .hero-facts { display:flex; flex-wrap:wrap; gap:10px 17px; margin-top:38px; font-size:.66rem; color:#b8cabc; }
  .hero-facts span+span::before { content:'+'; margin-right:17px; color:var(--yellow); }
  .goal-visual { position:relative; border:1px solid #52745b; border-radius:140px 140px 4px 4px; background:linear-gradient(150deg,#1b4b33,#0e3425); padding:40px 28px 24px; }
  .visual-top { display:flex; justify-content:space-between; gap:10px; padding:20px 16px 0; color:#b3c7b6; text-transform:uppercase; font-size:.57rem; letter-spacing:.1em; }
  .goal-art { display:block; width:calc(100% + 35px); margin:0 -18px; }
  .visual-bottom { display:flex; align-items:center; justify-content:space-between; border-top:1px solid #52745b; padding-top:20px; color:#bfd2c3; font-size:.8rem; line-height:1.6; }
  .visual-bottom strong { color:white; font-size:1.1rem; }
  .visual-arrow { display:grid; place-items:center; width:44px; height:44px; border-radius:50%; background:var(--yellow); color:var(--dark); font-size:1.5rem; }
  .training-section { padding:85px 0 70px; scroll-margin-top:110px; }
  .section-heading { display:grid; grid-template-columns:1.25fr .75fr; align-items:end; gap:65px; margin-bottom:35px; }
  h2 { margin:14px 0 0; font-size:clamp(2.3rem,4.1vw,3.8rem); line-height:1.08; letter-spacing:-.045em; }
  .section-heading>p { max-width:365px; color:#5c6b60; line-height:1.8; margin:0; }
  .training-grid { display:grid; grid-template-columns:1fr 1fr; gap:22px; }
  .training-card { display:flex; flex-direction:column; padding:30px 35px; border:1px solid #cfd9cb; border-radius:5px; background:#e8eede; }
  .group-top { display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:.63rem; font-weight:800; text-transform:uppercase; letter-spacing:.1em; }
  .day-badge { background:#fff9; padding:8px 11px; border-radius:3px; }
  .training-card h3 { margin:25px 0 0; font-size:4.4rem; font-weight:850; letter-spacing:-.065em; line-height:1; }
  .training-card h3>span { font-size:2rem; font-weight:500; }
  .training-card h3>small { display:block; margin-top:9px; font-size:.66rem; font-weight:650; letter-spacing:.1em; text-transform:uppercase; }
  .training-time { display:flex; align-items:baseline; flex-wrap:wrap; gap:10px; margin:28px 0 23px; font-size:clamp(1.7rem,3.3vw,2.7rem); font-weight:750; letter-spacing:-.04em; }
  .training-time>span { font-weight:400; opacity:.5; }
  .training-time>small { font-size:.82rem; letter-spacing:0; font-weight:600; }
  .training-location { margin:-8px 0 23px; font-size:.85rem; line-height:1.6; font-weight:650; }
  .group-description { border-top:1px solid #bdcbb9; padding-top:22px; }
  .group-description strong { font-size:.9rem; }
  .group-description p { font-size:.86rem; line-height:1.7; color:#53674f; margin:9px 0 25px; }
  .training-card>a { display:flex; justify-content:space-between; gap:20px; margin-top:auto; font-size:.79rem; font-weight:850; text-decoration:none; min-height:36px; align-items:center; }
  .training-card>a:hover { text-decoration:underline; text-underline-offset:5px; }
  .training-card-dark { background:var(--green); color:white; border-color:var(--green); }
  .training-card-dark .day-badge { background:#ffffff14; color:#d8e5db; }
  .training-card-dark h3 { color:var(--yellow); }
  .training-card-dark .group-description { border-color:#55745d; }
  .training-card-dark .group-description p { color:#c0d3c4; }
  .training-card-dark>a { color:var(--yellow); }
  .training-note { font-size:.78rem; color:#5c6b60; line-height:1.7; margin:21px 0 0; }
  .training-note>span { margin-right:9px; color:var(--green); }
  .skills-section { padding:20px 0 90px; }
  .skills-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:30px; }
  .skills-grid article { padding-top:25px; border-top:1px solid #cfd9cb; }
  .skills-grid article>span { color:#587453; font-size:.7rem; font-weight:850; }
  .skills-grid h3 { font-size:1.2rem; letter-spacing:-.02em; margin:17px 0 10px; }
  .skills-grid p { color:#5c6b60; line-height:1.8; font-size:.88rem; margin:0; }
  .coach-section { background:#e8eede; padding:75px 0; }
  .coach-grid { display:grid; grid-template-columns:.9fr 1.1fr; gap:85px; align-items:center; }
  .coach-portrait { position:relative; display:flex; justify-content:center; overflow:hidden; aspect-ratio:4/4.7; background:var(--green); border-radius:5px; }
  .portrait-word { position:absolute; top:17px; color:#ffffff1c; font-size:clamp(3rem,6.5vw,6.2rem); font-weight:900; letter-spacing:-.055em; }
  .coach-portrait img { position:relative; display:block; align-self:end; width:91%; height:92%; object-fit:contain; object-position:center bottom; }
  .license-badge { position:absolute; bottom:22px; left:22px; padding:9px 13px; color:var(--dark); background:var(--yellow); border-radius:3px; font-size:.73rem; font-weight:850; }
  .coach-copy h2 { font-size:clamp(3rem,5.7vw,5rem); }
  .coach-role { font-size:.79rem; font-weight:800; color:var(--green); margin:18px 0 24px; }
  .coach-copy>p:not(.coach-role) { color:#53674f; line-height:1.8; font-size:.9rem; }
  .coach-contacts { display:grid; margin-top:25px; border-top:1px solid #bccbb8; }
  .coach-contacts>a { display:flex; align-items:center; gap:14px; min-height:82px; border-bottom:1px solid #bccbb8; text-decoration:none; }
  .coach-contacts>a:hover strong { text-decoration:underline; text-underline-offset:4px; }
  .contact-symbol { display:grid; place-items:center; width:42px; height:42px; flex:0 0 auto; border:1px solid #bccbb8; border-radius:50%; }
  .contact-symbol svg { width:20px; height:20px; stroke:currentColor; stroke-width:1.5; }
  .coach-contacts small { display:block; margin-bottom:5px; font-size:.63rem; color:#53674f; }
  .coach-contacts strong { font-size:.83rem; }
  .coach-contacts b { margin-left:auto; }
  .join-section { padding:80px 0 90px; text-align:center; }
  .join-section h2 { font-size:clamp(2.7rem,5vw,4.5rem); }
  .join-section p { max-width:485px; margin:24px auto; line-height:1.8; color:#5c6b60; font-size:.92rem; }
  @media (max-width:1000px) { .hero-grid { gap:30px; } .hero-facts { max-width:350px; } .hero-facts span+span::before { display:none; } .coach-grid { gap:45px; } .training-card { padding:26px; } }
  @media (max-width:760px) { .hero-grid,.section-heading,.coach-grid { grid-template-columns:1fr; } .hero-grid { margin-top:38px; gap:40px; } h1 { font-size:clamp(3.5rem,10vw,5.7rem); } .goal-visual { max-width:470px; width:100%; margin:auto; } .section-heading { gap:20px; } .section-heading>p { max-width:500px; } .coach-portrait { max-width:400px; width:100%; margin:auto; } .portrait-word { font-size:5rem; } .skills-grid { gap:20px; } .training-time { font-size:1.7rem; gap:6px; } }
  @media (max-width:540px) { .shell { width:calc(100% - 36px); } .keeper-hero { padding:26px 0 40px; } .hero-copy>p { font-size:.95rem; } .hero-actions { gap:22px; } .hero-facts { margin-top:26px; font-size:.62rem; } .hero-grid { gap:35px; } .goal-visual { padding:30px 22px 20px; border-radius:100px 100px 4px 4px; } .visual-top { font-size:.52rem; padding-inline:12px; } .training-grid,.skills-grid { grid-template-columns:1fr; } .training-section { padding:55px 0; } .training-card { padding:25px; } .training-time { font-size:2.1rem; gap:9px; } .skills-section { padding:0 0 55px; } .skills-grid { gap:25px; } .coach-section { padding:40px 0 45px; } .coach-grid { gap:32px; } .join-section { padding:55px 0 60px; } }
  @media (prefers-reduced-motion:reduce) { .button { transition:none; } }
</style>
