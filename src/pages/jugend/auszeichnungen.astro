---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';

const timArticle = 'https://www.suedkurier.de/regionalsport/regionalsport-bodensee-west/zwei-junge-fussballhelden-vom-bodensee%3Bart2783%2C11030099';
const jeromeArticle = 'https://www.suedkurier.de/regionalsport/regionalsport-bodensee-west/einfach-ein-ausgezeichneter-mann%3Bart2783%2C11571835';
const sbfvProtocol = 'https://bodensee.sbfv.de/fileadmin/user_upload/Nav_Bezirke/Nav_Bez6/BT-BJT/Protokolle-BT/Protokoll_BT_2023.pdf';
const seppArticle = 'https://www.suedkurier.de/region/kreis-konstanz/radolfzell/auszeichnung-fuer-den-bsv-nordstern%3Bart372455%2C10778125';
const dfbClub100Article = 'https://www.dfb.de/news/detail/der-club-100-des-dfb-feiert-im-deutschen-fussballmuseum-256670';
const dfbClub100Video = 'https://www.youtube.com/watch?v=lpIhf4oQvKk';
const club100Gallery = [
  {
    src: withBase('/images/jugend/auszeichnungen/2023-club-100-uebergabe.webp'),
    alt: 'Übergabe der Club-100-Ehrentafel an Jérôme Ernsberger beim BSV Nordstern',
  },
  {
    src: withBase('/images/jugend/auszeichnungen/2023-club-100-ehrentafel.webp'),
    alt: 'Gäste und Vereinsvertretung bei der Club-100-Ehrung auf dem BSV-Sportplatz',
  },
  {
    src: withBase('/images/jugend/auszeichnungen/2023-club-100-gruppenfoto.webp'),
    alt: 'Gruppenfoto mit Fußbällen, Ehrentafel und den neuen Minitoren',
  },
  {
    src: withBase('/images/jugend/auszeichnungen/2023-club-100-zertifikat.webp'),
    alt: 'Club-100-Zertifikat für Jérôme Ernsberger aus dem Jahr 2023',
  },
];
---

<Layout title="Auszeichnungen | Junge Sterne | BSV Nordstern Radolfzell" description="Auszeichnungen und besondere Ehrungen aus der Jugendarbeit des BSV Nordstern Radolfzell.">
  <Header />
  <main class="awards-page">
    <section class="hero"><div class="shell"><a href={withBase('/jugend')}>← Zurück zu Junge Sterne</a><span>Engagement · Verantwortung · Vorbilder</span><h1>Engagement,<br /><em>das Spuren hinterlässt.</em></h1><p>Jugendarbeit lebt von Menschen, die Zeit schenken, Verantwortung übernehmen und Kindern und Jugendlichen Möglichkeiten eröffnen. Einige dieser Leistungen wurden auch vom DFB, dem SBFV und der DFB-Stiftung Sepp Herberger ausgezeichnet.</p></div></section>
    <section class="intro shell"><div><span>Ausgezeichnetes Ehrenamt</span><h2>Menschen machen<br />den Unterschied.</h2></div><p>Keine einzelne Ehrung steht über der anderen. Wir möchten hier Menschen und Projekte zeigen, deren Engagement über die Vereinsgrenzen hinaus Anerkennung gefunden hat – stellvertretend für viele Ehrenamtliche beim BSV.</p></section>
    <section class="award-grid shell">
      <article class="award-card"><div class="badge">DFB</div><div class="award-copy"><span>Fußballheld · Aktion Junges Ehrenamt</span><h2>Ole Schmal</h2><p>Ole Schmal wurde als DFB-Fußballheld für besonderes junges Ehrenamt ausgezeichnet. Die Aktion würdigt junge Menschen, die früh Verantwortung übernehmen und sich in besonderer Weise für den Nachwuchs und ihren Verein engagieren.</p><strong class="statement">Verantwortung übernehmen. Jugendarbeit mitgestalten.</strong></div></article>
      <article class="award-card"><div class="badge">DFB</div><div class="award-copy"><span>Fußballheld · Aktion Junges Ehrenamt</span><h2>Tim Dölling</h2><p>Tim Dölling wurde 2021 Bezirkssieger der DFB-Aktion „Fußballhelden“. Beim BSV engagierte er sich unter anderem als Jugendtrainer und stellvertretender Jugendleiter, unterstützte den Schulfußball und organisierte Trainingslager.</p><strong class="statement">Junges Ehrenamt mit Ideen, Leidenschaft und einem besonderen Draht zu Jugendlichen.</strong><a class="source-link" href={timArticle} target="_blank" rel="noopener noreferrer">Zeitungsartikel „Zwei junge Fußballhelden vom Bodensee“ lesen <b>↗</b></a><small class="image-source">Bildquelle des verlinkten Pressefotos: Südkurier · Foto: KHA.</small></div></article>
      <article class="award-card"><div class="badge">100</div><div class="award-copy"><span>DFB-Ehrenamtspreis · Club 100</span><h2>Jérôme Ernsberger</h2><p>Jérôme Ernsberger wurde Bezirkssieger der DFB-Aktion Ehrenamt und zusätzlich in den DFB Club 100 aufgenommen. Mit dieser Auszeichnung würdigt der DFB besonders herausragendes ehrenamtliches Engagement im Amateurfußball.</p><strong class="statement">Eine Auszeichnung für nachhaltiges Engagement in der Jugendarbeit des BSV.</strong><div class="source-row"><a class="source-link" href={jeromeArticle} target="_blank" rel="noopener noreferrer">Südkurier: „Einfach ein ausgezeichneter Mann“ <b>↗</b></a><a class="source-link" href={sbfvProtocol} target="_blank" rel="noopener noreferrer">SBFV-Nachweis Club 100 <b>↗</b></a></div></div></article>
      <article class="award-card club-card"><div class="badge">3.</div><div class="award-copy"><span>DFB-Stiftung Sepp Herberger</span><h2>BSV Nordstern</h2><p>Die Nachwuchsarbeit des BSV Nordstern wurde auch als Verein ausgezeichnet. Für die Zusammenarbeit von <strong>Schule und Verein</strong> erreichte der BSV bei den Sepp-Herberger-Urkunden bundesweit den <strong>3. Platz</strong> und erhielt 2.000 Euro Preisgeld.</p><strong class="statement">Eine Auszeichnung für die gemeinsame Arbeit vieler Menschen im Verein und an den Radolfzeller Schulen.</strong><a class="source-link" href={seppArticle} target="_blank" rel="noopener noreferrer">Südkurier-Artikel zur Auszeichnung lesen <b>↗</b></a></div></article>
    </section>
    <section class="club100-note"><div class="shell"><span>Club 100 · BSV-Ehrung 2023</span><h2>Die Ehrung wirkt<br />bis auf den Platz.</h2><p>Im Mai 2023 wurde die Club-100-Auszeichnung auch beim BSV Nordstern sichtbar: Gemeinsam mit der persönlichen Ehrung wurden dem Verein zwei Minitore, Fußbälle und eine Ehrentafel übergeben.</p><div class="club100-gallery">{club100Gallery.map((image) => <figure><img src={image.src} alt={image.alt} width="320" height="212" loading="lazy" decoding="async" /></figure>)}</div><small class="gallery-source">Bilder: Vereinsarchiv BSV Nordstern</small></div></section>
    <section class="club100-video shell" aria-labelledby="club100-video-title">
      <div class="video-head"><div><span>11. November 2023 · Dortmund</span><h2 id="club100-video-title">Club 100 im<br />Deutschen Fußballmuseum.</h2></div><p>Bei der zentralen DFB-Ehrungsveranstaltung kamen die ausgezeichneten Ehrenamtlichen aus ganz Deutschland im Deutschen Fußballmuseum zusammen. Der DFB hat dazu ein offizielles Video veröffentlicht.</p></div>
      <div class="video-actions"><a class="youtube-button" href={dfbClub100Video} target="_blank" rel="noopener noreferrer"><span class="play-icon" aria-hidden="true">▶</span><span><small>Offizielles DFB-Video</small><strong>Club-100-Ehrung auf YouTube ansehen</strong></span><b>↗</b></a><div class="dfb-source"><a class="dfb-link" href={dfbClub100Article} target="_blank" rel="noopener noreferrer">Offiziellen DFB-Bericht zur Club-100-Ehrung lesen <b>↗</b></a><small>Bericht und Bildmaterial zur Veranstaltung: Deutscher Fußball-Bund (DFB), 11. November 2023.</small></div></div>
    </section>
    <section class="legacy shell"><div><span>Langjähriges Engagement</span><h2>Günther Glasze</h2></div><div><p>Günther Glasze gehört zu den Menschen, die sich über viele Jahre für den Nachwuchsfußball eingesetzt haben – unter anderem im Juniorinnenbereich und im Schulfußball.</p><p>Auch sein Engagement wurde im Fußball gewürdigt. Die genaue Bezeichnung und das Jahr seiner persönlichen Auszeichnung ergänzen wir, sobald sie verlässlich dokumentiert sind.</p></div></section>
    <section class="closing"><div class="shell"><span>Danke.</span><h2>Auszeichnungen gehören Einzelnen.<br /><em>Erfolge gehören uns allen.</em></h2><p>Diese Ehrungen stehen stellvertretend für Trainerinnen und Trainer, Spielerinnen und Spieler, Betreuer, Eltern, Organisatoren und Helfer, die unsere Jugendarbeit jeden Tag möglich machen.</p></div></section>
  </main>
  <Footer />
</Layout>

<style>
:root{--green:#092f20;--mid:#164f32;--yellow:#f4d638;--paper:#f4f7f4}.shell{width:min(1120px,calc(100% - 48px));margin-inline:auto}.awards-page{background:var(--paper);color:#17251b}.hero{padding:90px 0 105px;background:linear-gradient(135deg,#061e14,#164f32);color:#fff}.hero a{color:var(--yellow);font-size:.75rem;font-weight:900;text-decoration:none}.hero>div>span,.intro span,.award-copy>span,.club100-note span,.legacy span,.closing span,.video-head span{display:block;margin-top:45px;color:var(--yellow);font-size:.65rem;font-weight:950;letter-spacing:.14em;text-transform:uppercase}.hero h1{max-width:900px;margin:14px 0 25px;font-size:clamp(3.4rem,7vw,6.8rem);line-height:.88;letter-spacing:-.055em}.hero h1 em,.closing h2 em{font-family:Georgia,serif;font-weight:400;color:var(--yellow)}.hero p{max-width:760px;color:#d0ded5;font-size:1.05rem;line-height:1.75}.intro{padding:85px 0 55px;display:grid;grid-template-columns:.9fr 1.1fr;gap:80px;align-items:end}.intro span,.legacy span{margin:0;color:var(--mid)}.intro h2,.legacy h2,.club100-note h2,.closing h2,.video-head h2{margin:10px 0 0;font-size:clamp(2.5rem,4.7vw,4.8rem);line-height:.94;letter-spacing:-.045em}.intro p,.legacy p{margin:0;color:#617067;line-height:1.8}.award-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding-bottom:90px}.award-card{position:relative;min-height:430px;padding:38px;background:#fff;border-top:5px solid var(--yellow);box-shadow:0 15px 40px rgb(9 47 32 / 7%)}.badge{width:70px;height:70px;display:grid;place-items:center;margin-bottom:45px;border-radius:50%;background:var(--green);color:var(--yellow);font-weight:950;font-size:1.1rem}.award-copy>span{margin:0;color:var(--mid)}.award-copy h2{margin:8px 0 20px;font-size:2.5rem;letter-spacing:-.04em}.award-copy p{color:#64736a;line-height:1.75}.statement{display:block;margin-top:28px;padding-top:22px;border-top:1px solid #dce4de;color:var(--mid);line-height:1.55}.source-link{display:inline-flex;margin-top:20px;color:var(--green);font-size:.75rem;font-weight:900;text-decoration:none;border-bottom:2px solid var(--yellow);padding-bottom:3px}.source-link:hover{color:var(--mid)}.source-row{display:flex;flex-wrap:wrap;gap:8px 20px}.image-source{display:block;margin-top:14px;color:#7a877f;font-size:.65rem;line-height:1.55}.club-card{background:#fffdf0}.club100-note{padding:80px 0;background:var(--yellow)}.club100-note span{margin:0;color:var(--green)}.club100-note p{max-width:760px;line-height:1.8}.club100-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:36px}.club100-gallery figure{margin:0;overflow:hidden;background:var(--green)}.club100-gallery img{display:block;width:100%;aspect-ratio:320/212;object-fit:cover;transition:transform .2s ease}.club100-gallery figure:hover img{transform:scale(1.025)}.gallery-source{display:block;margin-top:12px;color:rgb(9 47 32 / 72%);font-size:.65rem}.club100-video{padding:95px 0}.video-head{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:end;margin-bottom:34px}.video-head span{margin:0;color:var(--mid)}.video-head p{margin:0;color:#65746a;line-height:1.75}.video-actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap}.youtube-button{min-width:min(100%,620px);display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:20px;padding:22px 25px;background:var(--green);color:#fff;text-decoration:none;box-shadow:0 14px 35px rgb(9 47 32 / 14%);transition:transform .18s ease,box-shadow .18s ease}.youtube-button:hover{transform:translateY(-2px);box-shadow:0 18px 42px rgb(9 47 32 / 20%)}.play-icon{width:54px;height:54px;display:grid;place-items:center;border-radius:50%;background:#fff;color:var(--green);font-size:1.15rem;padding-left:3px}.youtube-button small{display:block;color:var(--yellow);font-size:.62rem;font-weight:950;letter-spacing:.12em;text-transform:uppercase}.youtube-button strong{display:block;margin-top:4px;font-size:1rem}.youtube-button>b{color:var(--yellow);font-size:1.3rem}.dfb-source{display:grid;gap:10px;max-width:350px}.dfb-source small{color:#758279;font-size:.65rem;line-height:1.55}.dfb-link{display:inline-flex;width:max-content;max-width:100%;padding-bottom:4px;border-bottom:2px solid var(--yellow);color:var(--green);font-size:.78rem;font-weight:900;text-decoration:none}.legacy{padding:90px 0;display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.legacy p+p{margin-top:16px}.closing{padding:90px 0;background:var(--green);color:#fff}.closing span{margin:0}.closing h2{max-width:900px}.closing p{max-width:700px;color:#c7d6cc;line-height:1.75}@media(max-width:800px){.intro,.legacy,.video-head{grid-template-columns:1fr;gap:35px}.club100-gallery{grid-template-columns:1fr 1fr}.award-grid{grid-template-columns:1fr}.hero{padding:65px 0 80px}}@media(max-width:560px){.shell{width:min(100% - 32px,1120px)}.award-card{padding:28px}.hero h1{font-size:3.5rem}.club100-gallery{grid-template-columns:1fr}.youtube-button{grid-template-columns:auto 1fr;padding:18px}.youtube-button>b{display:none}.play-icon{width:46px;height:46px}}
</style>
