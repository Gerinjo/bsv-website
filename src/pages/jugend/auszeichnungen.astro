---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';

const timArticle = 'https://www.suedkurier.de/regionalsport/regionalsport-bodensee-west/zwei-junge-fussballhelden-vom-bodensee%3Bart2783%2C11030099';
const jeromeArticle = 'https://www.suedkurier.de/regionalsport/regionalsport-bodensee-west/einfach-ein-ausgezeichneter-mann%3Bart2783%2C11571835';
const sbfvProtocol = 'https://bodensee.sbfv.de/fileadmin/user_upload/Nav_Bezirke/Nav_Bez6/BT-BJT/Protokolle-BT/Protokoll_BT_2023.pdf';
const seppArticle = 'https://www.suedkurier.de/region/kreis-konstanz/radolfzell/auszeichnung-fuer-den-bsv-nordstern%3Bart372455%2C10778125';
---

<Layout title="Auszeichnungen | Junge Sterne | BSV Nordstern Radolfzell" description="Auszeichnungen für besonderes ehrenamtliches Engagement in der Jugendarbeit des BSV Nordstern Radolfzell.">
  <Header />
  <main class="awards-page">
    <section class="hero"><div class="shell"><a href={withBase('/jugend')}>← Zurück zu Junge Sterne</a><span>Engagement · Verantwortung · Vorbilder</span><h1>Engagement,<br /><em>das Spuren hinterlässt.</em></h1><p>Jugendarbeit lebt von Menschen, die Zeit schenken, Verantwortung übernehmen und Kindern und Jugendlichen Möglichkeiten eröffnen. Einige dieser Leistungen wurden auch vom DFB, dem SBFV und der DFB-Stiftung Sepp Herberger ausgezeichnet.</p></div></section>

    <section class="intro shell"><div><span>Ausgezeichnetes Ehrenamt</span><h2>Menschen machen<br />den Unterschied.</h2></div><p>Keine einzelne Ehrung steht über der anderen. Wir möchten hier Menschen und Projekte zeigen, deren Engagement über die Vereinsgrenzen hinaus Anerkennung gefunden hat – stellvertretend für viele Ehrenamtliche beim BSV.</p></section>

    <section class="award-grid shell">
      <article class="award-card"><div class="badge">DFB</div><div class="award-copy"><span>Fußballheld · Aktion Junges Ehrenamt</span><h2>Ole Schmal</h2><p>Ole Schmal wurde als DFB-Fußballheld für besonderes junges Ehrenamt ausgezeichnet. Die Aktion würdigt junge Menschen, die früh Verantwortung übernehmen und sich in besonderer Weise für den Nachwuchs und ihren Verein engagieren.</p><strong class="statement">Verantwortung übernehmen. Jugendarbeit mitgestalten.</strong></div></article>

      <article class="award-card"><div class="badge">DFB</div><div class="award-copy"><span>Fußballheld · Aktion Junges Ehrenamt</span><h2>Tim Dölling</h2><p>Tim Dölling wurde 2021 Bezirkssieger der DFB-Aktion „Fußballhelden“. Beim BSV engagierte er sich unter anderem als Jugendtrainer und stellvertretender Jugendleiter, unterstützte den Schulfußball und organisierte Trainingslager.</p><strong class="statement">Junges Ehrenamt mit Ideen, Leidenschaft und einem besonderen Draht zu Jugendlichen.</strong><a class="source-link" href={timArticle} target="_blank" rel="noopener noreferrer">Zeitungsartikel „Zwei junge Fußballhelden vom Bodensee“ lesen <b>↗</b></a><small class="image-source">Zum Pressebild: Quelle Südkurier · Foto: KHA. Das Pressefoto selbst wird aus urheberrechtlichen Gründen nicht auf unserer Seite übernommen.</small></div></article>

      <article class="award-card"><div class="badge">100</div><div class="award-copy"><span>DFB-Ehrenamtspreis · Club 100</span><h2>Jérôme Ernsberger</h2><p>Jérôme Ernsberger wurde Bezirkssieger der DFB-Aktion Ehrenamt und zusätzlich in den DFB Club 100 aufgenommen. Mit dieser Auszeichnung würdigt der DFB besonders herausragendes ehrenamtliches Engagement im Amateurfußball.</p><strong class="statement">Eine Auszeichnung für nachhaltiges Engagement in der Jugendarbeit des BSV.</strong><div class="source-row"><a class="source-link" href={jeromeArticle} target="_blank" rel="noopener noreferrer">Südkurier: „Einfach ein ausgezeichneter Mann“ <b>↗</b></a><a class="source-link" href={sbfvProtocol} target="_blank" rel="noopener noreferrer">SBFV-Nachweis Club 100 <b>↗</b></a></div></div></article>

      <article class="award-card club-card"><div class="badge">3.</div><div class="award-copy"><span>DFB-Stiftung Sepp Herberger</span><h2>BSV Nordstern</h2><p>2021 wurde die Nachwuchsarbeit des BSV Nordstern als Verein ausgezeichnet. Für die Zusammenarbeit von <strong>Schule und Verein</strong> erreichte der BSV bei den Sepp-Herberger-Urkunden bundesweit den <strong>3. Platz</strong> und erhielt 2.000 Euro Preisgeld.</p><strong class="statement">Eine Auszeichnung für die gemeinsame Arbeit vieler Menschen im Verein und an den Radolfzeller Schulen.</strong><a class="source-link" href={seppArticle} target="_blank" rel="noopener noreferrer">Südkurier-Artikel zur Auszeichnung lesen <b>↗</b></a></div></article>
    </section>

    <section class="club100-note"><div class="shell"><span>Club 100 · Auszeichnung für Verein und Ehrenamt</span><h2>Die Ehrung wirkt<br />bis auf den Platz.</h2><p>Mit der Aufnahme eines Ehrenamtlichen in den Club 100 würdigt der DFB auch dessen Verein. Club-100-Vereine erhalten unter anderem zwei Minitore, Fußbälle und eine Ehrentafel. Für die BSV-Auszeichnung suchen wir derzeit noch das vereinseigene Bildmaterial von der Übergabe der Tore – dieses möchten wir hier ergänzen, sobald es wiedergefunden ist.</p></div></section>

    <section class="legacy shell"><div><span>Langjähriges Engagement</span><h2>Günther Glasze</h2></div><div><p>Günther Glasze gehört zu den Menschen, die sich über viele Jahre für den Nachwuchsfußball eingesetzt haben – unter anderem im Juniorinnenbereich und im Schulfußball.</p><p>Auch sein Engagement wurde im Fußball gewürdigt. Die genaue Bezeichnung und das Jahr seiner persönlichen Auszeichnung ergänzen wir, sobald sie verlässlich dokumentiert sind.</p></div></section>

    <section class="closing"><div class="shell"><span>Danke.</span><h2>Auszeichnungen gehören Einzelnen.<br /><em>Erfolge gehören uns allen.</em></h2><p>Diese Ehrungen stehen stellvertretend für Trainerinnen und Trainer, Betreuer, Eltern, Organisatoren und Helfer, die unsere Jugendarbeit jeden Tag möglich machen.</p></div></section>
  </main>
  <Footer />
</Layout>

<style>
:root{--green:#092f20;--mid:#164f32;--yellow:#f4d638;--paper:#f4f7f4}.shell{width:min(1120px,calc(100% - 48px));margin-inline:auto}.awards-page{background:var(--paper);color:#17251b}.hero{padding:90px 0 105px;background:linear-gradient(135deg,#061e14,#164f32);color:#fff}.hero a{color:var(--yellow);font-size:.75rem;font-weight:900;text-decoration:none}.hero>div>span,.intro span,.award-copy>span,.club100-note span,.legacy span,.closing span{display:block;margin-top:45px;color:var(--yellow);font-size:.65rem;font-weight:950;letter-spacing:.14em;text-transform:uppercase}.hero h1{max-width:900px;margin:14px 0 25px;font-size:clamp(3.4rem,7vw,6.8rem);line-height:.88;letter-spacing:-.055em}.hero h1 em,.closing h2 em{font-family:Georgia,serif;font-weight:400;color:var(--yellow)}.hero p{max-width:760px;color:#d0ded5;font-size:1.05rem;line-height:1.75}.intro{padding:85px 0 55px;display:grid;grid-template-columns:.9fr 1.1fr;gap:80px;align-items:end}.intro span,.legacy span{margin:0;color:var(--mid)}.intro h2,.legacy h2,.club100-note h2,.closing h2{margin:10px 0 0;font-size:clamp(2.5rem,4.7vw,4.8rem);line-height:.94;letter-spacing:-.045em}.intro p,.legacy p{margin:0;color:#617067;line-height:1.8}.award-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding-bottom:90px}.award-card{position:relative;min-height:430px;padding:38px;background:#fff;border-top:5px solid var(--yellow);box-shadow:0 15px 40px rgb(9 47 32 / 7%)}.badge{width:70px;height:70px;display:grid;place-items:center;margin-bottom:45px;border-radius:50%;background:var(--green);color:var(--yellow);font-weight:950;font-size:1.1rem}.award-copy>span{margin:0;color:var(--mid)}.award-copy h2{margin:8px 0 20px;font-size:2.5rem;letter-spacing:-.04em}.award-copy p{color:#64736a;line-height:1.75}.statement{display:block;margin-top:28px;padding-top:22px;border-top:1px solid #dce4de;color:var(--mid);line-height:1.55}.source-link{display:inline-flex;margin-top:20px;color:var(--green);font-size:.75rem;font-weight:900;text-decoration:none;border-bottom:2px solid var(--yellow);padding-bottom:3px}.source-link:hover{color:var(--mid)}.source-row{display:flex;flex-wrap:wrap;gap:8px 20px}.image-source{display:block;margin-top:14px;color:#7a877f;font-size:.65rem;line-height:1.55}.club-card{background:#fffdf0}.club100-note{padding:80px 0;background:var(--yellow)}.club100-note span{margin:0;color:var(--green)}.club100-note p{max-width:760px;line-height:1.8}.legacy{padding:90px 0;display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.legacy p+p{margin-top:16px}.closing{padding:90px 0;background:var(--green);color:#fff}.closing span{margin:0}.closing h2{max-width:900px}.closing p{max-width:700px;color:#c7d6cc;line-height:1.75}@media(max-width:800px){.intro,.legacy{grid-template-columns:1fr;gap:35px}.award-grid{grid-template-columns:1fr}.hero{padding:65px 0 80px}}@media(max-width:560px){.shell{width:min(100% - 32px,1120px)}.award-card{padding:28px}.hero h1{font-size:3.5rem}}
</style>
