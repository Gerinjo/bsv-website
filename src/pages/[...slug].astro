---

<Layout title={`${page.title} – BSV Nordstern Radolfzell`} description={page.intro}>
  <Header />
  <main>
    <section class:list={["page-hero", { "referee-hero": isRefereePage, "girls-team-hero": isTeamPage, "department-hero": isDepartmentPage }]}>
      <div class="shell hero-grid">
        <div class="hero-copy"><a class="back" href={section.href}>← {section.label}</a><p class="eyebrow">{page.eyebrow}</p><h1 class={heroTitleClass}>{page.title}</h1><p class="lead">{page.intro}</p></div>
        <div class:list={["hero-image", { "is-team-placeholder": isTeamPage && !heroImage }]}>
          {heroImage
            ? <img class:list={{ 'is-portrait': isPortraitHero }} src={heroImage} alt={isTeamPage ? `Mannschaftsbild ${page.title}` : ''} width="900" height="650" />
            : <div class="team-image-placeholder" aria-label={`Für ${page.title} ist noch kein Mannschaftsbild vorhanden`}><small>BSV Nordstern</small><strong>{teamProfile?.letter}</strong><b>Teambild folgt</b></div>}
          <span>BSV · 1956</span>
        </div>
      </div>
    </section>

    <section class="content shell">
      {isRefereePage && (
        <div class="referee-page">
          <section class="referee-intro">
            <div><span>Fairness braucht Haltung</span><h2>Entscheiden.<br /><em>Verantwortung tragen.</em></h2></div>
            <div class="referee-copy"><p>Der BSV Nordstern Radolfzell ist stolz auf seine engagierten Jugendschiedsrichterinnen und Jugendschiedsrichter. Sie leiten Spiele im gesamten Raum Bodensee und sorgen dafür, dass der Spielbetrieb fair und reibungslos verläuft.</p><p>Fundiertes Regelwissen, ein klarer Kopf und der Mut, auch unter Druck die richtige Entscheidung zu treffen, machen sie zu Vorbildern auf und neben dem Platz.</p></div>
          </section>

          <section class="referee-team">
            <div class="referee-head"><div><span>Unser Team</span><h2>Die Menschen<br />mit der Pfeife.</h2></div><p>Fünf Persönlichkeiten, ein gemeinsames Ziel: Fußball fair und verlässlich möglich machen.</p></div>
            <div class="referee-grid">
              {youthReferees.map((referee, index) => (
                <article class:list={["referee-card", { coordinator: index === 0 }]}>
                  <span class="referee-number">0{index + 1}</span>
                  <div class:list={["referee-portrait", { "is-balanced": referee.balancedPortrait }]} style={referee.balancedPortrait ? `--portrait-image:url('${referee.image}');--portrait-scale:${referee.portraitScale}` : undefined}>
                    {referee.image ? <img src={referee.image} alt={referee.name} width="500" height="650" loading="lazy" /> : <span>{referee.name.split(' ').map((part) => part[0]).join('')}</span>}
                  </div>
                  <div class="referee-info"><h3>{referee.name}</h3><p>{referee.role}</p>
                    {(referee.email || referee.phone) && <div class="contact-icons">
                      {referee.email && <a href={`mailto:${referee.email}`} aria-label={`E-Mail an ${referee.name}`}></a>}
                      {referee.phone && <a href={`tel:${referee.phone}`} aria-label={`${referee.name} anrufen`}></a>}
                    </div>}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="referee-thanks">
            <div><span>Mentoring</span><h2>Rückhalt für<br />junge Schiris.</h2></div>
            <div><p>Ein besonderer Dank gilt Stefan Gastaudo. Als Ansprechpartner unterstützt und begleitet er unsere jungen Schiedsrichterinnen und Schiedsrichter, damit sie jede Woche gut vorbereitet und motiviert auf dem Platz stehen.</p><p>Er ist Mentor, verlässlicher Ansprechpartner und Vorbild für unsere jungen Talente.</p></div>
          </section>

          <section class="referee-cta">
            <span aria-hidden="true">✦</span><div><small>Neue Perspektive gesucht?</small><h2>Werde Schiedsrichter:in.</h2><p>Du liebst Fußball und möchtest Verantwortung übernehmen? Ob Mädchen oder Junge – bei uns bist du willkommen. Wir begleiten dich bei deinen ersten Schritten und darüber hinaus.</p></div><a href="mailto:Stefan.Gastaudo@bsvnordstern.de">Interesse anmelden <b>↗</b></a>
          </section>
        </div>
      )}
      {isYouthConcept && (
        <div class="concept-page">
          <section class="concept-opening">
            <div class="concept-heading">
              <span>01 · Warum</span>
              <h2>Ein Plan für<br /><em>junge Menschen.</em></h2>
            </div>
            <div class="concept-copy">
              <p>Willkommen beim BSV Nordstern Radolfzell! Als fester Bestandteil unserer Stadt am Bodensee ist es uns ein Anliegen, nicht nur die Tradition des Sports zu pflegen, sondern aktiv zur Entwicklung unserer Jugend beizutragen.</p>
              <h3>Was ist ein Jugendkonzept?</h3>
              <p>Ein Jugendkonzept ist ein strategischer Plan, der die Bedürfnisse, Interessen und Potenziale junger Menschen innerhalb des Vereins erfasst und fördert. Es ist unsere gemeinsame Blaupause dafür, wie wir Jugendliche erreichen, unterstützen und in das Vereinsleben integrieren.</p>
              <p>Wir nehmen ihre Ideen und Anliegen ernst und begleiten sie auf dem Weg zu selbstbewussten, verantwortungsvollen Mitgliedern der Gemeinschaft. Dafür schaffen wir einen sicheren und inspirierenden Raum, in dem junge Menschen ihre Talente im Sport, bei Veranstaltungen und durch die Übernahme von Verantwortung entfalten können.</p>
            </div>
          </section>

          <section class="concept-promise">
            <div class="promise-title"><span>Unser Versprechen</span><strong>Zuhören.<br />Fördern.<br />Vertrauen.</strong></div>
            <div class="promise-copy"><p>Der BSV Nordstern ist nicht nur ein Ort für sportliche Aktivitäten, sondern ein Zuhause für unsere Jugendlichen. Sie sollen sich willkommen, sicher und unterstützt fühlen.</p><p>Wir hören ihre Stimmen, verstehen ihre Bedürfnisse und begleiten sie bei ihren sportlichen und persönlichen Zielen.</p></div>
            <span class="promise-star" aria-hidden="true">✦</span>
          </section>

          <section class="principles-section">
            <div class="concept-section-head"><div><span>02 · Wie</span><h2>Acht Prinzipien.<br />Ein gemeinsamer Weg.</h2></div><p>Unsere Leitlinien verbinden sportliche Qualität mit sozialer Verantwortung.</p></div>
            <div class="principles-grid">
              {conceptPrinciples.map((principle, index) => (
                <article class:list={["principle-card", { "has-image": principle.image, "is-wide": index === 0 || index === 3 || index === 6 }]}>
                  {principle.image && <img src={principle.image} alt="Jugendliche des BSV Nordstern beim Fußball" width="900" height="600" loading="lazy" />}
                  <div><span>0{index + 1}</span><h3>{principle.title}</h3><p>{principle.text}</p></div>
                </article>
              ))}
            </div>
          </section>

          <section class="concept-join">
            <div class="join-photo"><img src="/images/migration/571bd8370a-20230722_133328.jpg" alt="Gemeinschaft in der BSV-Jugend" width="1200" height="800" loading="lazy" /><span>#aufgehtsgrün</span></div>
            <div class="join-message"><span>03 · Mitmachen</span><h2>Deine Stimme zählt.</h2><p>Möchtest du Teil dieser Reise sein? Bring deine Ideen ein, übernimm Verantwortung und gestalte mit uns die Zukunft der BSV-Jugend.</p><a href="mailto:jugend@bsvnordstern.de">Jugendabteilung kontaktieren <b>↗</b></a></div>
          </section>

          <section class="concept-documents">
            <div><span>Vertiefende Dokumente</span><h2>Zum Nachlesen.</h2></div>
            <div class="document-links">
              <a href="/images/migration/83266e0a0b-BSV_Jugendkonzept-2015.pdf" target="_blank"><span>PDF · Stand 2015</span><strong>BSV Jugendkonzept</strong><b>↓</b></a>
              <a href="/images/migration/eaf3ae53f8-DFB-Ausbildungskonzeption.pdf" target="_blank"><span>PDF · Ausbildung</span><strong>DFB-Konzeption</strong><b>↓</b></a>
            </div>
          </section>
        </div>
      )}
      {isHistoryPage && (
        <div class="history-page">
          <section class="history-opening">
            <div><span>Seit 1956</span><h2>Aus einer Idee<br />wurde <em>Heimat.</em></h2></div>
            <div><p>Die Geschichte des BSV Nordstern ist eine Geschichte von Menschen, die angepackt haben. Von 32 Gründungsmitgliedern im Altbohl-Stüble bis zu Generationen von Sportlerinnen, Sportlern und Ehrenamtlichen.</p><p>Plätze und Vereinsheim entstanden mit Beharrlichkeit und tausenden Stunden Eigenleistung. Aufstiege, Rückschläge und Neuanfänge haben den Verein geprägt – der Zusammenhalt ist geblieben.</p></div>
          </section>

          <section class="history-numbers" aria-label="Zahlen aus der Vereinsgeschichte">
            <div><strong>1956</strong><span>Gründungsjahr</span></div>
            <div><strong>32</strong><span>Menschen beim Start</span></div>
            <div><strong>16.000</strong><span>Stunden Eigenleistung</span></div>
            <div><strong>118:22</strong><span>Tore in der Saison 2014/15</span></div>
          </section>

          <section class="history-chronicle">
            <div class="history-head"><span>Unsere Chronik</span><h2>Sieben Kapitel.<br />Ein Nordstern.</h2></div>
            <div class="history-track">
              {historyChapters.map((chapter, index) => (
                <article class:list={["history-chapter", { "is-reverse": index % 2 === 1 }]}>
                  <div class="history-visual">
                    {chapter.image ? (
                      <figure><img src={chapter.image} alt={chapter.caption ?? ''} width="900" height="620" loading="lazy" /><figcaption>{chapter.caption}</figcaption></figure>
                    ) : (
                      <div class="history-fact"><span>{chapter.fact?.value}</span><strong>{chapter.fact?.label}</strong><small>BSV Nordstern Radolfzell</small></div>
                    )}
                  </div>
                  <div class="history-marker"><span>0{index + 1}</span></div>
                  <div class="history-story">
                    <div class="history-date"><span>{chapter.eyebrow}</span><time>{chapter.date}</time></div>
                    <h3>{chapter.title}</h3>
                    <p class="history-subtitle">{chapter.subtitle}</p>
                    {chapter.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                    {chapter.roster && <details class="history-roster"><summary>Mannschaftsaufstellung ansehen <span>+</span></summary><p>{chapter.roster}</p></details>}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="history-finale">
            <div><small>Die Geschichte geht weiter</small><h2>Das nächste Kapitel<br />schreiben wir gemeinsam.</h2></div>
            <a href="/verein/mitglied-werden">Teil des BSV werden <span>↗</span></a>
          </section>
        </div>
      )}
      {departmentPage && (
        <div class:list={["department-page", `is-${departmentPage.theme}`]}>
          <section class="department-opening">
            <div class="department-heading"><span>{departmentPage.kicker}</span><h2 set:html={departmentPage.headline} /></div>
            <div class="department-copy"><p>{departmentPage.lead}</p><p>{departmentPage.description}</p></div>
          </section>

          <section class="department-facts" aria-label="Training und wichtige Informationen">
            {departmentPage.facts.map((fact, index) => (
              <article><span>0{index + 1}</span><div><small>{fact.label}</small><strong>{fact.value}</strong><p>{fact.detail}</p></div></article>
            ))}
          </section>

          <section class="department-qualities">
            <div class="department-section-head"><div><span>Was uns bewegt</span><h2>Drei gute Gründe.</h2></div><p>Sport wirkt am besten, wenn Bewegung, persönliche Entwicklung und Gemeinschaft zusammenkommen.</p></div>
            <div class="quality-grid">
              {departmentPage.qualities.map((quality, index) => (
                <article><span class="quality-number">0{index + 1}</span><b aria-hidden="true">{quality.icon}</b><h3>{quality.title}</h3><p>{quality.text}</p></article>
              ))}
            </div>
          </section>

          <section class="department-people">
            <div class="department-section-head"><div><span>Direkter Kontakt</span><h2>{departmentPage.people.length > 1 ? 'Unsere Wanderführung.' : 'Deine Ansprechperson.'}</h2></div><p>Fragen zum Angebot, zum Einstieg oder zum nächsten Termin beantworten wir gerne persönlich.</p></div>
            <div class:list={["department-people-grid", { "is-single": departmentPage.people.length === 1 }]}>
              {departmentPage.people.map((person) => (
                <article class="department-person">
                  {person.image ? <div class="department-portrait"><img src={person.image} alt={person.name} width="667" height="1000" loading="lazy" /></div> : <div class="department-portrait is-placeholder" aria-hidden="true">{person.name.split(' ').map((part) => part[0]).join('')}</div>}
                  <div><small>{person.role}</small><h3>{person.name}</h3><div class="contact-icons">{person.email && <a href={`mailto:${person.email}`} aria-label={`E-Mail an ${person.name}`}>✉</a>}{person.phone && <a href={`tel:${person.phone}`} aria-label={`${person.name} anrufen`}>☎</a>}</div></div>
                </article>
              ))}
            </div>
          </section>

          {departmentPage.gallery.length > 0 && (
            <section class="department-gallery-section">
              <div class="department-section-head"><div><span>Einblicke</span><h2>Mitten im Erlebnis.</h2></div><p>Bilder aus Training, Touren und gemeinsamen Momenten unserer Abteilung.</p></div>
              <div class:list={["department-gallery", { "has-four": departmentPage.gallery.length === 4 }]}>
                {departmentPage.gallery.map((photo, index) => (
                  <button type="button" data-gallery-image={photo.src} data-gallery-alt={photo.alt} data-gallery-caption={photo.caption} aria-label={`${photo.caption} vergrößern`}>
                    <img src={photo.src} alt={photo.alt} width="1024" height="768" loading="lazy" />
                    <span><small>0{index + 1}</small><strong>{photo.caption}</strong><b aria-hidden="true">↗</b></span>
                  </button>
                ))}
              </div>
            </section>
          )}

          <section class="department-notice">
            <div><small>Gut zu wissen</small><h2>{departmentPage.theme === 'archery' ? 'Interesse geweckt?' : departmentPage.theme === 'hiking' ? 'Komm einfach mit.' : 'Bleib in Bewegung.'}</h2><p>{departmentPage.notice}</p></div>
            <a href={`mailto:${departmentPage.people[0].email ?? 'info@bsvnordstern.de'}?subject=${encodeURIComponent(`Anfrage ${page.title}`)}`}>Kontakt aufnehmen <span>↗</span></a>
          </section>

          {departmentPage.gallery.length > 0 && <dialog class="gallery-dialog" aria-label="Vergrößerte Galerieansicht"><button class="gallery-close" type="button" aria-label="Galerie schließen">×</button><figure><img src="" alt="" /><figcaption></figcaption></figure></dialog>}
        </div>
      )}
      {isOrganizationPage && (
        <div class="org-page">
          <section class="org-opening">
            <div><span>Gemeinsam organisiert</span><h2>Wer bewegt<br /><em>was?</em></h2></div>
            <div><p>Ein lebendiger Verein braucht klare Zuständigkeiten – und Menschen, die Verantwortung übernehmen. Unser Organigramm zeigt, wie Geschäftsführung und Fachbereiche zusammenarbeiten.</p><p>Die einzelnen Bereiche lassen sich öffnen. Dort findest du die verantwortlichen Personen und die zugehörigen Aufgaben auf einen Blick.</p><div class="org-hint"><span aria-hidden="true">+</span> Bereich auswählen und aufklappen</div></div>
          </section>

          <section class="org-governance" aria-labelledby="governance-title">
            <div class="org-section-label"><span>Ebene 01</span><strong id="governance-title">Geschäftsführender Vorstand</strong></div>
            <div class="executive-grid">
              {executiveBoard.map((member, index) => (
                <article class:list={["executive-card", { "is-chair": index === 0 }]}>
                  <span class="executive-initials">{member.initials}</span>
                  <div><small>{member.role}</small><h3>{member.name}</h3></div>
                </article>
              ))}
            </div>
            <div class="governance-support">
              <div><small>Unterstützende Aufgaben</small><ul><li>Finanzcontrolling</li><li>Kassenwesen</li><li>Recht</li><li>Datenschutz</li><li>Vertragswesen</li></ul></div>
              <a href="/foerderverein/vorstandschaft"><span>Eigenständiger Partner</span><strong>Förderverein</strong><small>Förderung · Projekte · Sponsoring</small><b aria-hidden="true">↗</b></a>
            </div>
          </section>

          <section class="org-departments" aria-labelledby="departments-title">
            <div class="org-department-head"><div><span>Ebene 02</span><h2 id="departments-title">Sieben Bereiche.<br />Ein Verein.</h2></div><p>Jeder Bereich arbeitet eigenverantwortlich und ist zugleich eng mit der Vorstandschaft sowie den anderen Teams verbunden.</p></div>
            <div class="org-accordion">
              {organizationUnits.map((unit, index) => (
                <details class="org-unit" open={index === 0}>
                  <summary>
                    <span class="org-unit-number">{unit.number}</span>
                    <span class="org-summary-copy"><small>Fachbereich</small><strong>{unit.title}</strong><span>{unit.intro}</span></span>
                    <b aria-hidden="true">+</b>
                  </summary>
                  <div class="org-unit-content">
                    <div class="org-responsible"><small>Verantwortliche Personen</small><div>{unit.people.map((person) => <article><span>{person.name.split(' ').map((part) => part[0]).join('')}</span><div><strong>{person.name}</strong><small>{person.role}</small></div></article>)}</div></div>
                    <div class="org-tasks"><small>Aufgaben & Zuständigkeiten</small><ul>{unit.tasks.map((task) => <li>{task}</li>)}</ul></div>
                  </div>
                </details>
              ))}
            </div>
          </section>

          <section class="org-cta">
            <div><small>Menschen hinter der Struktur</small><h2>Engagement hat viele Gesichter.</h2><p>Lerne die gesamte Vorstandschaft und ihre Arbeit für den BSV Nordstern kennen.</p></div>
            <a href="/verein/vorstandschaft">Zur Vorstandschaft <span>↗</span></a>
          </section>
        </div>
      )}
      {teamProfile && (
        <div class="d-girls-page team-profile-page">
          <section class="d-girls-opening">
            <div class="d-girls-heading"><span>{teamProfile.kicker}</span><h2 set:html={teamProfile.headline} /></div>
            <div class="d-girls-copy">
              {teamProfile.opening.map((paragraph) => <p>{paragraph}</p>)}
              {teamProfile.partners && (
                <div class="team-partners"><small>Spielgemeinschaft mit</small><div>{teamProfile.partners.map((partner) => partner.href ? <a href={partner.href} target="_blank" rel="noreferrer">{partner.label}<span aria-hidden="true">↗</span></a> : <span>{partner.label}</span>)}</div></div>
              )}
              {teamProfile.squad && (
                <details class="team-squad"><summary>Mannschaftsaufstellung ansehen <span aria-hidden="true">+</span></summary><div>{teamProfile.squad.map((line) => <p>{line}</p>)}</div></details>
              )}
            </div>
          </section>

          <section class="d-girls-training" aria-labelledby="team-training-title">
            <div class="training-intro"><span>Training</span><h2 id="team-training-title">Gemeinsam trainieren.<br />Besser werden.</h2><p>{teamProfile.trainingLead}</p></div>
            <div class="training-days">
              {teamProfile.training.map((slot, index) => (
                <article><span>{String(index + 1).padStart(2, '0')}</span><div><small>{slot.day}</small><strong>{slot.time}</strong><p>{slot.place}</p></div></article>
              ))}
              {teamProfile.trainingNote && <p class="training-note"><span aria-hidden="true">◎</span> {teamProfile.trainingNote}</p>}
            </div>
          </section>

          {teamProfile.notice && <aside class="team-notice"><span aria-hidden="true">!</span><div><small>Wichtiger Hinweis</small><p>{teamProfile.notice}</p></div></aside>}

          {teamProfile.coaches.length > 0 && (
            <section class="d-girls-coaches">
              <div class="d-girls-section-head"><div><span>Ansprechpersonen</span><h2>Das Trainerteam.</h2></div><p>Klare Zuständigkeiten und ein direkter Draht für Spieler:innen und Eltern.</p></div>
              <div class:list={["coach-grid", { "is-single": teamProfile.coaches.length === 1 }]}>
                {teamProfile.coaches.map((coach) => (
                  <article class="coach-card">
                    {coach.image ? <div class="coach-portrait"><img src={coach.image} alt={coach.name} width="677" height="1000" loading="lazy" /></div> : <div class="coach-portrait coach-placeholder" aria-hidden="true">{coach.name.split(' ').map((part) => part[0]).join('')}</div>}
                    <div class="coach-details"><small>{coach.role}</small><h3>{coach.name}</h3>{coach.qualification && <p>{coach.qualification}</p>}{coach.club && <p class="coach-club"><small>Stammverein</small><strong>{coach.club}</strong></p>}{(coach.email || coach.phone) && <div class="contact-icons">{coach.email && <a href={`mailto:${coach.email}`} aria-label={`E-Mail an ${coach.name}`}>✉</a>}{coach.phone && <a href={`tel:${coach.phone}`} aria-label={`${coach.name} anrufen`}>☎</a>}</div>}</div>
                  </article>
                ))}
              </div>
            </section>
          )}

          {teamProfile.gallery.length > 0 && (
            <section class="d-girls-gallery-section">
              <div class="d-girls-section-head gallery-head"><div><span>Team-Momente</span><h2>Mehr als 90 Minuten.</h2></div><p>Vorhandene Bilder zeigen Training, Spieltage und gemeinsame Erlebnisse der Mannschaft.</p></div>
              <div class:list={["d-girls-gallery", { "is-single": teamProfile.gallery.length === 1 }]}>
                {teamProfile.gallery.map((photo, index) => (
                  <button class:list={["gallery-tile", photo.size && `is-${photo.size}`]} type="button" data-gallery-image={photo.src} data-gallery-alt={photo.alt} data-gallery-caption={photo.caption} aria-label={`${photo.caption} vergrößern`}>
                    <img src={photo.src} alt={photo.alt} width="1600" height="1200" loading="lazy" />
                    <span><small>{String(index + 1).padStart(2, '0')}</small><strong>{photo.caption}</strong><b aria-hidden="true">↗</b></span>
                  </button>
                ))}
              </div>
            </section>
          )}

          <section class="d-girls-cta" data-letter={teamProfile.letter}>
            <div><small>Lust auf Fußball?</small><h2>Mach den ersten Pass.</h2><p>{teamProfile.trial}</p></div>
            <a href={`mailto:${teamProfile.coaches.find((coach) => coach.email)?.email ?? (page.path.startsWith('jugend/') ? 'jugend@bsvnordstern.de' : 'info@bsvnordstern.de')}?subject=${encodeURIComponent(`Probetraining ${page.title}`)}`}>Probetraining anfragen <span>↗</span></a>
          </section>

          {teamProfile.gallery.length > 0 && <dialog class="gallery-dialog" aria-label="Vergrößerte Galerieansicht"><button class="gallery-close" type="button" aria-label="Galerie schließen">×</button><figure><img src="" alt="" /><figcaption></figcaption></figure></dialog>}
        </div>
      )}
      {migratedBody && <article class="legacy-content" set:html={migratedBody} />}
      {isDocumentPage && <DocumentPage document={documentProfile} />}
      {isYouthBoard && (
        <aside class="youth-contact-panel">
          <span class="youth-contact-star" aria-hidden="true">✦</span>
          <div>
            <small>Direkter Draht zur Jugend</small>
            <h2>Fragen, Ideen<br />oder Lust mitzumachen?</h2>
            <p>Unsere Jugendleitung hilft bei Fragen rund um Mannschaften, Training und das Engagement in der Jugendabteilung gerne weiter.</p>
          </div>
          <a href="mailto:jugend@bsvnordstern.de"><span>Jugendleitung kontaktieren</span><strong>↗</strong></a>
        </aside>
      )}
      {!migratedBody && !isDepartmentPage && !isDocumentPage && page.body && <div class="prose">{page.body.map((paragraph) => <p>{paragraph}</p>)}</div>}

      {!migratedBody && page.kind === 'events' && <div class="event-list"><article><time><b>11</b> JUL</time><div><small>07:00 – 14:00 Uhr</small><h2>Gebrauchträdermarkt</h2><p>Mit Zweirad Mees und dem Förderverein BSV Nordstern.</p></div></article><article><time><b>11</b> JUL</time><div><small>08:00 – 16:00 Uhr</small><h2>Flohmarkt</h2><p>Auf dem Gelände des BSV Nordstern, Schlesierstraße 43.</p></div></article></div>}

      {!migratedBody && !isDepartmentPage && page.people && <div class="people"><div class="section-title"><p>Menschen im BSV</p><h2>{page.kind === 'board' ? 'Unser Team.' : 'Ansprechpersonen.'}</h2></div><div class="people-grid">{page.people.map((person) => <article>{person.image ? <img src={person.image} alt={person.name} width="500" height="650" loading="lazy" /> : <div class="placeholder">{person.name.split(' ').map((part) => part[0]).join('')}</div>}<div><h3>{person.name}</h3><p>{person.role}</p></div></article>)}</div></div>}

      {page.kind === 'document' && !isDocumentPage && <aside class="document-cta"><div><small>Dokument & Auskunft</small><h2>Noch Fragen?</h2><p>Die Vorstandschaft hilft dir bei verbindlichen oder persönlichen Anliegen gerne weiter.</p></div><a href="mailto:info@bsvnordstern.de">Kontakt aufnehmen ↗</a></aside>}

      {page.path.includes('mitglied-werden') && <aside class="join-cta"><div><small>Auf geht’s grün</small><h2>Bereit für den BSV?</h2></div><a href="https://mitglied.bsvnordstern.de" target="_blank" rel="noreferrer">Online anmelden ↗</a></aside>}
    </section>
  </main>
  <Footer />

  <script>
    document.querySelectorAll<HTMLElement>('.legacy-content .contact-icons, .referee-page .contact-icons, .d-girls-page .contact-icons, .department-page .contact-icons').forEach((contacts, groupIndex) => {
      const links = [...contacts.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"], a[href^="tel:"]')];

      links.forEach((originalLink, linkIndex) => {
        const href = originalLink.getAttribute('href');
        if (!href) return;

        const isEmail = href.startsWith('mailto:');
        const value = decodeURIComponent(href.replace(/^(mailto:|tel:)/, ''));
        const panelId = `contact-${groupIndex}-${linkIndex}`;
        const toggle = document.createElement('button');
        const directLink = document.createElement('a');

        toggle.type = 'button';
        toggle.className = `contact-toggle ${isEmail ? 'is-email' : 'is-phone'}`;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-controls', panelId);
        toggle.setAttribute('aria-label', isEmail ? 'E-Mail-Adresse anzeigen' : 'Telefonnummer anzeigen');

        directLink.id = panelId;
        directLink.className = 'contact-value';
        directLink.href = href;
        directLink.hidden = true;
        directLink.textContent = value;
        directLink.setAttribute('aria-label', isEmail ? `E-Mail an ${value}` : `${value} anrufen`);

        toggle.addEventListener('click', () => {
          const willOpen = directLink.hidden;
          contacts.querySelectorAll<HTMLButtonElement>('.contact-toggle').forEach((button) => button.setAttribute('aria-expanded', 'false'));
          contacts.querySelectorAll<HTMLElement>('.contact-value').forEach((contact) => contact.hidden = true);
          toggle.setAttribute('aria-expanded', String(willOpen));
          directLink.hidden = !willOpen;
        });

        originalLink.replaceWith(toggle, directLink);
      });
    });

    const galleryDialog = document.querySelector<HTMLDialogElement>('.gallery-dialog');
    const galleryDialogImage = galleryDialog?.querySelector<HTMLImageElement>('img');
    const galleryDialogCaption = galleryDialog?.querySelector<HTMLElement>('figcaption');

    document.querySelectorAll<HTMLButtonElement>('[data-gallery-image]').forEach((tile) => {
      tile.addEventListener('click', () => {
        if (!galleryDialog || !galleryDialogImage || !galleryDialogCaption) return;
        galleryDialogImage.src = tile.dataset.galleryImage ?? '';
        galleryDialogImage.alt = tile.dataset.galleryAlt ?? '';
        galleryDialogCaption.textContent = tile.dataset.galleryCaption ?? '';
        galleryDialog.showModal();
      });
    });

    galleryDialog?.querySelector<HTMLButtonElement>('.gallery-close')?.addEventListener('click', () => galleryDialog.close());
    galleryDialog?.addEventListener('click', (event) => {
      if (event.target === galleryDialog) galleryDialog.close();
    });

    document.querySelectorAll<HTMLDetailsElement>('.org-unit').forEach((unit) => {
      unit.addEventListener('toggle', () => {
        if (!unit.open) return;
        document.querySelectorAll<HTMLDetailsElement>('.org-unit').forEach((otherUnit) => {
          if (otherUnit !== unit) otherUnit.open = false;
        });
      });
    });
  </script>
</Layout>

