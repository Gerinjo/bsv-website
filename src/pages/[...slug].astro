ument-cta p{margin:0;color:#66766b}.document-cta a,.join-cta a{padding:16px 20px;background:var(--green);color:white;font-weight:800;text-decoration:none;white-space:nowrap}.join-cta{background:var(--yellow)}.join-cta a{background:var(--dark)}footer{padding:38px 0;background:#061f15;color:#94aa9c;font-size:.78rem}footer .shell{display:flex;justify-content:space-between;gap:25px}footer strong{color:white}footer a{color:inherit}@media(max-width:980px){.hero-grid{grid-template-columns:1fr}.hero-image{width:min(100%,680px)}.people-grid{grid-template-columns:repeat(3,1fr)}.org-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.shell{width:min(100% - 30px,1120px)}.page-hero{padding:55px 0}.back{margin-bottom:35px}.hero-grid{gap:45px}.hero-image{width:calc(100% - 14px)}.content{padding-top:70px}.people-grid{grid-template-columns:repeat(2,1fr);gap:12px}.people-grid img,.placeholder{height:210px}.organization{padding:20px}.org-grid{grid-template-columns:1fr}.event-list article{grid-template-columns:80px 1fr;gap:18px;padding:15px}.document-cta,.join-cta{padding:30px;align-items:flex-start;flex-direction:column}footer .shell{flex-direction:column}}
