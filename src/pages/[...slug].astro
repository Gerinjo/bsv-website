---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import { legacyContent } from '../data/legacyContent';
import { sportsPages, sportsPaths } from '../data/sportsPages';

type Person = { name: string; role: string; image?: string };
type Page = { path: string; eyebrow: string; title: string; intro: string; image: string; body?: string[]; people?: Person[]; kind?: 'history' | 'board' | 'events' | 'document' | 'organization' };
type HistoryChapter = { date: string; eyebrow: string; title: string; subtitle: string; paragraphs: string[]; image?: string; caption?: string; roster?: string; fact?: { value: string; label: string } };

const people: Person[] = [
  { name: 'Sandra Fuchs', role: '1. Vorstand', image: '/images/verein/personen/sandra-fuchs.jpg' },
  { name: 'Felix Schüle', role: '2. Vorstand', image: '/images/verein/personen/felix-schuele.jpg' },
  { name: 'Claudia Gastaudo', role: 'Kassiererin', image: '/images/verein/personen/claudia-gastaudo.jpg' },
  { name: 'Michaela Auer', role: 'Schriftführerin', image: '/images/verein/personen/michaela-auer.jpg' },
  { name: 'Nicole Erbes', role: 'Sportliche Leitung Frauen', image: '/images/verein/personen/nicole-erbes.jpg' },
  { name: 'Ann-Kathrin Sugg', role: 'Sportliche Leitung Frauen' },
  { name: 'Karsten Grammel', role: 'Sportliche Leitung Alte Herren' },
  { name: 'Oliver Schillinger', role: 'Spielbetrieb' },
  { name: 'Manuel Schellhammer', role: 'Passwesen', image: '/images/verein/personen/manuel-schellhammer.jpg' },
  { name: 'Konrad Mauz', role: 'Abteilungsleiter Bogensport', image: '/images/verein/personen/konrad-mauz.jpg' },
  { name: 'Heike Seidel', role: 'Abteilungsleitung Gymnastik', image: '/images/verein/personen/heike-seidel.jpg' },
  { name: 'Thomas Graf', role: 'Abteilungsleiter Wandern' },
  { name: 'Sigrid Burkhardt', role: 'Mitgliederbestandspflege', image: '/images/verein/personen/sigrid-burkhardt.jpg' },
  { name: 'Jérôme Ernsberger', role: 'IT & Administration', image: '/images/verein/personen/jerome-ernsberger.jpg' },
  { name: 'Markus Sawicki', role: 'Einkauf & Organisation', image: '/images/verein/personen/markus-sawicki.jpg' },
  { name: 'Ole Schmal', role: 'Marketing & Social Media' },
  { name: 'Julian Kemmer', role: 'Presse', image: '/images/verein/personen/julian-kemmer.jpg' },
  { name: 'Mario Jost', role: 'Platzwart', image: '/images/verein/personen/mario-jost.jpg' },
  { name: 'Eberhard Klinkenberg', role: 'Hausmeister', image: '/images/verein/personen/eberhard-klinkenberg.jpg' },
  { name: 'Markus Moßbrugger', role: 'Schlüsselmanagement' },
];

const pages: Page[] = [
  { path: 'verein', eyebrow: 'BSV Nordstern Radolfzell', title: 'Unser Verein', intro: 'Sport, Gemeinschaft und Heimat – seit 1956 ist der BSV ein fester Teil von Radolfzell.', image: '/images/verein/bereiche/verein.jpeg', body: ['Was als Ball-Spiel-Verein in der Altbohl-Siedlung begann, ist heute eine vielseitige Sportgemeinschaft für alle Generationen.', 'Fußball, Bogensport, Gymnastik und Wandern geben unseren Mitgliedern Raum für Bewegung, Begegnung und gemeinsames Engagement.'] },
  { path: 'verein/vorstandschaft', eyebrow: 'Menschen, die bewegen', title: 'Vorstandschaft', intro: 'Engagierte Menschen gestalten die Zukunft unseres Vereins und halten das tägliche Vereinsleben in Bewegung.', image: '/images/verein/personen/sandra-fuchs.jpg', kind: 'board', people },
  { path: 'verein/geschichte', eyebrow: 'Seit 1956', title: 'Unsere Geschichte', intro: 'Von einer mutigen Idee im Altbohl-Stüble zu einem lebendigen Mehrspartenverein.', image: '/images/verein/bereiche/geschichte.jpg', kind: 'history' },
  { path: 'verein/organigramm', eyebrow: 'Struktur & Verantwortung', title: 'Organigramm', intro: 'Viele Aufgaben, klare Verantwortlichkeiten und ein gemeinsames Ziel: ein Verein, der gut funktioniert.', image: '/images/verein/bereiche/verein.jpeg', kind: 'organization' },
  { path: 'verein/satzung', eyebrow: 'Das Fundament', title: 'Satzung', intro: 'Unsere Satzung legt Ziele, Organisation sowie Rechte und Pflichten innerhalb des BSV Nordstern fest.', image: '/images/verein/bereiche/geschichte.jpg', kind: 'document', body: ['Sie bildet die rechtliche Grundlage der Vereinsarbeit, beschreibt die Aufgaben der Organe und sichert die gemeinnützige Förderung des Sports und der Jugend.', 'Für verbindliche Auskünfte gilt immer die aktuell beschlossene und unterzeichnete Fassung der Vereinssatzung.'] },
  { path: 'verein/beitragsordnung', eyebrow: 'Transparent & fair', title: 'Beitragsordnung', intro: 'Mitgliedsbeiträge sichern Trainingsbetrieb, Anlagen und eine verlässliche Vereinsarbeit.', image: '/images/verein/bereiche/verein.jpeg', kind: 'document', body: ['Die Beitragsordnung regelt Beitragshöhen, Fälligkeiten und Ermäßigungen. Zum 1. Januar 2026 wurde die Beitragsordnung durch die Mitgliederversammlung angepasst.', 'Die vollständige, rechtsverbindliche Fassung bleibt maßgeblich. Bei Fragen hilft die Vorstandschaft gerne weiter.'] },
  { path: 'verein/mitglied-werden', eyebrow: 'Willkommen beim BSV', title: 'Mitglied werden', intro: 'Lebe deinen Sport, lerne neue Menschen kennen und werde Teil unserer lebendigen Gemeinschaft.', image: '/images/verein/bereiche/verein.jpeg', body: ['Als Mitglied kannst du in unseren Mannschaften und Abteilungen trainieren, an Veranstaltungen teilnehmen oder dich ehrenamtlich engagieren.', 'Unsere Trainerinnen, Trainer und Verantwortlichen begleiten dich beim Einstieg und finden gemeinsam mit dir das passende Angebot.'] },
  { path: 'verein/kuendigung', eyebrow: 'Mitgliedschaft', title: 'Kündigung', intro: 'Schade, dass du uns verlassen möchtest. Hier findest du die wichtigsten Hinweise zum Austritt.', image: '/images/verein/bereiche/geschichte.jpg', kind: 'document', body: ['Der Austritt erfolgt durch eine schriftliche Erklärung an den geschäftsführenden Vorstand. Er ist zum Ende eines Kalenderjahres unter Einhaltung einer Kündigungsfrist von sechs Wochen möglich.', 'Verpflichtungen gegenüber dem Verein sind bis zum Ablauf des laufenden Kalenderjahres zu erfüllen. Maßgeblich ist § 7 der aktuellen Satzung.'] },
  { path: 'verein/termine', eyebrow: 'Gemeinsam erleben', title: 'Termine', intro: 'Veranstaltungen, Feste und besondere Tage rund um den BSV Nordstern.', image: '/images/verein/bereiche/verein.jpeg', kind: 'events' },
  { path: 'foerderverein/vorstandschaft', eyebrow: 'Unterstützen & ermöglichen', title: 'Förderverein', intro: 'Der Förderverein schafft zusätzliche Möglichkeiten für Sport, Jugend und Vereinsleben.', image: '/images/verein/bereiche/geschichte.jpg', body: ['Mit persönlichem Einsatz, Veranstaltungen und finanzieller Unterstützung hilft der Förderverein dort, wo gute Ideen zusätzliche Kraft brauchen.', 'Bei Fragen zur Arbeit und Vorstandschaft des Fördervereins erreichst du uns über die zentrale Vereinsadresse.'] },
  { path: 'foerderverein/mitglied-werden', eyebrow: 'Gemeinsam fördern', title: 'Fördermitglied werden', intro: 'Unterstütze Projekte, Ausstattung und die Zukunft des BSV Nordstern Radolfzell.', image: '/images/verein/bereiche/verein.jpeg', body: ['Du kannst bei Veranstaltungen mithelfen, Sportgeräte und Ausstattung ermöglichen oder die finanzielle Basis unserer Vereinsarbeit stärken.', 'Jeder Beitrag – ob Zeit, Idee oder Förderung – kommt unserer Vereinsgemeinschaft zugute.'] },
  { path: 'abteilungen/gymnastik', eyebrow: 'Beweglich & gemeinsam', title: 'Gymnastik', intro: 'Fitness erhalten und gemeinsam Spaß an der Bewegung haben.', image: '/images/verein/bereiche/gymnastik.jpeg', body: ['Abteilungsleiterin: Luzia Menz', 'Training: Dienstag von 19:00 bis 20:15 Uhr in der Gymnastikhalle des BSV Nordstern.'] },
  { path: 'abteilungen/bogensport', eyebrow: 'Ruhe. Fokus. Präzision.', title: 'Bogensport', intro: 'Breiten- und Leistungssport auf unserem Nebenplatz an der Schlesierstraße.', image: '/images/verein/bereiche/bogensport.jpg', body: ['Abteilungsleiter: Konrad Mauz', 'Training: Freitag von 17:30 bis 19:00 Uhr auf dem Nebenplatz des BSV Nordstern. Die Abteilung führt derzeit eine Warteliste für Interessierte.'] },
  { path: 'abteilungen/wandergruppe', eyebrow: 'Draußen zuhause', title: 'Wandergruppe', intro: 'Gemeinsam unterwegs – bei jeder Witterung und mit Freude an Natur und Geselligkeit.', image: '/images/verein/bereiche/wandern.jpg', people: [
    { name: 'Peter Weidele', role: 'Wanderführer · 0152 / 05170308' }, { name: 'Jutta Fuchs', role: 'Wanderführerin · 07732 / 12379' }, { name: 'Anita Steppacher', role: 'Wanderführerin · 0170 / 5757127' }, { name: 'Siggi Bayer', role: 'Wanderführer · 07732 / 4938' }, { name: 'Thomas Graf', role: 'Wanderführer · 0176 / 54027893' },
  ], body: ['Unterstützt werden die Wanderungen durch Josef Fuchs und Patrick Kittel. Die Strecken können je nach Wetterlage angepasst werden.', 'Aktuelle Wanderbeschreibungen erscheinen im Hallo Radolfzell und im Schaukasten des BSV Nordstern.'] },
];
pages.push(...sportsPages);

export function getStaticPaths() {
  return [
    'verein', 'verein/vorstandschaft', 'verein/geschichte', 'verein/organigramm',
    'verein/satzung', 'verein/beitragsordnung', 'verein/mitglied-werden',
    'verein/kuendigung', 'verein/termine', 'foerderverein/vorstandschaft',
    'foerderverein/mitglied-werden', 'abteilungen/gymnastik',
    'abteilungen/bogensport', 'abteilungen/wandergruppe', ...sportsPaths,
  ].map((slug) => ({ params: { slug } }));
}
const page = pages.find((entry) => entry.path === Astro.params.slug) as Page;
const isYouthConcept = page.path === 'jugend/jugendkonzept';
const isRefereePage = page.path === 'jugend/jugendschiedsrichter';
const isYouthBoard = page.path === 'jugend/vorstandschaft';
const isHistoryPage = page.path === 'verein/geschichte';
const migratedBody = isYouthConcept || isRefereePage || isHistoryPage ? undefined : legacyContent[page.path];
const section = page.path.startsWith('fussball') ? { label: 'Fußball', href: '/fussball' } : page.path.startsWith('jugend') ? { label: 'Jugend', href: '/jugend' } : { label: 'Verein', href: '/verein' };
const heroTitleClass = page.title.length >= 20 ? 'is-extra-long' : page.title.length >= 16 ? 'is-long' : undefined;
const isPortraitHero = page.image.includes('/personen/');

const conceptPrinciples = [
  { title: 'Sportliche Angebote', text: 'Wir bieten eine breite Palette von Fußballaktivitäten und Programmen, die auf die Bedürfnisse und Interessen unserer jugendlichen Mitglieder zugeschnitten sind. Von Trainingseinheiten über Turniere bis hin zu Freundschaftsspielen – bei uns ist für alle etwas dabei, um das fußballerische Können zu verbessern und Spaß zu haben.', image: '/images/migration/95a716aa54-BSV2023-71.jpg' },
  { title: 'Persönliche Entwicklung', text: 'Wir legen Wert darauf, dass unsere Jugendlichen nicht nur auf dem Platz, sondern auch im Leben Erfolg haben. Durch Teamwork, Fairplay und Selbstvertrauen unterstützen wir sie dabei, zu selbstbewussten und verantwortungsvollen jungen Menschen heranzuwachsen.' },
  { title: 'Talente & Potenziale', text: 'Jeder junge Mensch hat individuelle Talente und Fähigkeiten, die es zu entdecken und zu fördern gilt. Wir unterstützen talentierte Spielerinnen und Spieler dabei, ihr Potenzial zu entfalten und ihre sportlichen Ziele zu erreichen.' },
  { title: 'Teamgeist & Gemeinschaft', text: 'Zusammenhalt und Zugehörigkeit sind uns besonders wichtig. Gemeinsame Aktivitäten, Teambuilding, Trainingslager und Ausflüge stärken den Gemeinschaftssinn und schaffen echte Freundschaften.', image: '/images/migration/098fa63758-BSV2023-285.jpg' },
  { title: 'Integration & Vielfalt', text: 'Unser Verein ist ein Ort der Vielfalt. Jugendliche aus unterschiedlichen Hintergründen und Kulturen sollen sich willkommen fühlen. Wir fördern einen respektvollen Umgang – unabhängig von Herkunft, Geschlecht oder sozialem Status.' },
  { title: 'Elternbeteiligung', text: 'Die Unterstützung der Eltern spielt eine entscheidende Rolle. Elternabende, Informationsveranstaltungen und Möglichkeiten zur Mitarbeit fördern den Austausch und schaffen eine Gemeinschaft, die unsere Jugendlichen trägt.' },
  { title: 'Mitbestimmung', text: 'Wir ermutigen Jugendliche, sich aktiv am Vereinsleben zu beteiligen, eigene Ideen einzubringen und Entscheidungen mitzugestalten. Regelmäßige Jugendversammlungen sorgen dafür, dass ihre Stimmen gehört werden.', image: '/images/migration/21579480c3-BSV2023-318.jpg' },
  { title: 'Gesundheit & Prävention', text: 'Neben dem sportlichen Training gehören Ernährung, Verletzungsprävention und mentale Gesundheit zu einer ganzheitlichen Entwicklung. Wir vermitteln Wissen und schaffen ein gesundes, sicheres Umfeld.' },
];

const youthReferees = [
  { name: 'Stefan Gastaudo', role: 'Ansprechpartner Jugendschiedsrichter', image: '/images/verein/personen/stefan-gastaudo.jpg', email: 'Stefan.Gastaudo@bsvnordstern.de', phone: '+491795111126' },
  { name: 'Remo Schellhammer', role: 'Jugendschiedsrichter', image: '/images/verein/personen/remo-schellhammer.jpg' },
  { name: 'Leonardo Gastaudo', role: 'Jugendschiedsrichter', image: '/images/verein/personen/leonardo-gastaudo.jpg' },
  { name: 'Mia Julie Huber', role: 'Jugendschiedsrichterin', image: '/images/verein/personen/mia-julie-huber.jpg', balancedPortrait: true, portraitScale: '.92' },
  { name: 'Johannes Horn', role: 'Jugendschiedsrichter', image: '/images/verein/personen/johannes-horn.jpg', balancedPortrait: true, portraitScale: '.76' },
];

const historyChapters: HistoryChapter[] = [
  {
    date: '11. Juli 1956', eyebrow: 'Gründung', title: 'Ein Verein entsteht.', subtitle: 'Ball-Spiel-Verein Nordstern Radolfzell',
    paragraphs: [
      'Am 11. Juli 1956 lud Albin Richter die Bewohner der Altbohl-Siedlung sowie die Angehörigen der „Framo“ zu einer Versammlung ins Altbohl-Stüble ein. Ziel war die Gründung des Sportvereins „Radolfzell-Altbohl“.',
      '32 Personen folgten der Einladung dieses Idealisten und eigentlichen Gründers des Ball-Spiel-Verein Nordstern Radolfzell. Nicht alle begrüßten die Entstehung eines neuen Sportvereins – und nur wenige gaben dem Vorhaben damals eine echte Chance.',
    ],
    fact: { value: '32', label: 'Gründungsmitglieder' },
  },
  {
    date: '08. August 1956', eyebrow: 'Erste Hauptversammlung', title: 'Zusammenhalt von Anfang an.', subtitle: 'Fußball, Damenhandball und gelebte Kameradschaft',
    paragraphs: [
      'Am 08. August 1956 berief Albin Richter die erste ordentliche Hauptversammlung im Altbohl-Stüble ein. Viele Aufgaben lagen vor der neuen Vorstandschaft. Neben dem Fußball sollte auch eine Damenhandball-Mannschaft ihren sportlichen Ehrgeiz zeigen.',
      'Die Damenmannschaft spielte mit großem Erfolg in der internationalen Bodenseeklasse – unter anderem gegen Schweizer Meister aus Zürich und St. Gallen. 1964 wurde der Handballbetrieb seitens der Vereinsleitung leider eingestellt.',
      'Zur französischen Garnison in der Kaserne bestand ein guter Kontakt und eine herzliche Kameradschaft. So durften die Handballerinnen die dortige Sporthalle für ihr Training nutzen. Beide Mannschaften mussten zu Beginn manche hohe Niederlage verkraften. Vielleicht war es gerade deshalb der außergewöhnliche Zusammenhalt, der diese Teams auszeichnete.',
    ],
    image: '/images/migration/6874ee100f-bild_team1956.jpg', caption: 'Eine der ersten Mannschaften des jungen BSV Nordstern.',
    roster: 'Von links oben: K. Stocker, M. Tausendfreund, E. Hafel, E. Reinhard, H. Günther, B. Schlicht, R. Strobel, H. Voigt, A. Lauinger, R. Günther, W. Frank und 1. Vorsitzender A. Richter. A-Jugend, kniend von links: E. Emmerich, S. Hainke, J. Kühl, G. Kassner, H. Günther, B. Schlicht, H. Wildemann, M. Ring, M. Kähl, W. Beck, W. Berg und W. Motz.',
  },
  {
    date: 'Sommer 1964', eyebrow: 'Anton Beck sen.', title: 'Endlich ein eigener Sportplatz.', subtitle: 'Aus Ausdauer wird ein Zuhause',
    paragraphs: [
      'Nachfolger von Albin Richter wurde Anton Beck sen. Unter seiner Führung erhielt der Verein endlich einen eigenen Sportplatz. Von den ehemaligen Umkleidekabinen des Mettnau-Stadions bekam der BSV die Hälfte zum Wiederaufbau. Zusätzlich entstanden Umkleidekabinen für Spieler und Schiedsrichter.',
      'Für seine unermüdlichen Arbeitseinsätze und seine große Spendenbereitschaft wurde Anton Beck sen. später zum Ehrenpräsidenten des Vereins ernannt.',
    ],
    image: '/images/migration/58966a3bb9-bild_team1964.jpg', caption: 'Die Meistermannschaft des Jahres 1964.',
  },
  {
    date: '16. Oktober 1970', eyebrow: 'Christian Peetz', title: 'Der große Ausbau beginnt.', subtitle: 'Vom neuen Platz bis zum ersten Spatenstich',
    paragraphs: [
      'Auch sportlich ging es aufwärts: von der C-Klasse über die B-Klasse bis in die A-Klasse. Am 16. Oktober 1970 wurde Christian Peetz zum 1. Vorsitzenden gewählt. Noch am selben Abend gab Bürgermeister Fritz Riester grünes Licht für den Bau eines neuen eigenen Platzes.',
      'Am 12. August 1973 weihte Bürgermeister Riester – Mitglied und Freund des BSV Nordstern – den neuen Sportplatz ein. Nach dessen Fertigstellung folgte die nächste große Aufgabe: ein Sportheim, das der Qualität der Anlage entsprechen sollte.',
      'In beinahe ständigen Verhandlungen überzeugte Christian Peetz die entscheidenden Institutionen von der Notwendigkeit eines Klubheims. Am 04. November 1975 erfolgte der erste Spatenstich. Bereits der Sportplatzbau hatte 311.000 DM gekostet; damit war allen bewusst, welche neue finanzielle Belastung auf den Verein zukam.',
    ],
    fact: { value: '1973', label: 'Einweihung des neuen Sportplatzes' },
  },
  {
    date: '10. Dezember 1977', eyebrow: 'Vereinsheim & Aufstieg', title: '16.000 Stunden für den Nordstern.', subtitle: 'Ein Haus, das die Mitglieder selbst bauten',
    paragraphs: [
      'Am 10. Dezember 1977 eröffnete Bürgermeister Günther Neurohr das neue Sportheim. Die BSV-Mitglieder hatten dafür unglaubliche 16.000 Arbeitsstunden Eigenleistung erbracht – die unzähligen Verhandlungsstunden des damaligen Vorsitzenden Christian Peetz noch nicht mitgerechnet.',
      'Besondere Verdienste erwarben sich Werner Beck, Anton Beck jun., Siggi Bayer und Anton Beck sen. Letztere wurden für ihren Einsatz zu Ehrenmitgliedern ernannt. Am 21. Januar 1979 folgte die Einweihung der Kegelbahnen, deren Bau 66.000 DM kostete. 1981 wurde schließlich der Parkplatz hergerichtet, der bis heute auch Besuchern des Naherholungsgebiets Altbohlwald dient.',
      'Parallel wuchs die Jugendarbeit: Bereits 1981 spielten über 100 Jugendliche in fünf Mannschaften. Der größte sportliche Erfolg jener Jahre war der Aufstieg der ersten Mannschaft in die Bezirksliga Bodensee. Unter Trainer Herbert Häring beendete das Team die Saison mit 91:35 Toren und 46:14 Punkten.',
    ],
    image: '/images/migration/bafa76fabf-bild_team1980.jpg', caption: 'Das Aufstiegsteam in die Bezirksliga 1980.',
  },
  {
    date: '1981–1998', eyebrow: 'Berg- und Talfahrt', title: 'Immer wieder aufstehen.', subtitle: 'Zwischen Kreisliga B und Bezirksliga',
    paragraphs: [
      'Nach dem Abstieg aus der Bezirksliga fand sich der BSV Mitte der achtziger Jahre in der Kreisliga B wieder. Fast jedes Jahr lautete das Ziel Aufstieg in die A-Klasse, doch Platz eins blieb zunächst außer Reichweite. Unter Trainer Wolfgang Eggert gelang als Tabellenzweiter schließlich der Sprung nach oben, weil der FC Wollmatingen II aufgrund des Abstiegs seiner ersten Mannschaft nicht aufsteigen durfte.',
      'Das Glück währte nur kurz: Wegen einer Strukturänderung gab es in der folgenden Saison vier Absteiger aus der A-Klasse statt der üblichen ein bis zwei – der BSV war einer davon.',
      'Ab der Saison 1992/93 übernahm der bisherige Kapitän Eric Bourguignon das Traineramt. In seinen ersten drei Jahren verpasste die Mannschaft mit zwei Vizemeisterschaften und einem dritten Platz den Aufstieg nur knapp. Nach einem schweren Einbruch 1995/96 folgte der Höhepunkt: 1998 sicherte sich der BSV in einem Herzschlagfinale am letzten Spieltag die Meisterschaft.',
    ],
    image: '/images/migration/2ba05b8d72-bild_team1998.jpg', caption: 'Die Meistermannschaft der Saison 1997/98.',
    roster: 'Obere Reihe von links: Spielausschuss Schädler, Betreuer Glatt, Sawicki, Bitter, Bracht, Wernick, Binder, Vogler, Schmid, Krause, Özkol, Klinkenberg, Tripodi und Trainer Bourguignon. Untere Reihe von links: Beck, Eggert, Widmann, A. Schmitt, Burkhart, Bickel, Unger, M. Schmitt, Schwarz, Nohl und Otto.',
  },
  {
    date: '30. Juni 2015', eyebrow: 'Durchmarsch', title: 'Zurück in die Kreisliga A.', subtitle: 'Eine Saison mit 118 Toren',
    paragraphs: [
      'Nach einem weiteren Abstieg gelang 1999/2000 erneut der Aufstieg in die Kreisliga A. Der mittlerweile als Fahrstuhlmannschaft bekannte BSV stieg 2001/02 jedoch wieder ab und scheiterte anschließend mehrfach knapp am Wiederaufstieg.',
      'In der Saison 2014/15 war es schließlich so weit: Unter Spielertrainer Antonio Fiore Tapia gelang mit einer herausragenden Tordifferenz von 118:22 Toren und 60 Punkten aus 22 Spielen die Rückkehr in die Kreisliga A.',
      'Antonio Fiore Tapia wurde mit 35 Treffern Torschützenkönig. Sein Bruder Daniel folgte mit 26 Toren auf Platz zwei, Sven Dieterle belegte mit 23 Treffern Rang vier.',
    ],
    image: '/images/migration/fb6712e6c9-Meister2015.jpg', caption: 'Die Meistermannschaft und Aufsteiger des Jahres 2015.',
  },
];
---

<Layout title={`${page.title} – BSV Nordstern Radolfzell`} description={page.intro}>
  <Header />
  <main>
    <section class:list={["page-hero", { "referee-hero": isRefereePage }]}>
      <div class="shell hero-grid">
        <div class="hero-copy"><a class="back" href={section.href}>← {section.label}</a><p class="eyebrow">{page.eyebrow}</p><h1 class={heroTitleClass}>{page.title}</h1><p class="lead">{page.intro}</p></div>
        <div class="hero-image"><img class:list={{ 'is-portrait': isPortraitHero }} src={page.image} alt="" width="900" height="650" /><span>BSV · 1956</span></div>
      </div>
    </section>

    <section class="content shell">
      {isRefereePage && (
        <div class="referee-page">
          <section class="referee-intro">
            <div><span>Fairness braucht Haltung</span><h2>Entscheiden.<br /><em>Verantwortung tragen.</em></h2></div>
            <div class="referee-copy"><p>Der BSV Nordstern Radolfzell ist stolz auf seine engagierten Jugendschiedsrichterinnen und Jugendschiedsrichter. Sie leiten Spiele im gesamten Raum Bodensee und sorgen dafür, dass der Spielbetrieb fair und reibungslos verläuft.</p><p>Fundiertes Regelwissen, ein klarer Kopf und der Mut, auch unter Druck die richtige Entscheidung zu treffen, machen sie zu Vorbildern auf und neben dem Platz.</p></div>
          </section>

          <section class="referee-team">
            <div class="referee-head"><div><span>Unser Team</span><h2>Die Menschen<br />mit der Pfeife.</h2></div><p>Fünf Persönlichkeiten, ein gemeinsames Ziel: Fußball fair und verlässlich möglich machen.</p></div>
            <div class="referee-grid">
              {youthReferees.map((referee, index) => (
                <article class:list={["referee-card", { coordinator: index === 0 }]}>
                  <span class="referee-number">0{index + 1}</span>
                  <div class:list={["referee-portrait", { "is-balanced": referee.balancedPortrait }]} style={referee.balancedPortrait ? `--portrait-image:url('${referee.image}');--portrait-scale:${referee.portraitScale}` : undefined}>
                    {referee.image ? <img src={referee.image} alt={referee.name} width="500" height="650" loading="lazy" /> : <span>{referee.name.split(' ').map((part) => part[0]).join('')}</span>}
                  </div>
                  <div class="referee-info"><h3>{referee.name}</h3><p>{referee.role}</p>
                    {(referee.email || referee.phone) && <div class="contact-icons">
                      {referee.email && <a href={`mailto:${referee.email}`} aria-label={`E-Mail an ${referee.name}`}></a>}
                      {referee.phone && <a href={`tel:${referee.phone}`} aria-label={`${referee.name} anrufen`}></a>}
                    </div>}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="referee-thanks">
            <div><span>Mentoring</span><h2>Rückhalt für<br />junge Schiris.</h2></div>
            <div><p>Ein besonderer Dank gilt Stefan Gastaudo. Als Ansprechpartner unterstützt und begleitet er unsere jungen Schiedsrichterinnen und Schiedsrichter, damit sie jede Woche gut vorbereitet und motiviert auf dem Platz stehen.</p><p>Er ist Mentor, verlässlicher Ansprechpartner und Vorbild für unsere jungen Talente.</p></div>
          </section>

          <section class="referee-cta">
            <span aria-hidden="true">✦</span><div><small>Neue Perspektive gesucht?</small><h2>Werde Schiedsrichter:in.</h2><p>Du liebst Fußball und möchtest Verantwortung übernehmen? Ob Mädchen oder Junge – bei uns bist du willkommen. Wir begleiten dich bei deinen ersten Schritten und darüber hinaus.</p></div><a href="mailto:Stefan.Gastaudo@bsvnordstern.de">Interesse anmelden <b>↗</b></a>
          </section>
        </div>
      )}
      {isYouthConcept && (
        <div class="concept-page">
          <section class="concept-opening">
            <div class="concept-heading">
              <span>01 · Warum</span>
              <h2>Ein Plan für<br /><em>junge Menschen.</em></h2>
            </div>
            <div class="concept-copy">
              <p>Willkommen beim BSV Nordstern Radolfzell! Als fester Bestandteil unserer Stadt am Bodensee ist es uns ein Anliegen, nicht nur die Tradition des Sports zu pflegen, sondern aktiv zur Entwicklung unserer Jugend beizutragen.</p>
              <h3>Was ist ein Jugendkonzept?</h3>
              <p>Ein Jugendkonzept ist ein strategischer Plan, der die Bedürfnisse, Interessen und Potenziale junger Menschen innerhalb des Vereins erfasst und fördert. Es ist unsere gemeinsame Blaupause dafür, wie wir Jugendliche erreichen, unterstützen und in das Vereinsleben integrieren.</p>
              <p>Wir nehmen ihre Ideen und Anliegen ernst und begleiten sie auf dem Weg zu selbstbewussten, verantwortungsvollen Mitgliedern der Gemeinschaft. Dafür schaffen wir einen sicheren und inspirierenden Raum, in dem junge Menschen ihre Talente im Sport, bei Veranstaltungen und durch die Übernahme von Verantwortung entfalten können.</p>
            </div>
          </section>

          <section class="concept-promise">
            <div class="promise-title"><span>Unser Versprechen</span><strong>Zuhören.<br />Fördern.<br />Vertrauen.</strong></div>
            <div class="promise-copy"><p>Der BSV Nordstern ist nicht nur ein Ort für sportliche Aktivitäten, sondern ein Zuhause für unsere Jugendlichen. Sie sollen sich willkommen, sicher und unterstützt fühlen.</p><p>Wir hören ihre Stimmen, verstehen ihre Bedürfnisse und begleiten sie bei ihren sportlichen und persönlichen Zielen.</p></div>
            <span class="promise-star" aria-hidden="true">✦</span>
          </section>

          <section class="principles-section">
            <div class="concept-section-head"><div><span>02 · Wie</span><h2>Acht Prinzipien.<br />Ein gemeinsamer Weg.</h2></div><p>Unsere Leitlinien verbinden sportliche Qualität mit sozialer Verantwortung.</p></div>
            <div class="principles-grid">
              {conceptPrinciples.map((principle, index) => (
                <article class:list={["principle-card", { "has-image": principle.image, "is-wide": index === 0 || index === 3 || index === 6 }]}>
                  {principle.image && <img src={principle.image} alt="Jugendliche des BSV Nordstern beim Fußball" width="900" height="600" loading="lazy" />}
                  <div><span>0{index + 1}</span><h3>{principle.title}</h3><p>{principle.text}</p></div>
                </article>
              ))}
            </div>
          </section>

          <section class="concept-join">
            <div class="join-photo"><img src="/images/migration/571bd8370a-20230722_133328.jpg" alt="Gemeinschaft in der BSV-Jugend" width="1200" height="800" loading="lazy" /><span>#aufgehtsgrün</span></div>
            <div class="join-message"><span>03 · Mitmachen</span><h2>Deine Stimme zählt.</h2><p>Möchtest du Teil dieser Reise sein? Bring deine Ideen ein, übernimm Verantwortung und gestalte mit uns die Zukunft der BSV-Jugend.</p><a href="mailto:jugend@bsvnordstern.de">Jugendabteilung kontaktieren <b>↗</b></a></div>
          </section>

          <section class="concept-documents">
            <div><span>Vertiefende Dokumente</span><h2>Zum Nachlesen.</h2></div>
            <div class="document-links">
              <a href="/images/migration/83266e0a0b-BSV_Jugendkonzept-2015.pdf" target="_blank"><span>PDF · Stand 2015</span><strong>BSV Jugendkonzept</strong><b>↓</b></a>
              <a href="/images/migration/eaf3ae53f8-DFB-Ausbildungskonzeption.pdf" target="_blank"><span>PDF · Ausbildung</span><strong>DFB-Konzeption</strong><b>↓</b></a>
            </div>
          </section>
        </div>
      )}
      {isHistoryPage && (
        <div class="history-page">
          <section class="history-opening">
            <div><span>Seit 1956</span><h2>Aus einer Idee<br />wurde <em>Heimat.</em></h2></div>
            <div><p>Die Geschichte des BSV Nordstern ist eine Geschichte von Menschen, die angepackt haben. Von 32 Gründungsmitgliedern im Altbohl-Stüble bis zu Generationen von Sportlerinnen, Sportlern und Ehrenamtlichen.</p><p>Plätze und Vereinsheim entstanden mit Beharrlichkeit und tausenden Stunden Eigenleistung. Aufstiege, Rückschläge und Neuanfänge haben den Verein geprägt – der Zusammenhalt ist geblieben.</p></div>
          </section>

          <section class="history-numbers" aria-label="Zahlen aus der Vereinsgeschichte">
            <div><strong>1956</strong><span>Gründungsjahr</span></div>
            <div><strong>32</strong><span>Menschen beim Start</span></div>
            <div><strong>16.000</strong><span>Stunden Eigenleistung</span></div>
            <div><strong>118:22</strong><span>Tore in der Saison 2014/15</span></div>
          </section>

          <section class="history-chronicle">
            <div class="history-head"><span>Unsere Chronik</span><h2>Sieben Kapitel.<br />Ein Nordstern.</h2></div>
            <div class="history-track">
              {historyChapters.map((chapter, index) => (
                <article class:list={["history-chapter", { "is-reverse": index % 2 === 1 }]}>
                  <div class="history-visual">
                    {chapter.image ? (
                      <figure><img src={chapter.image} alt={chapter.caption ?? ''} width="900" height="620" loading="lazy" /><figcaption>{chapter.caption}</figcaption></figure>
                    ) : (
                      <div class="history-fact"><span>{chapter.fact?.value}</span><strong>{chapter.fact?.label}</strong><small>BSV Nordstern Radolfzell</small></div>
                    )}
                  </div>
                  <div class="history-marker"><span>0{index + 1}</span></div>
                  <div class="history-story">
                    <div class="history-date"><span>{chapter.eyebrow}</span><time>{chapter.date}</time></div>
                    <h3>{chapter.title}</h3>
                    <p class="history-subtitle">{chapter.subtitle}</p>
                    {chapter.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                    {chapter.roster && <details class="history-roster"><summary>Mannschaftsaufstellung ansehen <span>+</span></summary><p>{chapter.roster}</p></details>}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="history-finale">
            <div><small>Die Geschichte geht weiter</small><h2>Das nächste Kapitel<br />schreiben wir gemeinsam.</h2></div>
            <a href="/verein/mitglied-werden">Teil des BSV werden <span>↗</span></a>
          </section>
        </div>
      )}
      {migratedBody && <article class="legacy-content" set:html={migratedBody} />}
      {isYouthBoard && (
        <aside class="youth-contact-panel">
          <span class="youth-contact-star" aria-hidden="true">✦</span>
          <div>
            <small>Direkter Draht zur Jugend</small>
            <h2>Fragen, Ideen<br />oder Lust mitzumachen?</h2>
            <p>Unsere Jugendleitung hilft bei Fragen rund um Mannschaften, Training und das Engagement in der Jugendabteilung gerne weiter.</p>
          </div>
          <a href="mailto:jugend@bsvnordstern.de"><span>Jugendleitung kontaktieren</span><strong>↗</strong></a>
        </aside>
      )}
      {!migratedBody && page.body && <div class="prose">{page.body.map((paragraph) => <p>{paragraph}</p>)}</div>}

      {!migratedBody && page.kind === 'organization' && <div class="organization"><div class="org-top"><strong>Geschäftsführender Vorstand</strong><span>Sandra Fuchs · Felix Schüle · Claudia Gastaudo · Michaela Auer</span></div><div class="org-grid">{['Fußball', 'Breitensport', 'Vereinspflege', 'Events', 'Kommunikation', 'Facility Management'].map((area) => <article><span>Bereich</span><strong>{area}</strong></article>)}</div></div>}

      {!migratedBody && page.kind === 'events' && <div class="event-list"><article><time><b>11</b> JUL</time><div><small>07:00 – 14:00 Uhr</small><h2>Gebrauchträdermarkt</h2><p>Mit Zweirad Mees und dem Förderverein BSV Nordstern.</p></div></article><article><time><b>11</b> JUL</time><div><small>08:00 – 16:00 Uhr</small><h2>Flohmarkt</h2><p>Auf dem Gelände des BSV Nordstern, Schlesierstraße 43.</p></div></article></div>}

      {!migratedBody && page.people && <div class="people"><div class="section-title"><p>Menschen im BSV</p><h2>{page.kind === 'board' ? 'Unser Team.' : 'Ansprechpersonen.'}</h2></div><div class="people-grid">{page.people.map((person) => <article>{person.image ? <img src={person.image} alt={person.name} width="500" height="650" loading="lazy" /> : <div class="placeholder">{person.name.split(' ').map((part) => part[0]).join('')}</div>}<div><h3>{person.name}</h3><p>{person.role}</p></div></article>)}</div></div>}

      {page.kind === 'document' && <aside class="document-cta"><div><small>Dokument & Auskunft</small><h2>Noch Fragen?</h2><p>Die Vorstandschaft hilft dir bei verbindlichen oder persönlichen Anliegen gerne weiter.</p></div><a href="mailto:info@bsvnordstern.de">Kontakt aufnehmen ↗</a></aside>}

      {page.path.includes('mitglied-werden') && <aside class="join-cta"><div><small>Auf geht’s grün</small><h2>Bereit für den BSV?</h2></div><a href="https://mitglied.bsvnordstern.de" target="_blank" rel="noreferrer">Online anmelden ↗</a></aside>}
    </section>
  </main>
  <Footer />

  <script>
    document.querySelectorAll<HTMLElement>('.legacy-content .contact-icons, .referee-page .contact-icons').forEach((contacts, groupIndex) => {
      const links = [...contacts.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"], a[href^="tel:"]')];

      links.forEach((originalLink, linkIndex) => {
        const href = originalLink.getAttribute('href');
        if (!href) return;

        const isEmail = href.startsWith('mailto:');
        const value = decodeURIComponent(href.replace(/^(mailto:|tel:)/, ''));
        const panelId = `contact-${groupIndex}-${linkIndex}`;
        const toggle = document.createElement('button');
        const directLink = document.createElement('a');

        toggle.type = 'button';
        toggle.className = `contact-toggle ${isEmail ? 'is-email' : 'is-phone'}`;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-controls', panelId);
        toggle.setAttribute('aria-label', isEmail ? 'E-Mail-Adresse anzeigen' : 'Telefonnummer anzeigen');

        directLink.id = panelId;
        directLink.className = 'contact-value';
        directLink.href = href;
        directLink.hidden = true;
        directLink.textContent = value;
        directLink.setAttribute('aria-label', isEmail ? `E-Mail an ${value}` : `${value} anrufen`);

        toggle.addEventListener('click', () => {
          const willOpen = directLink.hidden;
          contacts.querySelectorAll<HTMLButtonElement>('.contact-toggle').forEach((button) => button.setAttribute('aria-expanded', 'false'));
          contacts.querySelectorAll<HTMLElement>('.contact-value').forEach((contact) => contact.hidden = true);
          toggle.setAttribute('aria-expanded', String(willOpen));
          directLink.hidden = !willOpen;
        });

        originalLink.replaceWith(toggle, directLink);
      });
    });
  </script>
</Layout>

