---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';

const shopUrl = 'https://shop.bsvnordstern.de/';
const partnerUrl = 'https://www.teamsportbodensee.de/';
const showroomImage = withBase('/images/shop/Showroom_2024_820x370px.jpg');
---

<Layout title="BSV Shop – BSV Nordstern Radolfzell">
  <Header />

  <main>
    <section class="shop-hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> BSV Shop</p>
          <h1>Deine Farben.<br /><em>Dein Verein.</em></h1>
          <p class="lead">
            Vereinskleidung, Trainingswear und mehr für den BSV Nordstern. Unser Partner
            Teamsport Bodensee verbindet JAKO Teamwear mit persönlicher Beratung und professioneller Veredelung.
          </p>
          <div class="hero-actions">
            <a class="button button-yellow" href={shopUrl} target="_blank" rel="noopener noreferrer">
              Zum BSV Shop <span>↗</span>
            </a>
            <a class="partner-link" href={partnerUrl} target="_blank" rel="noopener noreferrer">
              Teamsport Bodensee <span>↗</span>
            </a>
          </div>
        </div>

        <figure class="showroom-card">
          <img src={showroomImage} alt="Showroom von Teamsport Bodensee mit JAKO Teamwear" />
          <figcaption>
            <span>Unser Ausrüstungspartner</span>
            <strong>Teamsport Bodensee · Steißlingen</strong>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="partner-section">
      <div class="shell partner-grid">
        <div class="section-copy">
          <p class="eyebrow dark"><span></span> Alles aus einer Hand</p>
          <h2>Ein Partner, der <em>Teams versteht.</em></h2>
          <p>
            Teamsport Bodensee ist die regionale Anlaufstelle für JAKO Teamwear am Bodensee. Für Vereine bedeutet das:
            passende Ausstattung, persönliche Beratung und die Veredelung der Kleidung aus einer Hand.
          </p>
          <p>
            Damit bekommen Mannschaften und Vereinsmitglieder einen einheitlichen Auftritt – vom Training bis zum Spieltag.
            Die ausgewählten BSV Artikel findest du bequem in unserem eigenen Online-Shop.
          </p>
        </div>

        <div class="service-grid">
          <article>
            <span>01</span>
            <h3>JAKO Teamwear</h3>
            <p>Teamkleidung, Trikots und Vereinsausstattung für einen einheitlichen BSV Auftritt.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Textilveredelung</h3>
            <p>Flock, Flextransfer, Siebdruck, Digitaltransfer, Badges und Stick für die individuelle Ausstattung.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Persönliche Beratung</h3>
            <p>Kompetente Beratung vor Ort in Steißlingen für Teams, Vereine und die passende Sportausstattung.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="history-section">
      <div class="shell history-grid">
        <div class="history-number" aria-hidden="true">2017</div>
        <div>
          <p class="eyebrow light"><span></span> Regional verwurzelt</p>
          <h2>Vom Start in der Garage zum Teamsport-Partner am Bodensee.</h2>
          <p>
            Die Geschichte von Teamsport Bodensee begann 2017. Seit 2020 ist das Unternehmen in Steißlingen zuhause und
            hat sein Angebot um Textildruck und Veredelung erweitert. Sporterfahrung und Nähe zum regionalen Vereinsleben
            gehören bis heute zum Kern des Teams.
          </p>
        </div>
      </div>
    </section>

    <section class="visit-section">
      <div class="shell visit-grid">
        <div>
          <p class="eyebrow dark"><span></span> Vor Ort</p>
          <h2>Teamsport Bodensee</h2>
          <p class="address">Daimler-Straße 3 · 78256 Steißlingen</p>
        </div>
        <div class="visit-facts">
          <div><small>Öffnungszeiten</small><strong>Mo–Fr · 09:00–12:30<br />& 14:00–17:00</strong></div>
          <div><small>Telefon</small><strong>07738 8024280</strong></div>
          <div><small>E-Mail</small><strong>info@teamsportbodensee.de</strong></div>
        </div>
        <a class="button button-outline" href={partnerUrl} target="_blank" rel="noopener noreferrer">
          Partner besuchen <span>↗</span>
        </a>
      </div>
    </section>

    <section class="shop-cta">
      <div class="shell cta-card">
        <div>
          <p class="eyebrow"><span></span> BSV Nordstern</p>
          <h2>Bereit für <em>Grün?</em></h2>
          <p>Entdecke die BSV Kollektion und bestelle deine Vereinskleidung direkt online.</p>
        </div>
        <a class="button button-dark" href={shopUrl} target="_blank" rel="noopener noreferrer">
          Zum BSV Shop <span>↗</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(:root){--green:#164f32;--green-dark:#092f20;--yellow:#f4d638;--cream:#f4f1e8;--ink:#10251a}
  .shell{width:min(1160px,calc(100% - 48px));margin-inline:auto}
  .shop-hero{overflow:hidden;background:var(--green-dark);color:white}
  .hero-grid{min-height:590px;padding:82px 0 90px;display:grid;grid-template-columns:.92fr 1.08fr;align-items:center;gap:64px}
  .eyebrow{display:flex;align-items:center;gap:10px;margin:0 0 20px;color:#b7d2c1;font-size:.72rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.eyebrow span{width:28px;height:3px;background:var(--yellow)}.eyebrow.dark{color:var(--green)}.eyebrow.light{color:#aac8b4}
  h1,h2,h3,p{margin-top:0}h1,h2{letter-spacing:-.055em}h1{margin:0 0 28px;font-size:clamp(3.8rem,6.5vw,6.5rem);line-height:.87}h1 em,h2 em{color:var(--yellow);font-family:Georgia,serif;font-weight:400}
  .lead{max-width:560px;margin-bottom:35px;color:#cadbd0;font-size:1.06rem;line-height:1.7}
  .hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:24px}.button{min-height:52px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;gap:22px;border-radius:4px;font-size:.82rem;font-weight:900;text-decoration:none}.button-yellow{background:var(--yellow);color:var(--green-dark);box-shadow:0 7px 0 #bda51e}.partner-link{color:white;font-size:.8rem;font-weight:850;text-decoration:none}.partner-link span{margin-left:8px}
  .showroom-card{margin:0;overflow:hidden;background:#fff;box-shadow:18px 20px 0 rgb(244 214 56 / 16%)}.showroom-card img{display:block;width:100%;aspect-ratio:820/370;object-fit:cover}.showroom-card figcaption{padding:20px 22px;color:var(--ink)}.showroom-card figcaption span,.showroom-card figcaption strong{display:block}.showroom-card figcaption span{color:var(--green);font-size:.62rem;font-weight:950;letter-spacing:.1em;text-transform:uppercase}.showroom-card figcaption strong{margin-top:6px;font-size:1.05rem}
  .partner-section{padding:105px 0;background:var(--cream)}.partner-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:70px;align-items:start}.section-copy h2,.history-grid h2,.visit-grid h2,.cta-card h2{margin:0 0 26px;color:var(--ink);font-size:clamp(2.7rem,4.7vw,4.5rem);line-height:.94}.section-copy p:not(.eyebrow){max-width:560px;color:#5f7066;line-height:1.75}.section-copy h2 em{color:var(--green)}
  .service-grid{display:grid;gap:12px}.service-grid article{position:relative;padding:26px 28px 25px;background:white;border-top:3px solid var(--green);box-shadow:0 9px 24px rgb(9 47 32 / 6%)}.service-grid article>span{position:absolute;right:20px;top:18px;color:#9aa89f;font-size:.63rem;font-weight:900}.service-grid h3{margin:0 0 9px;font-size:1.18rem}.service-grid p{margin:0;color:#68786e;font-size:.86rem;line-height:1.55}
  .history-section{padding:90px 0;background:var(--green);color:white}.history-grid{display:grid;grid-template-columns:.55fr 1.45fr;gap:70px;align-items:center}.history-number{color:rgb(244 214 56 / 18%);font-size:clamp(5.5rem,11vw,10rem);font-weight:950;letter-spacing:-.08em;line-height:.8}.history-grid h2{max-width:760px;color:white}.history-grid>div:last-child>p:last-child{max-width:760px;margin:0;color:#c5d8cc;line-height:1.75}
  .visit-section{padding:85px 0;background:#fff}.visit-grid{display:grid;grid-template-columns:.8fr 1.35fr auto;align-items:center;gap:42px}.visit-grid h2{margin-bottom:9px;font-size:2.35rem}.address{margin:0;color:#6b796f}.visit-facts{display:grid;grid-template-columns:1.2fr .85fr 1.2fr;gap:12px}.visit-facts>div{padding:17px;background:#f3f5f2}.visit-facts small,.visit-facts strong{display:block}.visit-facts small{color:#748279;font-size:.58rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.visit-facts strong{margin-top:5px;color:#27392f;font-size:.78rem;line-height:1.45}.button-outline{border:1px solid #b8c6bd;color:var(--green);white-space:nowrap}
  .shop-cta{padding:0 0 110px;background:#fff}.cta-card{min-height:280px;padding:52px 60px;display:flex;align-items:center;justify-content:space-between;gap:50px;background:var(--yellow);box-sizing:border-box}.cta-card .eyebrow{color:var(--green)}.cta-card h2{margin-bottom:14px}.cta-card h2 em{color:var(--green)}.cta-card p:last-child{margin:0;color:#405044}.button-dark{background:var(--green-dark);color:white;white-space:nowrap}
  @media(max-width:900px){.hero-grid,.partner-grid,.history-grid{grid-template-columns:1fr}.hero-grid{gap:45px}.history-grid{gap:25px}.history-number{font-size:6rem}.visit-grid{grid-template-columns:1fr}.visit-facts{grid-template-columns:repeat(3,1fr)}.cta-card{align-items:flex-start;flex-direction:column}}
  @media(max-width:650px){.shell{width:min(100% - 30px,1160px)}.hero-grid{min-height:0;padding:62px 0 70px}.partner-section{padding:75px 0}.history-section{padding:70px 0}.visit-section{padding:65px 0}.visit-facts{grid-template-columns:1fr}.cta-card{padding:38px 26px}.shop-cta{padding-bottom:75px}}
</style>
