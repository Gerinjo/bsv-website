---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import {
  sponsorshipLevels,
  sponsorshipModules,
  sponsorshipPrinciples,
  sponsoringDisclaimer,
} from '../../data/sponsoring';
import { withBase } from '../../utils/paths';
---

<Layout
  title="Sponsoring | BSV Nordstern Radolfzell"
  description="Sponsoring beim BSV Nordstern Radolfzell: Kids-, Bronze-, Silber- und Gold-Partnerschaften sowie individuelle Werbe- und Projektbausteine."
>
  <Header />

  <main class="sponsoring-page">
    <header class="sponsor-hero">
      <div class="shell sponsor-hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Partnerschaft mit Wirkung</span>
          <h1>Sichtbar werden.<br /><em>Zukunft ermöglichen.</em></h1>
          <p>Unternehmen, Selbstständige und private Förderer stärken mit ihrem Engagement Sport, Jugend und Gemeinschaft beim BSV Nordstern. Dafür bieten wir klare Sponsoring-Stufen und flexible Einzelbausteine.</p>
          <div class="hero-actions">
            <a class="primary" href="#pakete">Pakete entdecken <span>↓</span></a>
            <a class="secondary" href={withBase('/werbepartner')}>Unsere Werbepartner <span>↗</span></a>
            <a class="secondary" href={withBase('/kontakt?thema=sponsoring')}>Partnerschaft anfragen <span>↗</span></a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <span class="north-star">✦</span>
          <small>Gemeinsam für</small>
          <strong>Sport.<br />Jugend.<br />Radolfzell.</strong>
          <b>BSV · 1956</b>
        </div>
      </div>
    </header>

    <section class="sponsor-intro shell">
      <div>
        <span class="section-label">Warum BSV?</span>
        <h2>Eine Partnerschaft,<br />die vor Ort ankommt.</h2>
      </div>
      <div class="intro-copy">
        <p>Der BSV Nordstern verbindet Breiten- und Jugendfußball, weitere Sportangebote, Veranstaltungen und ein lebendiges Vereinsgelände. Sponsoren treffen bei uns auf Familien, Mitglieder, Mannschaften, Ehrenamtliche und Gäste aus Radolfzell und der Region.</p>
        <p>Unser Konzept schafft einen verlässlichen Rahmen: klare Leistungen, nachvollziehbare Stufen und genügend Spielraum für eine Partnerschaft, die zum Unternehmen und zum Verein passt.</p>
        <div class="impact-row">
          <span><b>01</b> Nachwuchs fördern</span>
          <span><b>02</b> Lokal sichtbar sein</span>
          <span><b>03</b> Gemeinschaft stärken</span>
        </div>
      </div>
    </section>

    <section id="pakete" class="package-section">
      <div class="shell">
        <div class="section-head">
          <div><span class="section-label">Sponsoring-Level</span><h2>Vier Stufen.<br />Ein gemeinsames Ziel.</h2></div>
          <p>Vom gezielten Nachwuchsbeitrag bis zur umfassenden Vereinspartnerschaft: Jedes Paket verbindet Unterstützung mit einer passenden Sichtbarkeit.</p>
        </div>

        <div class="package-grid">
          {sponsorshipLevels.map((level, index) => (
            <article id={level.id} class:list={["package-card", `is-${level.id}`, { featured: level.featured }]} style={`--level-accent:${level.accent}`}>
              {level.featured && <span class="popular">Empfohlen</span>}
              <div class="package-number">0{index + 1}</div>
              <div class="package-title">
                <small>{level.tagline}</small>
                <h3>{level.name}</h3>
                <div class="package-price"><strong>{level.price}</strong><span>Richtwert pro Saison</span></div>
              </div>
              <p>{level.summary}</p>
              <ul>{level.features.map((feature) => <li><span aria-hidden="true">✓</span>{feature}</li>)}</ul>
              <a href={withBase(`/kontakt?thema=sponsoring`)}>Dieses Paket anfragen <span>↗</span></a>
            </article>
          ))}
        </div>

        <p class="disclaimer">{sponsoringDisclaimer}</p>
      </div>
    </section>

    <section id="vergleich" class="comparison-section shell">
      <div class="section-head compact">
        <div><span class="section-label">Auf einen Blick</span><h2>Welches Paket passt?</h2></div>
        <p>Die Tabelle zeigt die grundsätzliche Ausrichtung. Im persönlichen Gespräch stellen wir die Leistungen passend zusammen.</p>
      </div>

      <div class="comparison-wrap">
        <table>
          <thead>
            <tr><th>Leistung</th>{sponsorshipLevels.map((level) => <th>{level.name.replace('-Sponsor', '')}</th>)}</tr>
          </thead>
          <tbody>
            <tr><th>Logo auf der Sponsoring-Seite</th><td>✓</td><td>✓</td><td>bevorzugt</td><td>Top-Platzierung</td></tr>
            <tr><th>Verlinkung zum Unternehmen</th><td>✓</td><td>✓</td><td>✓</td><td>✓</td></tr>
            <tr><th>Individuelle Social-Media-Beiträge</th><td>gemeinsam</td><td>1</td><td>2</td><td>4</td></tr>
            <tr><th>Zusätzlicher Präsenzbaustein</th><td>–</td><td>optional</td><td>1 inklusive</td><td>1 hochwertiger Baustein</td></tr>
            <tr><th>Einladungen zum Sponsoren-Event</th><td>–</td><td>2</td><td>4</td><td>6</td></tr>
            <tr><th>Jährliches Partnergespräch</th><td>–</td><td>–</td><td>optional</td><td>✓</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="bausteine" class="modules-section">
      <div class="shell">
        <div class="section-head">
          <div><span class="section-label">Individuelle Angebote</span><h2>Bausteine für<br />konkrete Ziele.</h2></div>
          <p>Einzelne Werbe- und Projektbausteine können separat gebucht oder mit einem Sponsoring-Level kombiniert werden.</p>
        </div>

        <div class="module-grid">
          {sponsorshipModules.map((module, index) => (
            <article>
              <span>0{index + 1}</span>
              <div><h3>{module.title}</h3><strong>{module.price}</strong></div>
              <p>{module.description}</p>
              {module.note && <small>{module.note}</small>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="principles-section shell">
      <div class="principles-title">
        <span class="section-label">Unser Anspruch</span>
        <h2>Fair. Klar.<br />Partnerschaftlich.</h2>
      </div>
      <div class="principles-grid">
        {sponsorshipPrinciples.map((principle, index) => (
          <article><span>0{index + 1}</span><div><h3>{principle.title}</h3><p>{principle.text}</p></div></article>
        ))}
      </div>
    </section>

    <section class="sponsor-cta">
      <div class="shell cta-inner">
        <div>
          <span>Der nächste Schritt</span>
          <h2>Lasst uns eine<br />Partnerschaft entwickeln.</h2>
          <p>Schildern Sie uns kurz, welches Unternehmen Sie vertreten, welche Zielgruppe Sie erreichen möchten und welcher Umfang interessant ist. Wir melden uns mit einem passenden Vorschlag.</p>
        </div>
        <a href={withBase('/kontakt?thema=sponsoring')}><span>Sponsoring anfragen</span><strong>↗</strong></a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(html){scroll-behavior:smooth}.sponsoring-page{--green:#164f32;--dark:#071f16;--yellow:#f4d638;--lime:#91c82f;--line:#d9e1db;background:#f5f7f4;color:#15231a}.shell{width:min(1160px,calc(100% - 48px));margin-inline:auto}.sponsor-hero{position:relative;overflow:hidden;padding:94px 0 105px;background:linear-gradient(120deg,#061e14,#0b3925 62%,#164f32);color:white}.sponsor-hero::before{content:'';position:absolute;right:-210px;top:-330px;width:690px;aspect-ratio:1;border:1px solid rgb(244 214 56 / 14%);border-radius:50%;box-shadow:0 0 0 85px rgb(255 255 255 / 2%),0 0 0 170px rgb(255 255 255 / 1.5%)}.sponsor-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(330px,.85fr);align-items:center;gap:80px}.eyebrow,.section-label,.sponsor-cta>div>div>span{display:block;color:var(--yellow);font-size:.68rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.hero-copy h1{margin:18px 0 24px;font-family:Georgia,serif;font-size:clamp(3.7rem,7vw,6.8rem);line-height:.88;letter-spacing:-.055em}.hero-copy h1 em{color:var(--yellow);font-weight:400}.hero-copy>p{max-width:700px;margin:0;color:#c7d8cd;font-size:1.06rem;line-height:1.75}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}.hero-actions a{min-height:52px;padding:0 20px;display:flex;align-items:center;justify-content:space-between;gap:28px;font-size:.8rem;font-weight:900;text-decoration:none}.hero-actions .primary{background:var(--yellow);color:var(--dark)}.hero-actions .secondary{border:1px solid rgb(255 255 255 / 34%);background:rgb(255 255 255 / 6%);color:white}.hero-actions span{font-size:1rem}.hero-visual{position:relative;min-height:410px;padding:58px;display:flex;flex-direction:column;justify-content:flex-end;border:1px solid rgb(255 255 255 / 18%);background:rgb(255 255 255 / 5%);box-shadow:18px 18px 0 var(--yellow);overflow:hidden}.hero-visual .north-star{position:absolute;right:42px;top:30px;color:var(--yellow);font-size:4rem}.hero-visual small,.hero-visual b{position:relative;z-index:2;color:#9eb8a8;font-size:.65rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.hero-visual strong{position:relative;z-index:2;margin:15px 0 25px;font-size:clamp(2.7rem,5vw,4.5rem);line-height:.86;letter-spacing:-.06em}.orbit{position:absolute;border:1px solid rgb(244 214 56 / 22%);border-radius:50%}.orbit-one{width:320px;aspect-ratio:1;right:-95px;top:-95px}.orbit-two{width:220px;aspect-ratio:1;left:-100px;bottom:-110px;box-shadow:0 0 0 45px rgb(255 255 255 / 3%)}.sponsor-intro{padding:105px 0;display:grid;grid-template-columns:.85fr 1.15fr;gap:95px}.section-label{color:var(--green)}.sponsor-intro h2,.section-head h2,.principles-title h2{margin:14px 0 0;font-size:clamp(3rem,5vw,4.8rem);line-height:.92;letter-spacing:-.06em}.intro-copy>p{margin:0 0 20px;color:#5a6a60;font-size:1.04rem;line-height:1.82}.intro-copy>p:first-child{color:#17251b;font-size:1.28rem}.impact-row{margin-top:34px;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.impact-row span{padding:18px 12px;color:#44544a;font-size:.76rem;font-weight:800}.impact-row b{display:block;margin-bottom:7px;color:var(--green);font-size:.62rem}.package-section,.modules-section{padding:105px 0;background:white}.section-head{display:flex;align-items:end;justify-content:space-between;gap:60px;margin-bottom:55px}.section-head>p{max-width:410px;margin:0;color:#68776e;line-height:1.7}.package-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.package-card{position:relative;overflow:hidden;padding:40px;display:flex;flex-direction:column;border-top:7px solid var(--level-accent);background:#f5f7f4;box-shadow:0 18px 50px rgb(9 47 32 / 8%)}.package-card.featured{background:#092f20;color:white;box-shadow:12px 12px 0 var(--yellow)}.popular{position:absolute;right:0;top:0;padding:9px 15px;background:var(--yellow);color:var(--dark);font-size:.62rem;font-weight:950;letter-spacing:.12em;text-transform:uppercase}.package-number{position:absolute;right:25px;bottom:-35px;color:rgb(22 79 50 / 6%);font-size:11rem;font-weight:950;line-height:1}.featured .package-number{color:rgb(255 255 255 / 5%)}.package-title{position:relative;z-index:1}.package-title small{color:var(--level-accent);font-size:.65rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.package-title h3{margin:10px 0 20px;font-size:2.2rem}.package-price{display:flex;align-items:end;gap:12px}.package-price strong{font-size:2.5rem;line-height:1}.package-price span{color:#77847c;font-size:.67rem}.featured .package-price span{color:#a9beb1}.package-card>p{position:relative;z-index:1;color:#5d6c62;line-height:1.7}.featured>p{color:#c4d5ca}.package-card ul{position:relative;z-index:1;margin:18px 0 30px;padding:0;list-style:none}.package-card li{padding:10px 0;display:grid;grid-template-columns:22px 1fr;gap:10px;border-bottom:1px solid rgb(22 79 50 / 12%);color:#45554b;font-size:.82rem;line-height:1.45}.featured li{border-color:rgb(255 255 255 / 11%);color:#d3e0d8}.package-card li span{color:var(--level-accent);font-weight:950}.package-card>a{position:relative;z-index:1;margin-top:auto;padding:15px 17px;display:flex;justify-content:space-between;background:var(--dark);color:white;font-size:.78rem;font-weight:900;text-decoration:none}.featured>a{background:var(--yellow);color:var(--dark)}.package-card>a span{color:var(--yellow)}.featured>a span{color:var(--dark)}.disclaimer{margin:30px 0 0;color:#77847c;font-size:.73rem;line-height:1.6}.comparison-section{padding:105px 0}.section-head.compact{margin-bottom:38px}.comparison-wrap{overflow-x:auto;background:white;box-shadow:0 18px 50px rgb(9 47 32 / 7%)}table{width:100%;min-width:820px;border-collapse:collapse}th,td{padding:18px 20px;border-bottom:1px solid #e2e8e3;text-align:center;font-size:.78rem}thead th{background:var(--dark);color:white;font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}thead th:first-child,tbody th{text-align:left}tbody th{color:#314137;font-weight:850}tbody td{color:#58685e}.modules-section{background:#092f20;color:white}.modules-section .section-label{color:var(--yellow)}.modules-section .section-head>p{color:#a9beb1}.module-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.module-grid article{position:relative;min-height:270px;padding:30px;display:flex;flex-direction:column;border:1px solid rgb(255 255 255 / 12%);background:rgb(255 255 255 / 5%)}.module-grid article>span{position:absolute;right:22px;top:18px;color:var(--yellow);font-size:.63rem;font-weight:900}.module-grid h3{margin:0 0 8px;font-size:1.35rem}.module-grid strong{color:var(--yellow);font-size:.78rem}.module-grid p{margin-top:28px;color:#bed0c4;line-height:1.65}.module-grid small{margin-top:auto;color:#849c8c;line-height:1.5}.principles-section{padding:105px 0;display:grid;grid-template-columns:.8fr 1.2fr;gap:90px}.principles-grid{border-top:1px solid var(--line)}.principles-grid article{padding:27px 0;display:grid;grid-template-columns:50px 1fr;gap:22px;border-bottom:1px solid var(--line)}.principles-grid article>span{color:var(--green);font-size:.68rem;font-weight:900}.principles-grid h3{margin:0 0 9px;font-size:1.35rem}.principles-grid p{margin:0;color:#66766c;line-height:1.7}.sponsor-cta{padding:0 0 110px}.cta-inner{position:relative;overflow:hidden;padding:65px 70px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:65px;background:var(--yellow)}.cta-inner::after{content:'✦';position:absolute;right:30%;top:-85px;color:rgb(255 255 255 / 42%);font-size:14rem}.cta-inner>div,.cta-inner>a{position:relative;z-index:1}.cta-inner>div>span{color:var(--green);font-size:.68rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.cta-inner h2{margin:12px 0 18px;font-size:clamp(2.8rem,5vw,4.7rem);line-height:.92;letter-spacing:-.06em}.cta-inner p{max-width:700px;margin:0;color:#425346;line-height:1.7}.cta-inner>a{min-width:235px;padding:17px 19px;display:flex;justify-content:space-between;gap:30px;background:var(--dark);color:white;font-size:.8rem;font-weight:900;text-decoration:none}.cta-inner>a strong{color:var(--yellow)}@media(max-width:900px){.sponsor-hero-grid,.sponsor-intro,.principles-section{grid-template-columns:1fr}.hero-visual{width:min(100%,600px)}.package-grid{grid-template-columns:1fr}.module-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cta-inner{grid-template-columns:1fr}.cta-inner>a{justify-self:start}}@media(max-width:650px){.shell{width:min(100% - 30px,1160px)}.sponsor-hero{padding:70px 0 80px}.sponsor-hero-grid{gap:45px}.hero-visual{min-height:330px;padding:35px;box-shadow:8px 8px 0 var(--yellow)}.sponsor-intro,.package-section,.comparison-section,.modules-section,.principles-section{padding:70px 0}.section-head{align-items:flex-start;flex-direction:column;gap:24px}.impact-row{grid-template-columns:1fr}.impact-row span+span{border-top:1px solid var(--line)}.package-card{padding:30px 24px}.module-grid{grid-template-columns:1fr}.cta-inner{padding:45px 28px}.cta-inner>a{width:100%;min-width:0}}
</style>
