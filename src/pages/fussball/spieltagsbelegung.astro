---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MatchdayPitch from '../../components/MatchdayPitch.astro';
import PlanLink from '../../components/PlanLink.astro';
import snapshot from '../../data/matchdaySchedule.json';
import type { MatchdaySchedule, Pitch } from '../../utils/matchdayPlan';
import { addDays, applyChangeovers, pitchSegments } from '../../utils/matchdayPlan';
import { savedMatchdayPlan } from '../../utils/savedMatchdayPlan';
import { withBase } from '../../utils/paths';
import { berlinNow } from '../../utils/nextMatch';

const { schedule, stale } = await savedMatchdayPlan(snapshot as MatchdaySchedule);
const today = berlinNow().slice(0, 10);
const pitches: Pitch[] = ['Hauptplatz', 'Nebenplatz'];
const dates: string[] = [];
for (let date = schedule.from; date <= schedule.through; date = addDays(date, 1)) dates.push(date);
const dateLabel = (date: string) => new Intl.DateTimeFormat('de-DE', { weekday:'long', day:'2-digit', month:'2-digit', year:'numeric', timeZone:'Europe/Berlin' }).format(new Date(date + 'T12:00:00Z'));
const plannedBookings = applyChangeovers(schedule.bookings);
const bookingsFor = (date: string) => plannedBookings.filter((b) => b.date === date);
const isTimed = (b: MatchdaySchedule['bookings'][number]) => b.pitch !== null && b.start !== null && b.end !== null;
const days = dates.map((date) => {
  const bookings = bookingsFor(date), timed = bookings.filter(isTimed);
  const boundaries = [...new Set(timed.flatMap((b) => [b.start!, b.end!]))].sort((a,b) => a-b);
  const conflicts = pitches.flatMap((pitch) => pitchSegments(timed.filter((b) => b.pitch === pitch)).filter((s) => s.conflict));
  return { date, bookings, timed, boundaries, conflicts, pending: bookings.filter((b) => !isTimed(b)) };
}).filter((day) => day.bookings.length > 0);
const initial = days.find((d) => d.date >= today)?.date ?? days[0]?.date ?? '';
const pendingCount = days.reduce((sum, d) => sum + d.pending.length, 0);
const conflictDays = days.filter((d) => d.conflicts.length).length;
const checkedAt = new Intl.DateTimeFormat('de-DE', { dateStyle:'medium', timeStyle:'short', timeZone:'Europe/Berlin' }).format(new Date(schedule.checkedAt));
---
<Layout title="Spieltagsbelegung | BSV Nordstern Radolfzell" description="Spiele und E-Jugend-Spieltage auf Haupt- und Nebenplatz: Belegung der Spielfeldhälften, Zeitpuffer und Platzkonflikte.">
  <Header />
  <main class="matchday-page">
    <div class="shell">
      <header class="plan-heading">
        <div><p class="eyebrow">BSV Nordstern · Spielbetrieb</p><h1>Spieltagsbelegung</h1><p class="source-status">FUSSBALL.DE · Stand {checkedAt} Uhr</p></div>
        <img src={withBase('/images/fussball/sportplaetze/bd41b6f7d7-hauptplatz-hp.png')} width="1600" height="1011" alt="Hauptplatz des BSV Nordstern" />
      </header>
      <nav class="plan-links" aria-label="Platzplanung">
        <PlanLink href="/fussball/belegungsplan" label="Belegungsplan" />
        <PlanLink href="/fussball/spielplan" label="Vereinsspielplan" />
        <PlanLink href="/fussball/sportplaetze" label="Sportplätze" />
      </nav>
      {stale && <p class="status-warning" role="status">Aktualisierung nicht verfügbar. Gespeicherter Stand vom {checkedAt} Uhr; neuere Änderungen sind möglicherweise nicht enthalten.</p>}
      {schedule.through < today && <p class="status-warning" role="alert">Der gespeicherte Planungszeitraum ist abgelaufen. Aktuelle Belegungen sind nicht bestätigt.</p>}
      <div class="summary">
        <span><b>{schedule.bookings.length}</b> Belegungen / offene Termine</span>
        <span class:list={{ danger:conflictDays > 0 }}><b>{conflictDays}</b> Tage mit Platzkonflikt</span>
        <span><b>{pendingCount}</b> Termine zu klären</span>
      </div>
      <div class="plan-controls">
        <label>Datum<select id="matchday-date" disabled={!days.length}>{!days.length && <option value="">Keine Spieltage vorhanden</option>}{days.map((d) => <option value={d.date} selected={d.date === initial}>{dateLabel(d.date)} · {d.bookings.length}{d.conflicts.length ? ' · Konflikt' : ''}{d.pending.length ? ' · Klärung' : ''}</option>)}</select></label>
        <label>Ansicht<select id="matchday-view" disabled={!days.length}><option value="day">Einzelner Tag</option><option value="all">Alle Spieltage</option></select></label>
      </div>
      <p class="planning-note">Gleiche Teamstärke hintereinander (7er, 9er, 11er): 15 Min. Wechselzeit. Sonst 30 Min. Vorlauf und 15 Min. Nachlauf. E-Spieltage: 2 Std.; sonst reguläre Spielzeit + 15 Min. Halbzeitpause. Hälften rechnerisch verteilt, keine verbindliche Seitenzuweisung. Ohne Trainings- und Fremdbelegungen.</p>
      <div class="legend" aria-label="Legende"><span class="full">Ganzer Platz</span><span class="half">Halber Platz</span><span class="kids">E-Spieltag</span><span class="girls">Juniorinnen 7er</span><span class="conflict">Platzkonflikt</span></div>
      <div id="matchday-plans" aria-live="polite">
        {!days.length && <p class="empty">Im Planungszeitraum sind keine Spiele für das BSV-Sportgelände eingetragen.</p>}
        {days.map((day) => (
          <section class="matchday" id={'tag-' + day.date} data-date={day.date} data-bookings={day.bookings.length} hidden={day.date !== initial}>
            <div class="day-heading"><h2>{dateLabel(day.date)}</h2>{day.conflicts.length > 0 && <strong class="conflict-label">Platzkonflikt</strong>}</div>
            {day.bookings.length === 0 ? <p class="empty">Keine Spiele für das BSV-Sportgelände eingetragen.</p> : (
              <div class="pitches">{pitches.map((pitch) => <MatchdayPitch pitch={pitch} bookings={day.timed.filter((b) => b.pitch === pitch)} boundaries={day.boundaries} date={day.date} />)}</div>
            )}
            {day.pending.length > 0 && <section class="pending"><h3>Noch zu klären</h3>{day.pending.map((booking) => <article><strong>{booking.label} · {booking.kickoff || 'Uhrzeit offen'}</strong><p>{booking.venue || 'Spielort offen'}</p>{booking.notes.map((note) => <p>{note}</p>)}<a href={booking.url} target="_blank" rel="noopener noreferrer">Spiel auf FUSSBALL.DE ↗</a></article>)}</section>}
          </section>
        ))}
      </div>
      <details class="rules">
        <summary>Planungsgrundlagen</summary>
        <p>Bei gleicher Teamstärke auf derselben Fläche reichen 15 Minuten zwischen geplantem Spielende und nächstem Anstoß. Der Nachlauf des ersten Spiels zählt als Wechselzeit; der Vorlauf des Folgespiels wird entsprechend gekürzt. Bei anderer Teamstärke bleiben die folgenden Standardpuffer bestehen.</p>
        <dl>
          <div><dt>E-Jugend-Viererspieltag</dt><dd>½ Platz · 120 Min. + 45 Min. Puffer. Ein gemeinsamer Spieltag mehrerer BSV-Teams zählt einmal.</dd></div>
          <div><dt>D-Junioren / D-Juniorinnen</dt><dd>7er · ½ Platz · 2 × 30 Min. + 15 Min. Pause + 45 Min. Puffer.</dd></div>
          <div><dt>C- / B-Juniorinnen</dt><dd>Mindestens eine 7er-Meldung: ½ Platz; sonst ganzer Platz. Spielzeit 2 × 35 / 2 × 40 Min. + 15 Min. Pause + 45 Min. Puffer.</dd></div>
          <div><dt>C1 / C2</dt><dd>11er / 9er · ganzer Platz · 2 × 35 Min. + 15 Min. Pause + 45 Min. Puffer.</dd></div>
          <div><dt>B / A / Aktive</dt><dd>Ganzer Platz · B: 2 × 40 Min.; A und Aktive: 2 × 45 Min. Jeweils + 15 Min. Pause + 45 Min. Puffer.</dd></div>
        </dl>
        <p>Geplante Endzeiten, keine garantierten Abpfiffzeiten. Bei Pokalspielen können Verlängerung und abweichende Spielformen hinzukommen. Nicht eindeutig zuordenbare Spiele bleiben als Prüffälle sichtbar.</p>
        <p>Quelle: <a href="https://www.fussball.de/verein/-/id/00ES8GN9F000001IVV0AG08LVUPGND5I" target="_blank" rel="noopener noreferrer">FUSSBALL.DE-Vereinsspielplan und einzelne Spielseiten</a>. Spielzeiten: <a href="https://www.sbfv.de/fileadmin/user_upload/Nav_Fussball/Kinder/AB_KiFu/AB13_Juniorenspiele-11.pdf" target="_blank" rel="noopener noreferrer">SBFV AB 13</a>. Tägliche Aktualisierung morgens; Planungshorizont acht Wochen.</p>
      </details>
    </div>
  </main>
  <Footer />
</Layout>
<script>
  const date = document.querySelector<HTMLSelectElement>('#matchday-date')!;
  const view = document.querySelector<HTMLSelectElement>('#matchday-view')!;
  const panels = [...document.querySelectorAll<HTMLElement>('.matchday[data-date]')];
  const update = () => {
    for (const panel of panels) panel.hidden = view.value === 'all' ? panel.dataset.bookings === '0' : panel.dataset.date !== date.value;
    date.disabled = view.value === 'all' || panels.length === 0;
  };
  date.addEventListener('change', update);
  view.addEventListener('change', update);
  const revealHash = () => {
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    const panel = target?.closest<HTMLElement>('.matchday');
    if (panel?.dataset.date) { date.value = panel.dataset.date; view.value = 'day'; update(); }
  };
  window.addEventListener('hashchange', revealHash);
  revealHash();
  update();
</script>
<noscript><style>.matchday[hidden]{display:block!important}.plan-controls{display:none!important}</style></noscript>
<style>
  .matchday-page { padding:36px 0 70px; color:#18362b; background:#fff; letter-spacing:0; }
  .shell { width:min(1180px,calc(100% - 48px)); margin-inline:auto; }
  .plan-heading { display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .plan-heading>div { min-width:0; }
  .plan-heading img { width:180px; height:104px; object-fit:cover; border-radius:4px; }
  .eyebrow { margin:0 0 10px; font-size:12px; font-weight:800; color:#164f32; }
  h1 { margin:0; font-size:36px; line-height:1.2; letter-spacing:0; overflow-wrap:anywhere; }
  .source-status { margin:10px 0 0; font-size:12px; color:#5c6c61; }
  .plan-links { display:flex; flex-wrap:wrap; gap:10px; border-bottom:1px solid #dce4de; padding:20px 0; }
  .summary { display:flex; flex-wrap:wrap; gap:12px 28px; padding:20px 0; font-size:13px; }
  .summary b { font-size:20px; margin-right:5px; }
  .danger { color:#a02c24; }
  .plan-controls { display:flex; flex-wrap:wrap; gap:18px; padding:18px 0; border-top:1px solid #dce4de; border-bottom:1px solid #dce4de; }
  .plan-controls label { display:flex; flex-direction:column; gap:7px; font-size:12px; font-weight:700; min-width:0; max-width:100%; }
  select { max-width:100%; height:44px; border:1px solid #b8c8bf; border-radius:4px; padding:0 32px 0 12px; background:white; color:#18362b; font:inherit; font-size:14px; }
  select:focus-visible { outline:2px solid #164f32; outline-offset:2px; }
  .planning-note { font-size:12px; color:#52625a; line-height:1.7; max-width:950px; margin:16px 0; }
  .legend { display:flex; flex-wrap:wrap; gap:12px 20px; font-size:11px; color:#52625a; }
  .legend span::before { content:''; display:inline-block; width:10px; height:10px; margin-right:6px; background:#164f32; }
  .legend .half::before { background:#b7d5c3; }.legend .kids::before { background:#e9c423; }.legend .girls::before { background:#68a7b0; }.legend .conflict::before { background:#b3322b; }
  .matchday { padding:28px 0; scroll-margin-top:145px; }
  .matchday[hidden] { display:none; }
  .day-heading { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin-bottom:22px; }
  h2 { margin:0; font-size:23px; line-height:1.3; letter-spacing:0; }
  .conflict-label { font-size:12px; color:#a02c24; }
  .pitches { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:36px; align-items:start; }
  .status-warning,.pending { padding:16px; background:#fff4d6; border-left:3px solid #c99a21; font-size:13px; line-height:1.7; }
  .pending { margin-top:24px; }
  .pending h3 { font-size:18px; margin:0; }
  .pending article { padding:14px 0; border-bottom:1px solid #e3d5ae; }
  .pending p { margin:6px 0; overflow-wrap:anywhere; }
  .pending a { color:#164f32; font-weight:700; }
  .empty { font-size:14px; color:#52625a; padding:20px 0; }
  .rules { margin-top:24px; padding-top:20px; border-top:1px solid #dce4de; font-size:13px; }
  .rules summary { font-weight:800; cursor:pointer; padding:8px 0; }
  .rules dl>div { display:grid; grid-template-columns:220px 1fr; gap:20px; padding:12px 0; border-bottom:1px solid #edf0ed; line-height:1.6; }
  .rules dt { font-weight:700; }.rules dd { margin:0; }.rules p { line-height:1.7; color:#52625a; }.rules a { color:#164f32; }
  @media(max-width:800px) { .pitches { grid-template-columns:1fr; gap:30px; } h1 { font-size:30px; } .plan-heading img { width:120px; height:90px; } }
  @media(max-width:540px) { .shell { width:calc(100% - 30px); } .plan-heading { display:block; } .plan-heading img { margin-top:16px; width:100%; height:110px; object-position:center 55%; } h1 { font-size:27px; } h2 { font-size:20px; } .plan-controls label { width:100%; } .rules dl>div { grid-template-columns:1fr; gap:4px; } }
  @media print { .plan-heading img,.plan-links,.plan-controls,.legend { display:none; } .shell { width:100%; } .matchday { break-inside:avoid; }.pitches { grid-template-columns:1fr 1fr; } }
</style>
