---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TrainingPlanFilter from '../../components/TrainingPlanFilter.astro';
import { teamProfiles } from '../../data/teamPages';
import { trainingFilterKeyByTeam } from '../../data/trainingPlanFilters';
import { withBase } from '../../utils/paths';
import { findTrainingConflicts } from '../../utils/trainingConflicts.mjs';

type Pitch = 'Hauptplatz' | 'Nebenplatz';
type Tone = 'active' | 'girls' | 'youth' | 'kids';
type Allocation = { pitch: Pitch; share: number; shareLabel: string; tone: Tone };
type ProposalChange = { day?: string; time?: string; place?: string; allocation?: Partial<Allocation> };

const dayOrder = ['Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag'];
const teamNames: Record<string, string> = {
  'fussball/herren/bezirksliga': 'Herren 1',
  'fussball/herren/kreisliga-2': 'Herren 2',
  'fussball/frauen/bezirksliga': 'Frauen 1',
  'fussball/frauen/kreisliga': 'Frauen 2',
  'fussball/alte-herren': 'Alte Herren',
  'jugend/u11-e1': 'E1-Junioren',
  'jugend/u11-e2': 'E2-Junioren',
  'jugend/u11-e3': 'E3-Junioren',
  'jugend/u9-f': 'U9 F-Junioren',
  'jugend/u8-f': 'F2 + F3-Junioren',
  'jugend/u7-g': 'U7 G-Junioren',
  'jugend/u6-g': 'U6 Spielgruppe',
  'jugend/u19': 'A-Junioren',
  'jugend/u17': 'B-Junioren',
  'jugend/u15-c1': 'C1-Junioren',
  'jugend/u15-c2': 'C2-Junioren',
  'jugend/u13-d1': 'D1-Junioren',
  'jugend/u13-d2': 'D2-Junioren',
  'jugend/u13-d3': 'D3-Junioren',
  'jugend/juniorinnen/u17': 'B-Juniorinnen',
  'jugend/juniorinnen/u15': 'C-Juniorinnen',
  'jugend/juniorinnen/u13': 'D-Juniorinnen',
};

const allocationByTeam: Record<string, Allocation> = {
  'fussball/herren/bezirksliga': { pitch: 'Hauptplatz', share: .5, shareLabel: '½ Platz', tone: 'active' },
  'fussball/herren/kreisliga-2': { pitch: 'Hauptplatz', share: .5, shareLabel: '½ Platz', tone: 'active' },
  'fussball/frauen/bezirksliga': { pitch: 'Nebenplatz', share: .5, shareLabel: '½ Platz', tone: 'girls' },
  'fussball/frauen/kreisliga': { pitch: 'Nebenplatz', share: .5, shareLabel: '½ Platz', tone: 'girls' },
  'fussball/alte-herren': { pitch: 'Nebenplatz', share: .5, shareLabel: '½ Platz', tone: 'active' },
  'jugend/u11-e1': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'kids' },
  'jugend/u11-e2': { pitch: 'Hauptplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'kids' },
  'jugend/u11-e3': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'kids' },
  'jugend/u9-f': { pitch: 'Hauptplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'kids' },
  'jugend/u8-f': { pitch: 'Hauptplatz', share: 1, shareLabel: 'je ½ Platz', tone: 'kids' },
  'jugend/u7-g': { pitch: 'Hauptplatz', share: .5, shareLabel: '½ Platz', tone: 'kids' },
  'jugend/u6-g': { pitch: 'Hauptplatz', share: .5, shareLabel: '½ Platz', tone: 'kids' },
  'jugend/u19': { pitch: 'Hauptplatz', share: 1, shareLabel: 'Ganzer Platz', tone: 'youth' },
  'jugend/u17': { pitch: 'Nebenplatz', share: .5, shareLabel: '½ Platz', tone: 'youth' },
  'jugend/u15-c1': { pitch: 'Hauptplatz', share: .5, shareLabel: '½ Platz', tone: 'youth' },
  'jugend/u15-c2': { pitch: 'Hauptplatz', share: .5, shareLabel: '½ Platz', tone: 'youth' },
  'jugend/u13-d1': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'youth' },
  'jugend/u13-d2': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'youth' },
  'jugend/u13-d3': { pitch: 'Hauptplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'youth' },
  'jugend/juniorinnen/u17': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'girls' },
  'jugend/juniorinnen/u15': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'girls' },
  'jugend/juniorinnen/u13': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'girls' },
};

const changes: Record<string, ProposalChange> = {
  'fussball/alte-herren|Mittwoch': { time: '19:00 – 20:30 Uhr', allocation: { pitch: 'Hauptplatz' } },
  'jugend/u19|Dienstag': { day: 'Montag', time: '19:30 – 21:00 Uhr', allocation: { pitch: 'Nebenplatz' } },
  'jugend/u15-c2|Dienstag': { day: 'Freitag', time: '19:00 – 20:30 Uhr' },
  'jugend/u15-c2|Donnerstag': { day: 'Montag', time: '19:00 – 20:30 Uhr' },
  'jugend/u13-d3|Donnerstag': { day: 'Freitag', time: '17:30 – 19:00 Uhr' },
  'jugend/u17|Donnerstag': { time: '19:00 – 20:30 Uhr' },
  'jugend/u13-d2|Montag': { time: '16:30 – 18:00 Uhr' },
  'jugend/u13-d2|Mittwoch': { allocation: { pitch: 'Hauptplatz' } },
  'jugend/u7-g|Mittwoch': { allocation: { pitch: 'Hauptplatz', share: 1 / 3, shareLabel: '⅓ Platz' } },
  'jugend/u6-g|Mittwoch': { allocation: { pitch: 'Hauptplatz', share: 1 / 3, shareLabel: '⅓ Platz' } },
  'fussball/herren/kreisliga-2|Dienstag': { place: 'SV Markelfingen' },
};

const actionItems = [
  {
    team: 'Alte Herren',
    original: 'Mittwoch ab 19:00 Uhr auf dem Nebenplatz; keine Endzeit angegeben.',
    proposal: 'Mittwoch 19:00–20:30 Uhr auf dem Hauptplatz.',
  },
  {
    team: 'A-Junioren',
    original: 'Dienstag 19:00–20:30 Uhr, ganzer Hauptplatz; Donnerstag zur gleichen Zeit in Markelfingen.',
    proposal: 'BSV-Einheit am Montag 19:30–21:00 Uhr, ganzer Nebenplatz; Donnerstag in Markelfingen unverändert.',
  },
  {
    team: 'C1-Junioren',
    original: 'Dienstag und Donnerstag 18:30–20:00 Uhr, jeweils ganzer Hauptplatz.',
    proposal: 'Dienstag und Donnerstag 18:30–20:00 Uhr, jeweils ½ Hauptplatz. Der Dienstag bleibt auf Wunsch des Trainers erhalten.',
  },
  {
    team: 'C2-Junioren',
    original: 'Dienstag und Donnerstag 18:30–20:00 Uhr, jeweils ½ Nebenplatz.',
    proposal: 'Montag und Freitag 19:00–20:30 Uhr, jeweils ½ Hauptplatz.',
  },
  {
    team: 'D3-Junioren',
    original: 'Montag und Donnerstag 17:00–18:30 Uhr, jeweils ⅓ Hauptplatz.',
    proposal: 'Montag unverändert; zweite Einheit Freitag 17:30–19:00 Uhr, ⅓ Hauptplatz.',
  },
  {
    team: 'B-Junioren',
    original: 'Dienstag 19:00–20:30 Uhr in Markelfingen; Donnerstag 18:30–20:00 Uhr auf ½ Nebenplatz beim BSV.',
    proposal: 'Dienstag unverändert; Donnerstag 19:00–20:30 Uhr auf ½ Nebenplatz beim BSV.',
  },
  {
    team: 'D2-Junioren',
    original: 'Montag und Mittwoch 17:30–19:00 Uhr, jeweils ⅓ Nebenplatz.',
    proposal: 'Montag 16:30–18:00 Uhr auf ⅓ Nebenplatz; Mittwoch 17:30–19:00 Uhr auf ⅓ Hauptplatz.',
  },
  {
    team: 'U6 & U7',
    original: 'Mittwoch 16:30–17:30 Uhr auf dem Hauptplatz, jeweils ½ Platz.',
    proposal: 'Zeit und Hauptplatz bleiben unverändert; Platzbedarf wird jeweils auf ⅓ reduziert.',
  },
  {
    team: 'Herren 1 & Herren 2',
    original: 'Beide Mannschaften trainieren dienstags und donnerstags 19:00–20:30 Uhr mit jeweils ½ Hauptplatz beim BSV.',
    proposal: 'Herren 1 bleibt dienstags und donnerstags auf ½ Hauptplatz. Herren 2 trainiert dienstags in Markelfingen und donnerstags auf ½ Hauptplatz beim BSV.',
  },
];

const timeValue = (time: string) => {
  const match = time.match(/(\d{1,2}):(\d{2})/);
  return match ? Number(match[1]) * 60 + Number(match[2]) : 24 * 60;
};
const isAtBsv = (place: string) => /BSV Nordstern/i.test(place);

const allTraining = Object.entries(teamProfiles).flatMap(([path, profile]) =>
  profile.training.map((slot) => {
    const change = changes[`${path}|${slot.day}`] ?? {};
    const allocation = allocationByTeam[path]
      ? { ...allocationByTeam[path], ...(change.allocation ?? {}) }
      : undefined;
    return {
      path,
      team: teamNames[path] ?? profile.letter,
      filterKey: trainingFilterKeyByTeam[path],
      ...slot,
      ...change,
      allocation,
    };
  }),
);
const bsvSessions = allTraining
  .filter((session) => isAtBsv(session.place) && dayOrder.includes(session.day) && session.allocation)
  .sort((left, right) => dayOrder.indexOf(left.day) - dayOrder.indexOf(right.day) || timeValue(left.time) - timeValue(right.time) || left.team.localeCompare(right.team, 'de'));
const offsiteSessions = allTraining
  .filter((session) => !isAtBsv(session.place) && dayOrder.includes(session.day))
  .sort((left, right) => dayOrder.indexOf(left.day) - dayOrder.indexOf(right.day) || timeValue(left.time) - timeValue(right.time));
const openSessions = allTraining.filter((session) => !dayOrder.includes(session.day));
const sessionsFor = (day: string, pitch: Pitch) => bsvSessions.filter((session) => session.day === day && session.allocation?.pitch === pitch);
const trainingConflicts = findTrainingConflicts(bsvSessions);
const conflictsFor = (day: string, pitch: Pitch) => trainingConflicts.filter((conflict) => conflict.day === day && conflict.pitch === pitch);
const filterKeyByTeamName = Object.fromEntries(Object.entries(teamNames).map(([path, name]) => [name, trainingFilterKeyByTeam[path]]));
---

<Layout
  title="Belegungsplan 2 – Diskussionsstand | BSV Nordstern Radolfzell"
  description="Nicht verlinkter Entwurf eines optimierten Trainings- und Platzbelegungsplans für den BSV Nordstern."
  noindex
>
  <Header />
  <main>
    <header class="hero">
      <img src={withBase('/images/fussball/sportplaetze/bd41b6f7d7-hauptplatz-hp.png')} alt="Hauptplatz des BSV Nordstern Radolfzell" width="1600" height="1011" />
      <div class="shade"></div>
      <div class="shell hero-inner">
        <span>Entwurf · nicht öffentlich verlinkt</span>
        <h1>Belegungsplan 2.<br /><em>Optimierter Vorschlag.</em></h1>
        <p>Diskussionsstand für die Trainings- und Platzbelegung der Saison 2026/27. Die unten genannten Änderungen sind noch nicht als verbindliche Trainingszeiten veröffentlicht.</p>
        <a href="#aenderungen">Änderungen ansehen <b aria-hidden="true">↓</b></a>
      </div>
    </header>

    <section id="aenderungen" class="actions-section">
      <div class="shell actions-grid">
        <div class="actions-heading">
          <span>Änderungen gegenüber dem Originalplan</span>
          <h2>Originalplan und Plan 2 im direkten Vergleich.</h2>
          <p><strong>Vergleichsgrundlage ist immer der aktuell auf der Homepage verlinkte Belegungsplan.</strong> Die Liste zeigt ausschließlich dessen Unterschiede zu Plan 2 – nicht die Änderungen seit einem früheren Stand von Plan 2.</p>
          <aside><strong>Planungsannahme</strong>Der Dienstagstermin der Herren 2 in Markelfingen muss mit der SG abgestimmt werden. Die Überbelegung des Hauptplatzes am Donnerstag von 19:00 bis 20:00 Uhr bleibt im Plan bewusst sichtbar.</aside>
        </div>
        <ol class="action-list">
          {actionItems.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <strong>{item.team}</strong>
                <dl>
                  <div><dt>Original</dt><dd>{item.original}</dd></div>
                  <div><dt>Plan 2</dt><dd>{item.proposal}</dd></div>
                </dl>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="allocation-section">
      <div class="shell allocation-card">
        <div><span>Ergebnis</span><h2>Eine Überbelegung bleibt sichtbar.</h2></div>
        <p>C1 bleibt dienstags auf ½ Hauptplatz, Herren 1 nutzt ab 19:00 Uhr die andere Hälfte und Herren 2 trainiert in Markelfingen. Donnerstags benötigen C1, Herren 1 und Herren 2 zwischen 19:00 und 20:00 Uhr zusammen 150 % des Hauptplatzes. Dieses Zeitfenster wird im Wochenplan bewusst als Überlastung ausgewiesen.</p>
      </div>
    </section>

    <section id="wochenplan" class="schedule-section">
      <div class="shell section-head"><div><span>Montag bis Freitag</span><h2>Der vorgeschlagene Wochenplan.</h2></div><p>Hauptplatz und Nebenplatz werden getrennt dargestellt. Die farbigen Balken zeigen den jeweils vorgesehenen Platzanteil.</p></div>
      <div class="shell"><TrainingPlanFilter /></div>
      <div class="shell schedule-list" data-schedule-list>
        {dayOrder.map((day) => (
          <article class="day-card" data-schedule-day>
            <header><span>{day.slice(0, 2).toUpperCase()}</span><h3>{day}</h3></header>
            <div class="pitch-grid">
              {(['Hauptplatz', 'Nebenplatz'] as Pitch[]).map((pitch) => {
                const sessions = sessionsFor(day, pitch);
                const conflicts = conflictsFor(day, pitch);
                const hasArchery = day === 'Freitag' && pitch === 'Nebenplatz';
                return (
                  <section class="pitch-card" data-pitch-card>
                    <div class="pitch-title"><span>{pitch === 'Hauptplatz' ? '01' : '02'}</span><div><small>BSV-Sportgelände</small><h4>{pitch}</h4></div></div>
                    <div class="booking-list">
                      {hasArchery && <a class="booking is-other" data-team-filter="other" href={withBase('/abteilungen/bogensport')}><span class="booking-time">17:30 – 19:00 Uhr</span><strong>Bogensport</strong><span class="share"><i style="--share:100%"></i><b>Nebenplatz belegt</b></span></a>}
                      {sessions.map((session) => (
                        <a class:list={['booking', `is-${session.allocation?.tone}`]} data-team-filter={session.filterKey} href={withBase(`/${session.path}`)}>
                          <span class="booking-time">{session.time}</span><strong>{session.team}</strong>
                          <span class="share"><i style={`--share:${(session.allocation?.share ?? 0) * 100}%`}></i><b>{session.allocation?.shareLabel}</b></span>
                        </a>
                      ))}
                      {!sessions.length && !hasArchery && <p class="free">Keine feste Belegung eingetragen.</p>}
                      <p class="free filter-empty" data-filter-empty hidden>Keine Termine für diese Auswahl.</p>
                    </div>
                    {conflicts.length > 0 && <div class="conflict-list" data-conflict-list>
                      {conflicts.map((conflict) => <p data-conflict-filter-keys={conflict.teams.map((team) => filterKeyByTeamName[team]).filter(Boolean).join(' ')}><strong>Überlastung · {conflict.time}</strong>{conflict.teams.join(', ')}: {conflict.occupancyPercent} %.</p>)}
                    </div>}
                  </section>
                );
              })}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="details-section">
      <div class="shell detail-grid">
        <article class="detail-card">
          <span>Spielgemeinschaften</span><h2>Training an anderen Orten.</h2>
          <div class="detail-list" data-filter-detail-list>
            {offsiteSessions.map((session) => <a data-team-filter={session.filterKey} href={withBase(`/${session.path}`)}><div><strong>{session.team}</strong><span>{session.place}</span></div><b>{session.day}<br />{session.time}</b></a>)}
            <p class="detail-empty" data-filter-detail-empty hidden>Für diese Auswahl gibt es keine auswärtigen Termine.</p>
          </div>
        </article>
        <article class="detail-card is-open">
          <span>Status</span><h2>Entwurf zur Abstimmung.</h2>
          <p>Dieser Plan ist nicht in der Navigation verlinkt und für Suchmaschinen auf „noindex“ gesetzt. Erst nach Abstimmung sollten die Änderungen in den Mannschaftsseiten und den offiziellen Belegungsplan übernommen werden.</p>
          {openSessions.length > 0 && <div class="detail-list">
            {openSessions.map((session) => <a href={withBase(`/${session.path}`)}><div><strong>{session.team}</strong><span>{session.place}</span></div><b>{session.day}<br />{session.time}</b></a>)}
          </div>}
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  :global(:root){--green:#164f32;--dark:#082f20;--yellow:#f4d638;--light:#f4f7f4;--ink:#14251a}
  html{scroll-behavior:smooth}.shell{width:min(1160px,calc(100% - 48px));margin-inline:auto}
  .hero{position:relative;min-height:570px;display:flex;align-items:flex-end;overflow:hidden;background:var(--dark);color:white}.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(90deg,rgb(5 34 22 / 96%) 0%,rgb(5 34 22 / 80%) 48%,rgb(5 34 22 / 20%) 84%),linear-gradient(0deg,rgb(5 34 22 / 82%),transparent 58%)}.hero-inner{position:relative;z-index:1;padding:95px 0 72px}.hero-inner>span,.actions-heading>span,.allocation-card span,.section-head span,.detail-card>span{color:var(--yellow);font-size:.69rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.hero h1{margin:18px 0 22px;font-family:Georgia,serif;font-size:clamp(3.4rem,7vw,6.6rem);line-height:.88;letter-spacing:-.055em}.hero h1 em{color:var(--yellow);font-weight:400}.hero p{max-width:730px;margin:0;color:#cfddd4;font-size:1.05rem;line-height:1.72}.hero a{display:inline-flex;align-items:center;gap:22px;margin-top:29px;padding:15px 19px;background:var(--yellow);color:var(--dark);font-weight:900;text-decoration:none}
  .actions-section{scroll-margin-top:30px;padding:90px 0;background:white}.actions-grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:70px}.actions-heading>span,.allocation-card span,.section-head span,.detail-card>span{color:var(--green)}.actions-heading h2,.allocation-card h2,.section-head h2,.detail-card h2{margin:14px 0 0;color:var(--ink);font-family:Georgia,serif;font-size:clamp(2.35rem,4.2vw,4rem);line-height:.98;letter-spacing:-.045em}.actions-heading>p{color:#5a695f;line-height:1.72}.actions-heading>p strong{color:var(--dark)}.actions-heading aside{margin-top:28px;padding:18px 20px;border-left:5px solid var(--yellow);background:#fff8cf;color:#4f594f;line-height:1.55}.actions-heading aside strong{display:block;color:var(--dark);font-size:.77rem;text-transform:uppercase;letter-spacing:.08em}.action-list{margin:0;padding:0;list-style:none;border-top:1px solid #dce3dd}.action-list li{display:grid;grid-template-columns:44px 1fr;gap:15px;padding:18px 0;border-bottom:1px solid #dce3dd}.action-list li>span{display:grid;place-items:center;width:38px;aspect-ratio:1;border-radius:50%;background:#e8f0e9;color:var(--green);font-size:.68rem;font-weight:950}.action-list li>div>strong{color:var(--dark);font-size:1rem}.action-list dl{display:grid;gap:7px;margin:9px 0 0}.action-list dl>div{display:grid;grid-template-columns:62px 1fr;gap:9px}.action-list dt{color:#728078;font-size:.66rem;font-weight:950;letter-spacing:.07em;text-transform:uppercase}.action-list dd{margin:0;color:#647168;font-size:.84rem;line-height:1.48}.action-list dl>div:last-child dt{color:var(--green)}.action-list dl>div:last-child dd{color:#263b2d;font-weight:650}
