---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { teamProfiles } from '../../data/teamPages';
import { withBase } from '../../utils/paths';
import { findTrainingConflicts } from '../../utils/trainingConflicts.mjs';

type Pitch = 'Hauptplatz' | 'Nebenplatz';
type Allocation = {
  pitch: Pitch;
  share: number;
  shareLabel: string;
  tone: 'active' | 'girls' | 'youth' | 'kids';
};

const dayOrder = ['Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag'];
const teamNames: Record<string, string> = {
  'fussball/herren/bezirksliga': 'Herren 1',
  'fussball/herren/kreisliga-2': 'Herren 2',
  'fussball/frauen/bezirksliga': 'Frauen 1',
  'fussball/frauen/kreisliga': 'Frauen 2',
  'fussball/alte-herren': 'Alte Herren',
  'jugend/u11-e1': 'E1-Junioren',
  'jugend/u11-e2': 'E2-Junioren',
  'jugend/u11-e3': 'E3-Junioren',
  'jugend/u9-f': 'U9 F-Junioren',
  'jugend/u8-f': 'F2 + F3-Junioren',
  'jugend/u7-g': 'U7 G-Junioren',
  'jugend/u6-g': 'U6 Spielgruppe',
  'jugend/u19': 'A-Junioren',
  'jugend/u17': 'B-Junioren',
  'jugend/u15-c1': 'C1-Junioren',
  'jugend/u15-c2': 'C2-Junioren',
  'jugend/u13-d1': 'D1-Junioren',
  'jugend/u13-d2': 'D2-Junioren',
  'jugend/u13-d3': 'D3-Junioren',
  'jugend/juniorinnen/u17': 'B-Juniorinnen',
  'jugend/juniorinnen/u15': 'C-Juniorinnen',
  'jugend/juniorinnen/u13': 'D-Juniorinnen',
};

const allocationByTeam: Record<string, Allocation> = {
  'fussball/herren/bezirksliga': { pitch: 'Hauptplatz', share: .5, shareLabel: '½ Platz', tone: 'active' },
  'fussball/herren/kreisliga-2': { pitch: 'Hauptplatz', share: .5, shareLabel: '½ Platz', tone: 'active' },
  'fussball/frauen/bezirksliga': { pitch: 'Nebenplatz', share: .5, shareLabel: '½ Platz', tone: 'girls' },
  'fussball/frauen/kreisliga': { pitch: 'Nebenplatz', share: .5, shareLabel: '½ Platz', tone: 'girls' },
  'fussball/alte-herren': { pitch: 'Nebenplatz', share: .5, shareLabel: '½ Platz', tone: 'active' },
  'jugend/u11-e1': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'kids' },
  'jugend/u11-e2': { pitch: 'Hauptplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'kids' },
  'jugend/u11-e3': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'kids' },
  'jugend/u9-f': { pitch: 'Hauptplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'kids' },
  'jugend/u8-f': { pitch: 'Hauptplatz', share: 1, shareLabel: 'je ½ Platz', tone: 'kids' },
  'jugend/u7-g': { pitch: 'Hauptplatz', share: .5, shareLabel: '½ Platz', tone: 'kids' },
  'jugend/u6-g': { pitch: 'Hauptplatz', share: .5, shareLabel: '½ Platz', tone: 'kids' },
  'jugend/u19': { pitch: 'Hauptplatz', share: 1, shareLabel: 'Ganzer Platz', tone: 'youth' },
  'jugend/u17': { pitch: 'Nebenplatz', share: .5, shareLabel: '½ Platz', tone: 'youth' },
  'jugend/u15-c1': { pitch: 'Hauptplatz', share: 1, shareLabel: 'Ganzer Platz', tone: 'youth' },
  'jugend/u15-c2': { pitch: 'Nebenplatz', share: .5, shareLabel: '½ Platz', tone: 'youth' },
  'jugend/u13-d1': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'youth' },
  'jugend/u13-d2': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'youth' },
  'jugend/u13-d3': { pitch: 'Hauptplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'youth' },
  'jugend/juniorinnen/u17': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'girls' },
  'jugend/juniorinnen/u15': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'girls' },
  'jugend/juniorinnen/u13': { pitch: 'Nebenplatz', share: 1 / 3, shareLabel: '⅓ Platz', tone: 'girls' },
};

const timeValue = (time: string) => {
  const match = time.match(/(\d{1,2}):(\d{2})/);
  return match ? Number(match[1]) * 60 + Number(match[2]) : 24 * 60;
};
const isAtBsv = (place: string) => /BSV Nordstern/i.test(place);

const allTraining = Object.entries(teamProfiles).flatMap(([path, profile]) =>
  profile.training.map((slot) => ({
    path,
    team: teamNames[path] ?? profile.letter,
    ...slot,
    allocation: allocationByTeam[path],
  })),
);
const bsvSessions = allTraining
  .filter((session) => isAtBsv(session.place) && dayOrder.includes(session.day) && session.allocation)
  .sort((left, right) => dayOrder.indexOf(left.day) - dayOrder.indexOf(right.day) || timeValue(left.time) - timeValue(right.time) || left.team.localeCompare(right.team, 'de'));
const offsiteSessions = allTraining
  .filter((session) => !isAtBsv(session.place) && dayOrder.includes(session.day))
  .sort((left, right) => dayOrder.indexOf(left.day) - dayOrder.indexOf(right.day) || timeValue(left.time) - timeValue(right.time));
const openSessions = allTraining.filter((session) => !dayOrder.includes(session.day));

const sessionsFor = (day: string, pitch: Pitch) => bsvSessions.filter((session) => session.day === day && session.allocation.pitch === pitch);
const trainingConflicts = findTrainingConflicts(bsvSessions);
const conflictsFor = (day: string, pitch: Pitch) => trainingConflicts.filter((conflict) => conflict.day === day && conflict.pitch === pitch);
---

<Layout
  title="Belegungsplan | BSV Nordstern Radolfzell"
  description="Wochenplan für Hauptplatz und Nebenplatz des BSV Nordstern mit Trainingszeiten und Platzanteilen aller Mannschaften."
>
  <Header />
  <main>
    <header class="hero">
      <img src={withBase('/images/fussball/sportplaetze/bd41b6f7d7-hauptplatz-hp.png')} alt="Hauptplatz des BSV Nordstern Radolfzell" width="1600" height="1011" />
      <div class="shade"></div>
      <div class="shell hero-inner">
        <span>Fußball · Platzplanung</span>
        <h1>Zwei Plätze.<br /><em>Viele Teams.</em></h1>
        <p>Der aktuelle Trainingsplan zeigt, wann unsere Mannschaften auf dem Haupt- und Nebenplatz trainieren und welcher Platzanteil dafür vorgesehen ist.</p>
        <a href="#wochenplan">Wochenplan ansehen <b aria-hidden="true">↓</b></a>
      </div>
    </header>

    <section class="plan-intro">
      <div class="shell intro-grid">
        <div><span>Aktueller Planungsstand</span><h2>Training gut<br />aufeinander abstimmen.</h2></div>
        <div class="intro-copy">
          <p>Grundlage sind die Trainingszeiten auf den einzelnen Mannschaftsseiten. Angezeigt werden nur Einheiten auf dem BSV-Sportgelände; auswärtige Termine und noch offene Zeiten stehen separat unter dem Wochenplan.</p>
          <div class="facts">
            <article><strong>2</strong><span>Plätze</span></article>
            <article><strong>{bsvSessions.length}</strong><span>BSV-Einheiten</span></article>
            <article><strong>Mo–Fr</strong><span>Wochenansicht</span></article>
          </div>
        </div>
      </div>
    </section>

    <section class="allocation-section">
      <div class="shell allocation-card">
        <div class="allocation-heading"><span>Geplante Platzanteile</span><h2>Vom Drittel bis zum ganzen Feld.</h2><p>Bei zeitgleich angesetzten Aktiven-Teams wird der jeweilige Platz hälftig dargestellt. Die Angaben sind die Grundlage für die Abstimmung vor Ort.</p></div>
        <div class="allocation-list">
          <div><b>G-Jugend</b><span>je ½ Platz</span></div>
          <div><b>F1-, E- und D-Jugend</b><span>je ⅓ Platz</span></div>
          <div><b>F2- & F3-Junioren</b><span>je ½ Platz</span></div>
          <div><b>D- bis B-Juniorinnen</b><span>je ⅓ Platz</span></div>
          <div><b>C1-Junioren</b><span>ganzer Platz</span></div>
          <div><b>C2- & B-Junioren</b><span>je ½ Platz</span></div>
          <div><b>A-Junioren</b><span>1× pro Woche ganzer Platz</span></div>
        </div>
      </div>
    </section>

    <section id="wochenplan" class="schedule-section">
      <div class="shell section-head"><div><span>Montag bis Freitag</span><h2>Belegung auf einen Blick.</h2></div><p>Rote Hinweise zeigen automatisch erkannte Zeitfenster, in denen die eingetragenen Platzanteile zusammen mehr als einen ganzen Platz benötigen.</p></div>
      <div class="shell schedule-list">
        {dayOrder.map((day) => (
          <article class="day-card">
            <header><span>{day.slice(0, 2).toUpperCase()}</span><h3>{day}</h3></header>
            <div class="pitch-grid">
              {(['Hauptplatz', 'Nebenplatz'] as Pitch[]).map((pitch) => {
                const sessions = sessionsFor(day, pitch);
                const conflicts = conflictsFor(day, pitch);
                return (
                  <section class="pitch-card">
                    <div class="pitch-title"><span>{pitch === 'Hauptplatz' ? '01' : '02'}</span><div><small>BSV-Sportgelände</small><h4>{pitch}</h4></div></div>
                    <div class="booking-list">
                      {sessions.length ? sessions.map((session) => (
                        <a class:list={['booking', `is-${session.allocation.tone}`]} href={withBase(`/${session.path}`)}>
                          <span class="booking-time">{session.time}</span>
                          <strong>{session.team}</strong>
                          <span class="share"><i style={`--share:${session.allocation.share * 100}%`}></i><b>{session.allocation.shareLabel}</b></span>
                        </a>
                      )) : day === 'Freitag' && pitch === 'Nebenplatz' ? (
                        <a class="booking is-other" href={withBase('/abteilungen/bogensport')}>
                          <span class="booking-time">17:30 – 19:00 Uhr</span><strong>Bogensport</strong><span class="share"><i style="--share:100%"></i><b>Nebenplatz belegt</b></span>
                        </a>
                      ) : <p class="free">Keine feste Belegung eingetragen.</p>}
                    </div>
                    {conflicts.length > 0 && <div class="conflict-list" aria-label={`Überlastungen ${pitch} am ${day}`}>
                      {conflicts.map((conflict) => (
                        <p class="conflict-note">
                          <span class="conflict-icon" aria-hidden="true">!</span>
                          <span><strong>Überlastung · {conflict.time}</strong>{conflict.teams.join(', ')} belegen zusammen {conflict.occupancyPercent} % des {pitch === 'Hauptplatz' ? 'Hauptplatzes' : 'Nebenplatzes'}.</span>
                        </p>
                      ))}
                    </div>}
                  </section>
                );
              })}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="details-section">
      <div class="shell detail-grid">
        <article class="detail-card">
          <span>Spielgemeinschaften</span><h2>Training an anderen Orten.</h2>
          <div class="detail-list">
            {offsiteSessions.map((session) => (
              <a href={withBase(`/${session.path}`)}><div><strong>{session.team}</strong><span>{session.place}</span></div><b>{session.day}<br />{session.time}</b></a>
            ))}
          </div>
        </article>
        <article class="detail-card is-open">
          <span>Noch offen</span><h2>Termin folgt.</h2>
          <p>Diese Mannschaften sind bereits berücksichtigt, haben auf ihrer Teamseite aber noch keinen festen Wochentag oder keine feste Uhrzeit.</p>
          <div class="detail-list">
            {openSessions.map((session) => (
              <a href={withBase(`/${session.path}`)}><div><strong>{session.team}</strong><span>{session.place}</span></div><b>{session.day}<br />{session.time}</b></a>
            ))}
          </div>
        </article>
      </div>
    </section>

    <aside class="plan-note">
      <div class="shell plan-note-inner"><div><span>Hinweis</span><h2>Änderungen bleiben möglich.</h2><p>Spielbetrieb, Witterung, Platzpflege und Absprachen innerhalb der Spielgemeinschaften können zu kurzfristigen Änderungen führen. Maßgeblich ist die Abstimmung mit dem jeweiligen Trainerteam.</p></div><a class="button button-yellow" href={withBase('/kontakt?thema=general')}>Fußballabteilung kontaktieren <span aria-hidden="true">↗</span></a></div>
    </aside>
  </main>
  <Footer />
</Layout>

<style>
  :global(:root){--green:#164f32;--dark:#082f20;--yellow:#f4d638;--light:#f4f7f4;--ink:#14251a}
  html{scroll-behavior:smooth}.shell{width:min(1160px,calc(100% - 48px));margin-inline:auto}
  .hero{position:relative;min-height:610px;display:flex;align-items:flex-end;overflow:hidden;background:var(--dark);color:white}.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(90deg,rgb(5 34 22 / 96%) 0%,rgb(5 34 22 / 80%) 44%,rgb(5 34 22 / 18%) 82%),linear-gradient(0deg,rgb(5 34 22 / 82%),transparent 58%)}.hero-inner{position:relative;z-index:1;padding:95px 0 78px}.hero-inner>span,.intro-grid>div>span,.allocation-heading>span,.section-head span,.detail-card>span,.plan-note span{color:var(--yellow);font-size:.69rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.hero h1{margin:18px 0 22px;font-family:Georgia,serif;font-size:clamp(3.5rem,7vw,6.8rem);line-height:.88;letter-spacing:-.055em}.hero h1 em{color:var(--yellow);font-weight:400}.hero p{max-width:710px;margin:0;color:#cfddd4;font-size:1.06rem;line-height:1.75}.hero a{display:inline-flex;align-items:center;gap:22px;margin-top:30px;padding:15px 19px;background:var(--yellow);color:var(--dark);font-weight:900;text-decoration:none}
  .plan-intro{padding:90px 0;background:white}.intro-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:80px}.intro-grid h2,.allocation-heading h2,.section-head h2,.detail-card h2,.plan-note h2{margin:14px 0 0;color:var(--ink);font-family:Georgia,serif;font-size:clamp(2.5rem,4.5vw,4.4rem);line-height:.96;letter-spacing:-.045em}.intro-grid>div>span,.allocation-heading>span,.section-head span,.detail-card>span{color:var(--green)}.intro-copy>p{margin:4px 0 30px;color:#5a695f;line-height:1.75}.facts{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #dce3dd;border-bottom:1px solid #dce3dd}.facts article{padding:20px 16px;border-right:1px solid #dce3dd}.facts article:last-child{border:0}.facts strong,.facts span{display:block}.facts strong{color:var(--green);font-size:1.75rem}.facts span{margin-top:3px;color:#66736a;font-size:.72rem;font-weight:800;text-transform:uppercase}
  .allocation-section{padding:0 0 90px;background:white}.allocation-card{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:65px;padding:52px;background:var(--yellow);box-shadow:10px 10px 0 var(--dark)}.allocation-heading h2{font-size:clamp(2.2rem,4vw,3.7rem)}.allocation-heading p{margin:20px 0 0;color:#475449;line-height:1.65}.allocation-list{display:grid;grid-template-columns:1fr 1fr;align-content:start}.allocation-list div{display:flex;justify-content:space-between;gap:16px;padding:17px 0;border-bottom:1px solid rgb(8 47 32 / 22%)}.allocation-list div:nth-child(odd){padding-right:18px}.allocation-list div:nth-child(even){padding-left:18px;border-left:1px solid rgb(8 47 32 / 22%)}.allocation-list b{color:var(--dark)}.allocation-list span{color:#455347;font-size:.84rem;text-align:right}
  .schedule-section{scroll-margin-top:30px;padding:95px 0 115px;background:var(--light)}.section-head{display:grid;grid-template-columns:minmax(0,1fr) 420px;gap:55px;align-items:end;margin-bottom:45px}.section-head p{margin:0;color:#5a695f;line-height:1.65}.schedule-list{display:grid;gap:24px}.day-card{overflow:hidden;border:1px solid #dbe3dc;background:white;box-shadow:0 14px 38px rgb(9 47 32 / 6%)}.day-card>header{display:flex;align-items:center;gap:15px;padding:17px 20px;background:var(--dark);color:white}.day-card>header>span{display:grid;place-items:center;width:40px;aspect-ratio:1;background:var(--yellow);color:var(--dark);font-size:.7rem;font-weight:950}.day-card>header h3{margin:0;font-family:Georgia,serif;font-size:1.8rem}.pitch-grid{display:grid;grid-template-columns:1fr 1fr}.pitch-card{min-width:0;padding:22px}.pitch-card+ .pitch-card{border-left:1px solid #dbe3dc}.pitch-title{display:flex;align-items:center;gap:12px;padding-bottom:14px;border-bottom:1px solid #e2e8e3}.pitch-title>span{display:grid;place-items:center;width:35px;aspect-ratio:1;border-radius:50%;background:#e6efe8;color:var(--green);font-size:.67rem;font-weight:950}.pitch-title small,.pitch-title h4{display:block}.pitch-title small{color:#738078;font-size:.62rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.pitch-title h4{margin:1px 0 0;color:var(--ink);font-size:1.08rem}.booking-list{display:grid;gap:9px;padding-top:14px}.booking{display:grid;grid-template-columns:125px minmax(0,1fr) 115px;gap:12px;align-items:center;padding:12px 13px;border-left:5px solid var(--green);background:#f3f7f4;color:var(--ink);text-decoration:none;transition:transform .18s ease,box-shadow .18s ease}.booking:hover,.booking:focus{transform:translateY(-2px);box-shadow:0 8px 20px rgb(9 47 32 / 10%)}.booking.is-girls{border-color:#9b4e87;background:#faf3f8}.booking.is-youth{border-color:#34739b;background:#f1f7fa}.booking.is-kids{border-color:#d39c16;background:#fff9e8}.booking.is-other{border-color:#85491d;background:#fbf2eb}.booking-time{color:#647168;font-size:.74rem;font-weight:800}.booking strong{font-size:.92rem}.share{display:grid;grid-template-columns:1fr;gap:4px}.share>span{display:block}.share::before{content:''}.share{position:relative;height:29px;padding-top:9px}.share:after{content:'';position:absolute;left:0;right:0;top:4px;height:4px;border-radius:99px;background:#d7dfd8}.share i{position:absolute;z-index:1;left:0;top:4px;width:var(--share);height:4px;border-radius:99px;background:var(--green)}.share b{color:#657269;font-size:.68rem;text-align:right}.free{margin:4px 0;padding:18px;background:#f6f8f6;color:#7a857e;font-size:.82rem}.conflict-list{display:grid;gap:1px;margin-top:14px;background:#e9b4b4;border:1px solid #dca0a0}.conflict-note{display:flex;align-items:flex-start;gap:11px;margin:0;padding:14px;background:#fff0f0;color:#7b1d1d;font-size:.79rem;line-height:1.5}.conflict-note>span:last-child{display:grid;gap:2px}.conflict-note strong{display:block;color:#9c1919}.conflict-icon{display:grid;place-items:center;flex:0 0 22px;aspect-ratio:1;border-radius:50%;background:#b42318;color:white;font-weight:950}
  .details-section{padding:95px 0;background:white}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.detail-card{padding:38px;background:#edf3ee}.detail-card.is-open{background:#fff6c9}.detail-card h2{font-size:clamp(2rem,3.5vw,3.25rem)}.detail-card>p{color:#59665d;line-height:1.65}.detail-list{display:grid;margin-top:25px}.detail-list a{display:grid;grid-template-columns:1fr auto;gap:20px;padding:16px 0;border-top:1px solid rgb(9 47 32 / 16%);color:var(--ink);text-decoration:none}.detail-list a:hover strong{text-decoration:underline}.detail-list strong,.detail-list span{display:block}.detail-list span{margin-top:3px;color:#657269;font-size:.78rem}.detail-list a>b{color:var(--green);font-size:.78rem;text-align:right;font-weight:800}.plan-note{padding:0 0 105px;background:white}.plan-note-inner{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:center;padding:45px 48px;background:var(--dark);color:white;box-shadow:10px 10px 0 var(--yellow)}.plan-note h2{color:white;font-size:clamp(2rem,3.5vw,3.2rem)}.plan-note p{max-width:750px;margin:14px 0 0;color:#bfd0c5;line-height:1.65}.button{min-height:52px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;gap:22px;border-radius:4px;font-size:.82rem;font-weight:900;text-decoration:none;transition:transform .18s ease,box-shadow .18s ease}.button-yellow{background:var(--yellow);color:var(--dark);box-shadow:0 7px 0 #bda51e;white-space:nowrap}.button-yellow:hover,.button-yellow:focus-visible{transform:translateY(2px);box-shadow:0 5px 0 #bda51e}
  @media(max-width:900px){.intro-grid,.allocation-card,.section-head,.detail-grid,.plan-note-inner{grid-template-columns:1fr}.pitch-grid{grid-template-columns:1fr}.pitch-card+.pitch-card{border-left:0;border-top:1px solid #dbe3dc}.section-head{gap:20px}.allocation-card{gap:35px}.plan-note .button{justify-self:start}.booking{grid-template-columns:115px minmax(0,1fr) 105px}}
  @media(max-width:600px){.shell{width:min(100% - 30px,1160px)}.hero{min-height:560px}.shade{background:linear-gradient(0deg,rgb(5 34 22 / 96%),rgb(5 34 22 / 36%))}.hero-inner{padding:75px 0 55px}.plan-intro,.schedule-section,.details-section{padding:65px 0}.allocation-section{padding-bottom:70px}.allocation-card{padding:32px 24px;box-shadow:7px 7px 0 var(--dark)}.allocation-list{grid-template-columns:1fr}.allocation-list div:nth-child(odd),.allocation-list div:nth-child(even){padding:15px 0;border-left:0}.facts article{padding:16px 10px}.facts strong{font-size:1.35rem}.day-card>header{padding:14px}.pitch-card{padding:16px 13px}.booking{grid-template-columns:1fr auto;gap:5px 12px}.booking-time{grid-column:1/-1}.share{width:105px}.detail-card{padding:28px 22px}.plan-note{padding-bottom:75px}.plan-note-inner{padding:34px 25px;box-shadow:7px 7px 0 var(--yellow)}.plan-note .button{width:100%;justify-content:space-between;white-space:normal}}
</style>
