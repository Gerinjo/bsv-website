---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';
---

<Layout
  title="Vereinsspielplan – BSV Nordstern Radolfzell"
  description="Alle Spiele der Mannschaften des BSV Nordstern Radolfzell im Vereinsspielplan."
>
  <Header />

  <main>
    <section class="schedule-hero">
      <div class="shell">
        <a class="back" href={withBase('/fussball')}>← Zurück zu Fußball</a>
        <p class="eyebrow">Alle Mannschaften · Alle Spiele</p>
        <h1>Vereinsspielplan.</h1>
        <p class="lead">Die aktuellen Begegnungen aller Mannschaften des BSV Nordstern Radolfzell auf einen Blick.</p>
      </div>
    </section>

    <section class="schedule-content" aria-label="Vereinsspielplan des BSV Nordstern Radolfzell">
      <div class="shell widget-wrap">
        <div
          class="fussballde_widget"
          data-id="bec04b28-2292-4e73-8994-8be64fe4f027"
          data-type="club-matches"
          style="width: 100%"
        ></div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(:root) { --green:#164f32; --yellow:#f4d638; --cream:#f4f1e8; --ink:#10251a; }
  .shell { width:min(1120px,calc(100% - 48px)); margin-inline:auto; }
  .schedule-hero { padding:72px 0 82px; overflow:hidden; background:var(--green); color:white; }
  .back { display:inline-block; margin-bottom:52px; color:#b7cfbf; font-size:.78rem; font-weight:800; text-decoration:none; }
  .eyebrow { margin:0 0 14px; color:var(--yellow); font-size:.7rem; font-weight:900; letter-spacing:.15em; text-transform:uppercase; }
  h1 { margin:0 0 24px; font-size:clamp(3.7rem,6vw,5.8rem); line-height:.9; letter-spacing:-.06em; }
  .lead { max-width:650px; margin:0; color:#d0e0d5; font-size:1.12rem; line-height:1.65; }
  .schedule-content { min-height:500px; padding:100px 0 120px; background:var(--cream); }
  .widget-wrap { min-height:300px; overflow:hidden; }
  @media(max-width:600px) {
    .shell { width:min(100% - 30px,1120px); }
    .schedule-hero { padding:55px 0 65px; }
    .back { margin-bottom:35px; }
    .schedule-content { padding:70px 0 85px; }
  }
</style>
