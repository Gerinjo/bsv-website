---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import { loadClubCalendar } from '../utils/calendar';
import { withBase } from '../utils/paths';

const departments = [
  { number: '01', name: 'Fußball', detail: 'Aktive · Junge Sterne · Juniorinnen', href: '/fussball' },
  { number: '02', name: 'Bogensport', detail: 'Präzision · Fokus · Gemeinschaft', href: '/abteilungen/bogensport' },
  { number: '03', name: 'Gymnastik', detail: 'Bewegung · Fitness · Gesundheit', href: '/abteilungen/gymnastik' },
  { number: '04', name: 'Wandern', detail: 'Natur · Bewegung · Geselligkeit', href: '/abteilungen/wandergruppe' },
];

const { events: calendarEvents, available: calendarAvailable } = await loadClubCalendar();
const upcomingEvents = calendarEvents.slice(0, 4);
const compactDateFormat = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'short', timeZone: 'Europe/Berlin' });

const getEventType = (title: string) => {
  const value = title.toLowerCase();
  if (/(turnier|cup|spieltag)/.test(value)) return 'Turnier';
  if (/(camp|fußballschule|fussballschule)/.test(value)) return 'Camp';
  if (/(sitzung|versammlung|jhv|hauptversammlung)/.test(value)) return 'Sitzung';
  if (/(flohmarkt|markt|fest|feier|hock|party)/.test(value)) return 'Vereinsevent';
  if (/(training|trainings)/.test(value)) return 'Training';
  return 'Termin';
};
---

<Layout title="BSV Nordstern Radolfzell – Auf geht’s grün">
  <Header />

  <main>
    <section class="hero">
      <div class="hero-lines" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="kicker"><span></span> BSV Nordstern Radolfzell</p>
          <h1>Mehr als<br />nur ein <em>Verein.</em></h1>
          <p class="intro">Seit 1956 bewegen wir Radolfzell. Auf dem Platz, in der Halle und weit darüber hinaus.</p>
          <div class="hero-actions">
            <a class="button button-yellow" href={withBase('/verein/mitglied-werden')}>Jetzt Mitglied werden <span>↗</span></a>
            <a class="text-link" href={withBase('/verein/geschichte')}>Den BSV entdecken <span>→</span></a>
          </div>
        </div>

        <div class="hero-art" aria-label="Illustration eines Fußballfeldes">
          <div class="year">19<span>56</span></div>
          <div class="pitch">
            <div class="pitch-circle"></div>
            <div class="pitch-box"></div>
            <div class="ball">✦</div>
          </div>
          <div class="hero-badge"><strong>#aufgehtsgrün</strong><span>Gemeinsam. Stark.</span></div>
        </div>
      </div>
      <div class="ticker" aria-label="Vereinswerte">
        <div>Fußball <span>✦</span> Gemeinschaft <span>✦</span> Leidenschaft <span>✦</span> Radolfzell <span>✦</span> Seit 1956 <span>✦</span> Fußball <span>✦</span> Gemeinschaft</div>
      </div>
    </section>

    <section class="promo-section" aria-label="BSV entdecken">
      <div class="shell promo-grid">
        <a class="promo-card promo-shop" href="https://shop.bsvnordstern.de/" target="_blank" rel="noopener noreferrer">
          <span class="promo-index">01</span>
          <div class="promo-symbol" aria-hidden="true">BSV<br />SHOP</div>
          <div class="promo-copy">
            <small>Fanartikel & Vereinskleidung</small>
            <h2>Zeig deine Farben.</h2>
            <p>Trikots, Trainingskleidung und mehr direkt im BSV Shop.</p>
            <strong>Zum Shop <b>↗</b></strong>
          </div>
        </a>

        <a class="promo-card promo-partners" href={withBase('/erlebnis')}>
          <span class="promo-index">02</span>
          <div class="promo-symbol" aria-hidden="true">✦</div>
          <div class="promo-copy">
            <small>Kooperationen & Benefits</small>
            <h2>Gemeinsam mehr erleben.</h2>
            <p>Fußballschulen, Partner und Vorteile rund um den BSV.</p>
            <strong>Kooperationen entdecken <b>↗</b></strong>
          </div>
        </a>

        <a class="promo-card promo-events" href={withBase('/erlebnis')}>
          <span class="promo-index">03</span>
          <div class="promo-symbol" aria-hidden="true">⚑</div>
          <div class="promo-copy">
            <small>Turniere & Aktionstage</small>
            <h2>Sportevents beim BSV.</h2>
            <p>Turniere, Camps und besondere Tage auf und neben dem Platz.</p>
            <strong>Events entdecken <b>↗</b></strong>
          </div>
        </a>
      </div>
    </section>

    <section class="match-section" id="spielplan">
      <div class="shell">
        <div class="section-head compact"><div><p class="kicker dark"><span></span> BSV Spielplan</p><h2>Immer im Einsatz.</h2></div></div>
        <div class="club-matches-widget" aria-label="Spiele des BSV Nordstern Radolfzell">
          <div
            class="fussballde_widget"
            data-id="6fdc77b9-0fea-44c5-ac49-24f468e4f5d3"
            data-type="club-matches"
            style="width: 100%"
          ></div>
        </div>
      </div>
    </section>

    <section class="dates-section" aria-labelledby="dates-title">
      <div class="shell">
        <div class="dates-head">
          <div>
            <p class="kicker dark"><span></span> Vereinskalender</p>
            <h2 id="dates-title">Die nächsten Termine.</h2>
          </div>
          <a href={withBase('/verein/termine')}>Alle Termine <span>→</span></a>
        </div>

        {calendarAvailable && upcomingEvents.length ? (
          <div class="dates-grid">
            {upcomingEvents.map((event) => (
              <a class="date-card" href={event.googleUrl} target="_blank" rel="noopener noreferrer">
                <div class="date-meta">
                  <span>{getEventType(event.title)}</span>
                  <time datetime={event.start.toISOString()}>{compactDateFormat.format(event.start)}</time>
                </div>
                <strong>{event.title}</strong>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        ) : (
          <div class="dates-empty">Aktuell sind keine kommenden Vereinstermine verfügbar.</div>
        )}
      </div>
    </section>

    <section class="departments-section">
      <div class="shell departments-grid">
        <div class="departments-intro"><p class="kicker light"><span></span> Ein Verein, viele Wege</p><h2>Finde deinen<br /><em>Sport.</em></h2><p>Ob auf Tore, ins Gold oder einfach gemeinsam in Bewegung – beim BSV ist für alle etwas dabei.</p></div>
        <div class="department-list">
          {departments.map((item) => <a href={withBase(item.href)}><span>{item.number}</span><div><strong>{item.name}</strong><small>{item.detail}</small></div><b>↗</b></a>)}
        </div>
      </div>
    </section>

    <section class="join-section">
      <div class="shell join-card">
        <span class="join-star" aria-hidden="true">✦</span>
        <div><p class="kicker dark"><span></span> Werde Teil des BSV</p><h2>Dein Verein.<br /><em>Dein Nordstern.</em></h2></div>
        <div class="join-copy"><p>Sport verbindet. Bei uns findest du Gemeinschaft, Bewegung und einen Platz, an dem du dazugehört.</p><a class="button button-dark" href={withBase('/verein/mitglied-werden')}>Mitglied werden <span>↗</span></a></div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(:root) { --green: #164f32; --green-dark: #092f20; --green-light: #1e6b43; --yellow: #f4d638; --cream: #f4f1e8; --ink: #10251a; }
  .shell { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
  .hero { position: relative; overflow: hidden; color: white; background: var(--green); }
  .hero::before { content: ''; position: absolute; inset: 0; opacity: .17; background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 22px 22px; mask-image: linear-gradient(to right, black, transparent 70%); }
  .hero-lines { position: absolute; width: 520px; height: 520px; right: -130px; top: -130px; border: 1px solid rgb(255 255 255 / 18%); border-radius: 50%; box-shadow: 0 0 0 70px rgb(255 255 255 / 4%), 0 0 0 140px rgb(255 255 255 / 4%); }
  .hero-grid { position: relative; min-height: 640px; padding-block: 80px 100px; display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 50px; }
  .kicker { display: flex; align-items: center; gap: 10px; margin: 0 0 22px; font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .kicker > span { width: 27px; height: 3px; background: var(--yellow); }
  .kicker.dark { color: var(--green); }.kicker.light { color: #a5ceb4; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { letter-spacing: -.055em; }
  h1 { margin-bottom: 28px; font-size: clamp(4rem, 7.6vw, 7rem); line-height: .86; }
  h1 em, h2 em { color: var(--yellow); font-family: Georgia, serif; font-weight: 400; }
  .intro { max-width: 550px; margin-bottom: 38px; color: #d2e3d8; font-size: 1.12rem; line-height: 1.65; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 28px; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 22px; min-height: 52px; padding: 0 22px; border-radius: 4px; color: var(--ink); font-size: .85rem; font-weight: 800; text-decoration: none; }
  .button-yellow { background: var(--yellow); box-shadow: 0 7px 0 #bda51e; }.button-yellow:hover { transform: translateY(2px); box-shadow: 0 5px 0 #bda51e; }
  .text-link { color: white; font-size: .85rem; font-weight: 800; text-decoration: none; }.text-link span { margin-left: 10px; }.dark-link { color: var(--ink); }
  .hero-art { position: relative; min-height: 440px; }
  .year { position: absolute; z-index: 1; right: 0; top: -25px; color: rgb(255 255 255 / 8%); font-size: 9rem; font-weight: 900; line-height: 1; writing-mode: vertical-rl; }.year span { color: rgb(244 214 56 / 15%); }
  .pitch { position: absolute; inset: 35px 36px 0 0; overflow: hidden; border: 2px solid rgb(255 255 255 / 32%); transform: rotate(-5deg); background: linear-gradient(90deg, rgb(255 255 255 / 3%) 50%, transparent 50%); }
  .pitch::before { content: ''; position: absolute; left: 50%; height: 100%; border-left: 2px solid rgb(255 255 255 / 28%); }.pitch-circle { position: absolute; left: 50%; top: 50%; width: 120px; aspect-ratio: 1; border: 2px solid rgb(255 255 255 / 28%); border-radius: 50%; transform: translate(-50%, -50%); }.pitch-box { position: absolute; left: -2px; top: 28%; width: 95px; height: 44%; border: 2px solid rgb(255 255 255 / 28%); }.ball { position: absolute; display: grid; place-items: center; right: 18%; top: 23%; width: 64px; aspect-ratio: 1; border-radius: 50%; background: var(--yellow); color: var(--green); font-size: 1.6rem; box-shadow: 0 12px 35px rgb(0 0 0 / 24%); }
  .hero-badge { position: absolute; z-index: 2; left: -28px; bottom: 5px; padding: 20px 25px; transform: rotate(3deg); background: white; color: var(--ink); box-shadow: 12px 15px 0 rgb(9 47 32 / 55%); }.hero-badge strong, .hero-badge span { display: block; }.hero-badge strong { font-size: 1.2rem; }.hero-badge span { margin-top: 4px; color: #6a796f; font-size: .75rem; }
  .ticker { position: relative; z-index: 2; overflow: hidden; padding: 17px 0; background: var(--yellow); color: var(--green-dark); font-weight: 900; text-transform: uppercase; white-space: nowrap; transform: rotate(-1deg) scale(1.02); }.ticker div { min-width: max-content; word-spacing: 16px; }.ticker span { color: white; }

  .promo-section { padding: 88px 0 24px; background: var(--cream); }
  .promo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .promo-card { position: relative; min-height: 330px; overflow: hidden; display: flex; flex-direction: column; color: inherit; text-decoration: none; box-shadow: 0 14px 35px rgb(9 47 32 / 9%); transition: transform .2s ease, box-shadow .2s ease; }
  .promo-card:hover { transform: translateY(-4px); box-shadow: 0 20px 42px rgb(9 47 32 / 14%); }
  .promo-index { position: absolute; z-index: 2; right: 18px; top: 16px; font-size: .62rem; font-weight: 900; opacity: .55; }
  .promo-symbol { height: 145px; display: grid; place-items: center; font-size: 3rem; font-weight: 950; line-height: .82; letter-spacing: -.05em; text-align: center; }
  .promo-copy { flex: 1; padding: 24px 26px 26px; display: flex; flex-direction: column; background: white; }
  .promo-copy small { color: var(--green); font-size: .6rem; font-weight: 950; letter-spacing: .1em; text-transform: uppercase; }
  .promo-copy h2 { margin: 8px 0 10px; font-size: 1.55rem; line-height: 1.05; letter-spacing: -.035em; }
  .promo-copy p { margin: 0 0 22px; color: #64736a; font-size: .82rem; line-height: 1.55; }
  .promo-copy strong { margin-top: auto; display: flex; align-items: center; justify-content: space-between; color: var(--green); font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; }
  .promo-shop .promo-symbol { background: var(--green-dark); color: var(--yellow); }
  .promo-partners .promo-symbol { background: var(--yellow); color: var(--green-dark); }
  .promo-events .promo-symbol { background: var(--green); color: white; }

  .match-section { padding: 86px 0 92px; background: var(--cream); }
  .club-matches-widget { min-height:220px; overflow:hidden; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 48px; }.section-head.compact { margin-bottom: 30px; }.section-head h2, .departments-intro h2, .join-card h2 { margin: 0; color: var(--ink); font-size: clamp(2.7rem, 5vw, 4.6rem); line-height: .94; }.section-head .kicker { margin-bottom: 10px; }

  .dates-section { padding: 0 0 82px; background: var(--cream); }
  .dates-head { margin-bottom: 20px; display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .dates-head .kicker { margin-bottom: 8px; }
  .dates-head h2 { margin: 0; font-size: clamp(2rem, 3.5vw, 3.25rem); line-height: .98; }
  .dates-head > a { padding-bottom: 5px; color: var(--green); font-size: .78rem; font-weight: 900; text-decoration: none; }
  .dates-head > a span { margin-left: 8px; }
  .dates-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .date-card { position: relative; min-height: 96px; padding: 14px 38px 14px 15px; display: flex; flex-direction: column; border-top: 3px solid var(--green); background: white; color: var(--ink); text-decoration: none; box-shadow: 0 8px 24px rgb(9 47 32 / 6%); transition: transform .18s ease, box-shadow .18s ease; }
  .date-card:hover { transform: translateY(-2px); box-shadow: 0 13px 29px rgb(9 47 32 / 10%); }
  .date-meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-weight: 950; }
  .date-meta span { display: inline-flex; align-items: center; min-height: 25px; padding: 0 8px; background: #edf3ee; color: var(--green); font-size: .7rem; letter-spacing: .05em; text-transform: uppercase; }
  .date-meta time { color: #27392f; font-size: .82rem; font-weight: 950; letter-spacing: .01em; text-transform: none; }
  .date-card > strong { margin-top: 9px; font-size: 1.05rem; line-height: 1.18; }
  .date-card > b { position: absolute; right: 15px; bottom: 13px; color: #6f9b18; font-size: .82rem; }
  .dates-empty { padding: 24px; border-left: 4px solid var(--yellow); background: white; color: #64736a; }

  .join-section { padding: 110px 0; }
  .departments-section { padding: 120px 0; color: white; background: var(--green-dark); }.departments-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 100px; }.departments-intro h2 { color: white; }.departments-intro > p:last-child { max-width: 420px; margin-top: 30px; color: #9eb5a7; line-height: 1.7; }.department-list { border-top: 1px solid rgb(255 255 255 / 18%); }.department-list a { display: grid; grid-template-columns: 45px 1fr 40px; align-items: center; gap: 12px; padding: 24px 5px; border-bottom: 1px solid rgb(255 255 255 / 18%); color: white; text-decoration: none; transition: .2s; }.department-list a:hover { padding-left: 15px; background: rgb(255 255 255 / 4%); }.department-list > a > span { color: var(--yellow); font-size: .65rem; }.department-list strong,.department-list small { display: block; }.department-list strong { font-size: 1.45rem; }.department-list small { margin-top: 5px; color: #8da598; font-size: .72rem; }.department-list b { display: grid; place-items: center; width: 36px; aspect-ratio: 1; border: 1px solid rgb(255 255 255 / 30%); border-radius: 50%; }
  .join-section { background: #fff; }.join-card { position: relative; overflow: hidden; min-height: 330px; padding: 65px 70px; display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: 70px; background: var(--yellow); border-radius: 8px; }.join-card::after { content: ''; position: absolute; right: -80px; top: -160px; width: 380px; aspect-ratio: 1; border: 1px solid rgb(9 47 32 / 18%); border-radius: 50%; box-shadow: 0 0 0 50px rgb(9 47 32 / 5%), 0 0 0 100px rgb(9 47 32 / 4%); }.join-star { position: absolute; right: 35px; top: 25px; color: white; font-size: 3rem; }.join-card h2 em { color: var(--green); }.join-copy { position: relative; z-index: 1; }.join-copy p { margin-bottom: 28px; color: #3b4c3f; line-height: 1.6; }.button-dark { background: var(--green-dark); color: white; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; }.hero-art { min-height: 330px; }.promo-grid { grid-template-columns: 1fr 1fr; }.promo-card:last-child { grid-column: 1 / -1; }.dates-grid { grid-template-columns: 1fr 1fr; }.departments-grid { grid-template-columns: 1fr; gap: 55px; }.join-card { padding: 50px; } }
  @media (max-width: 650px) { .shell { width: min(100% - 30px, 1160px); }.hero-grid { min-height: 720px; padding-top: 65px; }.hero-art { min-height: 250px; }.pitch { inset: 10px 10px 0 30px; }.hero-badge { left: 0; }.year { display: none; }.promo-section { padding-top: 58px; }.promo-grid,.dates-grid { grid-template-columns: 1fr; }.promo-card:last-child { grid-column: auto; }.promo-card { min-height: 300px; }.match-section,.join-section,.departments-section { padding: 75px 0; }.dates-section { padding-bottom: 70px; }.dates-head,.section-head { align-items: start; flex-direction: column; }.departments-grid { gap: 40px; }.join-card { grid-template-columns: 1fr; gap: 28px; padding: 42px 28px; } }
</style>
