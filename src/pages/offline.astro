---
import { withBase } from '../utils/paths';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#092f20" />
    <meta name="robots" content="noindex" />
    <title>Gerade offline – BSV Nordstern</title>
    <style is:inline>
      *{box-sizing:border-box}body{margin:0;min-height:100vh;min-height:100dvh;display:grid;place-items:center;padding:32px 24px;background:#092f20;color:white;font-family:system-ui,sans-serif}main{max-width:480px}.eyebrow{color:#f4d638;font-size:.75rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.symbol{display:block;color:#f4d638;font-size:4rem}h1{margin:24px 0;font-size:clamp(2.6rem,10vw,4rem);line-height:1.05}p{color:#cadbd0;line-height:1.7}.actions{display:flex;flex-wrap:wrap;gap:16px;margin-top:32px}button,a{padding:15px 20px;border:1px solid #f4d638;border-radius:6px;font:inherit;font-weight:750;text-decoration:none}button{background:#f4d638;color:#092f20;cursor:pointer}a{color:#f4d638}button:focus-visible,a:focus-visible{outline:3px solid white;outline-offset:4px}
    </style>
  </head>
  <body>
    <main>
      <p class="eyebrow">BSV Nordstern · Immer dabei</p>
      <span class="symbol" aria-hidden="true">✦</span>
      <h1>Kurze Pause.<br />Du bist offline.</h1>
      <p>Verbinde dein Handy mit dem Internet, um aktuelle Spielpläne, Teams und Vereinsnews zu laden.</p>
      <p>Auch für Anfragen und Anmeldungen brauchst du eine Internetverbindung.</p>
      <div class="actions"><button type="button" id="retry">Erneut versuchen</button><a href={withBase('/')}>Zur Startseite</a></div>
      <noscript><p>Bitte lade die Seite über deinen Browser neu.</p></noscript>
    </main>
    <script is:inline>document.querySelector('#retry').addEventListener('click', () => location.reload());</script>
  </body>
</html>
