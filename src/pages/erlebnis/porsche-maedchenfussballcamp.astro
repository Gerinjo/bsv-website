  .logo-shell{margin-top:-65px;position:relative;z-index:2}.kickers-lockup{min-height:138px;padding:24px 32px;display:flex;align-items:center;gap:28px;border-top:5px solid var(--kickers-blue);background:#fff;box-shadow:0 16px 40px rgb(0 111 159 / 15%)}.kickers-lockup img{width:86px;height:86px;object-fit:contain;flex:0 0 auto}.kickers-lockup span,.kickers-lockup strong{display:block}.kickers-lockup span{color:var(--kickers-blue);font-size:.74rem;font-weight:950;letter-spacing:.04em;text-transform:uppercase}.kickers-lockup strong{margin-top:4px;color:var(--kickers-deep);font-size:clamp(1.4rem,3vw,2.25rem);line-height:1;letter-spacing:-.035em}.kickers-lockup small{margin-left:auto;color:#71818a;font-size:.66rem;font-weight:800;text-align:right}
  .intro{padding:80px 0 55px;display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:70px;align-items:start}.intro h2,.included h2,.schedule h2,.gallery h2,.parents h2,.cta h2{margin:10px 0 20px;font-size:clamp(2.7rem,5vw,4.8rem);line-height:.92;letter-spacing:-.05em}.intro p,.schedule-copy p,.gallery-heading p{color:#5c6c63;line-height:1.8}.price-card{padding:28px;background:var(--kickers-ink);color:#fff;border-top:5px solid var(--kickers-blue);box-shadow:0 18px 42px rgb(0 0 0 / 10%)}.price-card>span{font-size:.63rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:#a9dff4}.price{margin:18px 0 16px;display:flex;align-items:baseline;gap:13px}.price strong{font-size:2.65rem;letter-spacing:-.05em}.price-card p{color:#c9d5db;font-size:.72rem;line-height:1.55}.price-card>b{display:block;margin-top:16px;color:#fff;font-size:.75rem}.price-card>a{margin-top:22px;min-height:50px;padding:0 16px;display:flex;align-items:center;justify-content:space-between;background:var(--kickers-blue);color:#fff;text-decoration:none;font-size:.74rem;font-weight:950}
  .included{padding:55px 0 85px}.included-heading{max-width:800px}.benefit-grid{margin-top:30px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.benefit-grid article{min-height:230px;padding:25px;background:#fff;border-top:4px solid var(--kickers-blue)}.benefit-grid article>span{color:var(--kickers-blue);font-size:.65rem;font-weight:950}.benefit-grid h3{margin:28px 0 10px;font-size:1.08rem}.benefit-grid p{margin:0;color:#65756c;font-size:.78rem;line-height:1.6}
