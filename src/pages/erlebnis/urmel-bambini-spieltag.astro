---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import BambiniRegistrationForm from '../../components/BambiniRegistrationForm.astro';
import EventPhotoGallery from '../../components/EventPhotoGallery.astro';
import { urmelGallery } from '../../data/urmelImages';
import { URMEL_EVENT } from '../../../supabase/functions/_shared/urmel-event.mjs';
import { withBase } from '../../utils/paths';

const urmelUrl = 'https://www.urmel-kinder-krebshilfe.org/';
const donationUrl = 'https://www.urmel-kinder-krebshilfe.org/spenden-hilfe.html';
const urmelLogo = withBase('/images/events/urmel/urmel-kinder-krebshilfe.webp');
const gallery = [
  { src: withBase('/images/events/urmel/2026/01-spielszene.webp'), alt: 'Spielszene beim URMEL Bambini Spieltag 2026' },
  { src: withBase('/images/events/urmel/2026/02-torschuss.webp'), alt: 'Torschuss beim URMEL Bambini Spieltag 2026' },
  { src: withBase('/images/events/urmel/2026/03-kleinfeld.webp'), alt: 'Bambini-Spiel auf dem Kleinfeld' },
  { src: withBase('/images/events/urmel/2026/04-turniertag.webp'), alt: 'Mannschaften beim URMEL Bambini Spieltag' },
  { src: withBase('/images/events/urmel/2026/05-medaillen.webp'), alt: 'Medaillen für die Kinder' },
  { src: withBase('/images/events/urmel/2026/06-siegerehrung.webp'), alt: 'Siegerehrung beim URMEL Bambini Spieltag' },
  { src: withBase('/images/events/urmel/2026/07-trainerteam.webp'), alt: 'Trainerinnen und Trainer des Spieltags' },
  { src: withBase('/images/events/urmel/2026/08-gruppenfoto.webp'), alt: 'Gruppenfoto zum Abschluss des URMEL Bambini Spieltags 2026' },
];
---

<Layout title={`${URMEL_EVENT.title} · ${URMEL_EVENT.date} | BSV Nordstern Radolfzell`} description={`Kids spielen für Kids: URMEL-Cup am ${URMEL_EVENT.date} beim BSV Nordstern. Drei Startzeiten, Mannschaftsanmeldung und Tombola zugunsten der Urmel Kinder-Krebshilfe.`}>
  <Header />
  <main class="urmel-page">
    <section class="hero" aria-labelledby="event-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <a class="back" href={withBase('/erlebnis')}>← Zu den Events & Erlebnissen</a>
          <p class="eyebrow">Bambini · Benefizturnier · {URMEL_EVENT.date}</p>
          <h1 id="event-title">URMEL-Cup.<br /><em>Kids spielen<br />für Kids.</em></h1>
          <p class="intro">Kleine Kicker, große Freude und ein gemeinsamer guter Zweck: Unser URMEL-Cup geht in die nächste Runde. Seid mit eurer Bambini-Mannschaft dabei und erlebt einen Fußballtag voller Teamgeist.</p>
          <a class="button" href="#anmeldung">Mannschaft anmelden <span aria-hidden="true">↗</span></a>
          <p class="hero-note">{URMEL_EVENT.date} · {URMEL_EVENT.venue}</p>
        </div>
        <aside class="benefit-card" aria-label="Zugunsten der Urmel Kinder-Krebshilfe">
          <img src={urmelLogo} alt="Urmel Kinder-Krebshilfe e.V." width="480" height="240" loading="eager" />
          <p class="eyebrow">Gemeinsam etwas bewegen</p>
          <strong>Fußball mit Herz.<br /><em>Hilfe, die ankommt.</em></strong>
          <p>Die gesamten Turniergebühren und die Einnahmen der Tombola kommen der Urmel Kinder-Krebshilfe zugute.</p>
        </aside>
      </div>
    </section>

    <section class="event-facts shell" aria-label="Der URMEL-Cup auf einen Blick">
      <div><span>Wann?</span><strong><time datetime={URMEL_EVENT.isoDate}>{URMEL_EVENT.date}</time></strong></div>
      <div><span>Wo?</span><strong>{URMEL_EVENT.venue}</strong></div>
      <div><span>Startzeiten</span><strong>{URMEL_EVENT.timeSlots.join(' · ')} Uhr</strong></div>
      <div><span>Startgebühr</span><strong>{URMEL_EVENT.fee} pro Mannschaft</strong></div>
    </section>

    <div class="atmosphere shell">
      <EventPhotoGallery id="event-urmel" {...urmelGallery} />
      <a class="archive-link" href="#rueckblick">Alle Eindrücke vom Spieltag 2026 →</a>
    </div>

    <section class="joy shell" aria-labelledby="joy-title">
      <div class="section-heading"><p class="eyebrow">Ein Tag für Kinder. Ein Beitrag für Familien.</p><h2 id="joy-title">Gemeinsam spielen.<br /><em>Gemeinsam helfen.</em></h2></div>
      <div class="joy-grid">
        <article><span class="article-number">01 / Fußballfreude</span><h3>Kleine Teams. Große Begeisterung.</h3><p>Beim URMEL-Cup gehören der Platz und die Freude am Spiel den Bambinis. Gemeinsam kicken, einander anfeuern und als Mannschaft einen schönen Tag erleben.</p></article>
        <article><span class="article-number">02 / Tombola</span><h3>Mitmachen und Gutes tun.</h3><p>Auch neben dem Spielfeld könnt ihr helfen: Die Einnahmen unserer Tombola gehen an die Urmel Kinder-Krebshilfe e.V. Jeder Beitrag zählt.</p></article>
        <article class="charity"><span class="article-number">03 / Kids spielen für Kids</span><h3>Eure Startgebühr hilft mit.</h3><p>{URMEL_EVENT.charityNote} So verbindet unser Spieltag Fußballfreude mit Unterstützung für betroffene Familien.</p></article>
      </div>
    </section>

    <section class="times-section" aria-labelledby="times-title">
      <div class="shell times-grid">
        <div><p class="eyebrow">Damit es für eure Mannschaft passt</p><h2 id="times-title">Drei Startzeiten.<br /><em>Eure Wünsche zählen.</em></h2><p>Gebt bei der Anmeldung an, in welchen Zeitfenstern eure Mannschaft am liebsten dabei wäre. Ihr könnt mehrere Wunschzeiten auswählen.</p><p>Wir sammeln eure Wünsche und stimmen die Einteilung ab. Die Teilnahme und eure endgültige Startzeit bestätigen wir anschließend persönlich.</p></div>
        <ol class="time-list" aria-label="Mögliche Startzeiten">{URMEL_EVENT.timeSlots.map((slot, index) => <li><span>Start {index + 1}</span><strong>{slot}<small> Uhr</small></strong></li>)}</ol>
      </div>
    </section>

    <section id="anmeldung" class="registration" aria-labelledby="registration-title">
      <div class="shell registration-grid">
        <div class="registration-copy"><p class="eyebrow">Seid ihr dabei?</p><h2 id="registration-title">Ein Team.<br /><em>Ein guter Zweck.</em></h2><p>Meldet eure Bambini-Mannschaft zum URMEL-Cup an. Als Kontaktperson benötigen wir eure Trainerin oder euren Trainer.</p><p>Wir melden uns bei euch mit der Teilnahmebestätigung, der Startzeit und allen weiteren Informationen.</p><div class="organizer"><span>Fragen zum URMEL-Cup?</span><strong>Jérôme Ernsberger</strong><a href={withBase('/kontakt?thema=person-jerome-ernsberger')}>Kontakt zur Organisation <span aria-hidden="true">↗</span></a></div></div>
        <BambiniRegistrationForm event={URMEL_EVENT} />
      </div>
    </section>

    <section class="charity-info shell" aria-labelledby="charity-title">
      <div><p class="eyebrow">Urmel Kinder-Krebshilfe e.V. · Friedrichshafen</p><h2 id="charity-title">Hilfe für die<br /><em>ganze Familie.</em></h2></div>
      <div><p>Die Urmel Kinder-Krebshilfe unterstützt an Krebs erkrankte Kinder und Jugendliche sowie ihre Familien.</p><p>{URMEL_EVENT.charityNote}</p><div class="charity-actions"><a href={urmelUrl} target="_blank" rel="noopener noreferrer">Urmel kennenlernen ↗</a><a href={donationUrl} target="_blank" rel="noopener noreferrer">Urmel direkt unterstützen ↗</a></div></div>
    </section>

    <section class="gallery shell" id="rueckblick">
      <div class="gallery-head"><div><span>Galerie</span><h2>Impressionen <em>2026.</em></h2></div><p>Acht Eindrücke vom URMEL Bambini Spieltag am 1. Mai 2026.</p></div>
      <div class="year-tabs"><span>2026</span></div>
      <div class="gallery-grid" data-urmel-gallery>
        {gallery.map((image, index) => (
          <button type="button" class:list={["gallery-item", index === 7 && "is-wide"]} data-gallery-index={index} aria-label={`${image.alt} vergrößern`}>
            <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
            <span>Vergrößern</span>
          </button>
        ))}
      </div>
    </section>

    <div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="URMEL Bildergalerie">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label="Galerie schließen">×</button>
      <button class="lightbox-nav lightbox-prev" type="button" data-lightbox-prev aria-label="Vorheriges Bild">‹</button>
      <figure class="lightbox-stage">
        <img data-lightbox-image src="" alt="" />
        <figcaption><span data-lightbox-caption></span><small><b data-lightbox-current>1</b> / {gallery.length}</small></figcaption>
      </figure>
      <button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label="Nächstes Bild">›</button>
    </div>


  </main>
  <Footer />
</Layout>

<script define:vars={{ gallery }}>
  const root = document.querySelector('[data-urmel-gallery]');
  const lightbox = document.querySelector('[data-lightbox]');
  if (root instanceof HTMLElement && lightbox instanceof HTMLElement) {
    const image = lightbox.querySelector('[data-lightbox-image]');
    const caption = lightbox.querySelector('[data-lightbox-caption]');
    const current = lightbox.querySelector('[data-lightbox-current]');
    const close = lightbox.querySelector('[data-lightbox-close]');
    const prev = lightbox.querySelector('[data-lightbox-prev]');
    const next = lightbox.querySelector('[data-lightbox-next]');
    let activeIndex = 0;
    let lastFocus = null;

    const render = () => {
      const item = gallery[activeIndex];
      if (image instanceof HTMLImageElement) { image.src = item.src; image.alt = item.alt; }
      if (caption) caption.textContent = item.alt;
      if (current) current.textContent = String(activeIndex + 1);
    };

    const open = (index, trigger) => {
      activeIndex = index;
      lastFocus = trigger;
      render();
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('lightbox-open');
      if (close instanceof HTMLElement) close.focus();
    };

    const hide = () => {
      lightbox.hidden = true;
      lightbox.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('lightbox-open');
      if (lastFocus instanceof HTMLElement) lastFocus.focus();
    };

    const show = (delta) => {
      activeIndex = (activeIndex + delta + gallery.length) % gallery.length;
      render();
    };

    root.addEventListener('click', (event) => {
      const trigger = event.target instanceof Element ? event.target.closest('[data-gallery-index]') : null;
      if (!(trigger instanceof HTMLElement)) return;
      open(Number(trigger.dataset.galleryIndex || 0), trigger);
    });
    close?.addEventListener('click', hide);
    prev?.addEventListener('click', () => show(-1));
    next?.addEventListener('click', () => show(1));
    lightbox.addEventListener('click', (event) => { if (event.target === lightbox) hide(); });
    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') hide();
      if (event.key === 'ArrowLeft') show(-1);
      if (event.key === 'ArrowRight') show(1);
    });
  }
</script>

<style>
  .urmel-page { --forest: #0e3929; --gold: #e4bf6a; --cream: #faf6ec; --leaf: #537d2a; background: var(--cream); color: #173d2b; }
  .shell { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
  h1, h2, h3, p { margin-top: 0; }h1, h2 { letter-spacing: -.045em; }h1 em, h2 em { font-family: Georgia, serif; font-weight: 400; }
  .hero { overflow: hidden; position: relative; padding: 65px 0 88px; background: radial-gradient(ellipse at 85% 20%, #22503a 0, transparent 55%), #092f20; color: #fff9ec; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr); align-items: center; gap: 60px; }
  .back { display: block; width: fit-content; margin-bottom: 34px; color: #c4d4c5; font-size: .78rem; text-decoration: none; }.back:hover { text-decoration: underline; }
  .eyebrow { font-size: .7rem; font-weight: 850; letter-spacing: .11em; text-transform: uppercase; line-height: 1.65; }.hero .eyebrow, .registration .eyebrow { color: var(--gold); }.eyebrow > span { margin-right: 7px; }
  h1 { font-size: clamp(2.8rem, 4.65vw, 4.4rem); line-height: 1.01; margin-bottom: 28px; }h1 em { color: var(--gold); }.intro { max-width: 580px; color: #d5dfd1; font-size: 1rem; line-height: 1.8; }
  .button { width: fit-content; display: flex; justify-content: space-between; gap: 28px; padding: 17px 21px; margin-top: 28px; background: #f4d638; color: #092f20; font-weight: 850; font-size: .87rem; text-decoration: none; }.button:hover { background: #ffe967; }
  .hero-note { margin: 18px 0 0; color: #d6ddc7; font-size: .75rem; line-height: 1.7; }
  .event-facts { position: relative; display: grid; grid-template-columns: 1fr 1.15fr 1.05fr 1fr; margin-top: -25px; background: #fffefa; box-shadow: 0 10px 28px #0e392910; border-top: 4px solid var(--gold); }.event-facts > div { padding: 26px 24px; border-right: 1px solid #e4e5d9; }.event-facts > div:last-child { border: 0; }.event-facts span { display: block; margin-bottom: 9px; font-size: .66rem; color: #6d745e; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; }.event-facts strong { display: block; font-size: .94rem; line-height: 1.55; }
  .joy { padding-block: 90px; }.section-heading { margin-bottom: 38px; }.section-heading .eyebrow { color: var(--leaf); }h2 { font-size: clamp(2.2rem, 3.9vw, 3.6rem); line-height: 1.05; margin-bottom: 24px; }h2 em { color: #426448; }.joy-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }.joy-grid article { padding: 30px 28px; border-top: 3px solid #b4c3a4; background: #fffefa; }.article-number { color: #7c856c; font-size: .67rem; font-weight: 850; letter-spacing: .07em; text-transform: uppercase; }h3 { font-size: 1.35rem; line-height: 1.2; margin: 23px 0 16px; }.joy-grid p, .times-grid p { color: #536353; font-size: .94rem; line-height: 1.8; margin-bottom: 0; }
  .times-section { padding: 70px 0 80px; border-top: 1px solid #dedfcd; background: #eff0e5; }.times-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: 90px; align-items: center; }.times-grid .eyebrow { color: var(--leaf); }.times-grid p + p { margin-top: 15px; }.time-list { list-style: none; margin: 0; padding: 0; }.time-list li { display: flex; align-items: center; justify-content: space-between; padding: 22px 4px; border-bottom: 1px solid #c4cdba; }.time-list li:first-child { border-top: 1px solid #c4cdba; }.time-list li > span { color: #66735a; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }.time-list strong { font-size: 2.9rem; letter-spacing: -.045em; line-height: 1; }.time-list small { font-size: 1rem; font-weight: 550; letter-spacing: 0; }
  .registration { padding: 90px 0 100px; background: var(--forest); color: #fff9ec; scroll-margin-top: 110px; }.registration-grid { display: grid; grid-template-columns: minmax(0, .76fr) minmax(0, 1.24fr); gap: 70px; align-items: start; }.registration-copy { position: sticky; top: 125px; }.registration h2 em { color: var(--gold); }.registration-copy > p:not(.eyebrow) { color: #d2dfcf; font-size: .95rem; line-height: 1.8; }.organizer { margin-top: 32px; border-top: 1px solid #52765b; padding-top: 25px; }.organizer > span, .organizer strong { display: block; }.organizer > span { color: #bed1ba; font-size: .76rem; margin-bottom: 9px; }.organizer strong { font-size: 1.08rem; }.organizer a { display: flex; align-items: center; gap: 20px; width: fit-content; margin-top: 15px; color: var(--gold); font-size: .78rem; text-underline-offset: 4px; }
  a:focus-visible { outline: 3px solid var(--gold); outline-offset: 5px; }
  .atmosphere { margin-block: 65px 0; overflow: hidden; background: var(--forest); box-shadow: 0 14px 34px #0e392914; }
  @media(max-width: 780px) { .atmosphere { margin-top: 40px; } }
  @media(max-width: 1000px) { .hero-grid { gap: 30px; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); }.event-facts { grid-template-columns: 1fr 1fr; }.event-facts > div { border-bottom: 1px solid #e4e5d9; }.joy-grid { gap: 15px; }.joy-grid article { padding: 25px 20px; }.registration-grid { gap: 35px; }.times-grid { gap: 45px; } }
  @media(max-width: 780px) { .hero-grid, .registration-grid, .times-grid { grid-template-columns: 1fr; }.hero-grid { gap: 40px; }.hero-copy h1 { font-size: clamp(2.9rem, 6.8vw, 4.4rem); }.joy-grid { grid-template-columns: 1fr; }.registration-copy { position: static; }.times-grid { gap: 25px; }.registration-grid { gap: 30px; }.event-facts strong { font-size: .89rem; } }
  @media(max-width: 480px) { .shell { width: calc(100% - 34px); }.hero { padding: 38px 0 65px; }.back { margin-bottom: 26px; }.hero-copy h1 { font-size: clamp(2.25rem, 9.6vw, 2.9rem); }.hero .eyebrow { font-size: .61rem; letter-spacing: .055em; }.intro { font-size: .92rem; }.event-facts > div { padding: 20px 16px; }.joy { padding-block: 60px; }.times-section { padding-block: 50px; }.registration { padding: 60px 0 75px; }.time-list strong { font-size: 2.5rem; } }
  .benefit-card { padding: clamp(24px, 4vw, 42px); background: #fffefa; color: #173d2b; border-top: 5px solid var(--gold); box-shadow: 12px 12px 0 #08261b; transform: rotate(1deg); }
  .benefit-card img { display: block; width: 100%; height: auto; max-height: 210px; object-fit: contain; margin-bottom: 28px; }.benefit-card .eyebrow { color: #607c38; }.benefit-card strong { display: block; font-size: clamp(1.75rem, 2.8vw, 2.5rem); line-height: 1.1; letter-spacing: -.04em; }.benefit-card em { color: #567b31; font-family: Georgia, serif; font-weight: 400; }.benefit-card > p:last-child { margin: 22px 0 0; color: #536353; font-size: .88rem; line-height: 1.8; }
  .archive-link { display: block; padding: 0 22px 22px; color: var(--gold); font-size: .8rem; text-underline-offset: 4px; }.joy-grid .charity { background: #e9edde; border-color: #779747; }
  .charity-info { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; padding-block: 80px; }.charity-info p { color: #536353; line-height: 1.8; }.charity-actions { display: flex; flex-wrap: wrap; gap: 15px 25px; margin-top: 24px; }.charity-actions a { color: #164f32; font-weight: 750; text-underline-offset: 4px; }
  .gallery{padding:70px 0 95px;border-top:1px solid #d9e2dc}.gallery-head{display:flex;align-items:end;justify-content:space-between;gap:50px}.gallery-head p{max-width:390px}.year-tabs{margin:20px 0 16px;border-bottom:1px solid #d7dfda}.year-tabs span{display:inline-block;padding:10px 20px;background:var(--forest);color:#fff;font-weight:950;box-shadow:inset 0 -4px var(--gold)}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.gallery-item{position:relative;display:block;padding:0;border:0;overflow:hidden;aspect-ratio:3/2;background:#dce6df;cursor:zoom-in}.gallery-item.is-wide{grid-column:span 2}.gallery-item img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .25s}.gallery-item:hover img{transform:scale(1.025)}.gallery-item>span{position:absolute;z-index:2;left:10px;bottom:10px;padding:6px 8px;background:rgb(9 47 32 / 90%);color:#fff;font-size:.58rem;font-weight:850}.lightbox[hidden]{display:none}.lightbox{position:fixed;z-index:9999;inset:0;display:grid;grid-template-columns:96px minmax(0,1fr) 96px;align-items:center;background:rgb(3 12 8 / 94%);padding:32px}.lightbox-stage{margin:0;min-width:0;text-align:center}.lightbox-stage img{display:block;max-width:min(1400px,100%);max-height:82vh;width:auto;height:auto;margin:auto;object-fit:contain;box-shadow:0 18px 65px rgb(0 0 0 / 45%)}.lightbox-stage figcaption{max-width:min(1400px,100%);margin:12px auto 0;display:flex;justify-content:space-between;gap:20px;color:#fff;font-size:.78rem;text-align:left}.lightbox-stage figcaption small{white-space:nowrap;color:#cbd8d0}.lightbox-close,.lightbox-nav{border:0;background:rgb(255 255 255 / 10%);color:#fff;cursor:pointer}.lightbox-close{position:absolute;right:22px;top:18px;width:48px;height:48px;border-radius:50%;font-size:2rem;line-height:1}.lightbox-nav{width:64px;height:90px;justify-self:center;font-size:3.5rem;line-height:1}.lightbox-nav:hover,.lightbox-close:hover{background:var(--gold);color:var(--forest)}:global(html.lightbox-open){overflow:hidden}
  .gallery-head h2 { margin: 12px 0 20px; }.gallery-head > p { color: #536353; line-height: 1.8; }.gallery-head span { color: #537d2a; font-size: .7rem; font-weight: 850; text-transform: uppercase; letter-spacing: .1em; }
  @media(max-width: 780px) { .benefit-card { max-width: 440px; margin-inline: auto; transform: none; }.charity-info { grid-template-columns: 1fr; gap: 10px; padding-block: 55px; }.gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }.gallery-head { display: block; } }
  @media(max-width: 480px) { .gallery-grid { grid-template-columns: 1fr; }.gallery-item.is-wide { grid-column: auto; }.lightbox-nav { position: absolute; top: 50%; width: 42px; height: 60px; }.lightbox-prev { left: 8px; }.lightbox-next { right: 8px; } }
</style>
