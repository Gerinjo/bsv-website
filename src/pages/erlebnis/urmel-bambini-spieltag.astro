---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';

const urmelUrl = 'https://www.urmel-kinder-krebshilfe.org/';
const donationUrl = 'https://www.urmel-kinder-krebshilfe.org/spenden-hilfe.html';
const urmelLogo = withBase('/images/events/urmel/urmel-kinder-krebshilfe.webp');
const gallery = [
  { src: withBase('/images/events/urmel/2026/01-spielszene.webp'), alt: 'Spielszene beim URMEL Bambini Spieltag 2026' },
  { src: withBase('/images/events/urmel/2026/02-torschuss.webp'), alt: 'Torschuss beim URMEL Bambini Spieltag 2026' },
  { src: withBase('/images/events/urmel/2026/03-kleinfeld.webp'), alt: 'Bambini-Spiel auf dem Kleinfeld' },
  { src: withBase('/images/events/urmel/2026/04-turniertag.webp'), alt: 'Mannschaften beim URMEL Bambini Spieltag' },
  { src: withBase('/images/events/urmel/2026/05-medaillen.webp'), alt: 'Medaillen für die Kinder' },
  { src: withBase('/images/events/urmel/2026/06-siegerehrung.webp'), alt: 'Siegerehrung beim URMEL Bambini Spieltag' },
  { src: withBase('/images/events/urmel/2026/07-trainerteam.webp'), alt: 'Trainerinnen und Trainer des Spieltags' },
  { src: withBase('/images/events/urmel/2026/08-gruppenfoto.webp'), alt: 'Gruppenfoto zum Abschluss des URMEL Bambini Spieltags 2026' },
];
---

<Layout title="URMEL Bambini Spieltag | BSV Nordstern Radolfzell" description="Rückblick auf den URMEL Bambini Spieltag 2026 beim BSV Nordstern Radolfzell – Kids spielen für Kids zugunsten der Urmel Kinder-Krebshilfe e.V.">
  <Header />
  <main class="urmel-page">
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <a href={withBase('/erlebnis')}>← Zurück zu allen Erlebnissen</a>
          <span>Turniere & Aktionstage · Rückblick 2026</span>
          <h1>URMEL<br /><em>Bambini Spieltag.</em></h1>
          <p>Kids spielen für Kids: Am 1. Mai 2026 wurde beim BSV Nordstern Fußball mit einem guten Zweck verbunden. Ein fröhlicher Bambini-Spieltag, bei dem die Kinder mit viel Begeisterung auf dem Platz waren und gleichzeitig die Urmel Kinder-Krebshilfe unterstützt wurde.</p>
          <div class="hero-meta"><span class="next-date"><small>Nächster Termin</small><strong>Mai 2027</strong></span><span class="review-date"><small>Rückblick</small><strong>1. Mai 2026</strong><em>BSV Nordstern Radolfzell</em></span></div>
        </div>
        <aside class="hero-card"><img src={urmelLogo} alt="URMEL Kinder-Krebshilfe e.V." /><small>Benefizspieltag</small><strong>KIDS SPIELEN <em>FÜR KIDS</em></strong></aside>
      </div>
    </section>

    <section class="report shell"><div class="section-title"><span>Rückblick 2026</span><h2>Ein super Event.<br /><em>Mit ganz viel Freude.</em></h2></div><div class="report-copy"><p>Der erste URMEL Bambini Spieltag beim BSV Nordstern war ein richtig schöner Fußballtag. Die Kinder standen im Mittelpunkt, konnten spielen, sich bewegen und gemeinsam mit ihren Teams einen besonderen 1. Mai erleben. Vor allem eines war überall zu sehen: <strong>Die Kinder hatten Spaß.</strong></p><p>Der Spieltag fand im Rahmen des 1.-Mai-Flohmarkts auf dem BSV-Gelände statt. Bambini-Mannschaften aus der Region waren eingeladen, in einem kindgerechten Rahmen miteinander Fußball zu spielen.</p></div></section>

    <section class="facts shell"><article><small>Termin 2026</small><strong>1. Mai</strong><p>Benefizspieltag auf dem BSV-Sportgelände.</p></article><article><small>Motto</small><strong>Kids spielen für Kids</strong><p>Fußballfreude und soziales Engagement.</p></article><article><small>Turnierbeitrag</small><strong>25 € pro Team</strong><p>Zugunsten der Urmel Kinder-Krebshilfe.</p></article><article><small>Zusätzliche Hilfe</small><strong>Freiwillige Spenden</strong><p>Gemeinsam für den guten Zweck.</p></article></section>

    <section class="gallery shell">
      <div class="gallery-head"><div><span>Galerie</span><h2>Impressionen <em>2026.</em></h2></div><p>Acht Eindrücke vom URMEL Bambini Spieltag am 1. Mai 2026.</p></div>
      <div class="year-tabs"><span>2026</span></div>
      <div class="gallery-grid" data-urmel-gallery>
        {gallery.map((image, index) => (
          <button type="button" class:list={["gallery-item", index === 7 && "is-wide"]} data-gallery-index={index} aria-label={`${image.alt} vergrößern`}>
            <img src={image.src} alt={image.alt} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
            <span>Vergrößern</span>
          </button>
        ))}
      </div>
    </section>

    <div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="URMEL Bildergalerie">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label="Galerie schließen">×</button>
      <button class="lightbox-nav lightbox-prev" type="button" data-lightbox-prev aria-label="Vorheriges Bild">‹</button>
      <figure class="lightbox-stage">
        <img data-lightbox-image src="" alt="" />
        <figcaption><span data-lightbox-caption></span><small><b data-lightbox-current>1</b> / {gallery.length}</small></figcaption>
      </figure>
      <button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label="Nächstes Bild">›</button>
    </div>

    <section class="purpose"><div class="shell purpose-grid"><div><span>Mehr als Fußball</span><h2>Gemeinsam spielen.<br /><em>Gemeinsam helfen.</em></h2></div><div class="purpose-copy"><p>Die gesamten Turniergebühren sowie freiwillige zusätzliche Spenden waren zugunsten der <strong>Urmel Kinder-Krebshilfe e.V. aus Friedrichshafen</strong> vorgesehen.</p></div></div></section>

    <section class="urmel-info shell"><div class="urmel-info-card"><div class="urmel-brand"><img src={urmelLogo} alt="URMEL Kinder-Krebshilfe e.V." /><span>Urmel Kinder-Krebshilfe e.V.</span><h2>Hilfe für die<br /><em>ganze Familie.</em></h2></div><div><p>Die Urmel Kinder-Krebshilfe unterstützt an Krebs erkrankte Kinder und Jugendliche sowie ihre Familien.</p><div class="actions"><a href={urmelUrl} target="_blank" rel="noopener noreferrer">Urmel kennenlernen <b>↗</b></a><a class="is-yellow" href={donationUrl} target="_blank" rel="noopener noreferrer">Urmel unterstützen <b>↗</b></a></div></div></div></section>

    <section class="next shell"><div><span>Ausblick</span><h2>Wir freuen uns auf<br /><em>Mai 2027.</em></h2></div><div><p>Nach dem gelungenen Spieltag 2026 soll auch 2027 wieder gemeinsam gekickt werden. Den genauen Termin und alle weiteren Informationen geben wir rechtzeitig hier bekannt.</p></div></section>
  </main>
  <Footer />
</Layout>

<script define:vars={{ gallery }}>
  const root = document.querySelector('[data-urmel-gallery]');
  const lightbox = document.querySelector('[data-lightbox]');
  if (root instanceof HTMLElement && lightbox instanceof HTMLElement) {
    const image = lightbox.querySelector('[data-lightbox-image]');
    const caption = lightbox.querySelector('[data-lightbox-caption]');
    const current = lightbox.querySelector('[data-lightbox-current]');
    const close = lightbox.querySelector('[data-lightbox-close]');
    const prev = lightbox.querySelector('[data-lightbox-prev]');
    const next = lightbox.querySelector('[data-lightbox-next]');
    let activeIndex = 0;
    let lastFocus = null;

    const render = () => {
      const item = gallery[activeIndex];
      if (image instanceof HTMLImageElement) { image.src = item.src; image.alt = item.alt; }
      if (caption) caption.textContent = item.alt;
      if (current) current.textContent = String(activeIndex + 1);
    };

    const open = (index, trigger) => {
      activeIndex = index;
      lastFocus = trigger;
      render();
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('lightbox-open');
      if (close instanceof HTMLElement) close.focus();
    };

    const hide = () => {
      lightbox.hidden = true;
      lightbox.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('lightbox-open');
      if (lastFocus instanceof HTMLElement) lastFocus.focus();
    };

    const show = (delta) => {
      activeIndex = (activeIndex + delta + gallery.length) % gallery.length;
      render();
    };

    root.addEventListener('click', (event) => {
      const trigger = event.target instanceof Element ? event.target.closest('[data-gallery-index]') : null;
      if (!(trigger instanceof HTMLElement)) return;
      open(Number(trigger.dataset.galleryIndex || 0), trigger);
    });
    close?.addEventListener('click', hide);
    prev?.addEventListener('click', () => show(-1));
    next?.addEventListener('click', () => show(1));
    lightbox.addEventListener('click', (event) => { if (event.target === lightbox) hide(); });
    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') hide();
      if (event.key === 'ArrowLeft') show(-1);
      if (event.key === 'ArrowRight') show(1);
    });
  }
</script>

<style>
:global(:root){--ug:#092f20;--um:#164f32;--uy:#f4d638;--up:#f4f7f4}.shell{width:min(1120px,calc(100% - 48px));margin-inline:auto}.urmel-page{background:var(--up);color:#15261b}.hero{padding:76px 0 86px;background:linear-gradient(145deg,#071f16,#164f32);color:#fff}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:70px;align-items:center}.hero-copy>a{color:var(--uy);font-size:.74rem;font-weight:900;text-decoration:none}.hero-copy>span,.section-title>span,.purpose span,.urmel-brand>span,.next>div>span,.gallery-head span{display:block;color:var(--uy);font-size:.64rem;font-weight:950;letter-spacing:.13em;text-transform:uppercase}.hero-copy>span{margin-top:44px}.hero h1,.report h2,.purpose h2,.urmel-info h2,.next h2,.gallery h2{margin:12px 0 22px;font-size:clamp(3rem,5.8vw,6rem);line-height:.9;letter-spacing:-.05em}.hero h1 em,.report h2 em,.purpose h2 em,.urmel-info h2 em,.next h2 em,.gallery h2 em{font-family:Georgia,serif;font-weight:400;color:var(--uy)}.hero-copy>p{max-width:650px;color:#d2e0d7;line-height:1.72}.hero-meta{margin-top:28px;display:flex;gap:10px}.hero-meta>span{padding:11px 13px;display:grid;gap:2px}.next-date{background:var(--uy);color:var(--ug)}.review-date{border:1px solid #ffffff33}.hero-meta small{font-size:.54rem;font-weight:950;text-transform:uppercase}.hero-meta em{color:#abc0b3;font-size:.6rem;font-style:normal}.hero-card{min-height:390px;padding:34px;display:flex;flex-direction:column;justify-content:center;gap:18px;background:#fff;box-shadow:18px 18px 0 #00000029;transform:rotate(1deg)}.hero-card img{width:100%;max-height:230px;object-fit:contain}.hero-card small{color:var(--um);font-weight:950;text-transform:uppercase}.hero-card strong{color:var(--ug);font-size:2rem}.hero-card strong em{color:#93bd00}.report{padding:90px 0 72px;display:grid;grid-template-columns:.85fr 1.15fr;gap:78px}.section-title>span,.gallery-head span,.urmel-brand>span,.next>div>span{color:var(--um)}.report h2,.gallery h2,.purpose h2,.urmel-info h2,.next h2{font-size:clamp(2.6rem,4.5vw,4.6rem)}.report h2 em,.gallery h2 em,.urmel-info h2 em,.next h2 em{color:var(--um)}.report-copy p,.purpose-copy p,.urmel-info-card p,.next p,.gallery-head p{color:#607067;line-height:1.8}.facts{padding:0 0 80px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.facts article{padding:24px;background:#fff;border-top:4px solid var(--uy)}.facts small{color:var(--um);font-weight:950}.facts strong{display:block;margin:25px 0 8px}.facts p{color:#68776e;font-size:.75rem}.gallery{padding:70px 0 95px;border-top:1px solid #d9e2dc}.gallery-head{display:flex;align-items:end;justify-content:space-between;gap:50px}.gallery-head p{max-width:390px}.year-tabs{margin:20px 0 16px;border-bottom:1px solid #d7dfda}.year-tabs span{display:inline-block;padding:10px 20px;background:var(--ug);color:#fff;font-weight:950;box-shadow:inset 0 -4px var(--uy)}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.gallery-item{position:relative;display:block;padding:0;border:0;overflow:hidden;aspect-ratio:3/2;background:#dce6df;cursor:zoom-in}.gallery-item.is-wide{grid-column:span 2}.gallery-item img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .25s}.gallery-item:hover img{transform:scale(1.025)}.gallery-item>span{position:absolute;z-index:2;left:10px;bottom:10px;padding:6px 8px;background:rgb(9 47 32 / 90%);color:#fff;font-size:.58rem;font-weight:850}.lightbox[hidden]{display:none}.lightbox{position:fixed;z-index:9999;inset:0;display:grid;grid-template-columns:96px minmax(0,1fr) 96px;align-items:center;background:rgb(3 12 8 / 94%);padding:32px}.lightbox-stage{margin:0;min-width:0;text-align:center}.lightbox-stage img{display:block;max-width:min(1400px,100%);max-height:82vh;width:auto;height:auto;margin:auto;object-fit:contain;box-shadow:0 18px 65px rgb(0 0 0 / 45%)}.lightbox-stage figcaption{max-width:min(1400px,100%);margin:12px auto 0;display:flex;justify-content:space-between;gap:20px;color:#fff;font-size:.78rem;text-align:left}.lightbox-stage figcaption small{white-space:nowrap;color:#cbd8d0}.lightbox-close,.lightbox-nav{border:0;background:rgb(255 255 255 / 10%);color:#fff;cursor:pointer}.lightbox-close{position:absolute;right:22px;top:18px;width:48px;height:48px;border-radius:50%;font-size:2rem;line-height:1}.lightbox-nav{width:64px;height:90px;justify-self:center;font-size:3.5rem;line-height:1}.lightbox-nav:hover,.lightbox-close:hover{background:var(--uy);color:var(--ug)}:global(html.lightbox-open){overflow:hidden}.purpose{padding:82px 0;background:var(--ug);color:#fff}.purpose-grid,.urmel-info-card,.next{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px}.purpose h2{color:#fff}.purpose-copy p{color:#c2d2c8}.urmel-info{padding:92px 0}.urmel-info-card{padding:50px;background:#fff}.urmel-brand img{width:min(100%,330px);margin-bottom:25px}.actions{display:flex;gap:10px;flex-wrap:wrap}.actions a,.next a{padding:15px 17px;background:var(--ug);color:#fff;text-decoration:none;font-weight:950}.actions a.is-yellow{background:var(--uy);color:var(--ug)}.next{margin-bottom:95px;padding:44px 48px;background:#edf2ee;border-left:6px solid var(--uy)}@media(max-width:900px){.hero-grid,.report,.purpose-grid,.urmel-info-card,.next{grid-template-columns:1fr}.facts{grid-template-columns:1fr 1fr}.gallery-grid{grid-template-columns:1fr 1fr}.lightbox{grid-template-columns:62px minmax(0,1fr) 62px;padding:20px}.lightbox-nav{width:50px;height:76px}}@media(max-width:620px){.shell{width:min(100% - 32px,1120px)}.hero-meta{flex-direction:column}.facts,.gallery-grid{grid-template-columns:1fr}.gallery-item.is-wide{grid-column:auto}.gallery-head{display:block}.hero-card{min-height:280px}.urmel-info-card,.next{padding:30px 26px}.lightbox{grid-template-columns:1fr;padding:58px 14px 18px}.lightbox-stage img{max-height:72vh}.lightbox-nav{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:66px;background:rgb(0 0 0 / 45%)}.lightbox-prev{left:8px}.lightbox-next{right:8px}.lightbox-stage figcaption{font-size:.68rem;padding:0 4px}}
</style>
