---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';
---
<Layout title="Bürgerstiftung & Grundschulturnier | BSV Nordstern Radolfzell" description="Kooperation des BSV Nordstern Radolfzell mit der Bürgerstiftung Radolfzell rund um das Zeller Grundschulturnier.">
  <Header />
  <main class="partner-page">
    <section class="hero"><div class="shell"><a href={withBase('/erlebnis')}>← Zurück zu allen Kooperationen</a><span>Schule, Bewegung & Gemeinschaft</span><h1>Bürgerstiftung Radolfzell<br /><em>Grundschulturnier</em></h1><p>Gemeinsam bringen wir Radolfzeller Grundschulen zu einem altersgerechten Sport- und Begegnungstag zusammen.</p></div></section>
    <section class="content shell"><div><h2>Gemeinsam für Radolfzell</h2><p>Die Bürgerstiftung Radolfzell unterstützt das Zeller Grundschulturnier und hilft dabei, Bewegung, Fairplay und Schulgemeinschaft miteinander zu verbinden. Diese Seite wird künftig zum zentralen Ort für Informationen zur Kooperation.</p></div><aside><h3>Geplant für diese Seite</h3><ul><li>Informationen zur Partnerschaft</li><li>Aktuelle Turniertermine</li><li>Rückblicke und Bildergalerien</li><li>Verknüpfung zur Turnierseite</li></ul></aside></section>
    <section class="gallery shell"><span>Galerie</span><h2>Das Turnier in Bildern.</h2><div class="placeholder"><strong>Bildgalerie vorbereitet</strong><p>Hier können später Eindrücke des Grundschulturniers ergänzt werden.</p></div></section>
  </main><Footer />
</Layout>
<style>
.shell{width:min(1120px,calc(100% - 48px));margin-inline:auto}.partner-page{background:#f5f7f4;color:#14251a}.hero{padding:90px 0;background:#164f32;color:#fff}.hero a{color:#f4d638;text-decoration:none;font-weight:800;font-size:.78rem}.hero span{display:block;margin-top:50px;color:#a9cbb8;font-size:.68rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.hero h1{margin:14px 0 24px;font-size:clamp(3.2rem,6vw,5.8rem);line-height:.9;letter-spacing:-.05em}.hero em{color:#f4d638;font-family:Georgia,serif;font-weight:400}.hero p{max-width:720px;color:#d3e2d8;font-size:1.08rem;line-height:1.7}.content{padding:90px 0;display:grid;grid-template-columns:1.25fr .75fr;gap:70px}.content h2,.gallery h2{font-size:clamp(2.4rem,4vw,4rem);letter-spacing:-.04em}.content p{color:#5d6c62;line-height:1.8}.content aside{padding:32px;background:#fff}.content h3{margin-top:0;color:#164f32}.content li{margin:12px 0;color:#536158}.gallery{padding:0 0 100px}.gallery>span{color:#164f32;font-size:.68rem;font-weight:900;text-transform:uppercase;letter-spacing:.14em}.placeholder{min-height:260px;padding:38px;display:grid;place-content:center;border:1px dashed #b9c5bd;background:#fff;text-align:center}.placeholder strong{font-size:1.35rem}.placeholder p{color:#68766d}@media(max-width:760px){.content{grid-template-columns:1fr;gap:30px}.hero{padding:65px 0}}
</style>