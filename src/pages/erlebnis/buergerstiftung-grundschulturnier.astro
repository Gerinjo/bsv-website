---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PartnerLogoPanel from '../../components/PartnerLogoPanel.astro';
import Layout from '../../layouts/Layout.astro';
import { erlebnisCooperations } from '../../data/erlebnis';
import { withBase } from '../../utils/paths';

const cooperation = erlebnisCooperations.find((item) => item.id === 'buergerstiftung-grundschulturnier')!;
const galleryRoot = join(process.cwd(), 'public', 'images', 'events', 'grundschulturnier');
const imagePattern = /\.(?:avif|gif|jpe?g|png|webp)$/i;
const configuredYears = ['2026'];
const discoveredYears = existsSync(galleryRoot)
  ? readdirSync(galleryRoot, { withFileTypes: true })
      .filter((entry) => entry.isDirectory() && /^20\d{2}$/.test(entry.name))
      .map((entry) => entry.name)
  : [];
const years = [...new Set([...configuredYears, ...discoveredYears])].sort((a, b) => Number(b) - Number(a));
const galleries = years.map((year) => {
  const yearDirectory = join(galleryRoot, year);
  const images = existsSync(yearDirectory)
    ? readdirSync(yearDirectory)
        .filter((file) => imagePattern.test(file))
        .sort((a, b) => a.localeCompare(b, 'de', { numeric: true }))
        .map((file, index) => ({
          src: withBase(`/images/events/grundschulturnier/${year}/${file}`),
          alt: `Zeller Grundschulturnier ${year} – Bild ${index + 1}`,
        }))
    : [];
  return { year, images };
});
---

<Layout title="Bürgerstiftung & Grundschulturnier | BSV Nordstern Radolfzell" description="Kooperation des BSV Nordstern Radolfzell mit der Bürgerstiftung Radolfzell rund um das Zeller Grundschulturnier.">
  <Header />
  <main class="partner-page">
    <section class="hero"><div class="shell"><a href={withBase('/erlebnis')}>← Zurück zu allen Kooperationen</a><span>Schule, Bewegung & Gemeinschaft</span><h1>Bürgerstiftung Radolfzell<br /><em>Grundschulturnier</em></h1><p>Gemeinsam bringen wir Radolfzeller Grundschulen zu einem altersgerechten Sport- und Begegnungstag zusammen.</p></div></section>
    <div class="logo-shell shell"><PartnerLogoPanel cooperation={cooperation} /></div>

    <section class="content shell">
      <div><h2>Gemeinsam für Radolfzell</h2><p>Die Bürgerstiftung Radolfzell unterstützt das Zeller Grundschulturnier und hilft dabei, Bewegung, Fairplay und Schulgemeinschaft miteinander zu verbinden. Diese Seite wird künftig zum zentralen Ort für Informationen zur Kooperation.</p></div>
      <aside><h3>Auf dieser Seite</h3><ul><li>Informationen zur Partnerschaft</li><li>Aktuelle Turniertermine</li><li>Rückblicke und Bildergalerien nach Jahr</li><li>Verknüpfung zur Turnierseite</li></ul></aside>
    </section>

    <section class="gallery shell" aria-labelledby="gst-gallery-title">
      <div class="gallery-heading">
        <div><span>Galerie</span><h2 id="gst-gallery-title">Das Turnier in Bildern.</h2></div>
        <p>Die Bilder sind nach Turnierjahr sortiert. Das aktuellste Jahr ist beim Öffnen automatisch aktiv.</p>
      </div>

      <div class="gallery-tabs" role="tablist" aria-label="Turnierjahr auswählen">
        {galleries.map((gallery, index) => (
          <button
            type="button"
            class="gallery-tab"
            id={`gallery-tab-${gallery.year}`}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`gallery-panel-${gallery.year}`}
            tabindex={index === 0 ? 0 : -1}
            data-gallery-year={gallery.year}
          >
            <strong>{gallery.year}</strong>
            <span>{gallery.images.length ? `${gallery.images.length} Bilder` : 'Bilder folgen'}</span>
          </button>
        ))}
      </div>

      {galleries.map((gallery, index) => (
        <div
          class="gallery-panel"
          id={`gallery-panel-${gallery.year}`}
          role="tabpanel"
          aria-labelledby={`gallery-tab-${gallery.year}`}
          hidden={index !== 0}
          data-gallery-panel={gallery.year}
        >
          {gallery.images.length ? (
            <div class="gallery-grid">
              {gallery.images.map((image, imageIndex) => (
                <button class="gallery-image" type="button" data-lightbox-src={image.src} data-lightbox-alt={image.alt} aria-label={`Bild ${imageIndex + 1} aus ${gallery.year} vergrößern`}>
                  <img src={image.src} alt={image.alt} loading={imageIndex < 8 ? 'eager' : 'lazy'} decoding="async" />
                  <span aria-hidden="true">↗</span>
                </button>
              ))}
            </div>
          ) : (
            <div class="gallery-empty"><strong>Galerie {gallery.year}</strong><p>Die Bilder für dieses Turnierjahr werden hier ergänzt.</p></div>
          )}
        </div>
      ))}
    </section>

    <dialog class="gallery-lightbox" id="gst-gallery-lightbox">
      <button class="lightbox-close" type="button" aria-label="Großansicht schließen">×</button>
      <button class="lightbox-nav is-prev" type="button" aria-label="Vorheriges Bild">‹</button>
      <figure><img src="" alt="" /><figcaption></figcaption></figure>
      <button class="lightbox-nav is-next" type="button" aria-label="Nächstes Bild">›</button>
    </dialog>
  </main>
  <Footer />
</Layout>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-year]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-gallery-panel]')];

  const activateYear = (year: string) => {
    tabs.forEach((tab) => {
      const selected = tab.dataset.galleryYear === year;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });
    panels.forEach((panel) => { panel.hidden = panel.dataset.galleryPanel !== year; });
  };

  tabs.forEach((tab) => tab.addEventListener('click', () => activateYear(tab.dataset.galleryYear ?? '')));

  const lightbox = document.querySelector<HTMLDialogElement>('#gst-gallery-lightbox');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('figure img');
  const lightboxCaption = lightbox?.querySelector<HTMLElement>('figcaption');
  const closeButton = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');
  const previousButton = lightbox?.querySelector<HTMLButtonElement>('.is-prev');
  const nextButton = lightbox?.querySelector<HTMLButtonElement>('.is-next');
  let activeImages: HTMLButtonElement[] = [];
  let activeIndex = 0;

  const showLightboxImage = (index: number) => {
    if (!lightboxImage || !lightboxCaption || !activeImages.length) return;
    activeIndex = (index + activeImages.length) % activeImages.length;
    const item = activeImages[activeIndex];
    lightboxImage.src = item.dataset.lightboxSrc ?? '';
    lightboxImage.alt = item.dataset.lightboxAlt ?? '';
    lightboxCaption.textContent = `${activeIndex + 1} / ${activeImages.length}`;
  };

  document.querySelectorAll<HTMLButtonElement>('.gallery-image').forEach((button) => {
    button.addEventListener('click', () => {
      if (!lightbox) return;
      const panel = button.closest<HTMLElement>('[data-gallery-panel]');
      activeImages = panel ? [...panel.querySelectorAll<HTMLButtonElement>('.gallery-image')] : [button];
      showLightboxImage(Math.max(0, activeImages.indexOf(button)));
      lightbox.showModal();
    });
  });

  closeButton?.addEventListener('click', () => lightbox?.close());
  previousButton?.addEventListener('click', () => showLightboxImage(activeIndex - 1));
  nextButton?.addEventListener('click', () => showLightboxImage(activeIndex + 1));
  lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
  lightbox?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') showLightboxImage(activeIndex - 1);
    if (event.key === 'ArrowRight') showLightboxImage(activeIndex + 1);
  });
</script>

<style>
.shell{width:min(1120px,calc(100% - 48px));margin-inline:auto}.partner-page{background:#f5f7f4;color:#14251a}.hero{padding:90px 0 120px;background:#164f32;color:#fff}.hero a{color:#f4d638;text-decoration:none;font-weight:800;font-size:.78rem}.hero span{display:block;margin-top:50px;color:#a9cbb8;font-size:.68rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.hero h1{margin:14px 0 24px;font-size:clamp(3.2rem,6vw,5.8rem);line-height:.9;letter-spacing:-.05em}.hero em{color:#f4d638;font-family:Georgia,serif;font-weight:400}.hero p{max-width:720px;color:#d3e2d8;font-size:1.08rem;line-height:1.7}.logo-shell{margin-top:-70px;position:relative;z-index:2}.content{padding:75px 0 90px;display:grid;grid-template-columns:1.25fr .75fr;gap:70px}.content h2,.gallery h2{font-size:clamp(2.4rem,4vw,4rem);letter-spacing:-.04em}.content p{color:#5d6c62;line-height:1.8}.content aside{padding:32px;background:#fff}.content h3{margin-top:0;color:#164f32}.content li{margin:12px 0;color:#536158}
.gallery{padding:0 0 105px}.gallery-heading{display:flex;align-items:end;justify-content:space-between;gap:55px;margin-bottom:32px}.gallery-heading>div>span{color:#164f32;font-size:.68rem;font-weight:900;text-transform:uppercase;letter-spacing:.14em}.gallery-heading h2{margin:10px 0 0}.gallery-heading>p{max-width:390px;margin:0;color:#68766d;line-height:1.65}.gallery-tabs{display:flex;gap:8px;margin-bottom:24px;border-bottom:1px solid #d8e0da}.gallery-tab{min-width:125px;padding:15px 18px 14px;border:0;border-bottom:4px solid transparent;background:transparent;color:#637168;text-align:left;cursor:pointer}.gallery-tab strong,.gallery-tab span{display:block}.gallery-tab strong{font-size:1.05rem}.gallery-tab span{margin-top:3px;font-size:.64rem;font-weight:750}.gallery-tab[aria-selected='true']{border-bottom-color:#f4d638;background:#164f32;color:#fff}.gallery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.gallery-image{position:relative;aspect-ratio:4/3;padding:0;overflow:hidden;border:0;background:#dfe5e0;cursor:zoom-in}.gallery-image img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .25s ease}.gallery-image:hover img,.gallery-image:focus-visible img{transform:scale(1.035)}.gallery-image>span{position:absolute;right:9px;bottom:9px;width:29px;aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:rgb(7 31 22 / 88%);color:#f4d638;font-weight:900}.gallery-empty{min-height:230px;padding:35px;display:grid;place-content:center;text-align:center;border:1px dashed #b9c5bd;background:#fff}.gallery-empty strong{font-size:1.4rem}.gallery-empty p{margin:8px 0 0;color:#68766d}.gallery-lightbox{width:min(1180px,calc(100vw - 32px));max-width:none;height:min(88vh,900px);max-height:calc(100vh - 32px);padding:0;overflow:hidden;border:0;background:#071f16;color:white;box-sizing:border-box;box-shadow:0 30px 90px rgb(0 0 0 / 50%)}.gallery-lightbox::backdrop{background:rgb(0 0 0 / 82%);backdrop-filter:blur(4px)}.gallery-lightbox figure{width:100%;height:100%;min-width:0;min-height:0;margin:0;padding:45px 70px 38px;overflow:hidden;display:grid;grid-template-rows:minmax(0,1fr) auto;place-items:center;box-sizing:border-box}.gallery-lightbox figure img{display:block;width:100%;height:100%;min-width:0;min-height:0;max-width:100%;max-height:100%;object-fit:contain}.gallery-lightbox figcaption{margin-top:10px;color:#c4d4ca;font-size:.72rem;font-weight:800}.lightbox-close,.lightbox-nav{position:absolute;z-index:2;border:0;background:rgb(255 255 255 / 10%);color:white;cursor:pointer}.lightbox-close{right:14px;top:14px;width:42px;height:42px;font-size:1.8rem}.lightbox-nav{top:50%;width:48px;height:64px;font-size:2.3rem;transform:translateY(-50%)}.lightbox-nav.is-prev{left:12px}.lightbox-nav.is-next{right:12px}.lightbox-close:hover,.lightbox-nav:hover{background:#f4d638;color:#071f16}
@media(max-width:900px){.gallery-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.gallery-heading{align-items:flex-start;flex-direction:column;gap:16px}}@media(max-width:760px){.content{grid-template-columns:1fr;gap:30px}.hero{padding:65px 0 100px}.logo-shell{margin-top:-55px}.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery-lightbox figure{padding:55px 14px 40px}.lightbox-nav{width:40px;height:54px;background:rgb(7 31 22 / 78%)}}@media(max-width:480px){.shell{width:min(100% - 30px,1120px)}.gallery-grid{gap:6px}.gallery-tabs{overflow-x:auto}.gallery-tab{flex:0 0 auto}}
</style>