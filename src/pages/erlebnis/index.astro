---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { erlebnisCooperations } from '../../data/erlebnis';
import { withBase } from '../../utils/paths';
---

<Layout
  title="Erlebnis | BSV Nordstern Radolfzell"
  description="Fußballcamps, Turniere, Aktionstage und Benefits des BSV Nordstern Radolfzell."
>
  <Header />

  <main class="experience-page">
    <header class="experience-hero">
      <div class="shell hero-grid">
        <div>
          <span>Erlebnisse, die bewegen</span>
          <h1>Mehr erleben.<br /><em>Gemeinsam wachsen.</em></h1>
          <p>Fußballcamps, besondere Turniere, Aktionstage und attraktive Benefits ergänzen den Vereinsalltag und schaffen besondere Erlebnisse beim BSV.</p>
        </div>
        <div class="hero-note">
          <small>BSV Nordstern · Erlebnis</small>
          <strong>Camps, Turniere,<br />Aktionstage & Benefits.</strong>
          <p>Auf den Detailseiten findest du Termine, ausführliche Informationen, Rückblicke und Bildergalerien.</p>
        </div>
      </div>
    </header>

    <section class="overview shell">
      <div class="section-head">
        <div><span>Unsere Erlebnisse</span><h2>Bereich auswählen.</h2></div>
        <p>Partnerlogos werden unverändert aus ihren Originalquellen dargestellt. Bei eigenen BSV-Events arbeiten wir mit eigenständigen Eventflächen und Bildern.</p>
      </div>

      <div class="partner-grid">
        {erlebnisCooperations.map((cooperation) => (
          <a
            class="partner-card"
            data-kind={cooperation.logoSrc ? 'logo' : 'label'}
            href={withBase(cooperation.actionHref)}
            style={`--accent:${cooperation.accent};--logo-bg:${cooperation.logoBackground}`}
          >
            <div class="logo-stage">
              {cooperation.logoSrc && (
                <img src={cooperation.logoSrc.startsWith('/') ? withBase(cooperation.logoSrc) : cooperation.logoSrc} alt={cooperation.logoAlt} loading="lazy" decoding="async" />
              )}
              {cooperation.logoLabel && (
                <span class="logo-label">{cooperation.logoLabel.split('\n').map((line) => <span>{line}</span>)}</span>
              )}
            </div>
            <div class="partner-copy">
              <span>{cooperation.category}</span>
              <h2>{cooperation.partner}</h2>
              <p>{cooperation.title}</p>
              {cooperation.date && <small>{cooperation.date}</small>}
              <strong>Mehr erfahren <b aria-hidden="true">↗</b></strong>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="future shell">
      <div><span>Immer in Bewegung</span><h2>Besondere Tage.<br />Eigene Geschichten.</h2></div>
      <p>Ob Fußballcamp, Turnier, Aktionstag oder Benefit: Jeder Bereich bekommt seinen eigenen Platz für Termine, Informationen, Ansprechpartner und Rückblicke.</p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(:root){--green:#164f32;--dark:#071f16;--yellow:#f4d638;--ink:#14251a}
  .shell{width:min(1160px,calc(100% - 48px));margin-inline:auto}
  .experience-page{background:#f5f7f4;color:var(--ink)}
  .experience-hero{padding:92px 0;background:linear-gradient(120deg,#061f15,#0d3b27 70%,#164f32);color:white}
  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:80px;align-items:center}
  .experience-hero span,.section-head span,.future span{color:var(--yellow);font-size:.67rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}
  .experience-hero h1{margin:17px 0 24px;font-size:clamp(3.8rem,7vw,6.5rem);line-height:.88;letter-spacing:-.055em}.experience-hero h1 em{color:var(--yellow);font-family:Georgia,serif;font-weight:400}.experience-hero>div>div>p{max-width:650px;color:#cadbd0;font-size:1.06rem;line-height:1.75}
  .hero-note{padding:38px;border:1px solid rgb(255 255 255 / 14%);background:rgb(255 255 255 / 5%);box-shadow:12px 12px 0 var(--yellow)}.hero-note small{color:#9db6a7;font-size:.62rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.hero-note strong{display:block;margin:17px 0;font-size:2rem;line-height:1.05}.hero-note p{margin:0;color:#c8d8ce;line-height:1.65}
  .overview{padding:100px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:60px;margin-bottom:45px}.section-head span{color:var(--green)}.section-head h2,.future h2{margin:12px 0 0;font-size:clamp(2.7rem,5vw,4.6rem);line-height:.94;letter-spacing:-.05em}.section-head>p{max-width:430px;margin:0;color:#617066;line-height:1.7}
  .partner-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:25px}.partner-card{overflow:hidden;border-top:5px solid var(--accent);background:white;color:inherit;text-decoration:none;box-shadow:0 16px 42px rgb(9 47 32 / 8%);transition:.2s ease}.partner-card:hover{transform:translateY(-4px);box-shadow:0 22px 48px rgb(9 47 32 / 13%)}
  .logo-stage{height:190px;padding:28px;display:flex;align-items:center;justify-content:center;gap:24px;background:var(--logo-bg);border-bottom:1px solid #e1e7e2}.logo-stage img{display:block;max-width:78%;max-height:132px;object-fit:contain}.logo-label{display:flex;flex-direction:column;color:#173d6f;font-size:1.15rem;font-weight:900;line-height:1.08}.partner-card[data-kind='label'] .logo-label{max-width:340px;color:#f4d638;font-size:1.55rem;line-height:1;text-align:center;letter-spacing:.02em;text-transform:uppercase}.partner-card[data-kind='label'] .logo-stage::before{content:'♥';margin-right:8px;color:#f4d638;font-size:2rem}
  .partner-copy{padding:30px}.partner-copy>span{color:var(--accent);font-size:.62rem;font-weight:950;letter-spacing:.11em;text-transform:uppercase}.partner-copy h2{margin:9px 0 8px;font-size:1.6rem;line-height:1.15}.partner-copy p{margin:0;color:#617066;line-height:1.6}.partner-copy small{display:block;margin-top:15px;color:#526158;font-weight:850}.partner-copy>strong{margin-top:25px;display:flex;align-items:center;justify-content:space-between;color:var(--green);font-size:.76rem;text-transform:uppercase;letter-spacing:.05em}.partner-copy>strong b{color:var(--accent);font-size:1rem}
  .future{margin-bottom:105px;padding:55px 60px;display:grid;grid-template-columns:1fr 1fr;gap:70px;background:var(--dark);color:white}.future span{color:var(--yellow)}.future h2{color:white}.future>p{margin:auto 0;color:#bfd0c5;font-size:1.02rem;line-height:1.8}
  @media(max-width:900px){.hero-grid,.future{grid-template-columns:1fr}.partner-grid{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column;gap:20px}}
  @media(max-width:560px){.shell{width:min(100% - 30px,1160px)}.experience-hero{padding:68px 0}.hero-grid{gap:45px}.hero-note{padding:28px;box-shadow:7px 7px 0 var(--yellow)}.overview{padding:72px 0}.logo-stage{height:160px;padding:20px}.logo-stage img{max-height:110px}.logo-label{font-size:.9rem}.partner-card[data-kind='label'] .logo-label{font-size:1.2rem}.future{padding:38px 28px;gap:25px;margin-bottom:75px}}
</style>
