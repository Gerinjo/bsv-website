---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PartnerLogoPanel from '../../components/PartnerLogoPanel.astro';
import Layout from '../../layouts/Layout.astro';
import { erlebnisCooperations } from '../../data/erlebnis';
import { withBase } from '../../utils/paths';

const cooperation = erlebnisCooperations.find((item) => item.id === 'skechers-fussballschule')!;
const highlightVideo = 'https://skechers-fussballschule.de/site/assets/files/5983/skechers-fussballcamp-highlight-reel-long.mp4';
const registrationUrl = 'https://skechers-fussballschule.de/anmeldung';
const galleryRoot = join(process.cwd(), 'public', 'images', 'events', 'skechers-fussballschule');
const imagePattern = /\.(?:avif|gif|jpe?g|png|webp)$/i;
const configuredYears = ['2026'];
const discoveredYears = existsSync(galleryRoot)
  ? readdirSync(galleryRoot, { withFileTypes: true })
      .filter((entry) => entry.isDirectory() && /^20\d{2}$/.test(entry.name))
      .map((entry) => entry.name)
  : [];
const years = [...new Set([...configuredYears, ...discoveredYears])].sort((a, b) => Number(b) - Number(a));
const galleries = years.map((year) => {
  const yearDirectory = join(galleryRoot, year);
  const images = existsSync(yearDirectory)
    ? readdirSync(yearDirectory)
        .filter((file) => imagePattern.test(file))
        .sort((a, b) => a.localeCompare(b, 'de', { numeric: true }))
        .map((file, index) => ({
          src: withBase(`/images/events/skechers-fussballschule/${year}/${file}`),
          alt: `SKECHERS Fußballcamp ${year} beim BSV Nordstern – Bild ${index + 1}`,
        }))
    : [];
  return { year, images };
});
---
<Layout title="SKECHERS Fußballschule | BSV Nordstern Radolfzell" description="Die SKECHERS Fußballschule mit Bernd Voss beim BSV Nordstern Radolfzell.">
  <Header />
  <main class="partner-page">
    <section class="hero"><div class="shell"><a href={withBase('/erlebnis')}>← Zurück zu allen Kooperationen</a><span>Fußballcamp & Nachwuchsförderung</span><h1>SKECHERS Fußballschule<br /><em>mit Bernd Voss</em></h1><p>Professionelles, kindgerechtes Training, Wettbewerbe, Fairness und jede Menge Spielfreude – als besonderes Ferienangebot beim BSV Nordstern.</p></div></section>
    <div class="logo-shell shell"><PartnerLogoPanel cooperation={cooperation} /></div>

    <section class="content shell">
      <div>
        <h2>Eine echte BSV-Tradition</h2>
        <p>Die Fußballschule mit Bernd Voss ist seit vielen Jahren fester Bestandteil des Ferienprogramms beim BSV Nordstern. 2026 fand das Camp in Radolfzell bereits zum <strong>19. Mal</strong> statt.</p>
        <p>Im Mittelpunkt stehen Fußball, Bewegung und Gemeinschaft. Trainiert wird in altersgerechten Gruppen und mit vielen unterschiedlichen Spielformen. Technik, Dribbling, Passspiel, Torschuss und Koordination wechseln sich mit kleinen Wettbewerben und natürlich ganz viel Fußball ab.</p>
        <p>Dabei zählt nicht nur das sportliche Lernen. Die Kinder sollen neue Impulse mitnehmen, Selbstvertrauen gewinnen und gemeinsam besondere Camp-Tage erleben – mit viel Spaß und ohne unnötigen Leistungsdruck.</p>
      </div>
      <aside><h3>Auf dieser Seite</h3><ul><li>Aktuelle Termine und Anmeldung</li><li>Informationen rund um das Camp</li><li>Rückblicke und Bildergalerien</li><li>Organisatorische Hinweise</li></ul></aside>
    </section>

    <section class="registration shell" aria-labelledby="registration-title">
      <div class="early-bird">
        <span>Frühbucheraktion</span>
        <strong>Nur bis 31.01.</strong>
        <p>Frühzeitig anmelden und den Frühbuchervorteil für das nächste Fußballcamp sichern.</p>
      </div>
      <div class="registration-copy">
        <span>Anmeldung</span>
        <h2 id="registration-title">Dein Platz im Camp.</h2>
        <p>Die Anmeldung erfolgt direkt über die SKECHERS Fußballschule mit Bernd Voss.</p>
        <a class="registration-button" href={registrationUrl} target="_blank" rel="noopener noreferrer">Jetzt zum Fußballcamp anmelden <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="facts shell" aria-labelledby="camp-facts-title">
      <div class="facts-heading"><span>Camp & Danke</span><h2 id="camp-facts-title">Fußballferien beim BSV.</h2><p>Was über viele Jahre gewachsen ist, funktioniert nur durch eine verlässliche Partnerschaft und viele helfende Hände.</p></div>
      <div class="facts-grid">
        <article><strong>19.</strong><span>Austragung 2026</span><p>Das Fußballcamp mit Bernd Voss gehört seit vielen Jahren fest zum BSV Nordstern.</p></article>
        <article><strong>Mehrere Tage</strong><span>Fußball pur</span><p>Training, Technik, Koordination, Wettbewerbe und vor allem viel Freude am gemeinsamen Spiel.</p></article>
        <article><strong>Für Kinder</strong><span>Entwicklung & Erlebnis</span><p>Ein Ferienangebot, bei dem sportliche Entwicklung und das gemeinsame Erlebnis gleichermaßen zählen.</p></article>
        <article class="thank-you"><strong>Danke!</strong><span>An alle, die das Camp möglich machen</span><p>Unser besonderer Dank gilt <b>Bernd Voss und seinem Team</b>, unserem Partner <b>SKECHERS</b> sowie allen Helferinnen und Helfern des BSV, die das Camp vor Ort begleiten.</p></article>
      </div>
    </section>

    <section class="highlight shell" aria-labelledby="camp-highlight-title">
      <div class="highlight-heading"><div><span>Highlight-Reel</span><h2 id="camp-highlight-title">So fühlt sich Fußballcamp an.</h2></div><p>Ein paar bewegte Eindrücke aus der SKECHERS Fußballschule mit Bernd Voss.</p></div>
      <div class="video-frame"><video controls playsinline preload="metadata"><source src={highlightVideo} type="video/mp4" />Dein Browser unterstützt die Videowiedergabe nicht. <a href={highlightVideo}>Video direkt öffnen</a>.</video></div>
    </section>

    <section class="gallery shell" aria-labelledby="camp-gallery-title">
      <div class="gallery-heading"><div><span>Galerie</span><h2 id="camp-gallery-title">Camp-Momente.</h2></div><p>Die Bilder sind nach Camp-Jahr sortiert. Neue Jahrgänge können später einfach ergänzt werden.</p></div>
      <div class="gallery-tabs" role="tablist" aria-label="Camp-Jahr auswählen">
        {galleries.map((gallery, index) => (
          <button type="button" class="gallery-tab" id={`gallery-tab-${gallery.year}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`gallery-panel-${gallery.year}`} tabindex={index === 0 ? 0 : -1} data-gallery-year={gallery.year}>
            <strong>{gallery.year}</strong><span>{gallery.images.length ? `${gallery.images.length} Bilder` : 'Bilder folgen'}</span>
          </button>
        ))}
      </div>
      {galleries.map((gallery, index) => (
        <div class="gallery-panel" id={`gallery-panel-${gallery.year}`} role="tabpanel" aria-labelledby={`gallery-tab-${gallery.year}`} hidden={index !== 0} data-gallery-panel={gallery.year}>
          {gallery.images.length ? (
            <div class="gallery-grid">
              {gallery.images.map((image, imageIndex) => (
                <button class="gallery-image" type="button" data-lightbox-src={image.src} data-lightbox-alt={image.alt} aria-label={`Bild ${imageIndex + 1} aus ${gallery.year} vergrößern`}>
                  <img src={image.src} alt={image.alt} loading={imageIndex < 4 ? 'eager' : 'lazy'} decoding="async" /><span aria-hidden="true">↗</span>
                </button>
              ))}
            </div>
          ) : <div class="gallery-empty"><strong>Galerie {gallery.year}</strong><p>Die Bilder für dieses Camp-Jahr werden hier ergänzt.</p></div>}
        </div>
      ))}
    </section>

    <dialog class="gallery-lightbox" id="camp-gallery-lightbox">
      <button class="lightbox-close" type="button" aria-label="Großansicht schließen">×</button>
      <button class="lightbox-nav is-prev" type="button" aria-label="Vorheriges Bild">‹</button>
      <figure><img src="" alt="" /><figcaption></figcaption></figure>
      <button class="lightbox-nav is-next" type="button" aria-label="Nächstes Bild">›</button>
    </dialog>
  </main><Footer />
</Layout>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-year]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-gallery-panel]')];
  const activateYear = (year: string) => {
    tabs.forEach((tab) => { const selected = tab.dataset.galleryYear === year; tab.setAttribute('aria-selected', String(selected)); tab.tabIndex = selected ? 0 : -1; });
    panels.forEach((panel) => { panel.hidden = panel.dataset.galleryPanel !== year; });
  };
  tabs.forEach((tab) => tab.addEventListener('click', () => activateYear(tab.dataset.galleryYear ?? '')));
  const lightbox = document.querySelector<HTMLDialogElement>('#camp-gallery-lightbox');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('figure img');
  const lightboxCaption = lightbox?.querySelector<HTMLElement>('figcaption');
  const closeButton = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');
  const previousButton = lightbox?.querySelector<HTMLButtonElement>('.is-prev');
  const nextButton = lightbox?.querySelector<HTMLButtonElement>('.is-next');
  let activeImages: HTMLButtonElement[] = [];
  let activeIndex = 0;
  const showLightboxImage = (index: number) => {
    if (!lightboxImage || !lightboxCaption || !activeImages.length) return;
    activeIndex = (index + activeImages.length) % activeImages.length;
    const item = activeImages[activeIndex];
    lightboxImage.src = item.dataset.lightboxSrc ?? '';
    lightboxImage.alt = item.dataset.lightboxAlt ?? '';
    lightboxCaption.textContent = `${activeIndex + 1} / ${activeImages.length}`;
  };
  document.querySelectorAll<HTMLButtonElement>('.gallery-image').forEach((button) => button.addEventListener('click', () => {
    if (!lightbox) return;
    const panel = button.closest<HTMLElement>('[data-gallery-panel]');
    activeImages = panel ? [...panel.querySelectorAll<HTMLButtonElement>('.gallery-image')] : [button];
    showLightboxImage(Math.max(0, activeImages.indexOf(button)));
    lightbox.showModal();
  }));
  closeButton?.addEventListener('click', () => lightbox?.close());
  previousButton?.addEventListener('click', () => showLightboxImage(activeIndex - 1));
  nextButton?.addEventListener('click', () => showLightboxImage(activeIndex + 1));
  lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
  lightbox?.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') showLightboxImage(activeIndex - 1); if (event.key === 'ArrowRight') showLightboxImage(activeIndex + 1); });
</script>

<style>
