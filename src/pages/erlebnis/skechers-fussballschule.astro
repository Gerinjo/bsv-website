.highlight{padding:0 0 95px}.highlight-heading,.gallery-heading{display:flex;align-items:end;justify-content:space-between;gap:55px;margin-bottom:28px}.highlight-heading>div>span,.gallery-heading>div>span{color:#164f32;font-size:.68rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.highlight-heading h2,.gallery-heading h2{margin:10px 0 0}.highlight-heading>p,.gallery-heading>p{max-width:390px;margin:0;color:#68766d;line-height:1.65}.video-frame{position:relative;overflow:hidden;background:#071f16;box-shadow:0 18px 48px rgb(9 47 32 / 12%)}.video-frame::before{content:'';display:block;padding-top:56.25%}.video-frame video{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:contain;background:#071f16}
.gallery{padding:0 0 100px}.gallery-tabs{display:flex;gap:8px;margin-bottom:24px;border-bottom:1px solid #d8e0da}.gallery-tab{min-width:125px;padding:15px 18px 14px;border:0;border-bottom:4px solid transparent;background:transparent;color:#637168;text-align:left;cursor:pointer}.gallery-tab strong,.gallery-tab span{display:block}.gallery-tab span{margin-top:3px;font-size:.64rem;font-weight:750}.gallery-tab[aria-selected='true']{border-bottom-color:#f4d638;background:#164f32;color:#fff}.gallery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.gallery-image{position:relative;aspect-ratio:4/3;padding:0;overflow:hidden;border:0;background:#dfe5e0;cursor:zoom-in}.gallery-image img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .25s ease}.gallery-image:hover img,.gallery-image:focus-visible img{transform:scale(1.035)}.gallery-image>span{position:absolute;right:9px;bottom:9px;width:29px;aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:rgb(7 31 22 / 88%);color:#f4d638;font-weight:900}.gallery-empty{min-height:220px;padding:35px;display:grid;place-content:center;text-align:center;border:1px dashed #b9c5bd;background:#fff}.gallery-lightbox{width:min(1180px,calc(100vw - 32px));max-width:none;height:min(88vh,900px);max-height:calc(100vh - 32px);padding:0;overflow:hidden;border:0;background:#071f16;color:white;box-sizing:border-box;box-shadow:0 30px 90px rgb(0 0 0 / 50%)}.gallery-lightbox::backdrop{background:rgb(0 0 0 / 82%);backdrop-filter:blur(4px)}.gallery-lightbox figure{width:100%;height:100%;min-width:0;min-height:0;margin:0;padding:45px 70px 38px;overflow:hidden;display:grid;grid-template-rows:minmax(0,1fr) auto;place-items:center;box-sizing:border-box}.gallery-lightbox figure img{display:block;width:100%;height:100%;min-width:0;min-height:0;max-width:100%;max-height:100%;object-fit:contain}.gallery-lightbox figcaption{margin-top:10px;color:#c4d4ca;font-size:.72rem;font-weight:800}.lightbox-close,.lightbox-nav{position:absolute;z-index:2;border:0;background:rgb(255 255 255 / 10%);color:white;cursor:pointer}.lightbox-close{right:14px;top:14px;width:42px;height:42px;font-size:1.8rem}.lightbox-nav{top:50%;width:48px;height:64px;font-size:2.3rem;transform:translateY(-50%)}.lightbox-nav.is-prev{left:12px}.lightbox-nav.is-next{right:12px}.lightbox-close:hover,.lightbox-nav:hover{background:#f4d638;color:#071f16}
@media(max-width:960px){.facts-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:760px){.content,.facts-heading,.registration{grid-template-columns:1fr;gap:30px}.registration{gap:0}.hero{padding:65px 0 100px}.logo-shell{margin-top:-55px}.facts-heading>span{grid-column:auto}.highlight-heading,.gallery-heading{align-items:flex-start;flex-direction:column;gap:16px}.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery-lightbox figure{padding:55px 14px 40px}}@media(max-width:520px){.facts-grid{grid-template-columns:1fr}.facts-grid article{min-height:0}.early-bird,.registration-copy{padding:28px 24px}.registration-button{width:100%}.gallery-tabs{overflow-x:auto}.gallery-tab{flex:0 0 auto}}
