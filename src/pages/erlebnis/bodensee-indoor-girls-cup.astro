---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GirlsCupRegistrationForm from '../../components/GirlsCupRegistrationForm.astro';
import { girlsCup } from '../../data/girlsCup';
import { withBase } from '../../utils/paths';
---

<Layout title={`${girlsCup.title} · 20. & 21. Februar | BSV Nordstern Radolfzell`} description={`Bodensee Indoor Girls Cup 2027 in der ${girlsCup.venue}: E- und D-Juniorinnen am 20. Februar, C- und B-Juniorinnen am 21. Februar. Startgebühr: ${girlsCup.fee}.`}>
  <Header />
  <main class="girls-cup">
    <section class="cup-hero" aria-labelledby="cup-title">
      <div class="shell hero-grid">
        <div>
          <a class="back" href={withBase('/erlebnis')}>← Zu den Events & Erlebnissen</a>
          <p class="eyebrow">Juniorinnen · Futsal · 2027</p>
          <h1 id="cup-title">Bodensee<br /><em>Indoor Girls Cup.</em><span>2027</span></h1>
          <p class="intro">Zwei Tage Hallenfußball für unsere Juniorinnen: Am 20. und 21. Februar bringt der Bodensee Indoor Girls Cup vier Altersklassen auf das Hallenparkett. Gemeinsam spielen, als Team zusammenhalten und die Freude am Fußball teilen.</p>
          <a class="button" href="#anmeldung">Teams anmelden <span aria-hidden="true">↓</span></a>
          <p class="hero-note">{girlsCup.venue} · {girlsCup.fee}</p>
        </div>
        <figure class="cup-art">
          <img src={withBase(girlsCup.artwork)} alt="Bodensee Indoor Girls Cup 2027 – Turniermotiv mit Fußball, Spielfeldlinien und Bodenseewellen" width="1200" height="800" loading="eager" fetchpriority="high" />
          <figcaption><span>{girlsCup.date}</span><strong>Vier Altersklassen.<br /><em>Ein Wochenende Fußballfreude.</em></strong></figcaption>
        </figure>
      </div>
    </section>

    <section class="cup-facts shell" aria-label="Der Girls Cup auf einen Blick">
      <div><span>Wann?</span><strong>{girlsCup.date}</strong></div>
      <div><span>Für wen?</span><strong>E-, D-, C- und B-Juniorinnen</strong></div>
      <div><span>Spielort / Halle</span><strong>{girlsCup.venue}</strong><p class="venue-address">{girlsCup.address}</p></div>
      <div><span>Startgebühr</span><strong>{girlsCup.fee}</strong></div>
    </section>

    <section class="cup-days shell" id="turniertage" aria-labelledby="days-title">
      <div class="section-heading"><p class="eyebrow">Euer Wochenende im Überblick</p><h2 id="days-title">Zwei Turniertage.<br /><em>Findet euren Termin.</em></h2><p>Die Altersklassen sind auf Samstag und Sonntag verteilt. Die Startzeiten der einzelnen Turniere folgen.</p></div>
      <div class="days-grid">
        {girlsCup.days.map((day) => (
          <article class="day-card" data-cup-day={day.isoDate}>
            <div class="day-top"><p class="eyebrow">{day.weekday}</p><time datetime={day.isoDate}><strong>{day.day}</strong><span>Februar<br />2027</span></time></div>
            <h3>{day.divisions.join(' & ')}</h3>
            <ul aria-label={`Altersklassen am ${day.date}`}>{day.divisions.map((division) => <li>{division}</li>)}</ul>
            <p>Dieser Turniertag gehört den {day.divisions.join(' und ')}. Die genauen Startzeiten geben wir noch bekannt.</p>
          </article>
        ))}
      </div>
    </section>

    <section class="cup-details" aria-labelledby="details-title">
      <div class="shell details-grid">
        <div><p class="eyebrow">Gut zu wissen</p><h2 id="details-title">Termine vormerken.<br /><em>Gemeinsam dabei sein.</em></h2><p>Die Anmeldung ist geöffnet. Ihr könnt Teams für einen oder beide Tage anmelden. Die genauen Startzeiten folgen mit dem Spielplan.</p></div>
        <dl>
          <div><dt>Spielort / Halle</dt><dd>{girlsCup.venue}<br />{girlsCup.address}</dd></div>
          <div><dt>Startzeiten</dt><dd>Folgen je Altersklasse</dd></div>
          <div><dt>Startgebühr</dt><dd>{girlsCup.fee}</dd></div>
          <div><dt>Mannschaftsanmeldung</dt><dd><a href="#anmeldung">Für einen oder beide Tage anmelden</a></dd></div>
        </dl>
      </div>
    </section>

    <section class="cup-rules shell" id="spielregeln" aria-labelledby="rules-title">
      <div class="section-heading"><p class="eyebrow">Fair spielen · Altersgerecht antreten</p><h2 id="rules-title">Futsal nach<br /><em>den SBFV-Regeln.</em></h2><p>Wir spielen nach den SBFV-Ausführungsbestimmungen für Futsalspiele und Futsalturniere (AB 11) und den jeweils gültigen FIFA-Futsalregeln. Für jede Altersklasse gelten die entsprechenden Anpassungen.</p></div>
      <div class="rules-grid">
        {girlsCup.rules.map((rule) => (
          <article class="rule-card"><h3>{rule.division}</h3><dl>
            <div><dt>Auf dem Spielfeld</dt><dd>{rule.players}</dd></div>
            <div><dt>Spielball</dt><dd>{rule.ball}</dd></div>
            <div><dt>Maximale Gesamtspielzeit pro Tag</dt><dd>{rule.maxMinutes} Minuten</dd></div>
          </dl></article>
        ))}
      </div>
      <p class="rules-note">Pro Mannschaft sind höchstens 14 Spielerinnen möglich. Gewechselt wird fliegend in der Wechselzone. Schienbeinschoner sind Pflicht. Zwischen zwei Spielen einer Mannschaft liegt mindestens ein Spiel Pause. Ab der D-Jugend werden kumulierte Fouls gezählt; ab dem fünften gelten besondere Ausführungsregeln.</p>
      <p class="rules-note">Die konkreten Spielzeiten und die Gruppeneinteilung folgen mit dem Spielplan. Die Übersicht nennt die Obergrenzen, nicht die geplante Spieldauer.</p>
      <div class="rules-links"><a href={girlsCup.rulesUrl} target="_blank" rel="noopener noreferrer">SBFV: AB 11 – Futsalregeln (PDF) ↗</a><a href={girlsCup.rulesOverviewUrl} target="_blank" rel="noopener noreferrer">Aktuelle SBFV-Ausführungsbestimmungen ↗</a></div>
      <p class="rules-source">Verlinkte AB-11-Fassung: Oktober 2019. Maßgeblich ist die zum Turnier gültige Fassung des SBFV.</p>
    </section>

    <section class="cup-registration" id="anmeldung" aria-labelledby="registration-title">
      <div class="shell registration-grid">
        <div class="registration-copy"><p class="eyebrow">Ein Verein · Ein oder zwei Tage</p><h2 id="registration-title">Eure Teams.<br /><em>Euer Wochenende.</em></h2><p>Meldet eure Mannschaften gemeinsam an. Wählt Samstag, Sonntag oder beide Tage und gebt die Teamanzahl je Altersklasse an.</p><p><strong>{girlsCup.fee}.</strong> Die Staffelung gilt gemeinsam für alle Teams dieser Anmeldung, auch über beide Tage. Zwei Teams kosten 70 €, drei Teams 100 €.</p><p>Als Kontaktperson benötigen wir eure Trainerin oder euren Trainer. Wir bestätigen die Teilnahme und die Startzeiten anschließend persönlich.</p><a href={withBase('/kontakt?thema=person-jerome-ernsberger')}>Kontakt zu Jérôme Ernsberger →</a></div>
        <GirlsCupRegistrationForm />
      </div>
    </section>

    <section class="cup-contact shell" aria-labelledby="contact-title">
      <div><p class="eyebrow">Wir sind für euch da</p><h2 id="contact-title">Fragen zum<br /><em>Girls Cup?</em></h2><p>Ihr möchtet mehr über das Turnier erfahren? Schreibt uns über das Kontaktformular.</p></div>
      <a class="button" href={withBase('/kontakt?thema=person-jerome-ernsberger')}>Kontakt zur Organisation <span aria-hidden="true">↗</span></a>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .venue-address { margin: 7px 0 0; font-size: .78rem; line-height: 1.6; color: #536353; }
  .girls-cup { --forest: #0e3929; --gold: #e4bf6a; --cream: #faf6ec; background: var(--cream); color: #173d2b; }
  .shell { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }h1, h2, h3, p { margin-top: 0; }h1, h2 { letter-spacing: -.045em; }h1 em, h2 em, figcaption em { font-family: Georgia, serif; font-weight: 400; }
  .cup-hero { padding: 65px 0 88px; background: radial-gradient(ellipse at 90% 10%, #24574b, transparent 60%), #092f20; color: #fff9ec; }.hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); align-items: center; gap: 55px; }.back { display: block; width: fit-content; margin-bottom: 34px; color: #c4d4c5; font-size: .78rem; text-decoration: none; }.back:hover { text-decoration: underline; }
  .eyebrow { margin-bottom: 14px; font-size: .7rem; font-weight: 850; letter-spacing: .11em; text-transform: uppercase; line-height: 1.65; }.cup-hero .eyebrow { color: var(--gold); }h1 { margin-bottom: 25px; font-size: clamp(2.8rem, 4.7vw, 4.5rem); line-height: 1.03; }h1 em { color: var(--gold); }h1 > span { display: block; margin-top: 15px; color: #c1d5c7; font-size: .45em; letter-spacing: .08em; }.intro { max-width: 580px; color: #d5dfd1; font-size: .97rem; line-height: 1.8; }
  .button { display: flex; align-items: center; justify-content: space-between; width: fit-content; gap: 28px; padding: 17px 21px; margin-top: 28px; background: #f4d638; color: #092f20; font-weight: 850; font-size: .87rem; text-decoration: none; }.button:hover { background: #ffe967; }
  .cup-art { margin: 0; border-top: 4px solid var(--gold); background: #0e3929; box-shadow: 12px 12px 0 #08261b; }.cup-art img { display: block; width: 100%; height: auto; }.cup-art figcaption { padding: 25px 28px 31px; border-top: 1px solid #496950; }.cup-art figcaption > span { display: block; margin-bottom: 15px; color: var(--gold); font-size: .83rem; font-weight: 850; }.cup-art strong { font-size: clamp(1.55rem, 2.6vw, 2.2rem); line-height: 1.2; letter-spacing: -.025em; }.cup-art em { color: #c1d5c7; }
  .hero-note { margin: 18px 0 0; color: #d5dfd1; font-size: .77rem; line-height: 1.7; }
  .cup-facts { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: -25px; background: #fffefa; border-top: 4px solid var(--gold); box-shadow: 0 10px 28px #0e392910; }.cup-facts > div { padding: 25px 24px; border-right: 1px solid #e4e5d9; }.cup-facts > div:last-child { border: 0; }.cup-facts span { display: block; margin-bottom: 9px; font-size: .65rem; color: #6d745e; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; }.cup-facts strong { font-size: .94rem; line-height: 1.6; }
  h2 { margin-bottom: 24px; font-size: clamp(2.2rem, 3.9vw, 3.6rem); line-height: 1.05; }h2 em { color: #426448; }.cup-days { padding-block: 85px; scroll-margin-top: 130px; }.section-heading { margin-bottom: 35px; }.section-heading .eyebrow, .cup-contact .eyebrow { color: #356b67; }.section-heading > p:last-child, .cup-contact p { max-width: 620px; color: #536353; font-size: .95rem; line-height: 1.8; }
  .days-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px; }.day-card { padding: 32px; border-top: 4px solid #e4bf6a; background: #fffefa; box-shadow: 0 12px 25px #0e392908; }.day-card:nth-child(2) { border-color: #337d88; }.day-top { display: flex; align-items: start; justify-content: space-between; gap: 20px; margin-bottom: 30px; }.day-top .eyebrow { padding-top: 5px; color: #637958; }.day-top time { display: flex; align-items: center; gap: 12px; }.day-top time strong { font-size: 4rem; font-weight: 850; line-height: 1; letter-spacing: -.06em; }.day-top time span { font-size: .8rem; line-height: 1.5; color: #607266; }.day-card h3 { margin-bottom: 20px; font-size: 1.55rem; line-height: 1.2; letter-spacing: -.025em; }.day-card ul { display: flex; flex-wrap: wrap; gap: 9px; padding: 0; margin: 0 0 22px; list-style: none; }.day-card li { padding: 8px 12px; border: 1px solid #c2d1c2; background: #edf2e9; font-size: .8rem; font-weight: 750; }.day-card > p { margin-bottom: 0; color: #536353; font-size: .9rem; line-height: 1.8; }
  .cup-details { padding-block: 75px; background: #eaf0e7; border-block: 1px solid #d8e0d2; }.details-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 75px; align-items: center; }.details-grid p:not(.eyebrow) { margin-bottom: 0; color: #536353; line-height: 1.8; }.details-grid dl { margin: 0; }.details-grid dl > div { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; padding: 20px 0; border-bottom: 1px solid #bdccba; }.details-grid dl > div:first-child { border-top: 1px solid #bdccba; }.details-grid dt { font-size: .82rem; font-weight: 800; line-height: 1.6; }.details-grid dd { margin: 0; color: #536353; font-size: .87rem; line-height: 1.6; }
  .cup-contact { display: flex; align-items: center; justify-content: space-between; gap: 45px; padding-block: 80px; }.cup-contact p { margin-bottom: 0; }.cup-contact .eyebrow { margin-bottom: 14px; }.cup-contact .button { flex: 0 0 auto; margin-top: 0; }a:focus-visible { outline: 3px solid #a22e36; outline-offset: 4px; }
  .cup-rules { padding-block: 80px; scroll-margin-top: 130px; }.rules-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }.rule-card { padding: 26px; border-top: 3px solid var(--gold); background: #fffefa; }.rule-card h3 { margin-bottom: 22px; font-size: 1.4rem; }.rule-card dl { margin: 0; }.rule-card dl > div + div { margin-top: 18px; }.rule-card dt { color: #637958; font-size: .72rem; font-weight: 750; }.rule-card dd { margin: 6px 0 0; font-size: .94rem; line-height: 1.5; }.rules-note { margin: 25px 0 0; color: #536353; font-size: .9rem; line-height: 1.8; }.rules-links { display: flex; flex-wrap: wrap; gap: 15px 30px; margin-top: 26px; }.rules-links a, .details-grid a { color: #164f32; text-underline-offset: 4px; }.rules-links a { font-size: .83rem; font-weight: 750; }.rules-source { margin: 18px 0 0; color: #637958; font-size: .72rem; line-height: 1.6; }
  .cup-registration { padding-block: 85px; background: var(--forest); color: #fff9ec; scroll-margin-top: 115px; }.registration-grid { display: grid; grid-template-columns: minmax(0, .76fr) minmax(0, 1.24fr); gap: 65px; align-items: start; }.registration-copy { position: sticky; top: 125px; }.registration-copy .eyebrow, .registration-copy h2 em, .registration-copy a { color: var(--gold); }.registration-copy p:not(.eyebrow) { color: #d2dfcf; font-size: .93rem; line-height: 1.8; }.registration-copy a { display: inline-block; margin-top: 15px; font-size: .83rem; text-underline-offset: 4px; }
  @media(max-width: 1000px) { .registration-grid { gap: 30px; } }
  @media(max-width: 780px) { .registration-grid { grid-template-columns: 1fr; }.registration-copy { position: static; } }
  @media(max-width: 560px) { .rules-grid { grid-template-columns: 1fr; }.cup-rules, .cup-registration { padding-block: 55px; } }
  @media(max-width: 1000px) { .hero-grid { gap: 30px; }.cup-facts > div { padding: 22px 18px; }.details-grid { gap: 40px; }.day-card { padding: 26px; } }
  @media(max-width: 780px) { .hero-grid, .details-grid { grid-template-columns: 1fr; }.hero-grid { gap: 40px; }.cup-art { max-width: 540px; margin-inline: auto; }.cup-facts { grid-template-columns: 1fr; }.cup-facts > div { border-right: 0; border-bottom: 1px solid #e4e5d9; }.days-grid { grid-template-columns: 1fr; }.cup-contact { flex-direction: column; align-items: start; gap: 25px; }.cup-days { padding-block: 60px; } }
  @media(max-width: 480px) { .shell { width: calc(100% - 34px); }.cup-hero { padding: 38px 0 65px; }h1 { font-size: clamp(2.45rem, 10.5vw, 3rem); }.back { margin-bottom: 26px; }.cup-art { box-shadow: 6px 6px 0 #08261b; }.cup-art figcaption { padding: 22px; }.cup-details, .cup-contact { padding-block: 55px; }.day-card { padding: 23px; }.day-top time strong { font-size: 3.3rem; }.day-card h3 { font-size: 1.4rem; }.details-grid dl > div { gap: 15px; }.button { gap: 15px; padding-inline: 17px; } }
</style>
