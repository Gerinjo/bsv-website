---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PartnerLogoPanel from '../../components/PartnerLogoPanel.astro';
import Layout from '../../layouts/Layout.astro';
import { erlebnisCooperations } from '../../data/erlebnis';
import { withBase } from '../../utils/paths';
import { MCSHAPE_MINIMUM_AGE } from '../../../supabase/functions/_shared/mcshape-config';
const cooperation = erlebnisCooperations.find((item) => item.id === 'mcshape-radolfzell')!;
const regularPriceUrl = 'https://www.mcshape.com/fitnessstudio/radolfzell/';
const configuredFormEndpoint = import.meta.env.PUBLIC_MCSHAPE_FORM_ENDPOINT ?? '';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const mcShapeFormEndpoint = configuredFormEndpoint || (supabaseUrl ? `${supabaseUrl.replace(/\/$/, '')}/functions/v1/mcshape-interest` : '');
const minimumAge = MCSHAPE_MINIMUM_AGE;
---
<Layout title="MC Shape Radolfzell | BSV Nordstern Radolfzell" description="Mitgliedervorteile aus der Kooperation des BSV Nordstern Radolfzell mit MC Shape Radolfzell.">
  <Header />
  <main class="partner-page">
    <section class="hero">
      <div class="shell">
        <a href={withBase('/erlebnis')}>← Zurück zu allen Erlebnissen</a>
        <span>Kooperation & Benefit</span>
        <h1>MC Shape<br /><em>Radolfzell</em></h1>
        <p>BSV-Mitglieder profitieren bei MC Shape Radolfzell von besonderen Konditionen für Fitness, Kurse und auf Wunsch auch Wellness.</p>
      </div>
    </section>

    <div class="logo-shell shell"><PartnerLogoPanel cooperation={cooperation} /></div>

    <section class="benefits shell" aria-labelledby="benefits-title">
      <div class="benefits-heading">
        <span>Dein BSV-Vorteil</span>
        <h2 id="benefits-title">Trainieren zu<br /><em>Vereinskonditionen.</em></h2>
        <p>Die Kooperation gilt für Mitglieder des BSV Nordstern Radolfzell. Der direkte Vergleich zeigt bewusst beide regulären Laufzeiten von MC Shape, damit der Vorteil transparent bleibt.</p>
      </div>

      <div class="price-grid">
        <article class="price-card">
          <small>Fitness & Kurse · BSV</small>
          <strong><span>29,90 €</span><b>/ Monat</b></strong>
          <div class="price-compare">
            <span>Regulär · Classic</span>
            <div class="regular-rates"><b>12 Monate</b><del>49,90 €</del><b>24 Monate</b><del>39,90 €</del></div>
            <strong>bis zu 20 € weniger / Monat</strong>
            <small>gegenüber dem regulären 12-Monats-Tarif: 240 € Vorteil über 12 Monate</small>
          </div>
          <p>Nutzung der Studioeinrichtungen und des Kursangebots bei MC Shape Radolfzell.</p>
        </article>

        <article class="price-card is-featured">
          <small>Fitness, Kurse & Wellness · BSV</small>
          <strong><span>39,90 €</span><b>/ Monat</b></strong>
          <div class="price-compare">
            <span>Regulär · All-In</span>
            <div class="regular-rates"><b>12 Monate</b><del>59,90 €</del><b>24 Monate</b><del>49,90 €</del></div>
            <strong>bis zu 20 € weniger / Monat</strong>
            <small>gegenüber dem regulären 12-Monats-Tarif: 240 € Vorteil über 12 Monate</small>
          </div>
          <p>Die Leistungen der Kooperation inklusive des optionalen Wellnessbereichs.</p>
        </article>

        <article class="price-card is-start">
          <small>Einmalig</small>
          <strong><span>39,90 €</span><b>Startgebühr</b></strong>
          <div class="price-compare is-neutral">
            <span>Reguläres Startpaket</span>
            <strong>ebenfalls 39,90 €</strong>
          </div>
          <p>Einmalige Gebühr für das Basisstartpaket bei Abschluss der Mitgliedschaft.</p>
        </article>
      </div>

      <div class="price-source">
        <div><strong>Preisvergleich · Stand 07.08.2026</strong><span>Reguläre Tarife laut offizieller MC-Shape-Seite für Radolfzell. Zeitlich begrenzte Aktionen können abweichen.</span></div>
        <a href={regularPriceUrl} target="_blank" rel="noopener noreferrer">Reguläre Tarife bei MC Shape prüfen <b>↗</b></a>
      </div>
    </section>

    <section class="details shell">
      <div class="details-copy">
        <span>So funktioniert's</span>
        <h2>BSV-Mitglied sein.<br />Vorteil nutzen.</h2>
        <p>Die vergünstigte MC-Shape-Mitgliedschaft läuft über die Kooperation mit dem BSV. Nach der Freischaltung erhalten berechtigte Mitglieder Zugang zu den vereinbarten Leistungen.</p>
        <a class="benefit-button" href="#mcshape-beratung">Beratung anfragen <b aria-hidden="true">↓</b></a>
      </div>

      <aside class="facts-card">
        <h3>Auf einen Blick</h3>
        <ul>
          <li><strong>12 Monate</strong><span>Laufzeit der Mitgliedschaft über die Kooperation</span></li>
          <li><strong>Keine automatische Verlängerung</strong><span>Eine Verlängerung erfolgt wieder über den Verein.</span></li>
          <li><strong>Direkte Zahlung</strong><span>Der Mitgliedsbeitrag wird direkt mit MC Shape abgerechnet.</span></li>
          <li><strong>Kooperationszugang</strong><span>Die Berechtigung wird über den BSV bestätigt und freigeschaltet.</span></li>
        </ul>
      </aside>
    </section>

    <section class="lead-section shell" id="mcshape-beratung" aria-labelledby="mcshape-form-title">
      <div class="lead-intro">
        <span>Persönlicher Termin</span>
        <h2 id="mcshape-form-title">Interesse?<br /><em>Wir stellen den Kontakt her.</em></h2>
        <p>Fülle das Formular vollständig aus, wenn du die BSV-Konditionen nutzen möchtest. Für die Online-Anfrage ist aktuell ein Mindestalter von <strong>{minimumAge} Jahren</strong> hinterlegt. Deine Angaben werden sicher im BSV-System gespeichert; zusätzlich ist eine automatische Benachrichtigung für die weitere Terminvereinbarung vorgesehen.</p>
      </div>

      <form id="mcshape-interest-form" data-endpoint={mcShapeFormEndpoint} data-min-age={minimumAge} novalidate>
        <div class="field"><label for="mc-first-name">Vorname</label><input id="mc-first-name" name="firstName" autocomplete="given-name" minlength="2" maxlength="80" required /></div>
        <div class="field"><label for="mc-last-name">Nachname</label><input id="mc-last-name" name="lastName" autocomplete="family-name" minlength="2" maxlength="80" required /></div>
        <div class="field birth-field">
          <label for="mc-birth-date">Geburtsdatum</label>
          <input id="mc-birth-date" name="birthDate" type="date" autocomplete="bday" aria-describedby="mc-birth-hint" required />
          <p class="field-hint" id="mc-birth-hint">Mindestalter für die Online-Anfrage aktuell: {minimumAge} Jahre.</p>
        </div>
        <div class="field"><label for="mc-email">E-Mail-Adresse</label><input id="mc-email" name="email" type="email" autocomplete="email" maxlength="160" required /></div>
        <div class="field"><label for="mc-phone">Telefonnummer</label><input id="mc-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" pattern="[0-9+() /-]{6,40}" required /></div>
        <div class="field"><label for="mc-interest">Wofür interessierst du dich?</label><select id="mc-interest" name="interest" required><option value="">Bitte auswählen …</option><option value="Fitness & Kurse · 29,90 €">Fitness & Kurse · 29,90 €</option><option value="Fitness, Kurse & Wellness · 39,90 €">Fitness, Kurse & Wellness · 39,90 €</option><option value="Noch unsicher – Beratung gewünscht">Noch unsicher – Beratung gewünscht</option></select></div>
        <div class="field full"><label for="mc-contact-time">Wann bist du am besten erreichbar?</label><select id="mc-contact-time" name="preferredContactTime" required><option value="">Bitte auswählen …</option><option value="Flexibel">Flexibel</option><option value="Vormittags">Vormittags</option><option value="Nachmittags">Nachmittags</option><option value="Abends">Abends</option></select></div>

        <div class="honeypot" aria-hidden="true"><label for="mc-website">Website</label><input id="mc-website" name="website" tabindex="-1" autocomplete="off" /></div>

        <label class="consent full"><input type="checkbox" name="clubMember" required /><span>Ich bestätige, dass ich Mitglied beim BSV Nordstern Radolfzell bin und die Kooperationskonditionen nutzen möchte.</span></label>
        <label class="consent full callback-consent"><input type="checkbox" name="callbackConsent" required /><span>Ich möchte zur persönlichen Terminabsprache von MC Shape Radolfzell unter der angegebenen Telefonnummer angerufen werden.</span></label>
        <label class="consent full"><input type="checkbox" name="privacyAccepted" required /><span>Ich stimme zu, dass meine Angaben zur Bearbeitung der Anfrage und Terminvereinbarung an MC Shape Radolfzell übermittelt werden. Die <a href={withBase('/datenschutz')}>Datenschutzerklärung</a> habe ich gelesen.</span></label>

        <div class="submit-row full">
          <button type="submit" disabled><span data-submit-label>Bitte Pflichtfelder vervollständigen</span><b aria-hidden="true">↗</b></button>
          <p id="mcshape-form-status" role="status" aria-live="polite">Der Button wird aktiv, sobald alle Angaben vollständig und gültig sind.</p>
        </div>
      </form>

      <div class="form-success" id="mcshape-form-success" hidden>
        <span aria-hidden="true">✓</span>
        <div><strong>Vielen Dank – deine Anfrage wurde gespeichert.</strong><p>Deine Angaben wurden sicher übernommen. Wir kümmern uns um die weitere Bearbeitung und Terminvereinbarung.</p></div>
      </div>
    </section>

    <section class="note shell">
      <span aria-hidden="true">i</span>
      <p>Separat angebotene Leistungen wie Snacks oder Eiweißshakes sind nicht Bestandteil der Kooperationskonditionen und werden bei Nutzung separat berechnet.</p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#mcshape-interest-form');
  const status = document.querySelector<HTMLElement>('#mcshape-form-status');
  const success = document.querySelector<HTMLElement>('#mcshape-form-success');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const buttonLabel = button?.querySelector<HTMLElement>('[data-submit-label]');
  const birthInput = form?.querySelector<HTMLInputElement>('#mc-birth-date');
  const birthHint = document.querySelector<HTMLElement>('#mc-birth-hint');
  const minimumAge = Number(form?.dataset.minAge ?? '15');
  let isSubmitting = false;

  const calculateAge = (value: string) => {
    const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
    if (!match) return null;
    const year = Number(match[1]);
    const month = Number(match[2]);
    const day = Number(match[3]);
    const birth = new Date(year, month - 1, day);
    if (birth.getFullYear() !== year || birth.getMonth() !== month - 1 || birth.getDate() !== day) return null;

    const today = new Date();
    let age = today.getFullYear() - year;
    if (today.getMonth() < month - 1 || (today.getMonth() === month - 1 && today.getDate() < day)) age -= 1;
    return age;
  };

  const validateBirthDate = () => {
    if (!birthInput || !birthHint) return false;
    birthHint.classList.remove('is-error', 'is-ok');
    birthInput.removeAttribute('aria-invalid');

    if (!birthInput.value) {
      birthInput.setCustomValidity('');
      birthHint.textContent = `Mindestalter für die Online-Anfrage aktuell: ${minimumAge} Jahre.`;
      return false;
    }

    const age = calculateAge(birthInput.value);
    if (age === null || age < 0) {
      birthInput.setCustomValidity('Bitte ein gültiges Geburtsdatum angeben.');
      birthInput.setAttribute('aria-invalid', 'true');
      birthHint.classList.add('is-error');
      birthHint.textContent = 'Bitte ein gültiges Geburtsdatum angeben.';
      return false;
    }

    if (age < minimumAge) {
      const message = `Für die Online-Anfrage ist aktuell ein Mindestalter von ${minimumAge} Jahren hinterlegt.`;
      birthInput.setCustomValidity(message);
      birthInput.setAttribute('aria-invalid', 'true');
      birthHint.classList.add('is-error');
      birthHint.textContent = `${message} Eine Rückrufanfrage kann deshalb noch nicht abgesendet werden.`;
      return false;
    }

    birthInput.setCustomValidity('');
    birthHint.classList.add('is-ok');
    birthHint.textContent = 'Altersvoraussetzung für die Online-Anfrage erfüllt.';
    return true;
  };

  const updateFormState = () => {
    if (!form || !button || !buttonLabel) return;
    validateBirthDate();
    const ready = form.checkValidity() && !isSubmitting;
    button.disabled = !ready;
    buttonLabel.textContent = isSubmitting
      ? 'Anfrage wird übermittelt …'
      : ready
        ? 'Rückruf anfragen'
        : 'Bitte Pflichtfelder vervollständigen';

    if (status && !isSubmitting && status.dataset.serverMessage !== 'true') {
      status.textContent = ready
        ? 'Alles vollständig – die Anfrage kann jetzt gesendet werden.'
        : 'Der Button wird aktiv, sobald alle Angaben vollständig und gültig sind.';
    }
  };

  form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((control) => {
    control.addEventListener('input', () => {
      if (status) delete status.dataset.serverMessage;
      updateFormState();
    });
    control.addEventListener('change', () => {
      if (status) delete status.dataset.serverMessage;
      updateFormState();
    });
  });

  updateFormState();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    updateFormState();
    if (!form.reportValidity() || !status || !button || button.disabled) return;

    const endpoint = form.dataset.endpoint ?? '';
    if (!endpoint) {
      status.dataset.serverMessage = 'true';
      status.textContent = 'Die Online-Anfrage ist noch nicht freigeschaltet. Bitte versuche es später erneut.';
      return;
    }

    const data = new FormData(form);
    const payload = {
      firstName: String(data.get('firstName') ?? ''),
      lastName: String(data.get('lastName') ?? ''),
      birthDate: String(data.get('birthDate') ?? ''),
      email: String(data.get('email') ?? ''),
      phone: String(data.get('phone') ?? ''),
      interest: String(data.get('interest') ?? ''),
      preferredContactTime: String(data.get('preferredContactTime') ?? ''),
      clubMember: data.get('clubMember') === 'on',
      callbackConsent: data.get('callbackConsent') === 'on',
      privacyAccepted: data.get('privacyAccepted') === 'on',
      website: String(data.get('website') ?? ''),
    };

    isSubmitting = true;
    status.dataset.serverMessage = 'true';
    status.textContent = 'Anfrage wird sicher übermittelt …';
    updateFormState();

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result?.ok) throw new Error(result?.message || 'Die Anfrage konnte nicht gesendet werden.');

      form.reset();
      form.hidden = true;
      status.textContent = '';
      if (success) success.hidden = false;
    } catch (error) {
      status.dataset.serverMessage = 'true';
      status.textContent = error instanceof Error ? error.message : 'Die Anfrage konnte nicht gesendet werden.';
    } finally {
      isSubmitting = false;
      updateFormState();
    }
  });
</script>

<style>
