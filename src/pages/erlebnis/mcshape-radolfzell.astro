  .price-compare{padding:14px 15px;background:#f3f5f3;border-left:4px solid #ef0011}.is-featured .price-compare{background:#171717}.price-compare>span,.price-compare>strong,.price-compare>small{display:block}.price-compare>span{color:#6b776f;font-size:.57rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.is-featured .price-compare>span{color:#aaa}.regular-rates{margin-top:8px;display:grid;grid-template-columns:1fr auto;gap:5px 12px;align-items:center}.regular-rates b{color:#6f7b73;font-size:.67rem}.regular-rates del{color:#7c8780;font-size:.82rem;font-weight:800}.is-featured .regular-rates b,.is-featured .regular-rates del{color:#aaa}.price-compare>strong{margin-top:9px;color:#cf0010;font-size:1.02rem}.is-featured .price-compare>strong{color:#ff4551}.price-compare>small{margin-top:3px;color:#45534a;font-size:.67rem;font-weight:800;line-height:1.4}.is-featured .price-compare>small{color:#ddd}.price-compare.is-neutral{border-left-color:#7d8580}.price-compare.is-neutral strong{color:#334239}
  .price-source{margin-top:16px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:24px;background:#fff;border-left:4px solid #ef0011}.price-source strong,.price-source span{display:block}.price-source strong{font-size:.72rem}.price-source span{margin-top:4px;color:#728078;font-size:.65rem}.price-source a{flex:0 0 auto;color:#050505;font-size:.68rem;font-weight:950;text-decoration:none}.price-source a b{margin-left:7px;color:#ef0011}
  .details{padding:58px 0 86px;display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:start}.details-copy p{max-width:610px;color:#5d6c62;line-height:1.8}.benefit-button{min-height:52px;margin-top:18px;padding:0 20px;display:inline-flex;align-items:center;gap:28px;background:#050505;color:#fff;text-decoration:none;font-size:.78rem;font-weight:950}.benefit-button b{color:#ef0011}.facts-card{padding:30px;background:#fff;border-top:5px solid #ef0011;box-shadow:0 14px 36px rgb(0 0 0 / 7%)}.facts-card h3{margin:0 0 10px;color:#cf0010;font-size:1.2rem}.facts-card ul{margin:0;padding:0;list-style:none}.facts-card li{padding:16px 0;border-bottom:1px solid #e5e9e6}.facts-card li:last-child{border-bottom:0}.facts-card strong,.facts-card span{display:block}.facts-card strong{font-size:.88rem}.facts-card span{margin-top:4px;color:#6a786f;font-size:.75rem;line-height:1.5}
