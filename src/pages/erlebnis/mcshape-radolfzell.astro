  @media(max-width:620px){.price-grid{grid-template-columns:1fr}.price-card.is-start{grid-column:auto}.price-card{min-height:0}.benefits{padding-top:65px}.hero{padding:65px 0 100px}.logo-shell{margin-top:-55px}.details{padding-top:42px}.benefit-button{width:100%;justify-content:space-between}.lead-section form{grid-template-columns:1fr;padding:22px}.field{grid-column:1/-1}.submit-row{align-items:flex-start;flex-direction:column}.submit-row button{width:100%;justify-content:space-between}}
</style>