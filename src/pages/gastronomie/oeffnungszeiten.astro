---
import GastroPage from '../../components/GastroPage.astro';
import { gastronomy } from '../../data/gastronomie';
import { withBase } from '../../utils/paths';
---

<GastroPage
  title="Öffnungszeiten"
  description="Aktuelle Öffnungszeiten und Betriebsurlaub der BSV Nordstern Vereinsgaststätte."
  eyebrow="Öffnungszeiten"
  headline="Zeit für Genuss<br />und Begegnung."
  intro="Hier finden Sie die aktuellen Öffnungszeiten der Vereinsgaststätte und Hinweise zu unserem Betriebsurlaub."
  heroImage={gastronomy.gallery[2]}
  activePath="/gastronomie/oeffnungszeiten"
>
  <span class="gastro-section-label">Wann wir geöffnet haben</span>
  <h2 class="gastro-title">Unsere Öffnungszeiten.</h2>
  <p class="gastro-lead">Wir freuen uns auf Ihren Besuch. Für Reservierungen empfiehlt sich eine kurze telefonische Rückfrage.</p>

  <aside class="vacation-notice">
    <span>Betriebsurlaub</span>
    <strong>{gastronomy.vacation.from} bis {gastronomy.vacation.through}</strong>
    <p>Ab dem {gastronomy.vacation.reopens} sind wir wieder für Sie da.</p>
  </aside>

  <div class="hours-grid">
    <section class="hours-card">
      <div class="hours-head"><span>Vor Ort</span><h2>Öffnungszeiten Gaststätte</h2></div>
      <dl>
        {gastronomy.openingHours.map((entry) => <div><dt>{entry.days}</dt><dd>{entry.hours}</dd></div>)}
      </dl>
      <a href={gastronomy.phoneHref}>Rückfrage: {gastronomy.phone}</a>
    </section>

    <section class="hours-card info-card">
      <div class="hours-head"><span>Gut zu wissen</span><h2>Speisekarte & Bilder</h2></div>
      <p>Bei neuen Bildern und der aktualisierten Speisekarte bitten wir noch um etwas Geduld.</p>
      <a href={withBase('/gastronomie/speisekarte')}>Zur Speisekarte ↗</a>
    </section>
  </div>
</GastroPage>

<style>
  .vacation-notice{margin-top:34px;padding:24px 28px;border-left:6px solid #f4d638;background:#092f20;color:white;box-shadow:9px 9px 0 #f4d638}.vacation-notice span,.vacation-notice strong{display:block}.vacation-notice span{color:#f4d638;font-size:.68rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.vacation-notice strong{margin-top:7px;font-family:Georgia,serif;font-size:clamp(1.45rem,3vw,2.3rem)}.vacation-notice p{margin:7px 0 0;color:#cfddd4}
  .hours-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:42px}
  .hours-card{padding:34px;background:white;box-shadow:0 16px 45px rgb(9 47 32 / 7%);border-top:5px solid #164f32}
  .info-card{border-top-color:#f4d638}.info-card p{color:#59685e;line-height:1.75}
  .hours-head>span{color:#6c7b71;font-size:.67rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.hours-head h2{margin:8px 0 25px;font-family:Georgia,serif;font-size:2rem}
  dl{margin:0}dl>div{display:flex;justify-content:space-between;gap:25px;padding:14px 0;border-bottom:1px solid #e2e8e3}dt{font-weight:800}dd{margin:0;color:#59685e;text-align:right}.hours-card>a{display:inline-block;margin-top:24px;color:#164f32;font-weight:900;text-decoration:none}
  @media(max-width:800px){.hours-grid{grid-template-columns:1fr}}
</style>
