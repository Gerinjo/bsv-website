---
import GastroPage from '../../components/GastroPage.astro';
import { gastronomy } from '../../data/gastronomie';
---

<GastroPage
  title="Speisekarte"
  description={gastronomy.menuNotice}
  eyebrow="Speisekarte"
  headline="Bald wieder<br />für Sie da."
  intro={gastronomy.menuNotice}
  heroImage={gastronomy.gallery[3]}
  activePath="/gastronomie/speisekarte"
>
  <div class="menu-intro">
    <div>
      <span class="gastro-section-label">Speisekarte in Überarbeitung</span>
      <h2 class="gastro-title">Noch etwas Geduld.</h2>
      <p class="gastro-lead">Sobald die neue Speisekarte fertig ist, finden Sie sie wieder hier. Für Fragen, Reservierungen und aktuelle Tagesangebote steht das Gastro-Team telefonisch zur Verfügung.</p>
    </div>
    <div class="menu-actions">
      <a class="call-button" href={gastronomy.reservationPhoneHref}>Reservieren: {gastronomy.reservationPhone}</a>
    </div>
  </div>

</GastroPage>

<style>
  .menu-intro{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:55px;align-items:end}.menu-actions{display:grid;gap:12px;min-width:260px}.menu-actions a{justify-content:center}.call-button{padding:14px 18px;border:1px solid #bac6bd;color:#164f32;text-align:center;text-decoration:none;font-weight:850;background:white}
  @media(max-width:760px){.menu-intro{grid-template-columns:1fr;gap:25px}.menu-actions{min-width:0}}
</style>
