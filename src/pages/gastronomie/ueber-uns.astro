---
import GastroPage from '../../components/GastroPage.astro';
import { gastronomy } from '../../data/gastronomie';
---

<GastroPage
  title="Über unsere Gaststätte"
  description="Über die Vereinsgaststätte des BSV Nordstern Radolfzell, ihre Küche, Atmosphäre und Möglichkeiten für private Feiern."
  eyebrow="Über uns"
  headline="Gastfreundschaft<br />am Sportplatz."
  intro="Eine gemütliche Vereinsgaststätte, eine Mischung aus italienischer und deutscher Küche und ein Team, das sich auf Mitglieder, Gäste und Freunde des Vereins freut."
  heroImage={gastronomy.gallery[1]}
  activePath="/gastronomie/ueber-uns"
>
  <div class="story-grid">
    <div>
      <span class="gastro-section-label">Unsere Gaststätte</span>
      <h2 class="gastro-title">Willkommen beim BSV Nordstern.</h2>
    </div>
    <div class="story-copy">
      <p>Liebe Mitglieder, Gäste und Freunde des Vereins, wir laden Sie herzlich ein, in unserer gemütlichen Gaststätte vorbeizuschauen und sich von unserer Mischung aus italienischer und deutscher Küche verwöhnen zu lassen.</p>
      <p>Unser Team bietet eine vielfältige Auswahl an Gerichten. Von Meeresfrüchten über frische Salate und hausgemachte Pasta bis hin zu herzhaften Burgern ist für viele Geschmäcker etwas dabei.</p>
      <p>Genießen Sie Burger mit hausgemachten Saucen und knackigen Beilagen oder lassen Sie sich von Meeresfrüchtegerichten, Salaten und Pasta-Spezialitäten überzeugen. Dazu gibt es erlesene Weine, frisch gezapfte Biere und erfrischende Softdrinks.</p>
      <p>Die Gaststätte bietet außerdem einen passenden Rahmen für private Feiern und Veranstaltungen. Ob Geburtstag, Jubiläum oder Firmenevent – das Gastro-Team unterstützt gerne bei der Planung.</p>
    </div>
  </div>

  <section class="occasion-grid">
    <article class="gastro-card"><span>01</span><h3>Essen & Trinken</h3><p>Italienische und deutsche Küche, Pasta, Salate, Burger, Meeresfrüchte sowie passende Getränke.</p></article>
    <article class="gastro-card"><span>02</span><h3>Vereinsleben</h3><p>Treffpunkt für Mannschaften, Mitglieder, Familien, Nachbarschaft und Gäste rund um den Spielbetrieb.</p></article>
    <article class="gastro-card"><span>03</span><h3>Private Feiern</h3><p>Nebenraum und Kegelbahn bieten Möglichkeiten für Geburtstage, Jubiläen und weitere Veranstaltungen.</p></article>
  </section>

  <div class="gastro-gallery">
    {gastronomy.gallery.map((image, index) => <img src={image} alt={`Vereinsgaststätte des BSV Nordstern ${index + 1}`} width="720" height="520" loading="lazy" />)}
  </div>
</GastroPage>

<style>
  .story-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:80px;align-items:start}
  .story-copy p{margin:0 0 20px;color:#56665b;font-size:1rem;line-height:1.85}
  .occasion-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:75px 0 30px}
  .occasion-grid article{position:relative;padding-top:58px}.occasion-grid article>span{position:absolute;top:22px;right:24px;color:#d3dbd5;font-size:1.8rem;font-weight:900}.occasion-grid h3{font-size:1.55rem}
  @media(max-width:850px){.story-grid{grid-template-columns:1fr;gap:32px}.occasion-grid{grid-template-columns:1fr}}
</style>
