---
import { withBase } from '../utils/paths';

interface Props { title?: string; description?: string }
const { title = 'BSV Nordstern Radolfzell', description = 'Offizielle Webseite des BSV Nordstern e.V. Radolfzell' } = Astro.props;
---
<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/gif" href={withBase('/images/verein/wappen/bsv-nordstern.gif')} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<script is:inline type="text/javascript" src="https://www.fussball.de/widgets.js"></script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #17251b;
		background: #f4f7f4;
		-webkit-font-smoothing: antialiased;
	}
	* { box-sizing: border-box; }
	::selection { background: #f4d638; color: #092f20; }
</style>
