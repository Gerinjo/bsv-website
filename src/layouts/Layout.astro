---
import { withBase } from '../utils/paths';

interface Props { title?: string; description?: string }
const { title = 'BSV Nordstern Radolfzell', description = 'Offizielle Webseite des BSV Nordstern e.V. Radolfzell' } = Astro.props;
const contactPath = withBase('/kontakt');
---
<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/gif" href={withBase('/images/verein/wappen/bsv-nordstern.gif')} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<script is:inline type="text/javascript" src="https://www.fussball.de/widgets.js"></script>
	</head>
	<body>
		<slot />
		<script define:vars={{ contactPath }}>
			const topicByEmail = new Map([
				['info@bsvnordstern.de', 'general'],
				['jugend@bsvnordstern.de', 'youth'],
				['stefan.gastaudo@bsvnordstern.de', 'referees'],
				['konrad.mauz@bsvnordstern.de', 'archery'],
				['heike.seidel@bsvnordstern.de', 'gymnastics'],
				['thomas.graf@bsvnordstern.de', 'hiking'],
			]);

			const contactButtons = document.querySelectorAll([
				'.referee-cta a[href^="mailto:"]',
				'.concept-join a[href^="mailto:"]',
				'.department-notice a[href^="mailto:"]',
			].join(','));

			contactButtons.forEach((link) => {
				const rawHref = link.getAttribute('href') ?? '';
				const address = decodeURIComponent(rawHref.slice(7).split('?')[0]).trim().toLowerCase();
				const topic = topicByEmail.get(address);
				link.setAttribute('href', topic ? `${contactPath}?thema=${encodeURIComponent(topic)}` : contactPath);
			});
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #17251b;
		background: #f4f7f4;
		-webkit-font-smoothing: antialiased;
	}
	* { box-sizing: border-box; }
	::selection { background: #f4d638; color: #092f20; }
</style>
