---
import ErlebnisMegaEnhancer from '../components/ErlebnisMegaEnhancer.astro';
import GastroMegaEnhancer from '../components/GastroMegaEnhancer.astro';
import HomeShopEnhancer from '../components/HomeShopEnhancer.astro';
import SponsoringMegaEnhancer from '../components/SponsoringMegaEnhancer.astro';
import TagDesMaedchenfussballMenuEnhancer from '../components/TagDesMaedchenfussballMenuEnhancer.astro';
import { withBase } from '../utils/paths';

interface Props { title?: string; description?: string }
const { title = 'BSV Nordstern Radolfzell', description = 'Offizielle Webseite des BSV Nordstern e.V. Radolfzell' } = Astro.props;
const contactPath = withBase('/kontakt');
const basePath = withBase('/');
const friendlyMatchTeamPaths = [
	'fussball/herren/bezirksliga',
	'fussball/herren/kreisliga-2',
	'fussball/frauen/bezirksliga',
	'fussball/frauen/kreisliga',
	'jugend/u19',
	'jugend/u17',
	'jugend/u15-c1',
	'jugend/u15-c2',
	'jugend/u13-d1',
	'jugend/u13-d2',
	'jugend/u13-d3',
	'jugend/juniorinnen/u17',
	'jugend/juniorinnen/u15',
	'jugend/juniorinnen/u13',
];
---
<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/gif" href={withBase('/images/verein/wappen/bsv-nordstern.gif')} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<script is:inline type="text/javascript" src="https://www.fussball.de/widgets.js"></script>
	</head>
	<body>
		<slot />
		<GastroMegaEnhancer />
		<SponsoringMegaEnhancer />
		<ErlebnisMegaEnhancer />
		<TagDesMaedchenfussballMenuEnhancer />
		<HomeShopEnhancer />
		<script define:vars={{ contactPath, basePath, friendlyMatchTeamPaths }}>
			const topicByEmail = new Map([
				['info@bsvnordstern.de', 'general'],
				['jugend@bsvnordstern.de', 'youth'],
				['stefan.gastaudo@bsvnordstern.de', 'referees'],
				['konrad.mauz@bsvnordstern.de', 'archery'],
				['verwaltung@bsvnordstern.de', 'gymnastics'],
				['thomas.graf@bsvnordstern.de', 'hiking'],
			]);

			const contactButtons = document.querySelectorAll([
				'.referee-cta a[href^="mailto:"]',
				'.concept-join a[href^="mailto:"]',
				'.department-notice a[href^="mailto:"]',
			].join(','));

			contactButtons.forEach((link) => {
				const rawHref = link.getAttribute('href') ?? '';
				const address = decodeURIComponent(rawHref.slice(7).split('?')[0]).trim().toLowerCase();
				const topic = topicByEmail.get(address);
				link.setAttribute('href', topic ? `${contactPath}?thema=${encodeURIComponent(topic)}` : contactPath);
			});

			const restoreDirectContactLinks = () => {
				document.querySelectorAll('.contact-toggle').forEach((toggle) => {
					const revealedLink = toggle.nextElementSibling;
					if (!(revealedLink instanceof HTMLAnchorElement) || !revealedLink.classList.contains('contact-value')) return;

					const isEmail = toggle.classList.contains('is-email');
					const directLink = document.createElement('a');
					directLink.href = revealedLink.getAttribute('href') ?? '';
					directLink.className = `contact-direct ${isEmail ? 'is-email' : 'is-phone'}`;
					directLink.setAttribute('aria-label', revealedLink.getAttribute('aria-label') ?? (isEmail ? 'E-Mail schreiben' : 'Telefonnummer anrufen'));
					directLink.textContent = isEmail ? '✉' : '☎';

					toggle.replaceWith(directLink);
					revealedLink.remove();
			});
			};

			const correctCoachNames = () => {
				const nameCorrections = new Map([
					['Dana Bulander', 'Dana-Sophie Bulander'],
					['Marlia Burlander', 'Marlia-Lena Bulander'],
				]);

				document.querySelectorAll('.coach-details h3, .legacy-content .uk-card-title').forEach((element) => {
					const currentName = element.textContent?.trim() ?? '';
					const correctedName = nameCorrections.get(currentName);
					if (correctedName) element.textContent = correctedName;
				});

				document.querySelectorAll('[title], [alt], [aria-label]').forEach((element) => {
					['title', 'alt', 'aria-label'].forEach((attribute) => {
						const currentValue = element.getAttribute(attribute);
						if (!currentValue) return;

						let correctedValue = currentValue;
						nameCorrections.forEach((correctName, oldName) => {
							correctedValue = correctedValue.replaceAll(oldName, correctName);
						});
						if (correctedValue !== currentValue) element.setAttribute(attribute, correctedValue);
					});
				});
			};

			const addFriendlyMatchButton = () => {
				const normalizedBase = basePath.endsWith('/') ? basePath : `${basePath}/`;
				const currentPath = (window.location.pathname.startsWith(normalizedBase)
					? window.location.pathname.slice(normalizedBase.length)
					: window.location.pathname.replace(/^\/+/, ''))
					.replace(/\/+$/, '');

				if (!friendlyMatchTeamPaths.includes(currentPath)) return;

				const trialButton = [...document.querySelectorAll('main a')].find((link) => {
					const label = link.textContent?.trim().toLocaleLowerCase('de-DE') ?? '';
					const href = link.getAttribute('href') ?? '';
					return label.includes('probetraining') || href.includes('--trial');
				});

				if (!(trialButton instanceof HTMLAnchorElement) || trialButton.dataset.friendlyMatchEnhanced === 'true') return;

				const teamKey = currentPath.replaceAll('/', '--');
				const friendlyButton = trialButton.cloneNode(true);
				if (!(friendlyButton instanceof HTMLAnchorElement)) return;

				friendlyButton.href = `${contactPath}?thema=${encodeURIComponent(`team--${teamKey}--friendly`)}`;
				friendlyButton.setAttribute('aria-label', 'Freundschaftsspiel mit dieser Mannschaft anfragen');
				friendlyButton.innerHTML = 'Freundschaftsspiel anfragen <span>↗</span>';

				const actions = document.createElement('div');
				actions.className = 'team-inquiry-actions';
				trialButton.dataset.friendlyMatchEnhanced = 'true';
				trialButton.before(actions);
				actions.append(trialButton, friendlyButton);
			};

			const enhancePage = () => {
				restoreDirectContactLinks();
				correctCoachNames();
				addFriendlyMatchButton();
			};

			if (document.readyState === 'loading') {
				window.addEventListener('DOMContentLoaded', enhancePage, { once: true });
			} else {
				enhancePage();
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		overflow-x: clip;
		font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #17251b;
		background: #f4f7f4;
		-webkit-font-smoothing: antialiased;
	}
	* { box-sizing: border-box; }
	::selection { background: #f4d638; color: #092f20; }
	:global(.contact-icons .contact-direct) {
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		border: 1px solid rgb(9 47 32 / 22%);
		border-radius: 50%;
		background: white;
		color: #164f32;
		font-size: 1rem;
		font-weight: 900;
		line-height: 1;
		text-decoration: none;
		transition: .18s ease;
	}
	:global(.contact-icons .contact-direct:hover),
	:global(.contact-icons .contact-direct:focus-visible) {
		border-color: #f4d638;
		background: #f4d638;
		color: #092f20;
		transform: translateY(-1px);
	}
	:global(.d-girls-cta > .team-inquiry-actions) {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: stretch;
		justify-content: flex-end;
		flex-wrap: wrap;
		gap: 12px;
	}
	:global(.d-girls-cta > .team-inquiry-actions > a) {
		min-width: 230px;
		margin: 0;
		padding: 16px 18px;
		display: flex;
		justify-content: space-between;
		gap: 28px;
		background: #092f20;
		color: white;
		font-size: .8rem;
		font-weight: 900;
		text-decoration: none;
	}
	:global(.d-girls-cta > .team-inquiry-actions > a span) {
		color: #f4d638;
	}
	@media (max-width: 900px) {
		:global(.d-girls-cta > .team-inquiry-actions) {
			justify-self: start;
			justify-content: flex-start;
		}
	}
	@media (max-width: 560px) {
		:global(.d-girls-cta > .team-inquiry-actions) {
			width: 100%;
			align-items: stretch;
			flex-direction: column;
		}
		:global(.d-girls-cta > .team-inquiry-actions > a) {
			width: 100%;
			min-width: 0;
		}
	}
</style>
